 "proposals": [
  {
   "code": "S2.01",
   "label": "岗位目的",
   "value": "负责部门品质与业务目标管理,承接上级与客户下达的任务 建立并维护管理体系、标准与培训考核机制 监督标准执行,组织检测、设备与物料验收,保障过程受控 通过数据收集与持续改善,定期报送运营数据 对接客户要求与审厂,管理供应商/外部资源质量。",
   "basis": "由 8 条职责归纳:「负责部门品质与业…」←职责1、「建立并维护管理体…」←职责2,3、「监督标准执行,组…」←职责4,5、「通过数据收集与持…」←职责6、「对接客户要求与审…」←职责7,8"
  },
  {
   "code": "S2.02",
   "label": "关键成功指标",
   "value": "目标达成率、异常闭环率 / 投诉件数、报表按时报送率、客户审厂通过率、供应商/外部资源合格率",
   "basis": "由职责动词推导:目标达成率←职责1「保质保量完成…任务」;异常闭环率 / 投诉件数←职责4「执行各项标准…达成目标」;报表按时报送率←职责6「完成周报、月报」;客户审厂通过率←职责7「接待客户、承接客户要求」;供应商/外部资源合格率←职责8「供应商品质管理」"
  },
  {
   "code": "S4.02",
   "label": "职责权重",
