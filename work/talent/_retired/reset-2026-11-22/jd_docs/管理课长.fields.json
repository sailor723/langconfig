  "S1.11": {
   "label": "岗位类别",
   "value": null,
   "status": "JD 未写",
   "note": "它决定用哪份模板 —— 按名字猜会错:品质经理原文写「直接下属:无」,按名字套经理模板就会问一堆管理幅度和预算的空问题"
  },
  "S2.03": {
   "label": "团队/部门目标",
   "value": null,
   "status": "JD 未写",
   "note": "没有团队目标,就无法判断这个管理者对什么负责,也评不出他带团队的方向对不对"
  },
  "S4.04": {
   "label": "管理幅度",
   "value": null,
   "status": "JD 未写",
   "note": "带 3 个人和带 30 个人是完全不同的岗位;不写人数,匹配出来的候选人会严重错配"
  },
  "S4.05": {
   "label": "预算与成本责任",
   "value": null,
   "status": "JD 未写",
   "note": "管不管钱决定了这个岗的权力边界;不管预算的管理岗,实际是高级执行岗"
  },
  "S4.06": {
   "label": "决策权限",
   "value": null,
   "status": "JD 未写",
   "note": "招进来做不了决定的管理者,会退化成传声筒 —— 这是招聘失败最常见的原因之一"
  },
  "S4.07": {
   "label": "跨部门接口",
   "value": null,
   "status": "JD 未写",
   "note": "管理岗的绩效大半取决于跨部门协作;不写清对接谁,面试时无法验证沟通成本"
  },
  "S5.08": {
   "label": "排班与交接",
   "value": null,
   "status": "JD 未写",
   "note": "要不要交接班、交接什么,直接决定这个人每天的有效工时与出错风险"
  }
