*.p12
*.pfx
*.key
*.pem
*.crt
*.cert
*.cer
*.provisionprofile

# OAuth and encryption (CRITICAL - never commit!)
backend/encryption.key
backend/*.key
oauth_tokens.json
credentials.json
token.json
client_secret*.json

# Backend outputs
/backend/outputs/
/backend/workspace/

# Internal documentation (keep docs/ folder but ignore contents except setup guides)
docs/*
!docs/.gitkeep
!docs/GOOGLE_OAUTH_SETUP.md
!docs/settings-refactor.md
!docs/tools-refactor.md
!docs/tools-audit.md
!docs/agents-audit.md
