langconfig/

# Private/unreleased features (uncomment before pushing to public)
# backend/core/codegen/generators/streamlit_configurable.py
langconfig/

# Backend data (large files, PDFs, chat attachments)
backend/data/**

# Root data/ — agent-generated analysis outputs (dashboards, ERD screenshots);
# keep on disk, never commit (backend/data/** covers the backend copy)
/data/

# Notebook fonts (large binaries; only the processed .pkl forms are tracked)
backend/notebooks/**/*.ttf

# Neo4j HR seed dump (≈19 MB binary). Kept on disk for the Graph Studio Neo4j
# agent and shipped with the team-install bundle — see docs/TEAM_INSTALL.md §1.
backend/scripts/seeds/neo4j-hr/neo4j.dump

# Team-install bundle (generated by scripts/make_team_zip.sh)
langconfig.zip

# Symlink form: "node_modules/" above does not match a symlink named node_modules
node_modules
