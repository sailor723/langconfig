dist/
dist-preview/
build/
src-tauri/target/

# IDE
.vscode/

# Generated sandbox directories (Phase 5: Data Analysis)
_data_analysis_sandbox/
_analysis_output/
backend/outputs/

# Runtime materialized workspace (DB is the source of truth; files are
