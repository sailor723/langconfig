# Internal documentation — docs/ contents stay private by default.
#
# Published set = the three key guides (architecture / installation / usage)
# plus the reference material that was already public before the reorg.
# Anything NOT listed here stays local-only (client briefings, OKF design notes,
# slide decks, carrier_studio assets). Add a line when a new doc should ship.
#
# NOTE: a file cannot be re-included while its parent directory is excluded, so
# docs/reference/ and docs/reference/plans/ are un-ignored before their files.
docs/*
!docs/.gitkeep

# ── the three key docs ──
!docs/system-architecture.md
!docs/system-architecture.zh-CN.md
!docs/installation.md
!docs/installation.zh-CN.md
!docs/installation.zh-CN.pdf
!docs/usage.md
!docs/usage.zh-CN.md

# ── reference material (published subset) ──
# Un-ignoring the directory is required to reach files inside it, but that alone
# would publish client briefings and slide decks too — so the directory's
# contents are re-ignored and only the published files are negated by name.
!docs/reference/
docs/reference/*
!docs/reference/GOOGLE_OAUTH_SETUP.md
!docs/reference/agents-audit.md
!docs/reference/data-taxonomy.md
!docs/reference/deepagent-vs-dsh.md
!docs/reference/deepagents-study.md
!docs/reference/deepseek-vision-model.md
!docs/reference/settings-refactor.md
!docs/reference/skill-authoring.md
!docs/reference/storage-map.md
!docs/reference/sunhing-dashboards.md
!docs/reference/tools-audit.md
!docs/reference/tools-refactor.md
!docs/reference/plans/
docs/reference/plans/*
!docs/reference/plans/2026-02-12-langconfig-saas-design.md
!docs/reference/plans/2026-02-12-langconfig-saas-implementation.md
!docs/reference/plans/2026-10-15-kv-ingest-core-spec.md
langconfig/

# Private/unreleased features (uncomment before pushing to public)
# backend/core/codegen/generators/streamlit_configurable.py
langconfig/

# Backend data (large files, PDFs, chat attachments)
backend/data/**

# Root data/ — agent-generated analysis outputs (dashboards, ERD screenshots);
# keep on disk, never commit (backend/data/** covers the backend copy)
/data/

# Notebook fonts (large binaries; only the processed .pkl forms are tracked)
backend/notebooks/**/*.ttf

# Neo4j HR seed dump (≈19 MB binary). Kept on disk for the Graph Studio Neo4j
# agent and shipped with the team-install bundle — see docs/TEAM_INSTALL.md §1.
backend/scripts/seeds/in/neo4j-hr/neo4j.dump

# Team-install bundle (generated by scripts/make_team_zip.sh)
langconfig.zip

# Symlink form: "node_modules/" above does not match a symlink named node_modules
node_modules

# Local backup snapshots written by the seed migration/repair scripts.
# Machine-local data, not source: never commit them.
backend/scripts/backups/
