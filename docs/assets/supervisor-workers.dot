digraph supervisor {
  rankdir=TB;
  bgcolor="#1A1334";
  pad=0.45;
  nodesep=0.75;
  ranksep=0.85;
  fontname="Menlo";

  node [shape=box, style="rounded,filled", penwidth=2.2, fontname="Menlo", fontsize=14,
        margin="0.22,0.13", fillcolor="#251A49", color="#9B7BDB", fontcolor="#E5DBFF"];
  edge [fontname="Menlo", fontsize=12, color="#9B7BDB", fontcolor="#C7AEFF",
        penwidth=2.2, arrowsize=0.9];

  sup [label="supervisor\n(自己也是一个 agent)", fontsize=16, penwidth=3.0, color="#62B7FF"];
  sch [label="schedule_event", color="#6E5FA8"];
  mng [label="manage_email", color="#6E5FA8"];
  cal [label="calendar agent\n日期换算 · 建日程", color="#62B7FF"];
  eml [label="email agent\n起草 · 发送", color="#62B7FF"];
  tol [label="create_calendar_event\nget_available_time_slots", shape=box, style="rounded,filled,dashed",
       color="#6E5FA8", fontcolor="#C7AEFF"];
  tol2 [label="send_email", style="rounded,filled,dashed", color="#6E5FA8", fontcolor="#C7AEFF"];

  sup -> sch [label="只看得到\n包装工具", color="#62B7FF", fontcolor="#62B7FF"];
  sup -> mng [color="#62B7FF"];
  sch -> cal;
  mng -> eml;
  cal -> tol [style=dashed, arrowhead=none, color="#6E5FA8"];
  eml -> tol2 [style=dashed, arrowhead=none, color="#6E5FA8"];

  {rank=same; sch; mng;}
  {rank=same; cal; eml;}
  {rank=same; tol; tol2;}
}
