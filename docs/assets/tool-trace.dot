digraph trace {
  rankdir=LR;
  bgcolor="#1A1334";
  pad=0.30;
  nodesep=0.42;
  ranksep=0.47;
  fontname="Menlo";

  node [shape=box, style="rounded,filled", penwidth=2.0, fontname="Menlo", fontsize=9,
        margin="0.14,0.07", fillcolor="#251A49", color="#9B7BDB", fontcolor="#E5DBFF"];
  edge [color="#62B7FF", penwidth=2.2, arrowsize=0.9];

  g  [label="glob\n找文件", color="#62B7FF"];
  r  [label="read_any_file\n读成按 sheet 分块的文本", color="#62B7FF"];
  l  [label="sqlite_load_csv ×3\n一个 sheet 一张表", color="#6E5FA8"];
  q  [label="sqlite_execute ×2\n回读表结构 · 样例", color="#6E5FA8"];

  g -> r -> l -> q;
}
