</owl:Class>

<owl:Class rdf:about="#Genre">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#PrimarySubject">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#QuestionType">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Role">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#FinancialReport">
  <rdfs:subClassOf rdf:resource="#Document"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Document"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasGenre"/>
          <owl:hasValue rdf:resource="#financial_data"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ComparisonReport">
  <rdfs:subClassOf rdf:resource="#Document"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Document"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasGenre"/>
          <owl:hasValue rdf:resource="#comparison"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#InvestmentGradeReport">
  <rdfs:subClassOf rdf:resource="#Document"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Document"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#mentionsEntity"/>
          <owl:someValuesFrom rdf:resource="#Metric"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#mentionsEntity"/>
          <owl:someValuesFrom rdf:resource="#Organization"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:NamedIndividual rdf:about="#company_analysis">
