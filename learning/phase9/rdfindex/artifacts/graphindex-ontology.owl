<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://langconfig.local/graphindex"
         xmlns="http://langconfig.local/graphindex#">

<owl:Ontology rdf:about="http://langconfig.local/graphindex"/>

<owl:ObjectProperty rdf:about="#mentionsEntity">
  <rdfs:domain rdf:resource="#Document"/>
  <rdfs:range rdf:resource="#EntityType"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasGenre">
  <rdfs:domain rdf:resource="#Document"/>
  <rdfs:range rdf:resource="#Genre"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPrimarySubject">
  <rdfs:domain rdf:resource="#Document"/>
  <rdfs:range rdf:resource="#PrimarySubject"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#answersQuestionType">
  <rdfs:domain rdf:resource="#Document"/>
  <rdfs:range rdf:resource="#QuestionType"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasTitle">
  <rdfs:domain rdf:resource="#Document"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSummary">
  <rdfs:domain rdf:resource="#Document"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#filePath">
  <rdfs:domain rdf:resource="#Document"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#supportedQuery">
  <rdfs:domain rdf:resource="#Document"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Document">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#EntityType">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Organization">
  <rdfs:subClassOf rdf:resource="#EntityType"/>
</owl:Class>

<owl:Class rdf:about="#Industry">
  <rdfs:subClassOf rdf:resource="#EntityType"/>
</owl:Class>

<owl:Class rdf:about="#Person">
  <rdfs:subClassOf rdf:resource="#EntityType"/>
</owl:Class>

<owl:Class rdf:about="#Product">
