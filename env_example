# ./data/documents — uploaded documents (FileStorage)
DOCUMENTS_BASE_DIR=./data/documents
# backend/.workspace_data — project AGENTS.md etc. (agents_md_service)
LANGCONFIG_WORKSPACE_ROOT=backend/.workspace_data
