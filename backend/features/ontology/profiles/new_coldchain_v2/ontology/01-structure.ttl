    :businessDescription "用户原话" .
:nlOk a owl:DatatypeProperty ; rdfs:domain :NlEvent ; :physicalColumn "ok" ;
    :businessDescription "是否成功解析并回答" .
:nlRefused a owl:DatatypeProperty ; rdfs:domain :NlEvent ; :physicalColumn "refused" ;
    :businessDescription "拒绝时的说明文本" .
:nlRefusalKind a owl:DatatypeProperty ; rdfs:domain :NlEvent ; :physicalColumn "refusal_kind" ;
    :businessDescription "拒绝类别" .
:nlIntent a owl:DatatypeProperty ; rdfs:domain :NlEvent ; :physicalColumn "intent" ;
    :businessDescription "解析意图（jsonb）" .
:nlBackend a owl:DatatypeProperty ; rdfs:domain :NlEvent ; :physicalColumn "backend" ;
    :businessDescription "解析后端（ollama:qwen2.5:3b 3 / 规则 12）" .
# ── KPI 扩展结构（由库 schema 生成，覆盖 9 张新表 + 11 个新列）─────────────────
@prefix : <https://cube.local/ontology/new_coldchain_v2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:DriverSchedule a owl:Class ; rdfs:label "司机排班日" ; :physicalTable "driver_schedule" ; :primaryKey "driver_id, day" ; :timeColumn "day" .
:driverScheduleDriverId a owl:ObjectProperty ; rdfs:domain :DriverSchedule ; :physicalColumn "driver_id" ; :references :Driver .
:driverScheduleDay a owl:DatatypeProperty ; rdfs:domain :DriverSchedule ; :physicalColumn "day" .
:driverScheduleStatus a owl:DatatypeProperty ; rdfs:domain :DriverSchedule ; :physicalColumn "status" .
:driverScheduleScheduled a owl:DatatypeProperty ; rdfs:domain :DriverSchedule ; :physicalColumn "scheduled" .
:driverScheduleHours a owl:DatatypeProperty ; rdfs:domain :DriverSchedule ; :physicalColumn "hours" .
:driverScheduleReason a owl:DatatypeProperty ; rdfs:domain :DriverSchedule ; :physicalColumn "reason" .

:IncidentTicket a owl:Class ; rdfs:label "异常工单" ; :physicalTable "incident_tickets" ; :primaryKey "id" ; :timeColumn "raised_at" .
:incidentTicketId a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "id" .
:incidentTicketTripId a owl:ObjectProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "trip_id" ; :references :Trip .
:incidentTicketStopId a owl:ObjectProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "stop_id" ; :references :Stop .
:incidentTicketType a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "type" .
:incidentTicketRaisedAt a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "raised_at" .
:incidentTicketChannel a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "channel" .
:incidentTicketResponsibleParty a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "responsible_party" .
:incidentTicketStatus a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "status" .
:incidentTicketIsPrimary a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "is_primary" .
:incidentTicketDetail a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "detail" .

:Violation a owl:Class ; rdfs:label "交通违章" ; :physicalTable "violations" ; :primaryKey "id" ; :timeColumn "occurred_at" .
