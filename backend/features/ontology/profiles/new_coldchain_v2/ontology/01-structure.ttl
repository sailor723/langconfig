:fuelLogStation a owl:DatatypeProperty ; rdfs:domain :FuelLog ; :physicalColumn "station" .

:MaintenanceOrder a owl:Class ; rdfs:label "维修工单" ; :physicalTable "maintenance_orders" ; :primaryKey "id" ; :timeColumn "opened_at" .
:maintenanceOrderId a owl:DatatypeProperty ; rdfs:domain :MaintenanceOrder ; :physicalColumn "id" .
:maintenanceOrderVehicleId a owl:ObjectProperty ; rdfs:domain :MaintenanceOrder ; :physicalColumn "vehicle_id" ; :references :Vehicle .
