:zonePermitStatus a owl:DatatypeProperty ; rdfs:domain :ZonePermit ; :physicalColumn "status" .

:VehicleFixedCost a owl:Class ; rdfs:label "车辆固定成本" ; :physicalTable "vehicle_fixed_costs" ; :primaryKey "id" ; :timeColumn "period" .
:vehicleFixedCostId a owl:DatatypeProperty ; rdfs:domain :VehicleFixedCost ; :physicalColumn "id" .
