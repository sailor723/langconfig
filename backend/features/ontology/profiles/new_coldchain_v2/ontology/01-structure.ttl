:RestrictionDay a owl:Class ; rdfs:label "限行日历" ; :physicalTable "restriction_calendar" ; :primaryKey "day, zone" ; :timeColumn "day" .
:restrictionDayDay a owl:DatatypeProperty ; rdfs:domain :RestrictionDay ; :physicalColumn "day" .
:restrictionDayZone a owl:DatatypeProperty ; rdfs:domain :RestrictionDay ; :physicalColumn "zone" .
:restrictionDayRestricted a owl:DatatypeProperty ; rdfs:domain :RestrictionDay ; :physicalColumn "restricted" .
:restrictionDayRestrictionType a owl:DatatypeProperty ; rdfs:domain :RestrictionDay ; :physicalColumn "restriction_type" .
:restrictionDayNote a owl:DatatypeProperty ; rdfs:domain :RestrictionDay ; :physicalColumn "note" .

:VehicleAxle a owl:Class ; rdfs:label "车辆轴荷" ; :physicalTable "vehicle_axles" ; :primaryKey "vehicle_id, axle_seq" .
:vehicleAxleVehicleId a owl:ObjectProperty ; rdfs:domain :VehicleAxle ; :physicalColumn "vehicle_id" ; :references :Vehicle .
:vehicleAxleAxleSeq a owl:DatatypeProperty ; rdfs:domain :VehicleAxle ; :physicalColumn "axle_seq" .
:vehicleAxleAxleType a owl:DatatypeProperty ; rdfs:domain :VehicleAxle ; :physicalColumn "axle_type" .
:vehicleAxleRatedKg a owl:DatatypeProperty ; rdfs:domain :VehicleAxle ; :physicalColumn "rated_kg" .
:vehicleAxleLoadShare a owl:DatatypeProperty ; rdfs:domain :VehicleAxle ; :physicalColumn "load_share" .

# ── 既有表的新列 ─────────────────────────────────────────────────────────
:tripActualKm a owl:DatatypeProperty ; rdfs:label "实际行驶里程（km）" ; rdfs:domain :Trip ; :physicalColumn "actual_km" .
:tripFuelLiters a owl:DatatypeProperty ; rdfs:label "本趟燃油升数（分摊值）" ; rdfs:domain :Trip ; :physicalColumn "fuel_liters" .
:tripMaintenanceCost a owl:DatatypeProperty ; rdfs:label "本趟维修成本（分摊值）" ; rdfs:domain :Trip ; :physicalColumn "maintenance_cost" .
:tripStopsDelivered a owl:DatatypeProperty ; rdfs:label "本趟送达站数（冻结）" ; rdfs:domain :Trip ; :physicalColumn "stops_delivered" .
:tripWeighbridgeWeight a owl:DatatypeProperty ; rdfs:label "地磅实称重量（kg）" ; rdfs:domain :Trip ; :physicalColumn "weighbridge_weight" .
:tripFixedCostApportioned a owl:DatatypeProperty ; rdfs:label "本趟固定成本（分摊值）" ; rdfs:domain :Trip ; :physicalColumn "fixed_cost" .
:tripAxleOverload a owl:DatatypeProperty ; rdfs:label "是否轴荷超限（冻结）" ; rdfs:domain :Trip ; :physicalColumn "axle_overload" .
:tripCoreRestricted a owl:DatatypeProperty ; rdfs:label "是否受限日进核心区（冻结）" ; rdfs:domain :Trip ; :physicalColumn "core_restricted" .
:tripPermitValid a owl:DatatypeProperty ; rdfs:label "该趟车辆当天是否持有效通行证（冻结）" ; rdfs:domain :Trip ; :physicalColumn "permit_valid" .
:stopServiceStatus a owl:DatatypeProperty ; rdfs:label "站点配送结果（delivered/refused/closed_store/not_delivered）" ; rdfs:domain :Stop ; :physicalColumn "service_status" .
:vehicleTotalKm a owl:DatatypeProperty ; rdfs:label "该车窗口内总里程（km）" ; rdfs:domain :Vehicle ; :physicalColumn "total_km" .
