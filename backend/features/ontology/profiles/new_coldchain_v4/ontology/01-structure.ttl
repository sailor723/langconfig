    :businessDescription "解析后端（ollama:qwen2.5:3b 3 / 规则 12）" .

# ================================================================ v4 delta：KPI 卡 1–6 需要的 9 张表
# 这一节是 2026 版 KPI 口径（Book1 + 口径字典）落地时补的对象：合规（轴/地磅/通行证/限行）、
# 出勤与线路执行、异常工单、油耗台账、维修工单、固定成本台账、违章台账。
# 规则不变：一个对象 = 一张表；每个物理列只在 :physicalColumn 里出现一次；属性名全库唯一。

# ---------------------------------------------------------------- 趟次上被 KPI 直接引用的列
:tripActualKm a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "actual_km" ;
    :businessDescription "本趟实际里程（GPS 清洗后累计）。百公里油耗、单公里成本的分母。" .
:tripFuelLiters a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "fuel_liters" ;
    :businessDescription "本趟油耗（升）。与 fuel_logs.liters 合计一致（32,378.1 L），但一条是趟次分摊、一条是加油记录，两者不能互相替代。" .
:tripMaintenanceCost a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "maintenance_cost" ;
    :businessDescription "本趟分摊的维修成本（元）。" .
:tripFixedCost a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "fixed_cost" ;
    :businessDescription "本趟分摊的固定成本（保险+折旧+车船税+年检）。与 vehicle_fixed_costs 台账合计差 0.26 元（四舍五入），本体一律用这一列，因为 TCO 的三条腿必须同源。" .
:tripStopsDelivered a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "stops_delivered" ;
    :businessDescription "本趟实际送达站点数。与 stops.service_status='delivered' 的合计一致（49,927），是线路完成率的分母/分子来源。" .
:tripWeighbridgeWeight a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "weighbridge_weight" ;
    :businessDescription "地磅/动态称重读数。列里既非吨也非公斤统一单位（口径未确认），所以超载幅度按称重口径按名拒绝。" .
:tripAxleOverload a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "axle_overload" ;
    :businessDescription "本趟是否轴荷超限（布尔）。轴型档案在 vehicle_axles（128 条，含 rated_kg），但库里没有逐轴实测轴荷，所以只能判「超/不超」，判不了每根轴超多少。" .
:tripCoreRestricted a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "core_restricted" ;
    :businessDescription "本趟是否进核心限行区（布尔）。" .
:tripPermitValid a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "permit_valid" ;
    :businessDescription "本趟车辆通行证是否有效（布尔）。与 zone_permits 台账的 12/20 张有效证互为第二路线。" .
:stopServiceStatus a owl:DatatypeProperty ; rdfs:domain :Stop ; :physicalColumn "service_status" ;
    :businessDescription "这一站的配送结果：delivered 49,927 / refused 412 / closed_store 274 / not_delivered 219。它是「站送没送到」的唯一判据，不是异常工单。" .

# ---------------------------------------------------------------- 异常工单
:IncidentTicket a owl:Class ; rdfs:label "异常工单" ; :physicalTable "incident_tickets" ; :primaryKey "id" ;
    :businessDescription "107 张异常工单，一张一趟（trip_id 无重复、stop_id 无重复），其中 23 张被标为主异常。类型只有 4 个：破损 74 / 倒温 16 / 超时 13 / 拒收 4。它记的是「这趟出了什么事」，不是「这站送到了没有」——后者在 stops.service_status。" .
:ticketId a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "id" ;
    :businessDescription "工单号" .
:ticketTrip a owl:ObjectProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "trip_id" ; :references :Trip ;
    :businessDescription "这张工单属于哪一趟（107 趟不重复，因为一单多异常在本库里已经合并成一张）" .
:ticketStop a owl:ObjectProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "stop_id" ; :references :Stop ;
    :businessDescription "这张工单发生在哪一站" .
:ticketType a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "type" ;
    :businessDescription "异常类型：破损/倒温/超时/拒收" .
:ticketRaisedAt a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "raised_at" ;
    :businessDescription "上报时间" .
:ticketChannel a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "channel" ;
    :businessDescription "上报渠道：客服工单 37 / 司机APP上报 39 / POD签收 31" .
:ticketResponsibleParty a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "responsible_party" ;
    :businessDescription "责任方：承运 70 / 不可抗力 19 / 客户 18" .
:ticketStatus a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "status" ;
    :businessDescription "处理状态：已处理 76 / 处理中 31" .
:ticketIsPrimary a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "is_primary" ;
    :businessDescription "是否主异常（一单多异常去重计 1 单的口径就落在这张标记上，23 张）" .
:ticketDetail a owl:DatatypeProperty ; rdfs:domain :IncidentTicket ; :physicalColumn "detail" ;
    :businessDescription "工单正文" .

# ---------------------------------------------------------------- 出勤与班次
:DriverSchedule a owl:Class ; rdfs:label "司机排班日" ; :physicalTable "driver_schedule" ; :primaryKey "driver_id, day" ;
    :businessDescription "5,400 行 = 司机 × 日期。4 个状态：attended 2,894 / absent 1,480 / leave 662 / not_scheduled 364。scheduled 为 true 的只有 5,036 行，所以出勤率的分母是 5,036 而不是 5,400——「没排班」既不是出勤也不是缺勤。" .
:scheduleDriver a owl:ObjectProperty ; rdfs:domain :DriverSchedule ; :physicalColumn "driver_id" ; :references :Driver ;
    :businessDescription "这一班是谁的" .
:scheduleDay a owl:DatatypeProperty ; rdfs:domain :DriverSchedule ; :physicalColumn "day" ;
    :businessDescription "排班日期" .
:scheduleStatus a owl:DatatypeProperty ; rdfs:domain :DriverSchedule ; :physicalColumn "status" ;
    :businessDescription "attended/absent/leave/not_scheduled" .
:scheduleScheduled a owl:DatatypeProperty ; rdfs:domain :DriverSchedule ; :physicalColumn "scheduled" ;
    :businessDescription "这一天是否排了班（布尔）。364 行 false 全是 not_scheduled。" .
:scheduleHours a owl:DatatypeProperty ; rdfs:domain :DriverSchedule ; :physicalColumn "hours" ;
    :businessDescription "计划工时" .
:scheduleReason a owl:DatatypeProperty ; rdfs:domain :DriverSchedule ; :physicalColumn "reason" ;
    :businessDescription "缺勤/请假原因" .

# ---------------------------------------------------------------- 轴荷档案
:VehicleAxle a owl:Class ; rdfs:label "车辆轴" ; :physicalTable "vehicle_axles" ; :primaryKey "vehicle_id, axle_seq" ;
    :businessDescription "128 条轴档案 = 60 台车的前桥 + 60 台车的后桥 + 8 台的第三轴。额定轴荷合计 244,500 kg。只有「轴能承多重」，没有「当天每根轴实际多重」，所以轴荷级超载只能复述 trips.axle_overload 这个判定，不能自己算幅度。" .
:axleVehicle a owl:ObjectProperty ; rdfs:domain :VehicleAxle ; :physicalColumn "vehicle_id" ; :references :Vehicle ;
    :businessDescription "这根轴属于哪台车" .
:axleSeq a owl:DatatypeProperty ; rdfs:domain :VehicleAxle ; :physicalColumn "axle_seq" ;
    :businessDescription "轴序（1 前桥 / 2 后桥 / 3 第三轴）" .
:axleType a owl:DatatypeProperty ; rdfs:domain :VehicleAxle ; :physicalColumn "axle_type" ;
    :businessDescription "轴型：前桥/后桥/第3轴" .
:axleRatedKg a owl:DatatypeProperty ; rdfs:domain :VehicleAxle ; :physicalColumn "rated_kg" ;
    :businessDescription "该轴额定载荷（kg）" .
:axleLoadShare a owl:DatatypeProperty ; rdfs:domain :VehicleAxle ; :physicalColumn "load_share" ;
    :businessDescription "厂商标定的该轴承载分担比例" .

# ---------------------------------------------------------------- 加油台账
:FuelLog a owl:Class ; rdfs:label "加油记录" ; :physicalTable "fuel_logs" ; :primaryKey "id" ;
    :businessDescription "3,000 条加油记录，合计 32,378.1 L / 372,009.39 元，均价 11.490 元/L。它与 trips.fuel_liters 的合计一致，但一个是加油动作、一个是趟次分摊：趟次成本只能用趟次那一条。" .
:fuelLogId a owl:DatatypeProperty ; rdfs:domain :FuelLog ; :physicalColumn "id" ;
    :businessDescription "加油记录号" .
:fuelLogVehicle a owl:ObjectProperty ; rdfs:domain :FuelLog ; :physicalColumn "vehicle_id" ; :references :Vehicle ;
    :businessDescription "哪台车加的油" .
:fuelLogFilledAt a owl:DatatypeProperty ; rdfs:domain :FuelLog ; :physicalColumn "filled_at" ;
    :businessDescription "加油时间" .
:fuelLogLiters a owl:DatatypeProperty ; rdfs:domain :FuelLog ; :physicalColumn "liters" ;
    :businessDescription "加油量（升）" .
:fuelLogUnitPrice a owl:DatatypeProperty ; rdfs:domain :FuelLog ; :physicalColumn "unit_price" ;
    :businessDescription "单价（元/升）" .
:fuelLogAmount a owl:DatatypeProperty ; rdfs:domain :FuelLog ; :physicalColumn "amount" ;
    :businessDescription "金额（元）" .
:fuelLogOdometerKm a owl:DatatypeProperty ; rdfs:domain :FuelLog ; :physicalColumn "odometer_km" ;
    :businessDescription "加油时里程表读数（km）" .
:fuelLogStation a owl:DatatypeProperty ; rdfs:domain :FuelLog ; :physicalColumn "station" ;
    :businessDescription "加油站" .

# ---------------------------------------------------------------- 维修工单
:MaintenanceOrder a owl:Class ; rdfs:label "维修工单" ; :physicalTable "maintenance_orders" ; :primaryKey "id" ;
    :businessDescription "250 张维修工单，合计 443,109.53 元、4,038.1 小时停机，均单 1,772.44 元。7 个科目里制冷机组最贵（171,449.87 元），轮胎次之（89,905.60）——冷链的成本痛点不在发动机。" .
:maintenanceId a owl:DatatypeProperty ; rdfs:domain :MaintenanceOrder ; :physicalColumn "id" ;
    :businessDescription "工单号" .
:maintenanceVehicle a owl:ObjectProperty ; rdfs:domain :MaintenanceOrder ; :physicalColumn "vehicle_id" ; :references :Vehicle ;
    :businessDescription "哪台车进厂" .
:maintenanceOpenedAt a owl:DatatypeProperty ; rdfs:domain :MaintenanceOrder ; :physicalColumn "opened_at" ;
    :businessDescription "进厂日期" .
:maintenanceClosedAt a owl:DatatypeProperty ; rdfs:domain :MaintenanceOrder ; :physicalColumn "closed_at" ;
    :businessDescription "出厂日期" .
:maintenanceCategory a owl:DatatypeProperty ; rdfs:domain :MaintenanceOrder ; :physicalColumn "category" ;
    :businessDescription "科目：刹车/保养/轮胎/制冷机组/车厢/电瓶" .
:maintenanceSpend a owl:DatatypeProperty ; rdfs:domain :MaintenanceOrder ; :physicalColumn "cost" ;
    :businessDescription "工单金额（元）" .
:maintenanceOdometerKm a owl:DatatypeProperty ; rdfs:domain :MaintenanceOrder ; :physicalColumn "odometer_km" ;
    :businessDescription "进厂里程表读数（km）" .
:maintenanceDowntimeHours a owl:DatatypeProperty ; rdfs:domain :MaintenanceOrder ; :physicalColumn "downtime_hours" ;
    :businessDescription "停机工时（小时）" .
:maintenanceVendor a owl:DatatypeProperty ; rdfs:domain :MaintenanceOrder ; :physicalColumn "vendor" ;
    :businessDescription "维修厂" .
:maintenanceNote a owl:DatatypeProperty ; rdfs:domain :MaintenanceOrder ; :physicalColumn "note" ;
    :businessDescription "工单备注" .

# ---------------------------------------------------------------- 固定成本台账
:VehicleFixedCost a owl:Class ; rdfs:label "车辆固定成本期" ; :physicalTable "vehicle_fixed_costs" ; :primaryKey "id" ;
    :businessDescription "180 行 = 60 台车 × 3 期，合计 3,014,690.57 元（保险+折旧+车船税+年检）。trips.fixed_cost 的分摊合计是 3,014,690.83，差 0.26 元——两条路线互为核对，口径以 trips 为准。" .
:fixedCostId a owl:DatatypeProperty ; rdfs:domain :VehicleFixedCost ; :physicalColumn "id" ;
    :businessDescription "台账行号" .
:fixedCostVehicle a owl:ObjectProperty ; rdfs:domain :VehicleFixedCost ; :physicalColumn "vehicle_id" ; :references :Vehicle ;
    :businessDescription "哪台车的固定成本" .
:fixedCostPeriod a owl:DatatypeProperty ; rdfs:domain :VehicleFixedCost ; :physicalColumn "period" ;
    :businessDescription "期间（月）" .
:fixedInsurance a owl:DatatypeProperty ; rdfs:domain :VehicleFixedCost ; :physicalColumn "insurance" ;
    :businessDescription "保险（元）" .
:fixedDepreciation a owl:DatatypeProperty ; rdfs:domain :VehicleFixedCost ; :physicalColumn "depreciation" ;
    :businessDescription "折旧（元）" .
:fixedRoadTax a owl:DatatypeProperty ; rdfs:domain :VehicleFixedCost ; :physicalColumn "road_tax" ;
    :businessDescription "车船税（元）" .
:fixedInspection a owl:DatatypeProperty ; rdfs:domain :VehicleFixedCost ; :physicalColumn "inspection" ;
    :businessDescription "年检（元）" .
:fixedCurrency a owl:DatatypeProperty ; rdfs:domain :VehicleFixedCost ; :physicalColumn "currency" ;
    :businessDescription "币种" .

# ---------------------------------------------------------------- 违章台账
:Violation a owl:Class ; rdfs:label "违章记录" ; :physicalTable "violations" ; :primaryKey "id" ;
    :businessDescription "245 条违章，61,200 元罚款 / 705 分，涉及 59 台车。4 个类别（超速 66 / 违停 64 / 闯禁行 61 / 疲劳驾驶 54）。没有「一起违章对应哪一趟」的列，所以违章率（每万公里、百车）在本库里是跨颗粒的，按名拒绝。" .
:violationId a owl:DatatypeProperty ; rdfs:domain :Violation ; :physicalColumn "id" ;
    :businessDescription "违章记录号" .
:violationVehicle a owl:ObjectProperty ; rdfs:domain :Violation ; :physicalColumn "vehicle_id" ; :references :Vehicle ;
    :businessDescription "哪台车" .
:violationDriver a owl:ObjectProperty ; rdfs:domain :Violation ; :physicalColumn "driver_id" ; :references :Driver ;
    :businessDescription "哪位司机" .
:violationOccurredAt a owl:DatatypeProperty ; rdfs:domain :Violation ; :physicalColumn "occurred_at" ;
    :businessDescription "违章时间" .
:violationCode a owl:DatatypeProperty ; rdfs:domain :Violation ; :physicalColumn "code" ;
    :businessDescription "违章代码" .
:violationCategory a owl:DatatypeProperty ; rdfs:domain :Violation ; :physicalColumn "category" ;
    :businessDescription "类别：超速/违停/闯禁行/疲劳驾驶" .
:violationPoints a owl:DatatypeProperty ; rdfs:domain :Violation ; :physicalColumn "points" ;
    :businessDescription "扣分" .
:violationFineAmount a owl:DatatypeProperty ; rdfs:domain :Violation ; :physicalColumn "fine_amount" ;
    :businessDescription "罚款金额（元）" .
:violationStatus a owl:DatatypeProperty ; rdfs:domain :Violation ; :physicalColumn "status" ;
    :businessDescription "处理状态：已处理 107 / 处理中 72 / 未处理 66" .
:violationRoadZone a owl:DatatypeProperty ; rdfs:domain :Violation ; :physicalColumn "road_zone" ;
    :businessDescription "发生路权区域：highway 120 / suburb 64 / core 61" .

# ---------------------------------------------------------------- 通行证台账
:ZonePermit a owl:Class ; rdfs:label "城区通行证" ; :physicalTable "zone_permits" ; :primaryKey "id" ;
    :businessDescription "20 张证（全部是核心区证），状态是中文枚举：有效 12 / 已失效 8。60 台车里只有 20 台有证，所以「有证才敢进核心区」这件事要按车看，不按趟看。" .
:permitId a owl:DatatypeProperty ; rdfs:domain :ZonePermit ; :physicalColumn "id" ;
    :businessDescription "证号行号" .
:permitVehicle a owl:ObjectProperty ; rdfs:domain :ZonePermit ; :physicalColumn "vehicle_id" ; :references :Vehicle ;
    :businessDescription "证挂在哪台车上" .
:permitZone a owl:DatatypeProperty ; rdfs:domain :ZonePermit ; :physicalColumn "zone" ;
    :businessDescription "通行区域（core）" .
:permitNo a owl:DatatypeProperty ; rdfs:domain :ZonePermit ; :physicalColumn "permit_no" ;
    :businessDescription "证号" .
:permitValidFrom a owl:DatatypeProperty ; rdfs:domain :ZonePermit ; :physicalColumn "valid_from" ;
    :businessDescription "生效日" .
:permitValidTo a owl:DatatypeProperty ; rdfs:domain :ZonePermit ; :physicalColumn "valid_to" ;
    :businessDescription "到期日" .
:permitStatus a owl:DatatypeProperty ; rdfs:domain :ZonePermit ; :physicalColumn "status" ;
    :businessDescription "状态：有效/已失效" .

# ---------------------------------------------------------------- 限行日历
:RestrictionDay a owl:Class ; rdfs:label "限行日（按区域）" ; :physicalTable "restriction_calendar" ; :primaryKey "day, zone" ;
    :businessDescription "180 行 = 90 天 × 2 个区，其中 43 行限行（core 40 / suburb 3）。类型：尾号限行 22 / 黄标限行 14 / 临时管制 7。它是「哪天哪个区限」，不是「哪趟被限」——后者在 trips.core_restricted。" .
:calendarDay a owl:ObjectProperty ; rdfs:domain :RestrictionDay ; :physicalColumn "day" ; :references :CalendarDay ;
    :businessDescription "哪一天（指向 :CalendarDay 的 day 列；本表 day 是主键的一部分）" .
:restrictionZone a owl:DatatypeProperty ; rdfs:domain :RestrictionDay ; :physicalColumn "zone" ;
    :businessDescription "哪个区：core/suburb" .
:calendarRestricted a owl:DatatypeProperty ; rdfs:domain :RestrictionDay ; :physicalColumn "restricted" ;
    :businessDescription "当天该区是否限行（布尔）" .
:restrictionType a owl:DatatypeProperty ; rdfs:domain :RestrictionDay ; :physicalColumn "restriction_type" ;
    :businessDescription "限行类型" .
:restrictionNote a owl:DatatypeProperty ; rdfs:domain :RestrictionDay ; :physicalColumn "note" ;
    :businessDescription "限行说明" .
