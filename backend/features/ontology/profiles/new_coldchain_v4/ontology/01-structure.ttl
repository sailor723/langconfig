    :businessDescription "星期几的整数编码（0–6）。整数到星期名的映射在本库里没有声明，所以不按「周几」下结论，只用 is_peak" .
:dayIsPeak a owl:DatatypeProperty ; rdfs:domain :CalendarDay ; :physicalColumn "is_peak" ;
    :businessDescription "是否高峰日（25 天 / 27.78%），落在 weekday 4 与 5 上" .

# ---------------------------------------------------------------- 客诉

:complaintId a owl:DatatypeProperty ; rdfs:domain :Complaint ; :physicalColumn "id" ;
    :businessDescription "客诉主键" .
:complaintOpenedAt a owl:DatatypeProperty ; rdfs:domain :Complaint ; :physicalColumn "opened_at" ;
    :businessDescription "客诉开立时间" .
# 属性名就叫 :liability，不叫 :complaintLiability：run_dashboard 的维度过滤按「属性本地名」找列
# （sqlgen._dimension_predicate → class_columns），所以面板要按责任方切，维度名必须等于属性名。
# 叫 :complaintLiability 的后果是实测出来的：complaintCount 按 liability 过滤直接拒绝
# （"cannot filter :Complaint by :liability"），面板就只能声明「这块切不了」。
:liability a owl:DatatypeProperty ; rdfs:domain :Complaint ; :physicalColumn "liability" ;
    :businessDescription "责任归属（driver 429 / labourer 425），731 件（46.12%）为空 = 尚未判定。NULL 不是「无责任」" .
:complaintAmount a owl:DatatypeProperty ; rdfs:domain :Complaint ; :physicalColumn "amount" ;
    :businessDescription "赔付金额，854 件有值，合计 543,309.02。为空的是还没判，不能填 0" .
:complaintClosedAt a owl:DatatypeProperty ; rdfs:domain :Complaint ; :physicalColumn "closed_at" ;
    :businessDescription "结案时间" .
:complaintKind a owl:DatatypeProperty ; rdfs:domain :Complaint ; :physicalColumn "kind" ;
    :businessDescription "客诉类型（迟到 485 / 货损 309 / 少送错送 229 / 态度 156），406 件（25.62%）为空" .

:complaintStop a owl:ObjectProperty ; rdfs:domain :Complaint ; :physicalColumn "stop_id" ; :references :Stop ;
    :businessDescription "客诉针对的那一站。客诉的时间、司机、车辆都要经过 Stop→Trip 才能拿到" .

