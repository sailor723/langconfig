# ABC 冷链 —— 对象与物理列（new_coldchain_v2）
# 一个对象类型 = 一张表；属性名按业务问法命名，物理列名只出现在 :physicalColumn 里。
# 每个属性名唯一到类（:tripDate / :driverLeftOn / :parkingStartDate），因为 RDF 里同名即同一属性，
# 六个类都叫 :id 的话，编译器在任何一处都会因为歧义拒绝。
# 事实来源：information_schema 直读 + 手写 SQL 实测（行数、NULL、枚举、区间），见 work/new_coldchain_v2/draft.json。
# 数据是固定历史窗 2026-08-01 → 2026-10-29（90 天，天天有趟次）：「最近 30 天」在这个库里不是一个有用的问法。

@prefix : <https://cube.local/ontology/new_coldchain_v4#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------- 对象类

:Vehicle a owl:Class ; rdfs:label "车辆" ; :physicalTable "vehicles" ; :primaryKey "id" ;
    :businessDescription "司机自带的冷藏货车，60 台（8t 35 / 3t 11 / 5t 6 / 10t 5 / 12t 3）。吨位、排放标准、核心区通行许可、车龄决定它当天能接哪条线；车与司机 1:1 绑定，所以「换司机」在数据上等于「换车」。" .

:Driver a owl:Class ; rdfs:label "司机" ; :physicalTable "drivers" ; :primaryKey "id" ;
    :businessDescription "带车加盟司机，60 人。status 全是 active，离职只体现在 left_on 上（10 人），所以「在职/离职」必须看 left_on，不能看 status。没有保底收入，闲置时多数选择休息。" .

:Route a owl:Class ; rdfs:label "线路" ; :physicalTable "routes" ; :primaryKey "id" ; :timeColumn "effective_from" ;
    :businessDescription "品牌方下达的配送线路，按版本存：v1 并线前 50 条（平均 10.46 计划站）、v2 并线后 40 条（平均 15.55 站）。一趟次挂的是当时生效的那一版，所以「按线路看」在事实行上就是按 route_version 看。" .

:RouteStop a owl:Class ; rdfs:label "计划站序" ; :physicalTable "route_stops" ; :primaryKey "route_id, seq" ;
    :businessDescription "品牌方计划里的一条站序：某线路第几站去哪家门店，1,145 条（平均 12.72 站/线）。这是计划不是执行 —— 与 stops 的实际到店不是同一批门店，不能拿来算计划达成率。" .

:Store a owl:Class ; rdfs:label "门店" ; :physicalTable "stores" ; :primaryKey "id" ;
    :businessDescription "品牌方连锁餐厅的门店，800 家（core 533 / suburb 267）。收货时间窗（window_from→window_to）与是否带警铃决定这一站难不难送。" .

# 类的 label 与指标 :tripCount 的 label 撞了（两个都叫「趟次」）。撞label 的后果是实测出来的：
# 问「趟次」时类 :Trip 以更短的词表赢下平局，返回的是一张行程清单而不是一个数字，而且清单查询
# 在护栏上被判为无界扫描 —— 用户拿到一句内部错误。类是一件东西（一次配送），指标是它的计数，
# 所以类叫「行程」，指标保留「趟次」。问「行程数」会经 _count_of_class 落到 :tripCount。
:Trip a owl:Class ; rdfs:label "行程" ; :physicalTable "trips" ; :primaryKey "id" ; :timeColumn "trip_date" ;
    :businessDescription "一趟配送 = 一天 + 一台车 + 一个司机 + 一条线路，4,120 趟（v1 2,600 / v2 1,520）。装载、运费、外车成本、耗时、迟到站数都在这一行；装载能力是派车当时冻结的快照，事后换车不改历史。" .

:Stop a owl:Class ; rdfs:label "站点执行" ; :physicalTable "stops" ; :primaryKey "id" ;
    :businessDescription "一趟里的一次门店送货，50,832 行（平均每趟 12.34 站）。准时、破损箱、温度异常、警铃、缺筐、搬运工是否配合都记在这一行 —— 这是质量与服务指标的颗粒度。它自己没有时间列，日期要回到所属趟次上取。" .

:TripCost a owl:Class ; rdfs:label "趟次成本" ; :physicalTable "trip_costs" ; :primaryKey "trip_id, source_type" ; :timeColumn "as_of" ;
    :businessDescription "向 NASS 追加导出的按趟成本，4,120 行与趟次一一对应。毛利只能算到这里为止：other_cost 整列为空（4,120/4,120），所以算出来的是毛利上限，不是毛利。" .

:CalendarDay a owl:Class ; rdfs:label "日历日" ; :physicalTable "calendar" ; :primaryKey "day" ; :timeColumn "day" ;
    :businessDescription "2026-08-01 → 2026-10-29 的 90 天，标了 weekday（0-6 的整数）与 is_peak。峰日落在 weekday 4 与 5 上（共 25 天，27.78%）。整数到星期名的对应在本库里没有声明，所以不按「周几」下结论。" .

:Complaint a owl:Class ; rdfs:label "客诉" ; :physicalTable "complaints" ; :primaryKey "id" ; :timeColumn "opened_at" ;
    :businessDescription "一条客诉对一次到店，1,585 件。liability 与 amount 都可能是空的：731 件（46.12%）责任未判定，这些是「还没判」的状态，不是「无责任」，不能当 0 参与金额合计。" .

:Refusal a owl:Class ; rdfs:label "拒单" ; :physicalTable "refusals" ; :primaryKey "id" ; :timeColumn "refused_date" ;
    :businessDescription "司机对一条线路的一次拒单，389 次。reason 有 113 次（29.05%）没填；assigned 记录这次拒单是否发生在正式指派之后（144 次 true），是停车规则的唯一事实来源。" .

:ParkingRecord a owl:Class ; rdfs:label "停车记录" ; :physicalTable "parking_list" ; :primaryKey "id" ; :timeColumn "start_date" ;
    :businessDescription "司机被停车的期间，7 条记录、共 21 天、7 位司机（来源 refusal 5 / manual 2）。样本极小，只能报事实，不能报趋势或处罚是否公平。" .

:DispatchDecision a owl:Class ; rdfs:label "派车决策" ; :physicalTable "dispatch_decisions" ; :primaryKey "id" ; :timeColumn "decision_date" ;
    :businessDescription "系统对一条线路给出建议司机、人最后选了谁，2,620 条，全部是影子模式（mode=shadow）。adopted 记录是否采纳（77.71%），未采纳的 584 条 override_reason 全部填写。" .

:DriverStat a owl:Class ; rdfs:label "司机统计快照" ; :physicalTable "driver_stats" ; :primaryKey "driver_id, window_days" ;
    :businessDescription "60 位司机 × 一个滚动窗口（库里只有 window_days=30）的预聚合。它是快照不是事实表：与 stops 现算的数可能不同，指标一律从事实行算，这里只用于对账。" .

:Appeal a owl:Class ; rdfs:label "申诉" ; :physicalTable "appeals" ; :primaryKey "id" ; :timeColumn "filed_on" ;
    :businessDescription "司机申诉，46 件：驳回 25 / 支持 12 / 待处理 9。它与 complaints、parking_list 之间没有外键，所以「申诉对应哪条客诉/哪次停车」在本库里不可回答。" .

:Handler a owl:Class ; rdfs:label "搬运工" ; :physicalTable "handlers" ; :primaryKey "id" ; :timeColumn "first_day" ;
    :businessDescription "日结搬运工，420 人，来自 3 家派遣公司（宏图 134 / 安捷 127 / 诚达 159）。平均只干 5.3 天，283 人干不满 5 天；破损集中在刚上岗的头几天，这是「熟练度」唯一能看见的地方。" .

:HandlerSettlement a owl:Class ; rdfs:label "搬运工结算单" ; :physicalTable "handler_settlements" ; :primaryKey "id" ; :timeColumn "period_start" ;
    :businessDescription "派遣公司按人结算的一张单：天数 × 日单价 = 金额，420 张，币种全部 RMB。这是搬运工成本的可对账来源；trips.cost_total 里的 handler_cost 是分摊值。" .

:Telemetry a owl:Class ; rdfs:label "车厢遥测" ; :physicalTable "telemetry" ; :primaryKey "id" ; :timeColumn "ts" ;
    :businessDescription "车厢温度读数，12,360 行，只覆盖 1,030 趟，且全部落在 2026-11-06 06:00–08:45 这一天（2.75 小时，且不在趟次窗口内）。所以能回答「有没有越界」，不能回答「趋势」。" .

:NlEvent a owl:Class ; rdfs:label "问答日志" ; :physicalTable "nl_events" ; :primaryKey "id" ; :timeColumn "ts" ;
    :businessDescription "助手自己的问答日志，15 条（ollama:qwen2.5:3b 3 条 / 规则 12 条）。它是工具的运行记录，不是冷链业务数据；只用于排查某个问句为什么被拒，不出业务指标。" .

# ---------------------------------------------------------------- 车辆

:vehicleId a owl:DatatypeProperty ; rdfs:domain :Vehicle ; :physicalColumn "id" ;
    :businessDescription "车辆主键" .
:vehiclePlate a owl:DatatypeProperty ; rdfs:domain :Vehicle ; :physicalColumn "plate" ;
    :businessDescription "车牌，60 台唯一" .
:vehicleTonnage a owl:DatatypeProperty ; rdfs:domain :Vehicle ; :physicalColumn "tonnage" ;
    :businessDescription "额定吨位（3 / 5 / 8 / 10 / 12 吨）" .
:vehicleEmission a owl:DatatypeProperty ; rdfs:domain :Vehicle ; :physicalColumn "emission" ;
    :businessDescription "排放标准（国四 27 / 国五 25 / 国六 8）。国四车在核心城区受限，是拒单原因之一" .
:vehicleAgeYears a owl:DatatypeProperty ; rdfs:domain :Vehicle ; :physicalColumn "age_years" ;
    :businessDescription "车龄（年），均值 9.0 年" .
:vehicleCoreZonePermit a owl:DatatypeProperty ; rdfs:domain :Vehicle ; :physicalColumn "core_zone_permit" ;
    :businessDescription "是否有核心城区通行许可。8t 车里只有 31.7% 有，这决定了它能不能接 core 线路" .
:vehicleBoxCapacity a owl:DatatypeProperty ; rdfs:domain :Vehicle ; :physicalColumn "box_capacity" ;
    :businessDescription "额定箱数" .
:vehicleVolumeCapacity a owl:DatatypeProperty ; rdfs:domain :Vehicle ; :physicalColumn "volume_capacity" ;
    :businessDescription "额定体积" .
:vehicleWeightCapacity a owl:DatatypeProperty ; rdfs:domain :Vehicle ; :physicalColumn "weight_capacity" ;
    :businessDescription "额定载重（吨）。超载判定用趟次上的快照列，不用这一列" .
:vehicleStatus a owl:DatatypeProperty ; rdfs:domain :Vehicle ; :physicalColumn "status" ;
    :businessDescription "车辆状态，60 台全部 active" .
:vehicleTotalKm a owl:DatatypeProperty ; rdfs:domain :Vehicle ; :physicalColumn "total_km" ;
    :businessDescription "里程表累计里程（公里）。60 台合计 257,872.3 km，与 trips.actual_km 求和逐位相同——单公里成本的分母就是它（运营口径 8.32 元/km、全成本口径 13.41 元/km）。按车取，不要按趟相加" .

# ---------------------------------------------------------------- 司机

:driverId a owl:DatatypeProperty ; rdfs:domain :Driver ; :physicalColumn "id" ;
    :businessDescription "司机主键" .
:driverName a owl:DatatypeProperty ; rdfs:domain :Driver ; :physicalColumn "name" ;
    :businessDescription "司机姓名" .
:driverAge a owl:DatatypeProperty ; rdfs:domain :Driver ; :physicalColumn "age" ;
    :businessDescription "年龄" .
:driverYearsService a owl:DatatypeProperty ; rdfs:domain :Driver ; :physicalColumn "years_service" ;
    :businessDescription "从业年限" .
:driverStatus a owl:DatatypeProperty ; rdfs:domain :Driver ; :physicalColumn "status" ;
    :businessDescription "状态列，60 人全是 active —— 离职不体现在这里，所以不能用它数在职人数" .
:driverLeftOn a owl:DatatypeProperty ; rdfs:domain :Driver ; :physicalColumn "left_on" ;
    :businessDescription "离职日期，10 人有值。在职/离职只能从这一列判断" .
:driverLeaveReason a owl:DatatypeProperty ; rdfs:domain :Driver ; :physicalColumn "leave_reason" ;
    :businessDescription "离职原因，只有离职的人有值" .

:driverVehicle a owl:ObjectProperty ; rdfs:domain :Driver ; :physicalColumn "vehicle_id" ; :references :Vehicle ;
    :businessDescription "这位司机开的车。1:1 绑定，所以司机与车辆的指标高度重合" .

# ---------------------------------------------------------------- 线路

:routeId a owl:DatatypeProperty ; rdfs:domain :Route ; :physicalColumn "id" ;
    :businessDescription "线路主键" .
:routeCode a owl:DatatypeProperty ; rdfs:domain :Route ; :physicalColumn "code" ;
    :businessDescription "线路编号（R-v1-028 这种，编号里带版本）" .
:routeVersion a owl:DatatypeProperty ; rdfs:domain :Route ; :physicalColumn "version" ;
    :businessDescription "线路版本 v1/v2（v1 50 条 / v2 40 条）。v2 是并线之后的版本，超载几乎都发生在这上面" .
:routeEffectiveFrom a owl:DatatypeProperty ; rdfs:domain :Route ; :physicalColumn "effective_from" ;
    :businessDescription "这一版从哪天起生效" .
:routePlannedStops a owl:DatatypeProperty ; rdfs:domain :Route ; :physicalColumn "planned_stops" ;
    :businessDescription "计划站数（v1 均值 10.46 / v2 均值 15.55）" .
:routePlannedKm a owl:DatatypeProperty ; rdfs:domain :Route ; :physicalColumn "planned_km" ;
    :businessDescription "计划里程（v1 均值 58.8 / v2 57.4 公里）" .
:routeZone a owl:DatatypeProperty ; rdfs:domain :Route ; :physicalColumn "zone" ;
    :businessDescription "线路所在区域（core / mixed / suburb）" .
:routeDifficulty a owl:DatatypeProperty ; rdfs:domain :Route ; :physicalColumn "difficulty" ;
    :businessDescription "线路难度分（1.00–2.50），由品牌方给定，不是我们算的" .

# ---------------------------------------------------------------- 计划站序

:routeStopSeq a owl:DatatypeProperty ; rdfs:domain :RouteStop ; :physicalColumn "seq" ;
    :businessDescription "在这条线路上的站序（从 1 开始）" .
:routeStopRoute a owl:ObjectProperty ; rdfs:domain :RouteStop ; :physicalColumn "route_id" ; :references :Route ;
    :businessDescription "这一站属于哪条线路" .
:routeStopStore a owl:ObjectProperty ; rdfs:domain :RouteStop ; :physicalColumn "store_id" ; :references :Store ;
    :businessDescription "这一站去哪个门店（计划）" .

# ---------------------------------------------------------------- 门店

:storeId a owl:DatatypeProperty ; rdfs:domain :Store ; :physicalColumn "id" ;
    :businessDescription "门店主键" .
:storeName a owl:DatatypeProperty ; rdfs:domain :Store ; :physicalColumn "name" ;
    :businessDescription "门店名" .
:storeZone a owl:DatatypeProperty ; rdfs:domain :Store ; :physicalColumn "zone" ;
    :businessDescription "门店区域（core 533 / suburb 267）" .
:storeDistrict a owl:DatatypeProperty ; rdfs:domain :Store ; :physicalColumn "district" ;
    :businessDescription "行政区" .
:storeWindowFrom a owl:DatatypeProperty ; rdfs:domain :Store ; :physicalColumn "window_from" ;
    :businessDescription "收货时间窗开始" .
:storeWindowTo a owl:DatatypeProperty ; rdfs:domain :Store ; :physicalColumn "window_to" ;
    :businessDescription "收货时间窗结束" .
:storeHasAlarm a owl:DatatypeProperty ; rdfs:domain :Store ; :physicalColumn "has_alarm" ;
    :businessDescription "门店是否带警铃（true 445 / false 355）。带警铃的门店迟到代价更高" .

# ---------------------------------------------------------------- 趟次

:tripId a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "id" ;
    :businessDescription "趟次主键" .
:tripDate a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "trip_date" ;
    :businessDescription "出车日期，2026-08-01 → 2026-10-29，90 天每天都有趟次。这是趟次级唯一的日期列" .
:tripIsExternal a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "is_external" ;
    :businessDescription "是否外车承运（true 417 / false 3,703）。外车占比平日 6.57%、高峰 19.30%" .
:tripVehicleSource a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "vehicle_source" ;
    :businessDescription "运力来源文本（own 3,703 / external 417），与 is_external 是同一件事的两种写法，指标只用其中一个" .
:tripIsPeakDay a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "is_peak_day" ;
    :businessDescription "是否高峰日（true 1,150 / false 2,970）。外车补位与超载都集中在这几天" .
:tripPlannedStops a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "planned_stops" ;
    :businessDescription "计划站数" .
:tripActualStops a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "actual_stops" ;
    :businessDescription "实际完成站数（9–17，均值 12.34）。它从不大于计划站数（0.00% 的趟次超计划），所以「站点超计划」在本库里没有发生过" .
:tripLoadBoxes a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "load_boxes" ;
    :businessDescription "实际装载箱数" .
:tripLoadVolume a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "load_volume" ;
    :businessDescription "实际装载体积" .
:tripLoadWeight a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "load_weight" ;
    :businessDescription "实际装载重量（吨）。超载（重量口径）的分子" .
:tripBoxCapacitySnapshot a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "box_capacity_snapshot" ;
    :businessDescription "派车当时冻结的额定箱数" .
:tripVolumeCapacitySnapshot a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "volume_capacity_snapshot" ;
    :businessDescription "派车当时冻结的额定体积" .
:tripWeightCapacitySnapshot a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "weight_capacity_snapshot" ;
    :businessDescription "派车当时冻结的额定载重（吨）。超载（重量口径）的分母，必须用快照而不是车辆现值" .
:tripRevenue a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "revenue" ;
    :businessDescription "这一趟的运费收入，合计 4,423,204.39" .
:tripExternalCost a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "external_cost" ;
    :businessDescription "外车费用（只有外车趟次有值）。它已计入 cost_total，不要再加一次" .
:tripStatus a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "status" ;
    :businessDescription "趟次状态，4,120 趟全部 completed —— 取消/未执行的趟次不在本库里" .
:tripCostTotal a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "cost_total" ;
    :businessDescription "已知成本合计 2,144,972.86（油费+路桥+司机工资+搬运+外车费）。它不含 other_cost，所以毛利是上限" .
:tripLateStopCount a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "late_stop_count" ;
    :businessDescription "这一趟迟到的站数。=0 即整趟全准点（2,221 趟 / 53.91%）" .
:tripActualDurationMin a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "actual_duration_min" ;
    :businessDescription "实际耗时（分钟），均值 178.33" .
:tripRouteVersion a owl:DatatypeProperty ; rdfs:domain :Trip ; :physicalColumn "route_version" ;
    :businessDescription "这一趟用的线路版本（v1 2,600 / v2 1,520）。并线把版本从线路下沉到趟次：按版本分组必须在事实行上有这一列，编译器不跨表" .

:tripRoute a owl:ObjectProperty ; rdfs:domain :Trip ; :physicalColumn "route_id" ; :references :Route ;
    :businessDescription "这一趟跑的是哪条线路" .
:tripVehicle a owl:ObjectProperty ; rdfs:domain :Trip ; :physicalColumn "vehicle_id" ; :references :Vehicle ;
    :businessDescription "这一趟用的车（外车趟次也记了一台车）" .
:tripDriver a owl:ObjectProperty ; rdfs:domain :Trip ; :physicalColumn "driver_id" ; :references :Driver ;
    :businessDescription "这一趟实际开车的司机" .

# ---------------------------------------------------------------- 站点执行

:stopId a owl:DatatypeProperty ; rdfs:domain :Stop ; :physicalColumn "id" ;
    :businessDescription "站点主键" .
:stopSeq a owl:DatatypeProperty ; rdfs:domain :Stop ; :physicalColumn "seq" ;
    :businessDescription "这一趟里的第几站" .
:stopOnTime a owl:DatatypeProperty ; rdfs:domain :Stop ; :physicalColumn "on_time" ;
    :businessDescription "这一站是否准时（48,085 / 50,832 = 94.60%）。站点级准点率的分子" .
:stopTempExcursion a owl:DatatypeProperty ; rdfs:domain :Stop ; :physicalColumn "temp_excursion" ;
    :businessDescription "这一站是否发生温度越界（1,148 站）。它是布尔标记，不是温度读数；温度读数在 Telemetry" .
:stopDamagedBoxes a owl:DatatypeProperty ; rdfs:domain :Stop ; :physicalColumn "damaged_boxes" ;
    :businessDescription "这一站破损箱数，合计 8,144 箱。每千站 160.21 箱" .
:stopAlarmTriggered a owl:DatatypeProperty ; rdfs:domain :Stop ; :physicalColumn "alarm_triggered" ;
    :businessDescription "这一站是否触发门店警铃（979 站）" .
:stopBasketsMissing a owl:DatatypeProperty ; rdfs:domain :Stop ; :physicalColumn "baskets_missing" ;
    :businessDescription "这一站缺筐数（17,059 站有缺失）" .
:stopHandlerDaysWorked a owl:DatatypeProperty ; rdfs:domain :Stop ; :physicalColumn "handler_days_worked" ;
    :businessDescription "搬这一站时搬运工累计上岗天数（快照）。≤3 天按「新手」处理，这个阈值是假设，不是任何文件写死的" .
:stopHandlerCooperated a owl:DatatypeProperty ; rdfs:domain :Stop ; :physicalColumn "handler_cooperated" ;
    :businessDescription "搬运工是否配合。14,133 站（27.80%）为 NULL，只在有记录的部分可报" .

:stopTrip a owl:ObjectProperty ; rdfs:domain :Stop ; :physicalColumn "trip_id" ; :references :Trip ;
    :businessDescription "这一站属于哪一趟（站点自己没有日期，日期从这里取）" .
:stopStore a owl:ObjectProperty ; rdfs:domain :Stop ; :physicalColumn "store_id" ; :references :Store ;
    :businessDescription "这一站送的是哪家门店" .
:stopHandler a owl:ObjectProperty ; rdfs:domain :Stop ; :physicalColumn "handler_id" ; :references :Handler ;
    :businessDescription "这一站的搬运工。14,133 站没有搬运工记录" .

