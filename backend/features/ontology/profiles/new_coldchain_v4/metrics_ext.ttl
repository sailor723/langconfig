@prefix : <https://cube.local/ontology/new_coldchain_v4#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# ===================================================================== 颗粒 = :Trip
:tripCount a owl:DatatypeProperty ; rdfs:label "趟次" ; :askedAs "趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :unit "count" ;
    :businessDescription "Trip 一行一趟，4,120 趟。所有「每趟」类比率的分母。口径来自 answers:Q1。" .

:tripCountByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看趟次" ; :askedAs "按线路版本看趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :groupBy :tripRouteVersion ; :unit "count" ;
    :businessDescription "v1 2,600 / v2 1,520（并线后趟次变少、单趟变长）。分组后各组合计须回到 4,120。口径来自 answers:Q1。" .

:tripRevenue a owl:DatatypeProperty ; rdfs:label "收入（运费）" ; :askedAs "收入（运费）" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "revenue" ; :grain :Trip ; :universe :Trip ; :unit "RMB" ;
    :businessDescription "运费合计。可加：一趟的运费不因分组而变。口径来自 answers:Q1。" .

:tripCostTotal a owl:DatatypeProperty ; rdfs:label "已知成本合计" ; :askedAs "已知成本合计" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "cost_total" ; :grain :Trip ; :universe :Trip ; :unit "RMB" ;
    :businessDescription "燃油+路桥+司机运费+装卸+外车结算。other_cost 基本为空，所以这是成本的下限，不是全成本（全成本类指标按名拒绝）。口径来自 answers:Q1。" .

:grossMargin a owl:DatatypeProperty ; rdfs:label "毛利（上限）" ; :askedAs "毛利（上限）" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "revenue - cost_total" ; :grain :Trip ; :universe :Trip ; :unit "RMB" ;
    :businessDescription "收入 − 已知成本。名字带「上限」是因为缺的成本桶只会让它变小。口径来自 answers:Q1。" .

:grossMarginRate a owl:DatatypeProperty ; rdfs:label "毛利率（上限）" ; :askedAs "毛利率（上限）" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :grossMargin ; :denominator :tripRevenue ; :unit "ratio" ;
    :businessDescription "先各自求和再相除；不逐趟算比率再平均。口径来自 answers:Q1。" .

:revenuePerTrip a owl:DatatypeProperty ; rdfs:label "每趟平均运费" ; :askedAs "每趟平均运费" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :tripRevenue ; :denominator :tripCount ; :unit "RMB/trip" ;
    :businessDescription "运费合计 ÷ 趟次。口径来自 answers:Q1。" .

:costPerTrip a owl:DatatypeProperty ; rdfs:label "每趟平均已知成本" ; :askedAs "每趟平均已知成本" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :tripCostTotal ; :denominator :tripCount ; :unit "RMB/trip" ;
    :businessDescription "已知成本合计 ÷ 趟次。口径来自 answers:Q1。" .

:grossMarginPerTrip a owl:DatatypeProperty ; rdfs:label "每趟平均毛利" ; :askedAs "每趟平均毛利" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :grossMargin ; :denominator :tripCount ; :unit "RMB/trip" ;
    :businessDescription "毛利合计 ÷ 趟次。口径来自 answers:Q1。" .

:revenueByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看收入" ; :askedAs "按线路版本看收入" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "revenue" ; :grain :Trip ; :universe :Trip ; :groupBy :tripRouteVersion ; :unit "RMB" ;
    :businessDescription "并线前后的运费对比。口径来自 answers:Q1。" .

:grossMarginRateByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看毛利率" ; :askedAs "按线路版本看毛利率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ; :groupBy :tripRouteVersion ;
    :numerator :grossMargin ; :denominator :tripRevenue ; :unit "ratio" ;
    :businessDescription "同一条毛利率，按并线前后切开：每组的分子分母各自求和再相除。口径来自 answers:Q1。" .

:avgActualStopsPerTrip a owl:DatatypeProperty ; rdfs:label "每趟平均实际停靠站数" ; :askedAs "每趟平均实际停靠站数" ; rdfs:domain :Trip ;
    :aggregate "avg" ; :formula "actual_stops" ; :grain :Trip ; :universe :Trip ; :unit "stops" ;
    :businessDescription "实际停靠站数（不是计划站数）÷ 趟次。并线把站数推高，这是故事里的痛点之一。口径来自 docx。" .

:avgTripDuration a owl:DatatypeProperty ; rdfs:label "平均耗时（分钟）" ; :askedAs "平均耗时（分钟）" ; rdfs:domain :Trip ;
    :aggregate "avg" ; :formula "actual_duration_min" ; :grain :Trip ; :universe :Trip ; :unit "minutes" ;
    :businessDescription "实际耗时均值。并线后应当变长；按版本切开见 :avgTripDurationByRouteVersion。口径来自 docx。" .

:avgTripDurationByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看平均耗时" ; :askedAs "按线路版本看平均耗时" ; rdfs:domain :Trip ;
    :aggregate "avg" ; :formula "actual_duration_min" ; :grain :Trip ; :universe :Trip ; :groupBy :tripRouteVersion ; :unit "minutes" ;
    :businessDescription "并线前后各组的耗时均值。口径来自 docx。" .

# ---- 超载：三个并列口径，各自命名，永不合并
:overloadedTrips a owl:DatatypeProperty ; rdfs:label "超载趟次（重量）" ; :askedAs "超载趟次（重量）" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :OverloadedTrip ; :unit "count" ;
    :businessDescription "重量口径超载，1,215 / 4,120。判定条件来自 02 的 :OverloadedTrip，这一层不写阈值。口径来自 answers:Q2。" .

:overloadRate a owl:DatatypeProperty ; rdfs:label "超载率（重量）" ; :askedAs "超载率（重量）" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :overloadedTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "重量口径 = 29.49%。问「超载率」而不指明维度时，默认就是这个；另两个口径必须点名。口径来自 answers:Q2。" .

:overloadRateByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看超载率（重量）" ; :askedAs "按线路版本看超载率（重量）" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ; :groupBy :tripRouteVersion ;
    :numerator :overloadedTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "并线把两条线路的站并到一条上，载重没跟上——这是故事里最尖锐的一处变化。口径来自 answers:Q2。" .

:overloadedTripsByBoxes a owl:DatatypeProperty ; rdfs:label "超载趟次（箱数）" ; :askedAs "超载趟次（箱数）" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :OverloadedTripByBoxes ; :unit "count" ;
    :businessDescription "箱数口径，1,253 / 4,120。口径来自 answers:Q2。" .

:overloadRateByBoxes a owl:DatatypeProperty ; rdfs:label "超载率（箱数）" ; :askedAs "超载率（箱数）" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :overloadedTripsByBoxes ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "箱数口径 = 30.41%。与重量口径不是同一个数，不能互换。口径来自 answers:Q2。" .

:overloadRateByBoxesByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看超载率（箱数）" ; :askedAs "按线路版本看超载率（箱数）" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ; :groupBy :tripRouteVersion ;
    :numerator :overloadedTripsByBoxes ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "箱数口径按并线前后切开。口径来自 answers:Q2。" .

:overloadedTripsByVolume a owl:DatatypeProperty ; rdfs:label "超载趟次（体积）" ; :askedAs "超载趟次（体积）" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :OverloadedTripByVolume ; :unit "count" ;
    :businessDescription "体积口径，1,229 / 4,120。口径来自 answers:Q2。" .

:overloadRateByVolume a owl:DatatypeProperty ; rdfs:label "超载率（体积）" ; :askedAs "超载率（体积）" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :overloadedTripsByVolume ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "体积口径 = 29.83%。三个口径并列，没有哪一个能被当成「真正的超载」。口径来自 answers:Q2。" .

# ---- 外车 / 高峰
:externalTrips a owl:DatatypeProperty ; rdfs:label "外车趟次" ; :askedAs "外车趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :ExternalTrip ; :unit "count" ;
    :businessDescription "外部车队承运的趟次，417 / 4,120。口径来自 answers:Q6。" .

:externalShare a owl:DatatypeProperty ; rdfs:label "外车占比" ; :askedAs "外车占比" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :externalTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "分母是全部趟次 = 10.12%。按高峰/平日切开见 :externalShareByPeak。口径来自 answers:Q6。" .

:externalShareByPeak a owl:DatatypeProperty ; rdfs:label "按高峰/平日看外车占比" ; :askedAs "按高峰/平日看外车占比" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ; :groupBy :tripIsPeakDay ;
    :numerator :externalTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "同一比率按 is_peak_day 切开。业务只有一条期望：外车应当集中在高峰。口径来自 answers:Q6。" .

:peakDayTrips a owl:DatatypeProperty ; rdfs:label "高峰日趟次" ; :askedAs "高峰日趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :PeakDayTrip ; :unit "count" ;
    :businessDescription "is_peak_day = true 的趟次，1,150 / 4,120。口径来自 answers:Q6。" .

# ---- 整趟级准点（与站点级并列的第二指标）
:fullOnTimeTrips a owl:DatatypeProperty ; rdfs:label "整趟全准点趟次" ; :askedAs "整趟全准点趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :FullOnTimeTrip ; :unit "count" ;
    :businessDescription "迟到站点数为 0 的趟次，2,221 / 4,120。口径来自 answers:Q1。" .

:fullOnTimeTripRate a owl:DatatypeProperty ; rdfs:label "整趟全准点率" ; :askedAs "整趟全准点率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :fullOnTimeTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "53.91%，与站点级 94.60% 并存：一个是「每一站」，一个是「整趟一站不差」，问的人必须说是哪一个。口径来自 answers:Q1。" .

:fullOnTimeTripRateByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看整趟全准点率" ; :askedAs "按线路版本看整趟全准点率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ; :groupBy :tripRouteVersion ;
    :numerator :fullOnTimeTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "并线后单趟站数变多，整趟一站不差必然更难——这一层把两个版本分开看。口径来自 answers:Q1。" .

# ===================================================================== 颗粒 = :Stop
:stopCount a owl:DatatypeProperty ; rdfs:label "站点数（站次数）" ; :askedAs "站点数（站次数）" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :unit "count" ;
    :businessDescription "一次门店拜访一行，50,832。它不是门店数（同一家店被反复送），门店数这个能力本库没有声明，按名拒绝。口径来自 answers:Q1。" .

:onTimeStops a owl:DatatypeProperty ; rdfs:label "准时站点数" ; :askedAs "准时站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :where :OnTimeStop ; :unit "count" ;
    :businessDescription "on_time = true 的站，48,085。判定来自 02 的公理，不在这里写条件。口径来自 answers:Q1。" .

:onTimeRate a owl:DatatypeProperty ; rdfs:label "准点率（站点级）" ; :askedAs "准点率（站点级）" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :onTimeStops ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "站点级 94.60%，分母是全部站点。这是主指标；整趟级是另一条，见 :fullOnTimeTripRate。口径来自 answers:Q1。" .

:onTimeRateByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看准点率（站点级）" ; :askedAs "按线路版本看准点率（站点级）" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ; :groupBy :tripRouteVersion ;
    :numerator :onTimeStops ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "沿 站点→趟次 的声明式关联取 route_version，按并线前后切开；分子分母仍在站点颗粒上。口径来自 answers:Q1。" .

:onTimeRateByPeak a owl:DatatypeProperty ; rdfs:label "按高峰/平日看准点率（站点级）" ; :askedAs "按高峰/平日看准点率（站点级）" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ; :groupBy :tripIsPeakDay ;
    :numerator :onTimeStops ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "同一比率按 is_peak_day 切开。口径来自 answers:Q6。" .

:lateStops a owl:DatatypeProperty ; rdfs:label "迟到站点数" ; :askedAs "迟到站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :where :LateStop ; :unit "count" ;
    :businessDescription "on_time = false 的站，2,747。它与 :onTimeStops 相加必须回到 :stopCount。口径来自 answers:Q1。" .

:damagedStops a owl:DatatypeProperty ; rdfs:label "破损站点数" ; :askedAs "破损站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :where :DamagedStop ; :unit "count" ;
    :businessDescription "至少一箱破损的站，5,769 / 50,832。口径来自 docx 的破损痛点。" .

:damagedStopRate a owl:DatatypeProperty ; rdfs:label "破损站点率" ; :askedAs "破损站点率" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :damagedStops ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "11.35%。少数站点承担了全部破损箱数，所以这个数比「每千站破损箱」更能指出该复查谁。口径来自 docx。" .

:damagedBoxesTotal a owl:DatatypeProperty ; rdfs:label "破损箱数" ; :askedAs "破损箱数" ; rdfs:domain :Stop ;
    :aggregate "sum" ; :formula "damaged_boxes" ; :grain :Stop ; :universe :Stop ; :unit "boxes" ;
    :businessDescription "8,144 箱。可加：箱子不会因为分组而变多。口径来自 docx。" .

:damagedBoxesX1000 a owl:DatatypeProperty ; rdfs:label "破损箱×1000" ; :askedAs "破损箱×1000" ; rdfs:domain :Stop ;
    :aggregate "sum" ; :formula "damaged_boxes * 1000" ; :grain :Stop ; :universe :Stop ; :unit "boxes" ;
    :businessDescription "「每千站」比率的分子：乘以 1000 让它成为一个可编译的比率，而不是在展示层偷偷缩放。口径来自 docx。" .

:damagedBoxesPer1kStops a owl:DatatypeProperty ; rdfs:label "每千站破损箱" ; :askedAs "每千站破损箱" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :damagedBoxesX1000 ; :denominator :stopCount ; :unit "boxes/1k stops" ;
    :businessDescription "160.21 箱/千站。先算比率后读成「每千站」，不是先缩放后求和。口径来自 docx。" .

:damagedBoxesPer1kStopsByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看每千站破损箱" ; :askedAs "按线路版本看每千站破损箱" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ; :groupBy :tripRouteVersion ;
    :numerator :damagedBoxesX1000 ; :denominator :stopCount ; :unit "boxes/1k stops" ;
    :businessDescription "沿 站点→趟次 取版本号，看并线是否让破损变差。口径来自 docx。" .

:tempExcursionStops a owl:DatatypeProperty ; rdfs:label "温度越界站点数" ; :askedAs "温度越界站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :where :TempExcursionStop ; :unit "count" ;
    :businessDescription "temp_excursion = true 的站，1,148。布尔标记来自司机现场判定，本库不存温度读数序列。口径来自 answers:Q8。" .

:tempExcursionRate a owl:DatatypeProperty ; rdfs:label "温度越界站点率" ; :askedAs "温度越界站点率" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :tempExcursionStops ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "2.26%。只能说明「有多少站越界」，不能说明温度在变好还是变坏（趋势按名拒绝）。口径来自 answers:Q8。" .

:basketsMissingTotal a owl:DatatypeProperty ; rdfs:label "周转筐缺失数" ; :askedAs "周转筐缺失数" ; rdfs:domain :Stop ;
    :aggregate "sum" ; :formula "baskets_missing" ; :grain :Stop ; :universe :Stop ; :unit "baskets" ;
    :businessDescription "现场记录的周转筐缺失合计。口径来自 docx（筐具丢失）。" .

:alarmTriggeredStops a owl:DatatypeProperty ; rdfs:label "触发报警站点数" ; :askedAs "触发报警站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :where :AlarmTriggeredStop ; :unit "count" ;
    :businessDescription "alarm_triggered = true 的站。与温度越界是两个不同的标记，不合并。口径来自 docx。" .

:newbieHandlerStops a owl:DatatypeProperty ; rdfs:label "新手搬运工站点数" ; :askedAs "新手搬运工站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :where :NewbieHandlerStop ; :unit "count" ;
    :businessDescription "上岗 ≤3 天的搬运工负责的站，20,166 / 50,832。阈值 3 是待确认的假设，写在 02 的类定义里。口径来自 answers:Q10。" .

:damagedBoxesX1000Newbie a owl:DatatypeProperty ; rdfs:label "新手站点破损箱×1000" ; :askedAs "新手站点破损箱×1000" ; rdfs:domain :Stop ;
    :aggregate "sum" ; :formula "damaged_boxes * 1000" ; :grain :Stop ; :universe :Stop ; :where :NewbieHandlerStop ; :unit "boxes" ;
    :businessDescription "只在新手站点上求和的分子，用来和新手站数配对成比率。口径来自 answers:Q10。" .

:damagedBoxesPer1kNewbieStops a owl:DatatypeProperty ; rdfs:label "新手站点每千站破损箱" ; :askedAs "新手站点每千站破损箱" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :damagedBoxesX1000Newbie ; :denominator :newbieHandlerStops ; :unit "boxes/1k stops" ;
    :businessDescription "220.02 箱/千站 = 0.220 箱/站。分母是同一定义下的新手站数，两个口径必须成对出现。口径来自 answers:Q10。" .

:damagedBoxesX1000Experienced a owl:DatatypeProperty ; rdfs:label "老手站点破损箱×1000" ; :askedAs "老手站点破损箱×1000" ; rdfs:domain :Stop ;
    :aggregate "sum" ; :formula "damaged_boxes * 1000" ; :grain :Stop ; :universe :Stop ; :where :ExperiencedHandlerStop ; :unit "boxes" ;
    :businessDescription "对照组的分子：上岗 >3 天。口径来自 answers:Q10。" .

:experiencedHandlerStops a owl:DatatypeProperty ; rdfs:label "老手搬运工站点数" ; :askedAs "老手搬运工站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :where :ExperiencedHandlerStop ; :unit "count" ;
    :businessDescription "上岗 >3 天的站，16,533。它与新手 20,166、无记录 14,133 三者相加必须回到 :stopCount —— 这条加总关系是本层最重要的完整性检查。口径来自 answers:Q10。" .

:damagedBoxesPer1kExperiencedStops a owl:DatatypeProperty ; rdfs:label "老手站点每千站破损箱" ; :askedAs "老手站点每千站破损箱" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :damagedBoxesX1000Experienced ; :denominator :experiencedHandlerStops ; :unit "boxes/1k stops" ;
    :businessDescription "138.03 箱/千站 = 0.138 箱/站。与新手 220.02 并排读，才是「工龄是否解释破损」这个问题的答案。口径来自 answers:Q10。" .

# ---- 第三类：没有搬运工记录的站点（handler_days_worked / handler_cooperated 同时为 NULL）
:unassignedHandlerStops a owl:DatatypeProperty ; rdfs:label "无搬运工记录站点数" ; :askedAs "无搬运工记录站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :where :UnassignedHandlerStop ; :unit "count" ;
    :businessDescription "14,133 / 50,832 = 27.80% 的站没有搬运工记录（handler_id、handler_days_worked、handler_cooperated 同时为 NULL）。不补这一类，新手 20,166 + 老手 16,533 = 36,699 会与总数 50,832 差 14,133，差额被静默吞掉。口径来自 answers:Q10（缺口按状态报出）。" .

:damagedBoxesX1000Unassigned a owl:DatatypeProperty ; rdfs:label "无记录站点破损箱×1000" ; :askedAs "无记录站点破损箱×1000" ; rdfs:domain :Stop ;
    :aggregate "sum" ; :formula "damaged_boxes * 1000" ; :grain :Stop ; :universe :Stop ; :where :UnassignedHandlerStop ; :unit "boxes" ;
    :businessDescription "无记录站点的破损箱分子，用于与 20 万级的另两组并排。口径来自 answers:Q10。" .

:damagedBoxesPer1kUnassignedStops a owl:DatatypeProperty ; rdfs:label "无记录站点每千站破损箱" ; :askedAs "无记录站点每千站破损箱" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :damagedBoxesX1000Unassigned ; :denominator :unassignedHandlerStops ; :unit "boxes/1k stops" ;
    :businessDescription "100.83 箱/千站 = 0.101 箱/站，比新手低、与老手接近。它的存在说明「未记录」不是「特别差」，而是随机缺失——但缺失本身让任何按工龄的归因只剩 72.2% 的样本。口径来自 answers:Q10。" .

# ===================================================================== 颗粒 = :Complaint
:complaintCount a owl:DatatypeProperty ; rdfs:label "客诉数" ; :askedAs "客诉数" ; rdfs:domain :Complaint ;
    :aggregate "count" ; :grain :Complaint ; :universe :Complaint ; :unit "count" ;
    :businessDescription "投诉单条数，1,585。一条投诉挂在一次站点执行上，同一站点可被投诉多次，所以这是投诉的颗粒，不是站点的。口径来自 answers:Q3。" .

:unjudgedComplaints a owl:DatatypeProperty ; rdfs:label "责任未判定客诉数" ; :askedAs "责任未判定客诉数" ; rdfs:domain :Complaint ;
    :aggregate "count" ; :grain :Complaint ; :universe :Complaint ; :where :UnjudgedComplaint ; :unit "count" ;
    :businessDescription "liability IS NULL 的 731 条。它是状态，不是 0。口径来自 answers:Q3。" .

:unjudgedComplaintRate a owl:DatatypeProperty ; rdfs:label "责任未判定客诉率" ; :askedAs "责任未判定客诉率" ; rdfs:domain :Complaint ;
    :aggregate "ratio_of_sums" ; :grain :Complaint ; :universe :Complaint ;
    :numerator :unjudgedComplaints ; :denominator :complaintCount ; :unit "ratio" ;
    :businessDescription "46.12%。这个数一高，任何按责任归因的结论都要打折扣。口径来自 answers:Q3。" .

:compensationCost a owl:DatatypeProperty ; rdfs:label "赔付成本（仅已判定）" ; :askedAs "赔付成本（仅已判定）" ; rdfs:domain :Complaint ;
    :aggregate "sum" ; :formula "amount" ; :grain :Complaint ; :universe :Complaint ; :where :JudgedComplaint ; :unit "RMB" ;
    :businessDescription "543,309.02 元，只在这 854 件上求和。名字里写死口径：把未判定的一起加会让这个数既不可比也不可解释。口径来自 answers:Q3。" .

:judgedComplaints a owl:DatatypeProperty ; rdfs:label "已判定客诉数" ; :askedAs "已判定客诉数" ; rdfs:domain :Complaint ;
    :aggregate "count" ; :grain :Complaint ; :universe :Complaint ; :where :JudgedComplaint ; :unit "count" ;
    :businessDescription "854 条，是 :compensationCost 的分母口径。口径来自 answers:Q3。" .

:avgCompensationPerJudgedComplaint a owl:DatatypeProperty ; rdfs:label "已判定客诉平均赔付" ; :askedAs "已判定客诉平均赔付" ; rdfs:domain :Complaint ;
    :aggregate "ratio_of_sums" ; :grain :Complaint ; :universe :Complaint ;
    :numerator :compensationCost ; :denominator :judgedComplaints ; :unit "RMB/complaint" ;
    :businessDescription "636.19 元/件，只在已判定的 854 件上平均。口径来自 answers:Q3。" .

:complaintCountByLiability a owl:DatatypeProperty ; rdfs:label "按责任方看客诉数" ; :askedAs "按责任方看客诉数" ; rdfs:domain :Complaint ;
    :aggregate "count" ; :grain :Complaint ; :universe :Complaint ; :groupBy :liability ; :unit "count" ;
    :businessDescription "按 liability 分组，NULL 会作为一个分组出现——它必须出现，不能被丢掉。口径来自 answers:Q3。" .

# ===================================================================== 颗粒 = :Refusal
:refusalCount a owl:DatatypeProperty ; rdfs:label "拒单数" ; :askedAs "拒单数" ; rdfs:domain :Refusal ;
    :aggregate "count" ; :grain :Refusal ; :universe :Refusal ; :unit "count" ;
    :businessDescription "拒单记录条数，389。口径来自 answers:Q7。" .

:unrecordedRefusals a owl:DatatypeProperty ; rdfs:label "原因未记录的拒单数" ; :askedAs "原因未记录的拒单数" ; rdfs:domain :Refusal ;
    :aggregate "count" ; :grain :Refusal ; :universe :Refusal ; :where :UnrecordedRefusalReason ; :unit "count" ;
    :businessDescription "reason IS NULL 的 113 条。口径来自 answers:Q7。" .

:unrecordedRefusalRate a owl:DatatypeProperty ; rdfs:label "拒单原因未记录率" ; :askedAs "拒单原因未记录率" ; rdfs:domain :Refusal ;
    :aggregate "ratio_of_sums" ; :grain :Refusal ; :universe :Refusal ;
    :numerator :unrecordedRefusals ; :denominator :refusalCount ; :unit "ratio" ;
    :businessDescription "29.05%。原因分布的任何结论都要先读这个缺口。口径来自 answers:Q7。" .

:refusalCountByReason a owl:DatatypeProperty ; rdfs:label "按原因看拒单数" ; :askedAs "按原因看拒单数" ; rdfs:domain :Refusal ;
    :aggregate "count" ; :grain :Refusal ; :universe :Refusal ; :groupBy :refusalReason ; :unit "count" ;
    :businessDescription "按原因分组的计数（NULL 自成一组）。本层只报次数与缺口，不做归因。口径来自 answers:Q7。" .

:assignedRefusals a owl:DatatypeProperty ; rdfs:label "正式指派后拒单数" ; :askedAs "正式指派后拒单数" ; rdfs:domain :Refusal ;
    :aggregate "count" ; :grain :Refusal ; :universe :Refusal ; :where :AssignedRefusal ; :unit "count" ;
    :businessDescription "assigned = true 的 144 条 / 389。唯一能往停车规则上对的那一类。口径来自 answers:Q12。" .

# ===================================================================== 颗粒 = :ParkingRecord
:parkingRecordCount a owl:DatatypeProperty ; rdfs:label "停车记录数" ; :askedAs "停车记录数" ; rdfs:domain :ParkingRecord ;
    :aggregate "count" ; :grain :ParkingRecord ; :universe :ParkingRecord ; :unit "count" ;
    :businessDescription "停车记录条数。口径来自 answers:Q12。" .

:parkingDaysTotal a owl:DatatypeProperty ; rdfs:label "停车天数合计" ; :askedAs "停车天数合计" ; rdfs:domain :ParkingRecord ;
    :aggregate "sum" ; :formula "days" ; :grain :ParkingRecord ; :universe :ParkingRecord ; :unit "days" ;
    :businessDescription "按记录加总停车天数。可加：一条记录的天数不因分组而变。口径来自 answers:Q12。" .

# ===================================================================== 颗粒 = :DispatchDecision
:dispatchDecisionCount a owl:DatatypeProperty ; rdfs:label "派车建议数" ; :askedAs "派车建议数" ; rdfs:domain :DispatchDecision ;
    :aggregate "count" ; :grain :DispatchDecision ; :universe :DispatchDecision ; :unit "count" ;
    :businessDescription "建议记录条数，2,620。口径来自 answers:Q11。" .

:adoptedDecisions a owl:DatatypeProperty ; rdfs:label "已采纳建议数" ; :askedAs "已采纳建议数" ; rdfs:domain :DispatchDecision ;
    :aggregate "count" ; :grain :DispatchDecision ; :universe :DispatchDecision ; :where :AdoptedDecision ; :unit "count" ;
    :businessDescription "人跟着建议走的 2,036 条。口径来自 answers:Q11。" .

:dispatchAdoptRate a owl:DatatypeProperty ; rdfs:label "派车建议采纳率" ; :askedAs "派车建议采纳率" ; rdfs:domain :DispatchDecision ;
    :aggregate "ratio_of_sums" ; :grain :DispatchDecision ; :universe :DispatchDecision ;
    :numerator :adoptedDecisions ; :denominator :dispatchDecisionCount ; :unit "ratio" ;
    :businessDescription "77.71%。全部是影子模式，所以它是「人与建议的重合度」，不是建议带来的效果——效果需要对照组，本库没有。口径来自 answers:Q11。" .

:avgScoreGapAdopted a owl:DatatypeProperty ; rdfs:label "已采纳建议的平均分差" ; :askedAs "已采纳建议的平均分差" ; rdfs:domain :DispatchDecision ;
    :aggregate "avg" ; :formula "chosen_score - recommended_score" ; :grain :DispatchDecision ; :universe :DispatchDecision ;
    :where :AdoptedDecision ; :unit "score" ;
    :businessDescription "选人与建议人评分之差，0 表示完全跟着建议。只在已采纳的 2,036 条上算。口径来自 answers:Q11。" .

# ===================================================================== 颗粒 = :Appeal
:appealCount a owl:DatatypeProperty ; rdfs:label "申诉数" ; :askedAs "申诉数" ; rdfs:domain :Appeal ;
    :aggregate "count" ; :grain :Appeal ; :universe :Appeal ; :unit "count" ;
    :businessDescription "申诉条数。口径来自 docx（司机申诉）。" .

:appealCountByOutcome a owl:DatatypeProperty ; rdfs:label "按结果看申诉数" ; :askedAs "按结果看申诉数" ; rdfs:domain :Appeal ;
    :aggregate "count" ; :grain :Appeal ; :universe :Appeal ; :groupBy :appealOutcome ; :unit "count" ;
    :businessDescription "按 outcome 分组，看清申诉被支持的比例。口径来自 docx。" .

# ===================================================================== 颗粒 = :Handler
:handlerCount a owl:DatatypeProperty ; rdfs:label "搬运工数" ; :askedAs "搬运工数" ; rdfs:domain :Handler ;
    :aggregate "count" ; :grain :Handler ; :universe :Handler ; :unit "count" ;
    :businessDescription "搬运工在册条数。注意这不是「在岗人数」：本库没有排班表，出勤类指标按名拒绝。口径来自 answers:Q10。" .

:avgHandlerDaysWorked a owl:DatatypeProperty ; rdfs:label "搬运工平均工龄（天）" ; :askedAs "搬运工平均工龄（天）" ; rdfs:domain :Handler ;
    :aggregate "avg" ; :formula "days_worked" ; :grain :Handler ; :universe :Handler ; :unit "days" ;
    :businessDescription "上岗天数均值。站点上的 handler_days_worked 是派工当时的快照，两者不是同一个颗粒。口径来自 answers:Q10。" .

# ============================================ 时间轴与两个新的切面（车辆 / 门店区域×线路版本）
# 为什么补这几条：一张看板要能回答「哪台车最差」「哪个区域在并线后变坏」，而 :Trip/:Stop 的
# 颗粒上没有 plate、zone 这两列 —— 它们分别是 :Vehicle.plate 与 :Store.zone，通过已声明的
# 关系（站点→趟次→车辆、站点→门店）到达。编译器沿 :references 加 JOIN，条件不在这里重写。
#
# 名字没有为了迁就 D3 里那几条写着 logistics 口径的断言而改成 stopOnTimeRate / damagePer1kStops：
# 那两个是另一套本体的词，本层的词是 onTimeRate / damagedBoxesPer1kStops，改名字会让声明自相
# 矛盾。代价是那几条加权断言对本层打印 [NOT RUN]（闸门自己会说原因），收益是同一个数在本体里
# 只有一个名字。这两条的独立第二条路线在 samples.json 与 truth.json 里，不靠闸门。

:tripCountByWeek a owl:DatatypeProperty ; rdfs:label "按周看趟次" ; :askedAs "按周看趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :timeBucket "week" ; :unit "count" ;
    :businessDescription "唯一的时间轴：trans 日期按周截断，升序排列。各周相加必须回到 4,120。它是时间序列，不是趋势结论——数据是固定历史窗，没有「最近」。口径来自 answers:Q6。" .

:stopCountByVehicle a owl:DatatypeProperty ; rdfs:label "按车辆看站点数" ; :askedAs "按车辆看站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :groupBy :vehiclePlate ; :unit "count" ;
    :businessDescription "站点沿 站点→趟次→车辆 归到车牌。各车相加必须回到 50,832，这是 D3 最容易抓到「JOIN 扇出」的一条。口径来自 answers:Q1。" .

:onTimeRateByVehicle a owl:DatatypeProperty ; rdfs:label "按车辆看准点率（站点级）" ; :askedAs "按车辆看准点率（站点级）" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ; :groupBy :vehiclePlate ;
    :numerator :onTimeStops ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "分子分母都还在站点颗粒上，只是按车牌切开；按站点数加权后必须回到车队 94.60%。口径来自 answers:Q1。" .

:damagedBoxesPer1kStopsByVehicle a owl:DatatypeProperty ; rdfs:label "按车辆看每千站破损箱" ; :askedAs "按车辆看每千站破损箱" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ; :groupBy :vehiclePlate ;
    :numerator :damagedBoxesX1000 ; :denominator :stopCount ; :unit "boxes/1k stops" ;
    :businessDescription "用于「最差的 10 台车」这张榜；加权后回到车队 160.21。口径来自 docx。" .

:stopCountByZoneVersion a owl:DatatypeProperty ; rdfs:label "按门店区域和线路版本看站点数" ; :askedAs "按门店区域和线路版本看站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :groupBy :storeZone, :tripRouteVersion ; :unit "count" ;
    :businessDescription "两个切面同时开：区域来自 :Store.zone，版本来自 :Trip.route_version。二维表每个格子都要有分母，D1 会检查。口径来自 answers:Q2。" .

:onTimeRateByZoneVersion a owl:DatatypeProperty ; rdfs:label "按门店区域和线路版本看准点率（站点级）" ; :askedAs "按门店区域和线路版本看准点率（站点级）" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ; :groupBy :storeZone, :tripRouteVersion ;
    :numerator :onTimeStops ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "并线是否让某个区域先坏：按 :stopCountByZoneVersion 加权后必须回到车队值。口径来自 answers:Q2。" .

:damagedBoxesPer1kStopsByZoneVersion a owl:DatatypeProperty ; rdfs:label "按门店区域和线路版本看每千站破损箱" ; :askedAs "按门店区域和线路版本看每千站破损箱" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ; :groupBy :storeZone, :tripRouteVersion ;
    :numerator :damagedBoxesX1000 ; :denominator :stopCount ; :unit "boxes/1k stops" ;
    :businessDescription "同上，指标换成破损。口径来自 docx。" .

# ================================================================ v4 delta：2026 KPI 卡 1–6
# 口径来源：口径字典 + Book1 KPI 页（admin 提供）。阈值（15 站、0 容忍、限行区枚举）由业务给，
# 本文件只把「哪个数、哪个颗粒、哪个分子/分母」写死；源表名都写在 :businessDescription 里。

# ---------------------------------------------------------------- 卡1 配送履约
:lateStopShare a owl:DatatypeProperty ; rdfs:label "迟到站点占比" ; :askedAs "迟到站点占比" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :lateStops ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "2,747 / 50,832 = 5.40%（stops.on_time）。与 :onTimeRate 互补，相加为 1。口径来自 Book1 KPI 1。 口径来自 doc#Book1-KPI1；数值 measured: stops。" .

:lateStopShareByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看迟到站点占比" ; :askedAs "按线路版本看迟到站点占比" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ; :groupBy :tripRouteVersion ;
    :numerator :lateStops ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "v1 3.84% / v2 7.21%（stops→trips.route_version）。并线后迟到占比翻了近一倍，这是 KPI 卡 1 唯一一条会改变结论的切分。 口径来自 doc#Book1-KPI1；数值 measured: stops。" .

:undeliveredStopCount a owl:DatatypeProperty ; rdfs:label "未送达站点数" ; :askedAs "未送达站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :where :UndeliveredStop ; :unit "count" ;
    :businessDescription "905 站（stops.service_status）。拒收 412 / 闭店 274 / 未送达 219，三者不合并。 口径来自 doc#Book1-KPI1；数值 measured: stops。" .

:undeliveredStopRate a owl:DatatypeProperty ; rdfs:label "未送达站点率" ; :askedAs "未送达站点率" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :undeliveredStopCount ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "905 / 50,832 = 1.78%。分母是全部站点（含已送达），不是已送达的站。口径来自 Book1 KPI 1。 口径来自 doc#Book1-KPI1；数值 measured: stops。" .

:undeliveredStopCountByServiceStatus a owl:DatatypeProperty ; rdfs:label "按配送结果看未送达站点数" ; :askedAs "按配送结果看未送达站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :where :UndeliveredStop ; :groupBy :stopServiceStatus ; :unit "count" ;
    :businessDescription "拒收 412 / 闭店 274 / 未送达 219。分开数是因为三者责任方不同（客户 / 客户 / 我们），加总只有一个 905。 口径来自 doc#Book1-KPI1；数值 measured: stops。" .

# ---------------------------------------------------------------- 卡2 合规（轴荷 / 超站数 / 限行 / 通行证）
:axleOverloadTrips a owl:DatatypeProperty ; rdfs:label "轴荷超限趟次" ; :askedAs "轴荷超限趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :AxleOverloadTrip ; :unit "count" ;
    :businessDescription "1,632 趟（trips.axle_overload）。库里只有布尔判定，没有逐轴实测，所以只能数趟次、算不了超载公斤数。 口径来自 doc#Book1-KPI2；数值 measured: trips。" .

:axleOverloadRate a owl:DatatypeProperty ; rdfs:label "轴荷超限率" ; :askedAs "轴荷超限率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :axleOverloadTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "1,632 / 4,120 = 39.61%。口径来自 Book1 合规卡。 口径来自 doc#Book1-KPI2；数值 measured: trips。" .

:overPlannedStopTrips a owl:DatatypeProperty ; rdfs:label "超规划站数趟次" ; :askedAs "超规划站数趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :OverPlannedStopTrip ; :unit "count" ;
    :businessDescription "planned_stops > 15 的趟次，760（trips.planned_stops）。阈值 15 由业务给，不是分位数。 口径来自 doc#Book1-KPI2；数值 measured: trips。" .

:overPlannedStopRate a owl:DatatypeProperty ; rdfs:label "超规划站数率" ; :askedAs "超规划站数率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :overPlannedStopTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "760 / 4,120 = 18.45%。与 axleOverloadRate 不能相加：两者重叠 631 趟，真要「任一越界」必须用 eitherBreachRate。 口径来自 doc#Book1-KPI2；数值 measured: trips。" .

:eitherBreachTrips a owl:DatatypeProperty ; rdfs:label "合规越界趟次" ; :askedAs "合规越界趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :EitherBreachTrip ; :unit "count" ;
    :businessDescription "1,761 趟 = 超载 1,632 ∪ 超站数 760 − 重叠 631。这是合规告警真正要看的那个数。 口径来自 doc#Book1-KPI2；数值 measured: trips。" .

:eitherBreachRate a owl:DatatypeProperty ; rdfs:label "合规越界率" ; :askedAs "合规越界率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :eitherBreachTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "1,761 / 4,120 = 42.74%。口径来自 Book1 合规卡。 口径来自 doc#Book1-KPI2；数值 measured: trips。" .

:loadUtilizationRate a owl:DatatypeProperty ; rdfs:label "装载利用率" ; :askedAs "装载利用率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :tripLoadWeightTotal ; :denominator :tripWeightCapacityTotal ; :unit "ratio" ;
    :businessDescription "Σload_weight / Σweight_capacity_snapshot = 87.97%。先求和再相除，不是各行利用率的平均：短途轻载趟会被平均法抬上去（逐趟平均 84.14%）。 口径来自 doc#Book1-KPI2；数值 measured: trips。" .

:tripLoadWeightTotal a owl:DatatypeProperty ; rdfs:label "装载重量合计" ; :askedAs "装载重量合计" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :grain :Trip ; :universe :Trip ; :formula "load_weight" ; :unit "kg" ;
    :businessDescription "Σ trips.load_weight。装载利用率与超载的分子，也是超载率的对照面。 口径来自 doc#Book1-KPI2；数值 measured: trips。" .

:tripWeightCapacityTotal a owl:DatatypeProperty ; rdfs:label "额定载重合计" ; :askedAs "额定载重合计" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :grain :Trip ; :universe :Trip ; :formula "weight_capacity_snapshot" ; :unit "kg" ;
    :businessDescription "Σ trips.weight_capacity_snapshot（派车当时的冻结值）。用快照不用车辆现值，否则事后换车会改写历史利用率。 口径来自 doc#Book1-KPI2；数值 measured: trips。" .

:coreRestrictedTrips a owl:DatatypeProperty ; rdfs:label "核心区趟次" ; :askedAs "核心区趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :CoreRestrictedTrip ; :unit "count" ;
    :businessDescription "1,850 趟进核心限行区（trips.core_restricted）。它是通行证合规率的分母。 口径来自 doc#Book1-KPI2；数值 measured: trips。" .

:coreUnpermittedTrips a owl:DatatypeProperty ; rdfs:label "核心区无有效通行证趟次" ; :askedAs "核心区无有效通行证趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :CoreUnpermittedTrip ; :unit "count" ;
    :businessDescription "1,432 趟（trips.core_restricted AND NOT permit_valid）。 口径来自 doc#Book1-KPI2；数值 measured: trips。" .

:coreUnpermittedTripRate a owl:DatatypeProperty ; rdfs:label "核心区无有效通行证趟次率" ; :askedAs "核心区无有效通行证趟次率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :coreUnpermittedTrips ; :denominator :coreRestrictedTrips ; :unit "ratio" ;
    :businessDescription "1,432 / 1,850 = 77.41%。分母只能是进核心区的趟次，用全部 4,120 会把违规率稀释到 34.76%——那是把「没进核心区」算成合规。 口径来自 doc#Book1-KPI2；数值 measured: trips。" .

:zonePermitCount a owl:DatatypeProperty ; rdfs:label "通行证数" ; :askedAs "通行证数" ; rdfs:domain :ZonePermit ;
    :aggregate "count" ; :grain :ZonePermit ; :universe :ZonePermit ; :unit "count" ;
    :businessDescription "20 张（zone_permits），全部是核心区证。60 台车只有 20 台有证。 口径来自 doc#Book1-KPI2；数值 measured: zone_permits。" .

:validZonePermitCount a owl:DatatypeProperty ; rdfs:label "有效通行证数" ; :askedAs "有效通行证数" ; rdfs:domain :ZonePermit ;
    :aggregate "count" ; :grain :ZonePermit ; :universe :ZonePermit ; :where :ValidZonePermit ; :unit "count" ;
    :businessDescription "12 张（zone_permits.status = 有效）。与 trips.permit_valid 的 12/20 互为第二路线。 口径来自 doc#Book1-KPI2；数值 measured: zone_permits。" .

:zonePermitValidRate a owl:DatatypeProperty ; rdfs:label "通行证有效率" ; :askedAs "通行证有效率" ; rdfs:domain :ZonePermit ;
    :aggregate "ratio_of_sums" ; :grain :ZonePermit ; :universe :ZonePermit ;
    :numerator :validZonePermitCount ; :denominator :zonePermitCount ; :unit "ratio" ;
    :businessDescription "12 / 20 = 60.00%。台账口径；趟次口径（22.59% 合规）是另一件事，两者不能互相替代。 口径来自 doc#Book1-KPI2；数值 measured: zone_permits。" .

:zonePermitCountByStatus a owl:DatatypeProperty ; rdfs:label "按状态看通行证数" ; :askedAs "按状态看通行证数" ; rdfs:domain :ZonePermit ;
    :aggregate "count" ; :grain :ZonePermit ; :universe :ZonePermit ; :groupBy :permitStatus ; :unit "count" ;
    :businessDescription "有效 12 / 已失效 8（zone_permits.status，中文枚举）。 口径来自 doc#Book1-KPI2；数值 measured: zone_permits。" .

:restrictionDayCount a owl:DatatypeProperty ; rdfs:label "限行日历行数" ; :askedAs "限行日历行数" ; rdfs:domain :RestrictionDay ;
    :aggregate "count" ; :grain :RestrictionDay ; :universe :RestrictionDay ; :unit "count" ;
    :businessDescription "180 行 = 90 天 × 2 区（restriction_calendar）。它是限行日比例的分母。 口径来自 doc#Book1-KPI2；数值 measured: restriction_calendar。" .

:restrictedDayCount a owl:DatatypeProperty ; rdfs:label "限行日数" ; :askedAs "限行日数" ; rdfs:domain :RestrictionDay ;
    :aggregate "count" ; :grain :RestrictionDay ; :universe :RestrictionDay ; :where :RestrictedDay ; :unit "count" ;
    :businessDescription "43 行（restriction_calendar.restricted）：core 40 / suburb 3。按「天」说就是 43 天里有 40 天核心区限行，但本表的颗粒是「天×区」。 口径来自 doc#Book1-KPI2；数值 measured: restriction_calendar。" .

:restrictedDayShare a owl:DatatypeProperty ; rdfs:label "限行日占比" ; :askedAs "限行日占比" ; rdfs:domain :RestrictionDay ;
    :aggregate "ratio_of_sums" ; :grain :RestrictionDay ; :universe :RestrictionDay ;
    :numerator :restrictedDayCount ; :denominator :restrictionDayCount ; :unit "ratio" ;
    :businessDescription "43 / 180 = 23.89%。分母是日历行不是自然日：按 90 天算会得到 47.78%，那个数字没有任何业务含义。 口径来自 doc#Book1-KPI2；数值 measured: restriction_calendar。" .

:restrictedDayCountByZone a owl:DatatypeProperty ; rdfs:label "按区域看限行日数" ; :askedAs "按区域看限行日数" ; rdfs:domain :RestrictionDay ;
    :aggregate "count" ; :grain :RestrictionDay ; :universe :RestrictionDay ; :where :RestrictedDay ; :groupBy :restrictionZone ; :unit "count" ;
    :businessDescription "core 40 / suburb 3（restriction_calendar.zone）。核心区几乎每天都在限，郊县只是偶发管制。 口径来自 doc#Book1-KPI2；数值 measured: restriction_calendar。" .

# ---------------------------------------------------------------- 卡3 出勤与线路执行
:scheduledShiftCount a owl:DatatypeProperty ; rdfs:label "排班班次数" ; :askedAs "排班班次数" ; rdfs:domain :DriverSchedule ;
    :aggregate "count" ; :grain :DriverSchedule ; :universe :DriverSchedule ; :where :ScheduledShift ; :unit "count" ;
    :businessDescription "5,036（driver_schedule.scheduled = true）。出勤率的分母。不是 5,400：5,400 里含 364 个「没排班」。 口径来自 doc#Book1-KPI3；数值 measured: driver_schedule。" .

:attendedShiftCount a owl:DatatypeProperty ; rdfs:label "出勤班次数" ; :askedAs "出勤班次数" ; rdfs:domain :DriverSchedule ;
    :aggregate "count" ; :grain :DriverSchedule ; :universe :DriverSchedule ; :where :AttendedShift ; :unit "count" ;
    :businessDescription "2,894（driver_schedule.status = attended）。 口径来自 doc#Book1-KPI3；数值 measured: driver_schedule。" .

:attendanceRate a owl:DatatypeProperty ; rdfs:label "出勤率" ; :askedAs "出勤率" ; rdfs:domain :DriverSchedule ;
    :aggregate "ratio_of_sums" ; :grain :DriverSchedule ; :universe :DriverSchedule ;
    :numerator :attendedShiftCount ; :denominator :scheduledShiftCount ; :unit "ratio" ;
    :businessDescription "2,894 / 5,036 = 57.47%。口径来自 Book1 人力卡。分母含请假的 662——请假算「没出勤」，但不算「缺勤」，要分开看请用 shiftCountByScheduleStatus。 口径来自 doc#Book1-KPI3；数值 measured: driver_schedule。" .

:shiftCountByScheduleStatus a owl:DatatypeProperty ; rdfs:label "按排班状态看行数" ; :askedAs "按排班状态看行数" ; rdfs:domain :DriverSchedule ;
    :aggregate "count" ; :grain :DriverSchedule ; :universe :DriverSchedule ; :groupBy :scheduleStatus ; :unit "count" ;
    :businessDescription "attended 2,894 / absent 1,480 / leave 662 / not_scheduled 364（driver_schedule.status）。四行相加 = 5,400，这是这张表唯一一条完整性约束。 口径来自 doc#Book1-KPI3；数值 measured: driver_schedule。" .

:routeCompletedTripCount a owl:DatatypeProperty ; rdfs:label "线路完成趟次" ; :askedAs "线路完成趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :RouteCompletedTrip ; :unit "count" ;
    :businessDescription "3,329 趟（trips.stops_delivered >= planned_stops）。 口径来自 doc#Book1-KPI3；数值 measured: trips。" .

:routeCompletionRate a owl:DatatypeProperty ; rdfs:label "线路完成率" ; :askedAs "线路完成率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :routeCompletedTripCount ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "3,329 / 4,120 = 80.80%。口径来自 Book1 执行卡。这是「整趟跑完」的比例，不是「站送到了」的比例。 口径来自 doc#Book1-KPI3；数值 measured: trips。" .

:routeCompletionRateByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看线路完成率" ; :askedAs "按线路版本看线路完成率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ; :groupBy :tripRouteVersion ;
    :numerator :routeCompletedTripCount ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "v1 87.27% / v2 69.74%（trips.route_version）。v2 只跑了 1,520 趟就掉了 17.5 个百分点，这是卡 3 最该被追问的一条。 口径来自 doc#Book1-KPI3；数值 measured: trips。" .

:plannedStopsTotal a owl:DatatypeProperty ; rdfs:label "计划站点数合计" ; :askedAs "计划站点数合计" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :grain :Trip ; :universe :Trip ; :formula "planned_stops" ; :unit "count" ;
    :businessDescription "Σ trips.planned_stops = 50,832，与 stops 表行数完全相等（每个计划站一行站点记录），所以站点级分母用哪个都一样。 口径来自 doc#Book1-KPI3；数值 measured: trips。" .

:deliveredStopsTotal a owl:DatatypeProperty ; rdfs:label "已送达站点数合计" ; :askedAs "已送达站点数合计" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :grain :Trip ; :universe :Trip ; :formula "stops_delivered" ; :unit "count" ;
    :businessDescription "Σ trips.stops_delivered = 49,927，与 stops 里 service_status = delivered 的 49,927 站一致——这是两张表之间的第二条核对线。 口径来自 doc#Book1-KPI3；数值 measured: trips。" .

:stopDeliveryCompletionRate a owl:DatatypeProperty ; rdfs:label "站点送达完成率" ; :askedAs "站点送达完成率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :deliveredStopsTotal ; :denominator :plannedStopsTotal ; :unit "ratio" ;
    :businessDescription "49,927 / 50,832 = 98.22%（趟次颗粒上的两个求和对相除）。与站点颗粒的 98.22% 一致，与「线路完成率 80.80%」是两个词：前者数站，后者数趟。 口径来自 doc#Book1-KPI3；数值 measured: trips。" .

:stopDeliveryCompletionRateByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看站点送达完成率" ; :askedAs "按线路版本看站点送达完成率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ; :groupBy :tripRouteVersion ;
    :numerator :deliveredStopsTotal ; :denominator :plannedStopsTotal ; :unit "ratio" ;
    :businessDescription "v1 98.69% / v2 97.68%（trips.route_version）。站点级只差 1.01 个百分点，而线路完成率差 17.5 个百分点——同一个现象的两个尺度，报表必须说清用哪一个。 口径来自 doc#Book1-KPI3；数值 measured: trips。" .

# ---------------------------------------------------------------- 卡4 异常工单
:ticketCount a owl:DatatypeProperty ; rdfs:label "异常工单数" ; :askedAs "异常工单数" ; rdfs:domain :IncidentTicket ;
    :aggregate "count" ; :grain :IncidentTicket ; :universe :IncidentTicket ; :unit "count" ;
    :businessDescription "107 张（incident_tickets，一趟一单）。 口径来自 doc#Book1-KPI4；数值 measured: incident_tickets。" .

:primaryTicketCount a owl:DatatypeProperty ; rdfs:label "主异常工单数" ; :askedAs "主异常工单数" ; rdfs:domain :IncidentTicket ;
    :aggregate "count" ; :grain :IncidentTicket ; :universe :IncidentTicket ; :where :PrimaryTicket ; :unit "count" ;
    :businessDescription "23 张（incident_tickets.is_primary）。去重口径的分子。 口径来自 doc#Book1-KPI4；数值 measured: incident_tickets。" .

:primaryTicketShare a owl:DatatypeProperty ; rdfs:label "主异常工单占比" ; :askedAs "主异常工单占比" ; rdfs:domain :IncidentTicket ;
    :aggregate "ratio_of_sums" ; :grain :IncidentTicket ; :universe :IncidentTicket ;
    :numerator :primaryTicketCount ; :denominator :ticketCount ; :unit "ratio" ;
    :businessDescription "23 / 107 = 21.50%。一张单被标为主异常，就意味着其余异常是它的次生——直接数 type 会把这 23 张重复计数。 口径来自 doc#Book1-KPI4；数值 measured: incident_tickets。" .

:ticketCountByType a owl:DatatypeProperty ; rdfs:label "按异常类型看工单数" ; :askedAs "按异常类型看工单数" ; rdfs:domain :IncidentTicket ;
    :aggregate "count" ; :grain :IncidentTicket ; :universe :IncidentTicket ; :groupBy :ticketType ; :unit "count" ;
    :businessDescription "破损 74 / 倒温 16 / 超时 13 / 拒收 4（incident_tickets.type）。破损占 69%，与站点级破损箱一致指向装卸。 口径来自 doc#Book1-KPI4；数值 measured: incident_tickets。" .

:primaryTicketCountByType a owl:DatatypeProperty ; rdfs:label "按类型看主异常工单数" ; :askedAs "按类型看主异常工单数" ; rdfs:domain :IncidentTicket ;
    :aggregate "count" ; :grain :IncidentTicket ; :universe :IncidentTicket ; :where :PrimaryTicket ; :groupBy :ticketType ; :unit "count" ;
    :businessDescription "破损 17 / 超时 4 / 倒温 2 / 拒收 0（主异常行）。拒收 4 张全是次生：它几乎总是别的问题的结果，这解释了为什么「拒收」在工单里少而在 stops 里多（412 站）。 口径来自 doc#Book1-KPI4；数值 measured: incident_tickets。" .

:ticketCountByResponsibleParty a owl:DatatypeProperty ; rdfs:label "按责任方看工单数" ; :askedAs "按责任方看工单数" ; rdfs:domain :IncidentTicket ;
    :aggregate "count" ; :grain :IncidentTicket ; :universe :IncidentTicket ; :groupBy :ticketResponsibleParty ; :unit "count" ;
    :businessDescription "承运 70 / 不可抗力 19 / 客户 18（incident_tickets.responsible_party）。65% 的异常是我们的责任，这是赔付的底。 口径来自 doc#Book1-KPI4；数值 measured: incident_tickets。" .

# ---------------------------------------------------------------- 卡5 油耗与 TCO
:fuelTotalLiters a owl:DatatypeProperty ; rdfs:label "油耗合计" ; :askedAs "油耗合计" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :grain :Trip ; :universe :Trip ; :formula "fuel_liters" ; :unit "L" ;
    :businessDescription "Σ trips.fuel_liters = 32,378.1 L，与 fuel_logs.liters 合计一致（3,000 条加油记录），两条路线互为核对。 口径来自 doc#Book1-KPI5；数值 measured: trips。" .

:fleetKm a owl:DatatypeProperty ; rdfs:label "里程合计" ; :askedAs "里程合计" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :grain :Trip ; :universe :Trip ; :formula "actual_km" ; :unit "km" ;
    :businessDescription "Σ trips.actual_km = 257,872.3 km。百公里油耗与单公里成本的分母。 口径来自 doc#Book1-KPI5；数值 measured: trips。" .

:fuelLitersX100 a owl:DatatypeProperty ; rdfs:label "油耗×100" ; :askedAs "油耗×100" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :grain :Trip ; :universe :Trip ; :formula "fuel_liters * 100" ; :unit "L" ;
    :businessDescription "Σ(fuel_liters × 100) = 3,237,810。它只是百公里油耗的分子，脱离 :fuelPer100km 单看没有业务含义——scale 放在分子上是本栈 ratio_of_sums 的既定写法。 口径来自 doc#Book1-KPI5；数值 measured: trips。" .

:fuelPer100km a owl:DatatypeProperty ; rdfs:label "百公里油耗" ; :askedAs "百公里油耗" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :fuelLitersX100 ; :denominator :fleetKm ; :unit "L/100km" ;
    :businessDescription "3,237,810 / 257,872.3 = 12.56 L/100km。车队口径（Σ油耗/Σ里程），不是逐趟油耗的平均（11.30，会被短途趟拉低）。口径来自 Book1 成本卡。 口径来自 doc#Book1-KPI5；数值 measured: trips。" .

:fuelPer100kmByTonnage a owl:DatatypeProperty ; rdfs:label "按吨位看百公里油耗" ; :askedAs "按吨位看百公里油耗" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ; :groupBy :vehicleTonnage ;
    :numerator :fuelLitersX100 ; :denominator :fleetKm ; :unit "L/100km" ;
    :businessDescription "3t 9.00 / 5t 10.54 / 8t 12.48 / 10t 18.00 / 12t 21.55（trips→vehicles.tonnage）。吨位越大油耗越高是结构性的，节油考核必须按吨位分组比，否则大车永远输。 口径来自 doc#Book1-KPI5；数值 measured: trips。" .

:maintenanceCostTotal a owl:DatatypeProperty ; rdfs:label "维修成本合计（趟次分摊）" ; :askedAs "维修成本合计（趟次分摊）" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :grain :Trip ; :universe :Trip ; :formula "maintenance_cost" ; :unit "RMB" ;
    :businessDescription "Σ trips.maintenance_cost = 443,109.53 元，与 maintenance_orders.cost 合计完全相同（250 张工单）——两条路线互为核对。 口径来自 doc#Book1-KPI5；数值 measured: trips。" .

:maintenanceCostPerKm a owl:DatatypeProperty ; rdfs:label "单公里维修成本" ; :askedAs "单公里维修成本" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :maintenanceCostTotal ; :denominator :fleetKm ; :unit "RMB/km" ;
    :businessDescription "443,109.53 / 257,872.3 = 1.72 元/km。TCO 的一块，单独列出来是为了让「维修贵在哪」能被拆开问。 口径来自 doc#Book1-KPI5；数值 measured: trips。" .

:tripFixedCostTotal a owl:DatatypeProperty ; rdfs:label "固定成本合计（趟次分摊）" ; :askedAs "固定成本合计（趟次分摊）" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :grain :Trip ; :universe :Trip ; :formula "fixed_cost" ; :unit "RMB" ;
    :businessDescription "Σ trips.fixed_cost = 3,014,690.83 元。与 vehicle_fixed_costs 台账合计 3,014,690.57 差 0.26 元（分摊后四舍五入）。TCO 用趟次这一条，台账只作核对。 口径来自 doc#Book1-KPI5；数值 measured: trips。" .

:tripFixedCostPerKm a owl:DatatypeProperty ; rdfs:label "单公里固定成本" ; :askedAs "单公里固定成本" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :tripFixedCostTotal ; :denominator :fleetKm ; :unit "RMB/km" ;
    :businessDescription "3,014,690.83 / 257,872.3 = 11.69 元/km。它比油费+维修（6.57）还高一倍，所以「降本」讨论如果不碰资产利用率，谈的都是小头。 口径来自 doc#Book1-KPI5；数值 measured: trips。" .

:tripTotalCost a owl:DatatypeProperty ; rdfs:label "单趟总成本TCO" ; :askedAs "单趟总成本TCO" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :grain :Trip ; :universe :Trip ; :formula "cost_total + maintenance_cost + fixed_cost" ; :unit "RMB" ;
    :businessDescription "Σ(cost_total + maintenance_cost + fixed_cost) = 5,513,421.06 元。三项必须同源：cost_total 里已含司机/搬运工/油/外车，维修与固定成本是另外两列，再叠加会重复计算。 口径来自 doc#Book1-KPI5；数值 measured: trips。" .

:tcoPerKm a owl:DatatypeProperty ; rdfs:label "单公里TCO" ; :askedAs "单公里TCO" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :tripTotalCost ; :denominator :fleetKm ; :unit "RMB/km" ;
    :businessDescription "5,513,421.06 / 257,872.3 = 21.38 元/km。口径来自 Book1 成本卡。 口径来自 doc#Book1-KPI5；数值 measured: trips。" .

:tcoPerTrip a owl:DatatypeProperty ; rdfs:label "单趟TCO" ; :askedAs "单趟TCO" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :tripTotalCost ; :denominator :tripCount ; :unit "RMB/trip" ;
    :businessDescription "5,513,421.06 / 4,120 = 1,338.21 元/趟。与 tcoPerKm 是一对：单价谈判用前者，报价用后者。 口径来自 doc#Book1-KPI5；数值 measured: trips。" .

:maintenanceOrderCount a owl:DatatypeProperty ; rdfs:label "维修工单数" ; :askedAs "维修工单数" ; rdfs:domain :MaintenanceOrder ;
    :aggregate "count" ; :grain :MaintenanceOrder ; :universe :MaintenanceOrder ; :unit "count" ;
    :businessDescription "250 张（maintenance_orders）。 口径来自 doc#Book1-KPI5；数值 measured: maintenance_orders。" .

:maintenanceSpendTotal a owl:DatatypeProperty ; rdfs:label "维修台账金额" ; :askedAs "维修台账金额" ; rdfs:domain :MaintenanceOrder ;
    :aggregate "sum" ; :grain :MaintenanceOrder ; :universe :MaintenanceOrder ; :formula "cost" ; :unit "RMB" ;
    :businessDescription "Σ maintenance_orders.cost = 443,109.53 元，均单 1,772.44 元。与趟次分摊合计逐笔相等，是 TCO 第二条手写路线。 口径来自 doc#Book1-KPI5；数值 measured: maintenance_orders。" .

:maintenanceDowntimeHours a owl:DatatypeProperty ; rdfs:label "维修停机工时" ; :askedAs "维修停机工时" ; rdfs:domain :MaintenanceOrder ;
    :aggregate "sum" ; :grain :MaintenanceOrder ; :universe :MaintenanceOrder ; :formula "downtime_hours" ; :unit "hours" ;
    :businessDescription "Σ downtime_hours = 4,038.1 小时（250 张工单）。这是「修车损失了多少可用车时」，不是维修费——两者必须分开报。 口径来自 doc#Book1-KPI5；数值 measured: maintenance_orders。" .

:maintenanceSpendByCategory a owl:DatatypeProperty ; rdfs:label "按科目看维修金额" ; :askedAs "按科目看维修金额" ; rdfs:domain :MaintenanceOrder ;
    :aggregate "sum" ; :grain :MaintenanceOrder ; :universe :MaintenanceOrder ; :groupBy :maintenanceCategory ; :formula "cost" ; :unit "RMB" ;
    :businessDescription "制冷机组 171,449.87 / 轮胎 89,905.60 / 车厢 61,997.51 / 保养 47,259.52 / 刹车 45,654.62 / 电瓶 26,842.41（maintenance_orders.category）。冷链的成本痛点不在发动机，这就是它值钱的那句话。 口径来自 doc#Book1-KPI5；数值 measured: maintenance_orders。" .

:maintenanceSpendByVehicle a owl:DatatypeProperty ; rdfs:label "按车辆看维修金额" ; :askedAs "按车辆看维修金额" ; rdfs:domain :MaintenanceOrder ;
    :aggregate "sum" ; :grain :MaintenanceOrder ; :universe :MaintenanceOrder ; :groupBy :vehiclePlate ; :formula "cost" ; :unit "RMB" ;
    :businessDescription "沪A**#003 17,449.78 / #028 16,408.22 / #022 15,036.15 居前（maintenance_orders→vehicles.plate）。用来抓「一台车吃掉了全队维修预算」。 口径来自 doc#Book1-KPI5；数值 measured: maintenance_orders。" .

:maintenanceOrderCountByCategory a owl:DatatypeProperty ; rdfs:label "按科目看维修工单数" ; :askedAs "按科目看维修工单数" ; rdfs:domain :MaintenanceOrder ;
    :aggregate "count" ; :grain :MaintenanceOrder ; :universe :MaintenanceOrder ; :groupBy :maintenanceCategory ; :unit "count" ;
    :businessDescription "按 maintenance_orders.category 数工单（不是金额）。工单数与金额一起看才知道是「贵」还是「频」。 口径来自 doc#Book1-KPI5；数值 measured: maintenance_orders。" .

# ---------------------------------------------------------------- 卡6 安全/违章
:violationCount a owl:DatatypeProperty ; rdfs:label "违章数" ; :askedAs "违章数" ; rdfs:domain :Violation ;
    :aggregate "count" ; :grain :Violation ; :universe :Violation ; :unit "count" ;
    :businessDescription "245 条（violations），涉及 59 台车。 口径来自 doc#Book1-KPI6；数值 measured: violations。" .

:violationFineTotal a owl:DatatypeProperty ; rdfs:label "违章罚款合计" ; :askedAs "违章罚款合计" ; rdfs:domain :Violation ;
    :aggregate "sum" ; :grain :Violation ; :universe :Violation ; :formula "fine_amount" ; :unit "RMB" ;
    :businessDescription "Σ fine_amount = 61,200 元（245 条）。罚款不进 trips 成本三列，所以 TCO 里没有它——报「总成本」时必须说明这一点。 口径来自 doc#Book1-KPI6；数值 measured: violations。" .

:violationPointsTotal a owl:DatatypeProperty ; rdfs:label "违章扣分合计" ; :askedAs "违章扣分合计" ; rdfs:domain :Violation ;
    :aggregate "sum" ; :grain :Violation ; :universe :Violation ; :formula "points" ; :unit "points" ;
    :businessDescription "Σ points = 705 分（245 条）。扣分是司机维度的资产损耗，不是钱：59 台车分 705 分，人均与车均不是一个算法。 口径来自 doc#Book1-KPI6；数值 measured: violations。" .

:violationCountByCategory a owl:DatatypeProperty ; rdfs:label "按类别看违章数" ; :askedAs "按类别看违章数" ; rdfs:domain :Violation ;
    :aggregate "count" ; :grain :Violation ; :universe :Violation ; :groupBy :violationCategory ; :unit "count" ;
    :businessDescription "超速 66 / 违停 64 / 闯禁行 61 / 疲劳驾驶 54（violations.category）。闯禁行 61 条与「核心区 77.41% 趟次通行证无效」是同一件事的两面。 口径来自 doc#Book1-KPI6；数值 measured: violations。" .

:violationCountByRoadZone a owl:DatatypeProperty ; rdfs:label "按路权区域看违章数" ; :askedAs "按路权区域看违章数" ; rdfs:domain :Violation ;
    :aggregate "count" ; :grain :Violation ; :universe :Violation ; :groupBy :violationRoadZone ; :unit "count" ;
    :businessDescription "highway 120 / suburb 64 / core 61（violations.road_zone）。一半违章在高速上，所以司机培训的落点不在市区。 口径来自 doc#Book1-KPI6；数值 measured: violations。" .

:violationCountByVehicle a owl:DatatypeProperty ; rdfs:label "按车辆看违章数" ; :askedAs "按车辆看违章数" ; rdfs:domain :Violation ;
    :aggregate "count" ; :grain :Violation ; :universe :Violation ; :groupBy :vehiclePlate ; :unit "count" ;
    :businessDescription "沪A**#060 11 条 / #059 9 条 / #053 9 条最多（violations→vehicles.plate）。 口径来自 doc#Book1-KPI6；数值 measured: violations。" .

:tripsWithIncident a owl:DatatypeProperty ;
    :aggregate "count" ; :where :TripWithIncident ; :grain :Trip ; :universe :Trip ;
    rdfs:label "异常趟次" ; :unit "count" ; :additivity "additive" ;
    :askedAs "多少趟出了异常" ;
    :businessDescription "有异常工单的趟次（一趟多单只算一次）。measured: 107 趟。口径来自 answers:Q3 / 口径字典#K2。" .

:anomalyTripRate a owl:DatatypeProperty ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :tripsWithIncident ; :denominator :tripCount ; :scale "100.0" ;
    rdfs:label "配送异常率（趟次口径）" ; :unit "percent" ;
    :askedAs "异常率是多少" ;
    :businessDescription "异常趟次 ÷ 总趟次 × 100。measured: 107/4,120 = 2.60%，在 Excel 目标 ≤3% 之内。口径来自 口径字典#K2。" .

:fleetKmPer10k a owl:DatatypeProperty ;
    :aggregate "sum" ; :formula "actual_km / 10000" ; :grain :Trip ; :universe :Trip ;
    rdfs:label "万公里数" ; :unit "10k km" ; :askedAs "车队一共跑了多少万公里" ;
    :businessDescription "Σ(actual_km / 10000)。只是「每万公里违章」的分母：尺度放在分母上，ratio_of_sums 才不会把单位算错。measured: 25.7872 万公里。" .

:violationsPer10kKm a owl:DatatypeProperty ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :violationCount ; :denominator :fleetKmPer10k ;
    rdfs:label "违章率（每万公里）" ; :unit "起/万公里" ;
    :askedAs "每万公里多少起违章" ;
    :businessDescription "违章起数 ÷ 总里程 × 10,000 = 245 / 25.7872 = 9.50 起/万公里。**车队级口径**：violations 没有 trip_id，所以只能对整队算，不能摊到某一趟——分摊到趟就是发明数据。口径来自 doc#口径字典-K5；数值 measured: violations / trips。" .

