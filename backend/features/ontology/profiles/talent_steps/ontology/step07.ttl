# ═════════════════════════════════════════════════════════════════════════════
# 第 7 步：写下那条公理
#
# 本步新增那条公理：软件工程师 = 是候选人 ∧ 会编程类技能 ∧ 年限 ≥ 3。
#                       类必须有名字（a owl:Class 不能省），否则推理机答不了「谁在里面」。
#                       owl:someValuesFrom 指向的是【类别类】，匹配的是个体的类型。
#                       equivalentClass 是定义不是要求：合格的人不需要写进文件。
#
# 【这一份是第 7 步的快照】前面 6 步的内容都在里面 —— 每一份文件都能在
# Protégé 里单独打开，而且第 7 步是第 6 步的严格超集（只多出新东西）。
#
# 完整教学说明见 backend/examples/talent_steps/README.md
# ═════════════════════════════════════════════════════════════════════════════

@prefix :    <http://example.org/talent#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── 第 1 步（新增）─────────────────────────────────────────────────────────────────
# 一个空筐：候选人
:Candidate  a  owl:Class .

# ── 第 2 步（新增）─────────────────────────────────────────────────────────────────
# 「工作年限」：主语是人，值是整数 → 数据属性
:yearsExperience  a  owl:DatatypeProperty ;
    rdfs:domain :Candidate ;
    rdfs:range  xsd:integer .

# ── 第 3 步（新增）─────────────────────────────────────────────────────────────────
# 另一个空筐：技能标签
:SkillTag  a  owl:Class .

# ── 第 4 步（新增）─────────────────────────────────────────────────────────────────
# 「会什么技能」：主语是人，宾语是技能 → 对象属性（桥）
:hasSkill  a  owl:ObjectProperty ;
    rdfs:domain :Candidate ;
    rdfs:range  :SkillTag .

# ── 第 5 步（新增）─────────────────────────────────────────────────────────────────
# 技能筐里的第一件东西：Python（还归进了「编程类」这个类别）
:Python  a  :SkillTag , :Programming .

# 类别类「编程类技能」：它是「技能标签」的子类
:Programming  a  owl:Class ;
    rdfs:subClassOf :SkillTag .

# ── 第 6 步（新增）─────────────────────────────────────────────────────────────────
# 两个具体的人 + 他们的技能和年限 —— 本体里第一批事实（ABox）
:cand_A  a  :Candidate ;
    rdfs:label         "A — Python, 5 years" ;
    :hasSkill        :Python ;
    :yearsExperience 5 .

:cand_B  a  :Candidate ;
    rdfs:label         "B — Python, 1 year" ;
    :hasSkill        :Python ;
    :yearsExperience 1 .

# ── 第 7 步（新增）─────────────────────────────────────────────────────────────────
# 「软件工程师」的定义 —— 本体第一次会推理
:matches_SoftwareEngineer  a  owl:Class ;
    owl:equivalentClass [
        owl:intersectionOf (
            :Candidate
            [ a  owl:Restriction ;
               owl:onProperty    :hasSkill ;
               owl:someValuesFrom :Programming ]
            [ a  owl:Restriction ;
               owl:onProperty    :yearsExperience ;
               owl:someValuesFrom [ a rdfs:Datatype ;
                                    owl:onDatatype xsd:integer ;
                                    owl:withRestrictions ( [ xsd:minInclusive 3 ] ) ] ] ) ] .

