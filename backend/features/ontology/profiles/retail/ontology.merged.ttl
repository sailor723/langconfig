@prefix : <https://cube.local/ontology/retail#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cube.local/ontology/retail> a owl:Ontology ;
    rdfs:label "Retail ontology, merged for the sql-first-style app" ;
    rdfs:comment "Union of the generated structure files and the hand-written meaning files, plus the sql-first overlay that declares :aggregate/:grain/:universe. Generated by merge_ttl.py — do not edit; edit the sources." .

:aggregate a owl:AnnotationProperty .

:amount a owl:DatatypeProperty ;
    rdfs:label "amount" ;
    rdfs:domain :Order ;
    rdfs:range xsd:decimal ;
    :physicalColumn "amount" ;
    :sqlType "numeric" ;
    :unit "money" .

:averageOrderValue a owl:DatatypeProperty ;
    rdfs:label "Average order value" ;
    rdfs:domain :Order ;
    :additivity "non-additive" ;
    :aggregate "ratio_of_sums" ;
    :businessDescription "Order revenue divided by the number of orders: a RATIO OF SUMS, not the average of per-order values." ;
    :formula "order_revenue / order_count" ;
    :grain :Order ;
    :unit "money" ;
    :universe :Order .

:cust_id a owl:DatatypeProperty ;
    rdfs:label "cust_id" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:integer ;
    :physicalColumn "id" ;
    :sqlType "int" .

:customer a owl:ObjectProperty ;
    rdfs:label "customer" ;
    rdfs:domain :Order ;
    rdfs:range :Customer .

:customer_id a owl:DatatypeProperty ;
    rdfs:label "customer_id" ;
    rdfs:domain :Order ;
    rdfs:range xsd:integer ;
    :physicalColumn "customer_id" ;
    :sqlType "int" .

:grain a owl:AnnotationProperty .

:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:string ;
    :physicalColumn "name" ;
    :sqlType "text" .

:orderCount a owl:DatatypeProperty ;
    rdfs:label "Order count" ;
    rdfs:domain :Order ;
    :additivity "additive" ;
    :aggregate "count" ;
    :businessDescription "Number of orders; used by :averageOrderValue's formula." ;
    :grain :Order ;
    :memberAlias "order_count" ;
    :unit "count" ;
    :universe :Order .

:orderRevenue a owl:DatatypeProperty ;
    rdfs:label "Order revenue" ;
    rdfs:domain :Order ;
    :additivity "additive" ;
    :aggregate "sum" ;
    :businessDescription "Total amount of all orders. Additive: money of a transaction adds up." ;
    :formula "amount" ;
    :grain :Order ;
    :memberAlias "order_revenue" ;
    :unit "money" ;
    :universe :Order .

:order_id a owl:DatatypeProperty ;
    rdfs:label "order_id" ;
    rdfs:domain :Order ;
    rdfs:range xsd:integer ;
    :physicalColumn "id" ;
    :sqlType "int" .

:premiumCustomers a owl:DatatypeProperty ;
    rdfs:label "Premium customers" ;
    rdfs:domain :Customer ;
    :aggregate "count" ;
    :businessDescription "Count of customers whose tier is PREMIUM. The predicate is compiled from the :PremiumCustomer axiom, so 'PREMIUM' is never re-typed in SQL." ;
    :concept :PremiumCustomer ;
    :counts :Customer ;
    :grain :Customer ;
    :universe :Customer .

:universe a owl:AnnotationProperty .

:PremiumCustomer a owl:Class ;
    rdfs:label "Premium customer" ;
    rdfs:subClassOf :Customer ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Customer [ a owl:Restriction ;
                        owl:hasValue "PREMIUM" ;
                        owl:onProperty :tier ] ) ] ;
    :businessDescription "Defined class: a Customer whose tier is PREMIUM. The definition lives in the owl:equivalentClass axiom (02-meaning.ttl); the mapping only binds raw rows." .

:tier a owl:DatatypeProperty ;
    rdfs:label "tier" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:string ;
    :physicalColumn "tier" ;
    :sqlType "text" .

:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "The business concept any purchase is attributed to." ;
    :businessDescription "Anyone who has bought from the retailer at least once." ;
    :physicalTable "customers" ;
    :primaryKey "id" .

:Order a owl:Class ;
    rdfs:label "Order" ;
    rdfs:comment "A purchase; every order belongs to exactly one customer." ;
    :businessDescription "One purchase, online or in a store." ;
    :physicalTable "orders" ;
    :primaryKey "id" .

