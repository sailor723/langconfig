# sunhing_v1 — 含义层。这个数在业务上是什么意思：哪一组行、什么单位、问它的人会怎么说。
# 这里 **不含任何聚合方式**（aggregate/grain/universe/where/groupBy 全在 metrics_ext.ttl），
# 所以只加载本文件时，每个指标都必须按名拒绝：一个没有计算声明的"指标"不是一个数字。
@prefix : <https://cube.local/ontology/sunhing#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

:unit a owl:AnnotationProperty .
:additivity a owl:AnnotationProperty .
:formula a owl:AnnotationProperty .
:formulaSource a owl:AnnotationProperty .
:askedAs a owl:AnnotationProperty .
:businessDescription a owl:AnnotationProperty .
:physicalPredicate a owl:AnnotationProperty .
:numerator a owl:AnnotationProperty .
:denominator a owl:AnnotationProperty .

# ---------------------------------------------------------------------------
# 口径锚点：期间。数据落在 2026-09 — 2027-02 这个**固定历史窗口**里，
# 所以这里不声明"最近 30 天"：任何相对 now() 的窗口都会静默返回空。
# 所有月度指标都钉在数据里最后一个期间（2027-02），这是声明出来的快照，不是猜的。
# ---------------------------------------------------------------------------
:AsOfHrPeriod a owl:Class ;
    rdfs:label "最新期间快照(2027-02) — HrMonth" ;
    skos:definition "HrMonth 在 period = '2027-02' 上的那一行；2027-02 是 dim_*_monthly 六张表实测的最后一个期间。" ;
    :businessDescription "快照锚点。以前这一条写成 :physicalPredicate \"period = '2027-02'\"，编译器静默丢掉了它（6 个月加总 = 2586 人，而不是最后一个月那一行的 46），所以改成真正的 OWL 交集：基类是 HrMonth，限制落在 hrPeriod 上。换期间＝改这些类，不散落在 60 个指标里。" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :HrMonth
        [ a owl:Restriction ; owl:onProperty :hrPeriod ; owl:hasValue "2027-02" ] ) ] .

:AsOfFinancePeriod a owl:Class ;
    rdfs:label "最新期间快照(2027-02) — FinanceMonth" ;
    skos:definition "FinanceMonth 在 period = '2027-02' 上的那一行；2027-02 是 dim_*_monthly 六张表实测的最后一个期间。" ;
    :businessDescription "快照锚点。以前这一条写成 :physicalPredicate \"period = '2027-02'\"，编译器静默丢掉了它（6 个月加总 = 2586 人，而不是最后一个月那一行的 46），所以改成真正的 OWL 交集：基类是 FinanceMonth，限制落在 finPeriod 上。换期间＝改这些类，不散落在 60 个指标里。" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :FinanceMonth
        [ a owl:Restriction ; owl:onProperty :finPeriod ; owl:hasValue "2027-02" ] ) ] .

:AsOfLegalPeriod a owl:Class ;
    rdfs:label "最新期间快照(2027-02) — LegalMonth" ;
    skos:definition "LegalMonth 在 period = '2027-02' 上的那一行；2027-02 是 dim_*_monthly 六张表实测的最后一个期间。" ;
    :businessDescription "快照锚点。以前这一条写成 :physicalPredicate \"period = '2027-02'\"，编译器静默丢掉了它（6 个月加总 = 2586 人，而不是最后一个月那一行的 46），所以改成真正的 OWL 交集：基类是 LegalMonth，限制落在 legalPeriod 上。换期间＝改这些类，不散落在 60 个指标里。" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :LegalMonth
        [ a owl:Restriction ; owl:onProperty :legalPeriod ; owl:hasValue "2027-02" ] ) ] .

:AsOfProductionPeriod a owl:Class ;
    rdfs:label "最新期间快照(2027-02) — ProductionMonth" ;
    skos:definition "ProductionMonth 在 period = '2027-02' 上的那一行；2027-02 是 dim_*_monthly 六张表实测的最后一个期间。" ;
    :businessDescription "快照锚点。以前这一条写成 :physicalPredicate \"period = '2027-02'\"，编译器静默丢掉了它（6 个月加总 = 2586 人，而不是最后一个月那一行的 46），所以改成真正的 OWL 交集：基类是 ProductionMonth，限制落在 prodPeriod 上。换期间＝改这些类，不散落在 60 个指标里。" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :ProductionMonth
        [ a owl:Restriction ; owl:onProperty :prodPeriod ; owl:hasValue "2027-02" ] ) ] .

:AsOfDigitalPeriod a owl:Class ;
    rdfs:label "最新期间快照(2027-02) — DigitalMonth" ;
    skos:definition "DigitalMonth 在 period = '2027-02' 上的那一行；2027-02 是 dim_*_monthly 六张表实测的最后一个期间。" ;
    :businessDescription "快照锚点。以前这一条写成 :physicalPredicate \"period = '2027-02'\"，编译器静默丢掉了它（6 个月加总 = 2586 人，而不是最后一个月那一行的 46），所以改成真正的 OWL 交集：基类是 DigitalMonth，限制落在 digPeriod 上。换期间＝改这些类，不散落在 60 个指标里。" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :DigitalMonth
        [ a owl:Restriction ; owl:onProperty :digPeriod ; owl:hasValue "2027-02" ] ) ] .

:AsOfSentimentPeriod a owl:Class ;
    rdfs:label "最新期间快照(2027-02) — SentimentMonth" ;
    skos:definition "SentimentMonth 在 period = '2027-02' 上的那一行；2027-02 是 dim_*_monthly 六张表实测的最后一个期间。" ;
    :businessDescription "快照锚点。以前这一条写成 :physicalPredicate \"period = '2027-02'\"，编译器静默丢掉了它（6 个月加总 = 2586 人，而不是最后一个月那一行的 46），所以改成真正的 OWL 交集：基类是 SentimentMonth，限制落在 sentPeriod 上。换期间＝改这些类，不散落在 60 个指标里。" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :SentimentMonth
        [ a owl:Restriction ; owl:onProperty :sentPeriod ; owl:hasValue "2027-02" ] ) ] .

:AsOfPmoPeriod a owl:Class ;
    rdfs:label "最新期间快照(2027-02) — PmoMonth" ;
    skos:definition "PmoMonth 在 period = '2027-02' 上的那一行；2027-02 是 dim_*_monthly 六张表实测的最后一个期间。" ;
    :businessDescription "快照锚点。以前这一条写成 :physicalPredicate \"period = '2027-02'\"，编译器静默丢掉了它（6 个月加总 = 2586 人，而不是最后一个月那一行的 46），所以改成真正的 OWL 交集：基类是 PmoMonth，限制落在 pmoMonthPeriod 上。换期间＝改这些类，不散落在 60 个指标里。" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :PmoMonth
        [ a owl:Restriction ; owl:onProperty :pmoMonthPeriod ; owl:hasValue "2027-02" ] ) ] .

:AsOfPeriod a owl:Class ;
    rdfs:label "已弃用：期间快照的抽象名" ;
    rdfs:comment "不要用它做 :where。它原先只有 :physicalPredicate 而没有基类，编译器会静默丢掉条件。按粒度分别用 :AsOfHrPeriod / :AsOfFinancePeriod / … 。" ;
    :businessDescription "保留这个名字只为不让旧引用悬空；任何指标必须用按粒度声明的那一个。" .

# ---------------------------------------------------------------------------
# 行的分组：哪些行算"生态伙伴"、"已协商减员"…… 全部用 OWL 写在列上，
# 语义由声明定义，不由 SQL 里的自由文本定义。
# ---------------------------------------------------------------------------
:EcoPartner a owl:Class ;
    rdfs:label "生态伙伴法人实体" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Entity
        [ a owl:Restriction ; owl:onProperty :entEntityType ; owl:hasValue "partner" ] ) ] .

:ProfitableEcoPartner a owl:Class ;
    rdfs:label "已盈利的生态伙伴实体" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Entity
        [ a owl:Restriction ; owl:onProperty :entEntityType ; owl:hasValue "partner" ]
        [ a owl:Restriction ; owl:onProperty :entIsProfitable ; owl:hasValue 1 ] ) ] .

:SeparatedArchitectureEntity a owl:Class ;
    rdfs:label "已独立核算的法人实体" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Entity
        [ a owl:Restriction ; owl:onProperty :entHasSeparateAccounting ; owl:hasValue 1 ] ) ] .

:SeveredEmployee a owl:Class ;
    rdfs:label "已协商减员的员工" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Employee
        [ a owl:Restriction ; owl:onProperty :empIsSevered ; owl:hasValue 1 ] ) ] .

:ActiveEmployee a owl:Class ;
    rdfs:label "在职员工(未协商减员)" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :Employee
        [ a owl:Restriction ; owl:onProperty :empIsSevered ; owl:hasValue 0 ] ) ] .

:CompletedMilestone a owl:Class ;
    rdfs:label "2027-02 已完成的里程碑" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :PmoMilestone
        [ a owl:Restriction ; owl:onProperty :pmoStatus ; owl:hasValue "completed" ]
        [ a owl:Restriction ; owl:onProperty :pmoMonth ; owl:hasValue "2027-02" ] ) ] ;
    :businessDescription "status 列的完成态实测取值为 'completed'；月份取 2027-02。" .

# ===========================================================================
# 一、人力（dim_hr_monthly，快照行 = 累计/期末值，所以 sum 对一行就是对它本身）
# ===========================================================================
:hrTotalHeadcount a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
:unit "count" ; :additivity "additive" ;
    rdfs:label "员工总人数" ;
    :askedAs "公司现在有多少人" ;
    :businessDescription "table: dim_hr_monthly.total_headcount；期末时点数。" ;
    :formula "total_headcount" ;
    :formulaSource "total_headcount 列直取，无跨行/跨表运算。" .

:hrProductionHeadcount a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
:unit "count" ; :additivity "additive" ;
    rdfs:label "生产人员人数" ;
    :askedAs "生产人员有多少人" ;
    :businessDescription "table: dim_hr_monthly.production_headcount。" ;
    :formula "production_headcount" ;
    :formulaSource "production_headcount 列直取，无跨行/跨表运算。" .

:hrSeveranceCompletedCumulative a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
:unit "count" ; :additivity "additive" ;
    rdfs:label "协商减员完成人数" ;
    :askedAs "已经完成协商减员多少人" ;
    :businessDescription "table: dim_hr_monthly.severance_completed_cumulative；口径是**累计**已完成，不是当月新增。" ;
    :formula "severance_completed_cumulative" ;
    :formulaSource "severance_completed_cumulative 列直取，无跨行/跨表运算。" .

:hrSeverancePlanned a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
:unit "count" ; :additivity "additive" ;
    rdfs:label "协商减员计划人数" ;
    :askedAs "计划协商减员多少人" ;
    :businessDescription "table: dim_hr_monthly.severance_planned；计划口径。" ;
    :formula "severance_planned" ;
    :formulaSource "severance_planned 列直取，无跨行/跨表运算。" .

:hrSeverancePaidCumulativeWan a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
:unit "money_wan" ; :additivity "additive" ;
    rdfs:label "已支付补偿金额" ;
    :askedAs "补偿一共付了多少钱" ;
    :businessDescription "table: dim_hr_monthly.severance_paid_cumulative_wan；单位为万元人民币。" ;
    :formula "severance_paid_cumulative_wan" ;
    :formulaSource "severance_paid_cumulative_wan 列直取，无跨行/跨表运算。" .

:hrPartnerConverted a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
    :unit "count" ; :additivity "additive" ;
    rdfs:label "已转合伙人员工数" ;
    :askedAs "转成合伙人或持股的员工有多少人" ;
    :businessDescription "table: dim_hr_monthly.employee_partner_converted。" ;
    :formula "employee_partner_converted" ;
    :formulaSource "employee_partner_converted 列直取。" .

:hrSeveranceDisputeCount a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
:unit "count" ; :additivity "additive" ;
    rdfs:label "协商减员纠纷件数" ;
    :askedAs "协商减员引起了几件纠纷" ;
    :businessDescription "table: dim_hr_monthly.severance_dispute_count。" ;
    :formula "severance_dispute_count" ;
    :formulaSource "severance_dispute_count 列直取，无跨行/跨表运算。" .

:hrSeveranceBudgetWan a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
:unit "money_wan" ; :additivity "additive" ;
    rdfs:label "补偿预算" ;
    :askedAs "协商减员的补偿预算多少" ;
    :formula "severance_planned * 4.5" ;
    :formulaSource "不是库里的列：= 计划人数 × 人均 4.5 万元。这个 4.5 来自业务简报，**未在库中声明**，需业务确认。" ;
    :businessDescription "table: dim_hr_monthly — 仅作为 :severanceBudgetControlRate 的分母存在；单独引用会暴露那个未声明的 4.5。" .

:severanceCompletionRate a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
rdfs:label "协商减员完成率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "协商减员完成率是多少" ;
    :businessDescription "table: dim_hr_monthly — 已完成协商减员(累计) ÷ 计划协商减员 × 100。" .

:severanceBudgetControlRate a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
rdfs:label "赔偿金额预算控制率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "赔偿金额预算控制率是多少" ;
    :businessDescription "table: dim_hr_monthly — 已支付补偿(累计) ÷ 计划补偿预算 × 100；目标 100%，越低越好(dim_kpi.lower_is_better=1)。" .

:productionHeadcountShare a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
rdfs:label "生产人员占比" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "生产人员占比是多少" ;
    :businessDescription "table: dim_hr_monthly — 期末生产人员数 ÷ 期末总人数 × 100。" .

:employeePartnerConversionRate a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
rdfs:label "员工转合伙人比例" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "有多少比例的员工转成了合伙人" ;
    :formula "employee_partner_converted * 100.0 / total_headcount" ;
    :formulaSource "dim_kpi 里没有这一行的公式，按 kpi_name『员工转合伙人比例』的字面定义补的：同一行内两列相除。" ;
    :businessDescription "table: dim_hr_monthly — 已转合伙人/持股员工数 ÷ 期末总人数 × 100。数据病理（照实报）：2027-02 分子 317（累计口径）> 分母 46（快照人数），所以值 = 689.13%，不是 6.89%。分子是累计转化人数，分母是最后一个月在册人数，两者不是同一总体——只能读成『累计转化相对当前在册』，不能读成转化比例。" .

:severanceDisputeRate a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
rdfs:label "协商减员纠纷发生率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "协商减员纠纷发生率是多少" ;
    :businessDescription "table: dim_hr_monthly — 协商减员纠纷件数 ÷ 已完成协商减员(累计) × 100；对应 dim_kpi RS01，目标 2.0。" .

# ===========================================================================
# 二、财务（dim_finance_monthly）
# ===========================================================================
:finCoreFactoryNetProfitWan a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
:unit "money_wan" ; :additivity "additive" ;
    rdfs:label "核心厂区净利润" ;
    :askedAs "核心厂区净利润多少" ;
    :businessDescription "table: dim_finance_monthly.core_factory_net_profit_wan。" ;
    :formula "core_factory_net_profit_wan" ;
    :formulaSource "core_factory_net_profit_wan 列直取，无跨行/跨表运算。" .

:finEcoPartnerNetProfitWan a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
:unit "money_wan" ; :additivity "additive" ;
    rdfs:label "生态伙伴厂净利润" ;
    :askedAs "生态伙伴厂的净利润多少" ;
    :businessDescription "table: dim_finance_monthly.eco_partner_net_profit_wan。" ;
    :formula "eco_partner_net_profit_wan" ;
    :formulaSource "eco_partner_net_profit_wan 列直取，无跨行/跨表运算。" .

:finTotalMfgNetProfitWan a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
:unit "money_wan" ; :additivity "additive" ;
    rdfs:label "制造业务净利润合计" ;
    :askedAs "制造业净利润合计多少" ;
    :businessDescription "table: dim_finance_monthly.total_mfg_net_profit_wan；核心厂 + 生态伙伴 + 其他。" ;
    :formula "total_mfg_net_profit_wan" ;
    :formulaSource "total_mfg_net_profit_wan 列直取，无跨行/跨表运算。" .

:finReinvestedWan a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
:unit "money_wan" ; :additivity "additive" ;
    rdfs:label "再投资金额" ;
    :askedAs "再投资了多少钱" ;
    :businessDescription "table: dim_finance_monthly.reinvested_wan。" ;
    :formula "reinvested_wan" ;
    :formulaSource "reinvested_wan 列直取，无跨行/跨表运算。" .

:finCashReleasedWan a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
:unit "money_wan" ; :additivity "additive" ;
    rdfs:label "释放现金" ;
    :askedAs "释放了多少现金" ;
    :businessDescription "table: dim_finance_monthly.cash_released_wan；轻资产化释放出的现金。" ;
    :formula "cash_released_wan" ;
    :formulaSource "cash_released_wan 列直取，无跨行/跨表运算。" .

:coreFactoryProfitShare a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
rdfs:label "核心厂区利润贡献率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "核心厂区利润贡献率是多少" ;
    :businessDescription "table: dim_finance_monthly — 核心厂区净利润 ÷ 制造业净利润合计 × 100。" .

:ecoPartnerProfitShare a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
rdfs:label "生态伙伴厂利润贡献率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "生态伙伴贡献多少利润占比" ;
    :businessDescription "table: dim_finance_monthly — 生态伙伴厂净利润 ÷ 制造业净利润合计 × 100。" .

:capitalReinvestmentRate a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
rdfs:label "变革资本再投资率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "资本再投资率是多少" ;
    :businessDescription "table: dim_finance_monthly — 再投资 ÷ 释放现金 × 100。" .

:equityMultiplier a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
    rdfs:label "新架构集团权益乘数" ;
    :unit "ratio" ; :additivity "non-additive" ;
    :askedAs "新架构集团权益乘数是多少" ;
    :formulaSource "dim_kpi #16 的存储公式原文：1.0 + (f.liability_total_wan / NULLIF(f.net_profit_wan * 10, 0)) FROM dim_finance_monthly WHERE period = ?。计算写在 metrics_ext.ttl 的 :formula 里（这一处只留来源与解释，避免同一指标出现两个 :formula）。" ;
    :businessDescription "table: dim_finance_monthly — 源口径是『1 + 负债合计 ÷ (净利润 × 10)』，不是杜邦的 总资产÷股东权益：库里没有 total_assets_wan / total_equity_wan 两列。把它读成杜邦杠杆率是错的（分母是净利润，×10 是源口径自带的量纲归一）；它只能读成『负债相对于当期盈利的倍数』。对外引用请连这句话一起引用。" .

# ===========================================================================
# 三、生产（dim_production_monthly）
# ===========================================================================
:prodCriticalProcessesRunning a owl:DatatypeProperty ;
    rdfs:domain :ProductionMonth ;
:unit "count" ; :additivity "additive" ;
    rdfs:label "在运行的关键工序数" ;
    :askedAs "关键工序保留了几个在运行" ;
    :businessDescription "table: dim_production_monthly.critical_processes_running。" ;
    :formula "critical_processes_running" ;
    :formulaSource "critical_processes_running 列直取，无跨行/跨表运算。" .

:prodTotalProcesses a owl:DatatypeProperty ;
    rdfs:domain :ProductionMonth ;
:unit "count" ; :additivity "additive" ;
    rdfs:label "关键工序总数" ;
    :askedAs "一共有多少道工序" ;
    :businessDescription "table: dim_production_monthly.total_processes。" ;
    :formula "total_processes" ;
    :formulaSource "total_processes 列直取，无跨行/跨表运算。" .

:processRetentionRate a owl:DatatypeProperty ;
    rdfs:domain :ProductionMonth ;
rdfs:label "工序保留完成率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "工序保留完成率是多少" ;
    :businessDescription "table: dim_production_monthly — 保留运行的关键工序数 ÷ 工序总数 × 100。" .

:prodOeePct a owl:DatatypeProperty ;
    rdfs:domain :ProductionMonth ;
rdfs:label "OEE" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "OEE 是多少" ;
    :businessDescription "table: dim_production_monthly.oee_pct；库里已是百分数(如 74.2)，所以不再乘 100。" ;
    :formula "oee_pct" ;
    :formulaSource "oee_pct 列直取，无跨行/跨表运算。" .

# ===========================================================================
# 四、法务与合规（dim_legal_monthly）
# ===========================================================================
:legalNewLaborArbitrationCases a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
:unit "count" ; :additivity "additive" ;
    rdfs:label "新增劳动仲裁案件数" ;
    :askedAs "新增了几件劳动仲裁" ;
    :businessDescription "table: dim_legal_monthly.new_labor_arbitration_cases。" ;
    :formula "new_labor_arbitration_cases" ;
    :formulaSource "new_labor_arbitration_cases 列直取，无跨行/跨表运算。" .

:legalPendingLaborCases a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
:unit "count" ; :additivity "additive" ;
    rdfs:label "待处理劳动争议案件数" ;
    :askedAs "现在有多少劳动案件在办" ;
    :businessDescription "table: dim_legal_monthly.pending_labor_cases。" ;
    :formula "pending_labor_cases" ;
    :formulaSource "pending_labor_cases 列直取，无跨行/跨表运算。" .

:legalMajorGroupIncidents a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
:unit "count" ; :additivity "additive" ;
    rdfs:label "重大群体性事件数" ;
    :askedAs "发生了几起重大群体性事件" ;
    :businessDescription "table: dim_legal_monthly.major_group_incidents。" ;
    :formula "major_group_incidents" ;
    :formulaSource "major_group_incidents 列直取，无跨行/跨表运算。" .

:legalNearMissGroupIncidents a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
:unit "count" ; :additivity "additive" ;
    rdfs:label "群体性事件苗头数" ;
    :askedAs "有几起群体性事件苗头" ;
    :businessDescription "table: dim_legal_monthly.near_miss_group_incidents。" ;
    :formula "near_miss_group_incidents" ;
    :formulaSource "near_miss_group_incidents 列直取，无跨行/跨表运算。" .

:laborDisputeEventCount a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
rdfs:label "劳动仲裁与诉讼事件数" ;
    :unit "count" ; :additivity "additive" ;
    :askedAs "劳动仲裁与诉讼事件数是多少" ;
    :formula "new_labor_arbitration_cases + pending_labor_cases" ;
    :formulaSource "dim_kpi #04 =SUM(E4,F4,G4)：三个单元格全部落在 dim_legal_monthly 一行内。" ;
    :businessDescription "table: dim_legal_monthly — 新增劳动仲裁 + 在办劳动案件；单位是**件数**，不是人次。" .

:majorRiskEventCount a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
rdfs:label "重大风险事件数" ;
    :unit "count" ; :additivity "additive" ;
    :askedAs "重大风险事件数是多少" ;
    :formula "major_group_incidents + near_miss_group_incidents" ;
    :formulaSource "dim_kpi #20 =D4+E4-G4：三项都在 dim_legal_monthly 一行内（第三项当月未发生事件，库中无该列）。" ;
    :businessDescription "table: dim_legal_monthly — 重大群体性事件 + 苗头事件。注意：#20 的存储公式里减掉的第三项在本库没有对应列，所以这里只累加了两项，**口径比 dim_kpi 窄一项**，已在拒绝清单注明。" .

:groupLaborRiskIndex a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
rdfs:label "群体性劳动争议风险指数" ;
    :unit "score_0_100" ; :additivity "additive" ;
    :askedAs "群体性劳动争议风险指数是多少" ;
    :formula "major_group_incidents * 10 + near_miss_group_incidents * 3" ;
    :formulaSource "权重 10 与 3 取自 dim_kpi RS03 的存储构造；不是库里的列。" ;
    :businessDescription "table: dim_legal_monthly — 0–100 分，越高越危险。权重是声明的常数：重大事件×10 + 苗头×3。" .

:legalCustomsCompliancePct a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
rdfs:label "保税物料合规处理完成率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "保税物料合规处理率是多少" ;
    :businessDescription "table: dim_legal_monthly.customs_compliance_pct；已是百分数，不再乘 100。对应 dim_kpi RS04(目标 100)。" ;
    :formula "customs_compliance_pct" ;
    :formulaSource "customs_compliance_pct 列直取，无跨行/跨表运算。" .

# ===========================================================================
# 五、数字化（dim_digital_monthly）
# ===========================================================================
:digReuseRatePct a owl:DatatypeProperty ;
    rdfs:domain :DigitalMonth ;
rdfs:label "数据复用率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "数据复用率是多少" ;
    :businessDescription "table: dim_digital_monthly.reuse_rate_pct；已是百分数。对应 dim_kpi #12。" ;
    :formula "reuse_rate_pct" ;
    :formulaSource "reuse_rate_pct 列直取，无跨行/跨表运算。" .

:digitalValueConversion a owl:DatatypeProperty ;
    rdfs:domain :DigitalMonth ;
rdfs:label "数字化价值转化率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "数字化价值转化率是多少" ;
    :formula "reuse_rate_pct * digital_maturity_score / 100.0" ;
    :formulaSource "dim_kpi #09 的 OEM/Sense 两段存储公式在本库都缺池内的第三项，只保留共用因子。" ;
    :businessDescription "table: dim_digital_monthly — 数据复用率 × 数字化成熟度 ÷ 100；产品(两个 0–100 的数)再归一到百分数。" .

# ===========================================================================
# 六、组织舆情（dim_sentiment_monthly）
# ===========================================================================
:sentSeveranceSatisfaction a owl:DatatypeProperty ;
    rdfs:domain :SentimentMonth ;
:unit "score_1_10" ; :additivity "non-additive" ;
    rdfs:label "历史追缴协商满意度" ;
    :askedAs "协商满意度多少分" ;
    :businessDescription "table: dim_sentiment_monthly.severance_satisfaction；1–10 分。对应 dim_kpi RS02(目标 7.0)。" ;
    :formula "severance_satisfaction" ;
    :formulaSource "severance_satisfaction 列直取，无跨行/跨表运算。" .

:valueExchangeLanding a owl:DatatypeProperty ;
    rdfs:domain :SentimentMonth ;
rdfs:label "价值交换落地度" ;
    :unit "score_0_10" ; :additivity "non-additive" ;
    :askedAs "价值交换落地度是多少" ;
    :formula "change_readiness_score * employee_satisfaction / 10.0" ;
    :formulaSource "dim_kpi #21：变革准备度 × 员工满意度 ÷ 10，两项都在 dim_sentiment_monthly 一行内。刻度不是猜的：实测 change_readiness_score 4.1–7.47（0–10 刻度，不是 0–100）、employee_satisfaction 6.32–6.80（1–10），所以乘积除以 10 落在 0–10。" ;
    :businessDescription "table: dim_sentiment_monthly — 变革准备度 × 满意度 ÷ 10，产出 0–10 分；2027-02 = 7.47 × 6.77 ÷ 10 = 5.06。**不能**拿它去比 dim_kpi #21 的目标 80（那是百分制）：这个存储公式的刻度与它自己的目标不一致，达成率算不出来。" .

# ===========================================================================
# 七、历史责任（raw_liability，**无期间列**：每项是一条责任，不是时点快照）
# ===========================================================================
:liabResolvedWan a owl:DatatypeProperty ;
    rdfs:domain :LiabilityItem ;
:unit "money_wan" ; :additivity "additive" ;
    rdfs:label "已化解历史责任金额" ;
    :askedAs "历史责任已经化解多少钱" ;
    :businessDescription "table: raw_liability.resolved_wan，按责任项求和。该表没有期间列，所以是**全量到现在**，不是某个月的数字——问「某月化解了多少」会被拒绝。" ;
    :formula "resolved_wan" ;
    :formulaSource "resolved_wan 列直取，无跨行/跨表运算。" .

:liabTotalWan a owl:DatatypeProperty ;
    rdfs:domain :LiabilityItem ;
    :unit "money_wan" ; :additivity "additive" ;
    rdfs:label "历史责任总额" ;
    :askedAs "历史责任总额是多少" ;
    :businessDescription "table: raw_liability.total_amount_wan，按责任项求和。" ;
    :formula "total_amount_wan" ;
    :formulaSource "total_amount_wan 列直取。" .

:historicalLiabilityResolutionRate a owl:DatatypeProperty ;
    rdfs:domain :LiabilityItem ;
rdfs:label "历史责任化解率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "历史责任化解率是多少" ;
    :businessDescription "table: raw_liability — 已化解 ÷ 应追缴总额 × 100。对应 dim_kpi #02(目标 40%)。" .

