rdfs:label "生态伙伴实体数" ;
    :unit "count" ; :additivity "additive" ;
    :askedAs "生态伙伴实体数是多少" ;
    :businessDescription "table: raw_entity — entity_type='partner' 的实体个数。" .

:profitableEcoPartnerCount a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
rdfs:label "已盈利生态伙伴实体数" ;
    :unit "count" ; :additivity "additive" ;
    :askedAs "已盈利生态伙伴实体数是多少" ;
    :businessDescription "table: raw_entity — entity_type='partner' 且 is_profitable=1 的实体个数。" .

:entityCount a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
rdfs:label "法人实体总数" ;
    :unit "count" ; :additivity "additive" ;
    :askedAs "法人实体总数是多少" ;
    :businessDescription "table: raw_entity 全部行数（core + partner）。" .

:separateArchitectureEntityCount a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
rdfs:label "已独立核算实体数" ;
    :unit "count" ; :additivity "additive" ;
    :askedAs "有几个实体已经独立核算" ;
    :businessDescription "table: raw_entity — has_separate_accounting=1 的实体个数。" .

:lightAssetIndex a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
rdfs:label "轻资产化指数" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "轻资产化指数是多少" ;
    :businessDescription "table: raw_entity — 已盈利生态伙伴实体数 ÷ 生态伙伴实体数 × 100。对应 dim_kpi #11(目标 70%)。" .

:architectureSeparationRate a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
rdfs:label "股权分立架构完成率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "股权分立架构完成率是多少" ;
    :businessDescription "table: raw_entity — 已独立核算实体数 ÷ 法人实体总数 × 100。对应 dim_kpi #14。" .

# ===========================================================================
# 九、PMO 里程碑（raw_pmo，text 月份）
# ===========================================================================
:pmoCompletedMilestones a owl:DatatypeProperty ;
    rdfs:domain :PmoMilestone ;
rdfs:label "已完成里程碑数" ;
    :unit "count" ; :additivity "additive" ;
    :askedAs "2027年2月完成了几个里程碑" ;
    :businessDescription "table: raw_pmo 中 month='2027-02' 且 status='completed' 的行数。" .

:pmoOnTimeMilestones a owl:DatatypeProperty ;
    rdfs:domain :PmoMilestone ;
rdfs:label "准时完成里程碑数" ;
    :unit "count" ; :additivity "additive" ;
    :askedAs "2027年2月按期完成了几个里程碑" ;
    :businessDescription "table: raw_pmo — 同一组行里 completed_on_time=1 的行数(对 completed_on_time 求和)。" .

:milestoneOnTimeRate a owl:DatatypeProperty ;
    rdfs:domain :PmoMilestone ;
rdfs:label "里程碑准时完成率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "里程碑准时完成率是多少" ;
    :businessDescription "table: raw_pmo — 按期完成里程碑数 ÷ 已完成里程碑数 × 100。对应 dim_kpi #19(目标 90%)。" .

# ===========================================================================
# 十、按维度切开（raw 表，每个是一个分组数字）
# ===========================================================================
:headcountByFactory a owl:DatatypeProperty ;
    rdfs:domain :Employee ;
rdfs:label "各厂区在职人数" ;
    :unit "count" ; :additivity "additive" ;
    :askedAs "各厂区在职人数是多少" ;
    :businessDescription "table: raw_employee — 按 raw_employee.factory 分组的在职员工计数。" .

:severedCountByDepartment a owl:DatatypeProperty ;
    rdfs:domain :Employee ;
rdfs:label "各部门协商减员人数" ;
    :unit "count" ; :additivity "additive" ;
    :askedAs "各部门协商减员人数是多少" ;
    :businessDescription "table: raw_employee — 按 raw_employee.department 分组的已协商减员员工计数。" .

:surveySatisfactionByFactory a owl:DatatypeProperty ;
    rdfs:domain :SurveyResponse ;
rdfs:label "各厂区员工满意度" ;
    :unit "score_1_10" ; :additivity "non-additive" ;
    :askedAs "各厂区员工满意度是多少" ;
    :businessDescription "table: raw_survey_response.satisfaction_score 按 factory 分组求平均。" .

:orderValueByCoreFactory a owl:DatatypeProperty ;
    rdfs:domain :Order ;
rdfs:label "订单金额" ;
    :unit "money_wan" ; :additivity "additive" ;
    :askedAs "订单金额是多少" ;
    :businessDescription "table: raw_order.order_value_wan 按 is_core_factory 分组求和。" .

:lotDefectCount a owl:DatatypeProperty ;
    rdfs:domain :ProductionLot ;
:unit "count" ; :additivity "additive" ;
    rdfs:label "不良件数" ;
    :askedAs "不良件数是多少" ;
    :businessDescription "table: raw_production_lot.defect_count 求和。" ;
    :formula "defect_count" ;
    :formulaSource "defect_count 列直取，无跨行/跨表运算。" .

:lotFramesProduced a owl:DatatypeProperty ;
    rdfs:domain :ProductionLot ;
:unit "count" ; :additivity "additive" ;
    rdfs:label "产出车架数" ;
    :askedAs "产出了多少车架" ;
    :businessDescription "table: raw_production_lot.frames_produced 求和。" ;
    :formula "frames_produced" ;
    :formulaSource "frames_produced 列直取，无跨行/跨表运算。" .

:lotDefectRateByFactory a owl:DatatypeProperty ;
    rdfs:domain :ProductionLot ;
rdfs:label "各厂区不良率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "各厂区不良率是多少" ;
    :businessDescription "table: raw_production_lot — 不良件数 ÷ 产出车架数 × 100，按 factory 分组。" .

# ===========================================================================
# 十一、按期间看趋势（同一批口径，换成按 period 分组）
# ===========================================================================
:severanceCompletionRateByMonth a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
rdfs:label "每个月协商减员完成率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月协商减员完成率是多少" ;
    :formula "severance_completed_cumulative * 100.0 / severance_planned" ;
    :formulaSource "同一行内两列相除，不是两次快照指标相除。理由：:hrSeveranceCompletedCumulative 与 :hrSeverancePlanned 都带 asOf 月过滤，拿它们做 ratio_of_sums 再分组，会让每个月都被钉在 2027-02 上（实测六行全部 94.63%，趋势是假的）。" ;
    :businessDescription "table: dim_hr_monthly — 每个月各自的『已完成 ÷ 计划』× 100，分母为 0 时该行为空。真趋势（手算核对过）：2026-09 0.00 → 2026-10 14.02 → 2026-11 39.72 → 2026-12 65.42 → 2027-01 84.11 → 2027-02 94.63。" .

:majorRiskEventCountByMonth a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
rdfs:label "每个月重大风险事件数" ;
    :unit "count" ; :additivity "additive" ;
    :askedAs "每个月重大风险事件数是多少" ;
    :businessDescription "table: dim_legal_monthly — 与 :majorRiskEventCount 同一口径，按 period 分组。" .

# ===========================================================================
# 十二、按名拒绝：菜单上有，但库里没有能定义它的东西。
# 这些**故意**不带 :aggregate：一个没有定义的数字不能被编译，只能被叫出名字。
# ===========================================================================
:rs05CustomsPenaltyAmount a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
rdfs:label "海关违规罚款金额" ;
    :unit "money_wan" ;
    :askedAs "海关违规罚款金额是多少" ;
    :formulaSource "dim_kpi.RS05 的 formula 为空（仓库自己没写公式）。绑定的依据不是文档，是数据：dim_legal_monthly.customs_penalties_wan 6 个月实测 0.0 / 33.9 / 9.1 / 0.0 / 46.6 / 24.6 —— 非单调，所以是当月发生额而不是累计值；列名与单位(万元)与 RS05 一一对上。仍未确认的一件：这个数是否含滞纳金。" ;
    :businessDescription "table: dim_legal_monthly — 当月海关违规/罚款金额（万元），目标 0（lower_is_better=0）。口径 = dim_legal_monthly.customs_penalties_wan 在快照月的那一行。" .

# 已退役：不再出现在菜单里，但留在这里，因为「为什么不算」也是一个交付物。
:rs06TechTalentAttritionRetired a owl:Class ;
    rdfs:label "核心技术骨干流失率（已退役，不再提供）" ;
    :refusalReason "退役原因不是缺数据，是口径矛盾：dim_kpi 的 formula 为空（仓库自己没写公式），而目标有两处互相矛盾的值——dim_kpi.target=5.0（% ，流失率越低越好），fact_kpi_monthly 同一 KPI 的 target=100.0 且取值 1.2→53.85。后者只有把它读成「保留率」才讲得通，前者只能读成「流失率」。同名同单位、方向相反，无法判断落地那一列是哪一种，所以整条退役。" ;
    :businessDescription "若要恢复，需要业务方二选一：① 骨干流失率 = 本期骨干离职事件数 ÷ 期末骨干人数 × 100（需把离职计数物化成一列）；② 骨干留任率 = 100 − ①。库里有原料：dim_hr_monthly.tech_lead_headcount、raw_hr_event(event_type='severance', position_category in Tech Lead/Team Lead)。两条路都还缺同一件声明：离职与骨干名单的关联口径（raw_hr_event 与 dim_hr_monthly 之间没有键约束）。" .

:rs07CustomerOrderChurn a owl:DatatypeProperty ;
    rdfs:domain :Order ;
rdfs:label "客户订单转移流失率" ;
    :unit "percent" ;
    :askedAs "客户订单转移流失率是多少" ;
    :formulaSource "dim_kpi 的 formula 为空。两处声明互相矛盾，两个都缺归属：(a) dim_kpi.target=3.0 —— 读成「流失率」(订单转移到别处的占比，越低越好)；(b) fact_kpi_monthly 同一指标 target=100.0、取值 100.0/80.0/60.0/100.0 —— 只有读成「未转移占比/保留率」才讲得通，与 (a) 方向相反。没有一份文档说落地的是哪一个。" ;
    :businessDescription "table: (无物理表) — 拒绝：库里根本没有「转移」这个事实。raw_order 的 12 列里没有 transferred/churned 标记，raw_crm 也没有客户流失标记；「流失」还需要一个基线期（上期下单、本期不下单），库里没有声明任何基线期键。两个矛盾的定义见 :formulaSource，两个都无法落地，所以不给数。" .

:ecoPartnerSynergyIndex a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
rdfs:label "生态伙伴战略协同指数" ;
    :unit "score_0_100" ;
    :askedAs "生态伙伴战略协同指数是多少" ;
    :formulaSource "dim_kpi #17 的存储公式：三项分别来自 raw_order(订单占比)、raw_entity(伙伴数)、raw_crm(客户数)，并把三张表拼成一个数；系数 60/5/2 是构造出来的常数，没有任何业务来源。" ;
    :businessDescription "table: (无物理表) — 拒绝：跨表(3 张) + 系数无人确认。缺的声明：一个把三张表按同一期间与同一实体键对齐的口径，以及 60/5/2 三个系数的业务依据。:formula 由 metrics_ext.ttl 声明，故意保留缺失的输入名，让编译器按名拒绝。" .

:techTalentRetentionRate a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
rdfs:label "技术骨干留任率" ;
    :unit "percent" ;
    :askedAs "技术骨干留任率是多少" ;
    :formulaSource "dim_kpi #18 的存储公式要 raw_hr_event(本月骨干离职事件)÷ dim_hr_monthly(骨干人数)；两张表没有任何键约束把它们连起来。" ;
    :businessDescription "table: (无物理表) — 拒绝：跨表 + 无关联键。分母是 dim_hr_monthly 的列，分子「本月骨干离职事件数」只能从 raw_hr_event 数出来，两张表之间没有键约束。缺的声明：骨干离职计数物化成一列，或声明两表按同期同部门的关联。:formula 由 metrics_ext.ttl 声明，故意保留缺失的输入名，让编译器按名拒绝。" .

:pmoOnTimeMilestones a owl:DatatypeProperty ;
    rdfs:domain :PmoMilestone ;
rdfs:label "准时完成里程碑数" ;
:formula "completed_on_time" ;
    :formulaSource "raw_pmo.completed_on_time，0/1 列；求和＝按期完成数。" ;
    :businessDescription "table: raw_pmo — 同一组行里 completed_on_time=1 的行数(对 completed_on_time 求和)。" .

:surveySatisfactionByFactory a owl:DatatypeProperty ;
    rdfs:domain :SurveyResponse ;
rdfs:label "各厂区员工满意度" ;
    :askedAs "各厂区员工满意度是多少" ;
:formula "satisfaction_score" ;
    :formulaSource "raw_survey_response.satisfaction_score（1–10 分）。" ;
    :businessDescription "table: raw_survey_response.satisfaction_score 按 factory 分组求平均。" .

:orderValueByCoreFactory a owl:DatatypeProperty ;
    rdfs:domain :Order ;
rdfs:label "订单金额" ;
    :askedAs "订单金额是多少" ;
:formula "order_value_wan" ;
    :formulaSource "raw_order.order_value_wan（万元）。" ;
    :businessDescription "table: raw_order.order_value_wan 按 is_core_factory 分组求和。" .
# ---------------------------------------------------------------------------
# fact_roe_summary 的快照锚点。这张表也有一期一行，所以「最新一期」要有一条
# 真正落在 roePeriod 上的交集类，而不是把 '2027-02' 写在指标里。
# ---------------------------------------------------------------------------
:AsOfRoePeriod a owl:Class ;
    rdfs:label "最新期间快照(2027-02) — RoeMonthSummary" ;
    skos:definition "RoeMonthSummary 在 period = '2027-02' 上的那一行；2027-02 是 fact_roe_summary 实测的最后一个期间（六期：2026-09 … 2027-02）。" ;
    :businessDescription "快照锚点。写成真正的 OWL 交集（基类 RoeMonthSummary + roePeriod 限制），与 :AsOfHrPeriod 等七条同一写法；这样换期间＝改这一类，不散落在指标里。company_id 恒为 1，所以本表无需按公司再切一次。" ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        :RoeMonthSummary
        [ a owl:Restriction ; owl:onProperty :roePeriod ; owl:hasValue "2027-02" ] ) ] .

# ---------------------------------------------------------------------------
# 第 2 批指标的含义（26 条）：20 个 KPI 的按月序列 + 3 条 ROE 趋势 + 3 个 ROE 时点。
# 公式与口径推导写在 metrics_ext.ttl，这里放单位、可加性与用户会怎么问。
# ---------------------------------------------------------------------------
:historicalLiabilityResolutionRateByMonth a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
    rdfs:label "每个月历史人力成本追缴化解率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月历史人力成本追缴化解率是多少" ;
    :businessDescription "已化解 ÷ (已化解+未化解) × 100，按期。六期都是 85.47：未化解那一列从 2026-09 起没动过，曲线是平的。" .

:severanceBudgetControlRateByMonth a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
    rdfs:label "每个月赔偿金额预算控制率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月赔偿金额预算控制率是多少" ;
    :businessDescription "累计已支付补偿 ÷ (计划 856 人 × 4.5 万元/人) × 100，按期。至 2027-02 已到 128.47%，即预算超支 28%。" .

:laborDisputeEventCountByMonth a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
    rdfs:label "每个月劳动仲裁与诉讼事件数" ;
    :unit "count" ; :additivity "additive" ;
    :askedAs "每个月劳动仲裁与诉讼事件数是多少" ;
    :businessDescription "本月新立仲裁 + 在办案件（存量加增量，照 dim_kpi #04 的写法）。趋势 1→2→2→3→4→4。" .

:processRetentionRateByMonth a owl:DatatypeProperty ;
    rdfs:domain :ProductionMonth ;
    rdfs:label "每个月工序保留完成率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月工序保留完成率是多少" ;
    :businessDescription "在跑关键工序 ÷ 工序总数 × 100，按期。33.33% 那一期是分母从 10 变成 9，不是掉了工序。" .

:productionHeadcountShareByMonth a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
    rdfs:label "每个月生产人员占比" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月生产人员占比是多少" ;
    :businessDescription "生产人员 ÷ 总人数 × 100，按期。61.21 一路上升到 71.74：总人数掉得比生产人员快，占比升高不等于产线在扩。" .

:coreFactoryProfitShareByMonth a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
    rdfs:label "每个月核心厂区利润贡献率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月核心厂区利润贡献率是多少" ;
    :businessDescription "核心厂区净利润 ÷ 制造板块合计 × 100，按期。" .

:ecoPartnerProfitShareByMonth a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
    rdfs:label "每个月生态伙伴利润贡献率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月生态伙伴利润贡献率是多少" ;
    :businessDescription "生态伙伴净利润 ÷ 制造板块合计 × 100，按期。与核心厂区那条同分母，每期两者相加 = 100，不能各自解读。" .

:digitalValueConversionRateByMonth a owl:DatatypeProperty ;
    rdfs:domain :DigitalMonth ;
    rdfs:label "每个月数字资产价值转化率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月数字资产价值转化率是多少" ;
    :businessDescription "复用率 × 数字成熟度分 ÷ 100，按期。它是两个因子的乘积，不是占比。" .

:oeePctByMonth a owl:DatatypeProperty ;
    rdfs:domain :ProductionMonth ;
    rdfs:label "每个月核心厂区固定资产利用率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月核心厂区固定资产利用率是多少" ;
    :businessDescription "dim_production_monthly.oee_pct 照抄，按期。六期全部 100.0 —— 常数，说明库里这个数没有信息量，不是设备满负荷。" .

:digitalReuseRateByMonth a owl:DatatypeProperty ;
    rdfs:domain :DigitalMonth ;
    rdfs:label "每个月数字资产归集与复用率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月数字资产归集与复用率是多少" ;
    :businessDescription "dim_digital_monthly.reuse_rate_pct 照抄，按期。76.70/37.30/56.90/78.40/44.30/83.00 锯齿波动，没有趋势方向。" .

:capitalReinvestmentRateByMonth a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
    rdfs:label "每个月变革资本再投资率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月变革资本再投资率是多少" ;
    :businessDescription "再投资 ÷ 释放现金 × 100，按期。33.74 起，2027-02 到 63.20。" .

:employeePartnerConversionRateByMonth a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
    rdfs:label "每个月员工合伙转化率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月员工合伙转化率是多少" ;
    :businessDescription "累计已转化 ÷ 当期在册人数 × 100，按期。2027-02 = 689.13% —— 分子累计、分母当期，这个定义本身有量纲缺陷；数与库里一致，但不要拿它做结论。" .

:equityMultiplierByMonth a owl:DatatypeProperty ;
    rdfs:domain :FinanceMonth ;
    rdfs:label "每个月新架构集团权益乘数" ;
    :unit "ratio" ; :additivity "non-additive" ;
    :askedAs "每个月新架构集团权益乘数是多少" ;
    :businessDescription "1 + 负债合计 ÷ (净利润 × 10)，按期。1.13–1.23，与 fact_roe_summary.equity_multiplier 逐期相等。" .

:milestoneOnTimeRateByMonth a owl:DatatypeProperty ;
    rdfs:domain :PmoMonth ;
    rdfs:label "每个月 PMO 里程碑准时达成率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月 PMO 里程碑准时达成率是多少" ;
    :businessDescription "按期完成 ÷ 完成里程碑数 × 100，按期。六期都 100%（每期完成的都按期），与 raw_pmo 逐单汇总一致；2027-02 的 100% 是 1/1。" .

:valueExchangeLandingRateByMonth a owl:DatatypeProperty ;
    rdfs:domain :SentimentMonth ;
    rdfs:label "每个月员工价值交换制度落地度" ;
    :unit "score_0_10" ; :additivity "non-additive" ;
    :askedAs "每个月员工价值交换制度落地度是多少" ;
    :businessDescription "变革准备度 × 员工满意度 ÷ 10，按期。实测 2.59–5.06；dim_kpi 的目标 80 在这个量纲上不可比（记在 metrics_ext 里，不在此处换算）。" .

:severanceDisputeRateByMonth a owl:DatatypeProperty ;
    rdfs:domain :HrMonth ;
    rdfs:label "每个月协商减员纠纷发生率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月协商减员纠纷发生率是多少" ;
    :businessDescription "本月纠纷数 ÷ 累计已完成协商人数 × 100，按期。2026-09 分母为 0 → 空值（不是 0）。" .

:severanceSatisfactionByMonth a owl:DatatypeProperty ;
    rdfs:domain :SentimentMonth ;
    rdfs:label "每个月历史追缴协商满意度" ;
    :unit "score_1_10" ; :additivity "non-additive" ;
    :askedAs "每个月历史追缴协商满意度是多少" ;
    :businessDescription "dim_sentiment_monthly.severance_satisfaction 照抄（十分制），按期。六期 5.12–5.75，全期低于目标 7。" .

:groupLaborRiskIndexByMonth a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
    rdfs:label "每个月群体性劳动争议风险指数" ;
    :unit "score_0_100" ; :additivity "additive" ;
    :askedAs "每个月群体性劳动争议风险指数是多少" ;
    :businessDescription "重大群体事件 × 10 + 苗头事件 × 3，按期。20/0/3/0/0/0：风险集中在 2026-09–11。" .

:customsComplianceRateByMonth a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
    rdfs:label "每个月保税物料合规处理完成率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月保税物料合规处理完成率是多少" ;
    :businessDescription "dim_legal_monthly.customs_compliance_pct 照抄，按期。70.5/89.3/93.1/71.5/92.5/100.0，波动无单调方向。" .

:customsPenaltyAmountByMonth a owl:DatatypeProperty ;
    rdfs:domain :LegalMonth ;
    rdfs:label "每个月海关违规罚款金额" ;
    :unit "money_wan" ; :additivity "additive" ;
    :askedAs "每个月海关违规罚款金额是多少" ;
    :businessDescription "dim_legal_monthly.customs_penalties_wan 照抄，按期。0/33.9/9.1/0/46.6/24.6 万元；单月额，不是累计。" .

:roePctByMonth a owl:DatatypeProperty ;
    rdfs:domain :RoeMonthSummary ;
    rdfs:label "每个月 ROE" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月 ROE是多少" ;
    :businessDescription "fact_roe_summary.roe 照抄，按期。21.50 → 50.03（%）。本表 roe 与自身三因子的关系是乘上权益乘数，不是常规杜邦除法；不要用它和 dim_finance_monthly 的净利率互相验算。" .

:netProfitMarginPctByMonth a owl:DatatypeProperty ;
    rdfs:domain :RoeMonthSummary ;
    rdfs:label "每个月净利润率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月净利润率是多少" ;
    :businessDescription "fact_roe_summary.net_profit_margin 照抄，按期。34.06 → 66.09（%）。与 dim_finance_monthly 按 net_profit/revenue 算的 39.55% 不是同一个口径。" .

:assetTurnoverPctByMonth a owl:DatatypeProperty ;
    rdfs:domain :RoeMonthSummary ;
    rdfs:label "每个月资产周转率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "每个月资产周转率是多少" ;
    :businessDescription "fact_roe_summary.asset_turnover 照抄，按期。45.87–61.55（%）。" .

:roePct a owl:DatatypeProperty ;
    rdfs:domain :RoeMonthSummary ;
    rdfs:label "ROE" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "ROE是多少" ;
    :businessDescription "fact_roe_summary 2027-02 那一行的 roe = 50.03%。" .

:netProfitMarginPct a owl:DatatypeProperty ;
    rdfs:domain :RoeMonthSummary ;
    rdfs:label "净利润率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "净利润率是多少" ;
    :businessDescription "fact_roe_summary 2027-02 的 net_profit_margin = 66.09%。" .

:assetTurnoverPct a owl:DatatypeProperty ;
    rdfs:domain :RoeMonthSummary ;
    rdfs:label "资产周转率" ;
    :unit "percent" ; :additivity "non-additive" ;
    :askedAs "资产周转率是多少" ;
    :businessDescription "fact_roe_summary 2027-02 的 asset_turnover = 61.55%。" .
