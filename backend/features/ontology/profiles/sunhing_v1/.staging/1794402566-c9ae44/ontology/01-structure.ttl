# ---------------------------------------------------------------- 行身份（主键列）
# S1b2 要求每个已建模表的每一列都能通过某个属性到达；主键列此前只写在 :primaryKey 上、
# 没有属性承载它，于是 16 个类各差一列。这些属性只声明「这一行的键是哪一列」，不参与任何计算。
:companyId a owl:DatatypeProperty ;
    rdfs:label "公司行主键" ;
    rdfs:domain :Company ;
    :physicalColumn "id" ;
    :valueType xsd:integer .

:crmId a owl:DatatypeProperty ;
    rdfs:label "CRM 订单行主键" ;
    rdfs:domain :CrmOrder ;
    :physicalColumn "id" ;
    :valueType xsd:integer .

:daId a owl:DatatypeProperty ;
    rdfs:label "数字化资产行主键" ;
    rdfs:domain :DigitalAsset ;
    :physicalColumn "id" ;
    :valueType xsd:integer .

:empId a owl:DatatypeProperty ;
    rdfs:label "员工行主键" ;
    rdfs:domain :Employee ;
    :physicalColumn "id" ;
    :valueType xsd:integer .

:entId a owl:DatatypeProperty ;
    rdfs:label "法人实体行主键" ;
    rdfs:domain :Entity ;
    :physicalColumn "id" ;
    :valueType xsd:integer .

:hrEventId a owl:DatatypeProperty ;
    rdfs:label "人事事件行主键" ;
    rdfs:domain :HrEvent ;
    :physicalColumn "id" ;
    :valueType xsd:integer .

:kpiKey a owl:DatatypeProperty ;
    rdfs:label "KPI 目录主键" ;
    rdfs:domain :KpiDefinition ;
    :physicalColumn "kpi_id" ;
    :valueType xsd:string .

:factKpiRowId a owl:DatatypeProperty ;
    rdfs:label "KPI 月度落地行主键" ;
    rdfs:domain :KpiMonthFact ;
    :physicalColumn "id" ;
    :valueType xsd:integer .

:lcId a owl:DatatypeProperty ;
    rdfs:label "法务案件行主键" ;
    rdfs:domain :LegalCase ;
    :physicalColumn "id" ;
    :valueType xsd:integer .

:liabId a owl:DatatypeProperty ;
    rdfs:label "历史责任行主键" ;
    rdfs:domain :LiabilityItem ;
    :physicalColumn "id" ;
    :valueType xsd:integer .

:ordId a owl:DatatypeProperty ;
