    ],
    "AsOfSentimentPeriod": [
      "dim_sentiment_monthly",
      "period = (select max(period) from dim_sentiment_monthly)"
    ],
    "AsOfPmoPeriod": [
      "dim_pmo_monthly",
      "period = (select max(period) from dim_pmo_monthly)"
    ],
    "CompletedMilestone": [
      "raw_pmo",
      "status = 'completed' and month = (select max(month) from raw_pmo)"
    ],
    "EcoPartner": [
      "raw_entity",
      "entity_type in ('partner')"
    ],
    "ProfitableEcoPartner": [
      "raw_entity",
      "entity_type = 'partner' and is_profitable::int = 1"
    ],
    "SeparatedArchitectureEntity": [
      "raw_entity",
      "has_separate_accounting::int = 1"
    ]
  },
