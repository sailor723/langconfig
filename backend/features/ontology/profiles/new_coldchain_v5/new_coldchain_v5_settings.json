{
 "title": "ABC 冷链配送运营本体（v5）",
 "ns": "https://cube.local/ontology/new_coldchain_v5#",
 "ontology_dir": "ontology",
 "overlay": "metrics_ext.ttl",
 "datasource": "new_coldchain",
 "dsn": {
  "host": "${ONTOLOGY_DB_HOST:-127.0.0.1}",
  "port": "${ONTOLOGY_DB_PORT:-5432}",
  "dbname": "new_coldchain",
  "user": "${ONTOLOGY_DB_USER:-weiping}",
  "password": ""
 },
 "guard": {
  "enabled": true,
  "max_rows": 500,
  "default_window_days": 0,
  "statement_timeout_ms": 8000,
  "max_plan_rows": 5000000,
  "_big_tables_note": "big_tables 只放自己有真时间列的表（G1c 逐列核对列真的存在）：trips.trip_date / telemetry.ts / complaints.opened_at / refusals.refused_date / dispatch_decisions.decision_date。stops 是行数最大的一张（50,832 行）却没有自己的时间列——它的日期隔一层 trip_id，所以只进 large_tables 算计划预算；给它拼窗口会得到一条引用不存在列的 SQL，比拒绝更坏。 violations 只有 245 行、不是大表；把它的 occurred_at 列进来，是因为违章族的分组指标（violationTypeMix）扫描时护栏会加一句 page cap，而没有任何「unbounded scan on violations」的报告——G4b 要求扫描被报告而不是被静默截断，声明它的时间列是唯一诚实的写法。",
  "big_tables": {
   "trips": "trip_date",
   "telemetry": "ts",
   "complaints": "opened_at",
   "refusals": "refused_date",
   "dispatch_decisions": "decision_date",
   "violations": "occurred_at"
  },
  "large_tables": [
   "stops",
   "route_stops"
  ],
  "_large_tables_note": "large_tables 只放「没有时间列但行数进预算」的表。G1e 要求一张表不能同时在两个集合里。",
  "_window_note": "default_window_days 保持 0，这是算过的：库里最晚一趟 2026-10-29、最早 2026-08-01，共 90 个数据日；环境 now() 在数据窗之后，任何自动 30/90 天窗口都会静默砍掉数据窗的头部（90 天窗口会丢掉 8 月初那几天）。悄悄少给数比按名拒绝更坏，所以不带时间过滤的整表读取拿一句「这是大表、没有 trip_date 过滤」的拒绝 + 两条出路；已声明的指标永不被窗口改写。"
 },
 "features": {
  "actions": false,
  "lane_b": false,
  "tutorial": true,
  "tutorial_style": "authored"
 },
