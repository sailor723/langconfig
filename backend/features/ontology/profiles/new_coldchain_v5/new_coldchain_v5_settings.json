{
  "title": "冷链配送经营本体 v5",
  "ns": "https://cube.local/ontology/new_coldchain_v5#",
  "ontology_dir": "ontology",
  "overlay": "metrics_ext.ttl",
  "dsn": {
    "host": "${ONTOLOGY_DB_HOST:-127.0.0.1}",
    "port": "${ONTOLOGY_DB_PORT:-5432}",
    "dbname": "new_coldchain",
    "user": "${ONTOLOGY_DB_USER:-weiping}",
    "password": ""
  },
  "guard": {
    "enabled": true,
    "max_rows": 500,
    "default_window_days": 0,
    "statement_timeout_ms": 8000,
    "max_plan_rows": 5000000,
    "big_tables": {
      "trips": "trip_date",
      "telemetry": "ts",
      "complaints": "opened_at",
      "violations": "occurred_at",
      "maintenance_orders": "opened_at",
      "fuel_logs": "filled_at",
      "dispatch_decisions": "decision_date",
      "driver_schedule": "day",
      "refusals": "refused_date",
      "nl_events": "ts"
    },
    "large_tables": [
      "stops",
      "trip_costs",
      "route_stops",
      "driver_stats",
      "handler_settlements",
      "vehicle_fixed_costs",
      "zone_permits",
      "incident_tickets",
      "appeals",
      "handlers"
    ]
  },
  "features": {
    "actions": false,
    "tutorial": true
  },
  "aliases": {
    "准时": "onTimeRate",
    "准点": "onTimeRate",
    "准时率": "onTimeRate",
    "准点率": "onTimeRate",
    "整趟准点": "wholeTripOnTimeRate",
    "全准点": "wholeTripOnTimeRate",
    "迟到": "lateStopCount",
    "晚点": "lateStopCount",
    "超载": "overloadRate",
    "超重": "weightOverloadRate",
    "地磅": "weighbridgeOverloadTripCount",
    "轴荷": "axleOverloadRate",
    "异常": "incidentTripRate",
    "异常率": "incidentTripRate",
    "温控": "tempExcursionStopCount",
    "失温": "tempExcursionStopCount",
    "破损": "damagedBoxCount",
    "货损": "damagedBoxCount",
    "少送": "missingBasketCount",
    "客诉": "complaintCount",
    "投诉": "complaintCount",
    "出勤": "attendanceRate",
    "请假": "leaveDayCount",
    "缺勤": "absentDayCount",
    "违章": "violationCount",
    "罚金": "violationFineTotal",
    "路权": "validPermitCount",
    "通行证": "validPermitCount",
    "限行": "unpermittedRestrictedTripRate",
    "油耗": "fuelPer100Km",
    "百公里油耗": "fuelPer100Km",
    "里程": "totalKm",
    "维修": "maintenanceCostTotal",
    "成本": "variableCostTotal",
    "变动成本": "variableCostTotal",
    "固定成本": "fixedCostTotal",
    "收入": "tripRevenue",
    "毛利": "contributionProfit",
    "贡献毛利": "contributionProfit",
    "毛利率": "grossMarginRate",
    "外车": "externalTripCount",
    "外包": "externalTripShare",
    "建议": "dispatchDecisionCount",
    "采纳率": "adoptionRate",
    "拒单": "refusalCount",
    "趟次": "tripCount",
    "趟": "tripCount",
    "站点": "stopCount",
    "门店数": "storeCount",
    "车辆数": "vehicleCount",
    "司机数": "driverCount",
    "线路数": "routeCount",
    "并线前": "version",
    "并线后": "version",
    "版本": "version"
  },
  "samples": [
    "站点准时率是多少",
    "2026-08-01 到 2026-10-29 的准时率是多少",
    "整趟全准点率是多少",
    "超载率是多少",
    "载重超限率是多少",
    "轴荷超限率是多少",
    "异常率是多少",
    "出勤率是多少",
    "百公里油耗是多少",
    "贡献毛利是多少",
    "贡献毛利率是多少",
    "固定成本合计是多少",
    "外车贡献毛利是多少",
    "派车建议采纳率是多少",
    "客诉赔付金额合计是多少",
    "按版本看准时率",
    "按版本看超载率",
    "按版本看站点数"
  ]
}