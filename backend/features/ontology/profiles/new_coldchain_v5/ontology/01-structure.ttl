:parkingRecordId a owl:DatatypeProperty ; rdfs:label "主键" ; rdfs:domain :ParkingRecord ; :physicalColumn "id" ;
    :businessDescription "parking_list.id；无空值。" .
:parkingRecordDriverId a owl:ObjectProperty ; rdfs:label "司机" ; rdfs:domain :ParkingRecord ; :physicalColumn "driver_id" ; :references :Driver ;
    :businessDescription "parking_list.driver_id；无空值。" .
:parkingRecordStartDate a owl:DatatypeProperty ; rdfs:label "start_date" ; rdfs:domain :ParkingRecord ; :physicalColumn "start_date" ;
    :businessDescription "parking_list.start_date；无空值。" .
:parkingRecordEndDate a owl:DatatypeProperty ; rdfs:label "end_date" ; rdfs:domain :ParkingRecord ; :physicalColumn "end_date" ;
    :businessDescription "parking_list.end_date；无空值。" .
:parkingRecordDays a owl:DatatypeProperty ; rdfs:label "天数" ; rdfs:domain :ParkingRecord ; :physicalColumn "days" ;
    :businessDescription "parking_list.days；取值 3 7；无空值。" .
:parkingRecordReason a owl:DatatypeProperty ; rdfs:label "原因" ; rdfs:domain :ParkingRecord ; :physicalColumn "reason" ;
    :businessDescription "parking_list.reason；取值 正式指派后拒单 2 / 车辆故障 1 / 超载风险 1 / 生病 1 / 站点太多 1 / 车辆不适配 1；无空值。" .
:parkingRecordSource a owl:DatatypeProperty ; rdfs:label "source" ; rdfs:domain :ParkingRecord ; :physicalColumn "source" ;
    :businessDescription "parking_list.source；取值 refusal 5 / manual 2；无空值。" .

# ---------------------------------------------------------------- 派车决策（dispatch_decisions）

:dispatchDecisionId a owl:DatatypeProperty ; rdfs:label "主键" ; rdfs:domain :DispatchDecision ; :physicalColumn "id" ;
    :businessDescription "dispatch_decisions.id；无空值。" .
:dispatchDecisionDecisionDate a owl:DatatypeProperty ; rdfs:label "决策日期" ; rdfs:domain :DispatchDecision ; :physicalColumn "decision_date" ;
    :businessDescription "dispatch_decisions.decision_date；无空值。" .
:dispatchDecisionRouteId a owl:ObjectProperty ; rdfs:label "线路" ; rdfs:domain :DispatchDecision ; :physicalColumn "route_id" ; :references :Route ;
    :businessDescription "dispatch_decisions.route_id；无空值。" .
:dispatchDecisionRecommendedDriver a owl:ObjectProperty ; rdfs:label "系统建议司机" ; rdfs:domain :DispatchDecision ; :physicalColumn "recommended_driver" ; :references :Driver ;
