    :businessDescription "driver_schedule.hours；范围 8–8，合计 40,288；空值 364（6.74%）。恒为 8.0（只有一个取值），常数列不含信息，所以工时利用率/人均人时类指标按名拒绝。" .
:driverScheduleReason a owl:DatatypeProperty ; rdfs:label "原因" ; rdfs:domain :DriverSchedule ; :physicalColumn "reason" ;
    :businessDescription "driver_schedule.reason；取值 None 3,258 / 休息 522 / 车辆维修 499 / 私人事务 459 / 事假 230 / 年假 220 / 病假 212；空值 3,258（60.33%）。只有非出勤的人才有可能有原因：休息 522 / 车辆维修 499 / 私人事务 459 / 事假 230 / 年假 220 / 病假 212；3,258 行为空。" .

# ---------------------------------------------------------------- 车辆轴配置（vehicle_axles）

:vehicleAxleVehicleId a owl:ObjectProperty ; rdfs:label "车辆" ; rdfs:domain :VehicleAxle ; :physicalColumn "vehicle_id" ; :references :Vehicle ;
    :businessDescription "vehicle_axles.vehicle_id；无空值。" .
:vehicleAxleAxleSeq a owl:DatatypeProperty ; rdfs:label "轴序" ; rdfs:domain :VehicleAxle ; :physicalColumn "axle_seq" ;
    :businessDescription "vehicle_axles.axle_seq；取值 2 60 / 1 60 / 3 8；无空值。" .
:vehicleAxleAxleType a owl:DatatypeProperty ; rdfs:label "轴位" ; rdfs:domain :VehicleAxle ; :physicalColumn "axle_type" ;
    :businessDescription "vehicle_axles.axle_type；取值 后桥 60 / 前桥 60 / 第3轴 8；无空值。" .
:vehicleAxleRatedKg a owl:DatatypeProperty ; rdfs:label "额定轴荷" ; rdfs:domain :VehicleAxle ; :physicalColumn "rated_kg" ;
    :businessDescription "vehicle_axles.rated_kg；范围 1,200–5,400，合计 429,000；无空值。" .
:vehicleAxleLoadShare a owl:DatatypeProperty ; rdfs:label "轴荷分配比" ; rdfs:domain :VehicleAxle ; :physicalColumn "load_share" ;
    :businessDescription "vehicle_axles.load_share；范围 0.22–0.66，合计 60；无空值。额定轴荷分配比（60 台合计 60.0），不是实测分配。" .

# ---------------------------------------------------------------- 限行日历（restriction_calendar）

:restrictionCalendarDay a owl:DatatypeProperty ; rdfs:label "日期" ; rdfs:domain :RestrictionCalendar ; :physicalColumn "day" ;
    :businessDescription "restriction_calendar.day；无空值。" .
:restrictionCalendarZone a owl:DatatypeProperty ; rdfs:label "区域" ; rdfs:domain :RestrictionCalendar ; :physicalColumn "zone" ;
    :businessDescription "restriction_calendar.zone；取值 郊区 90 / 核心区 90；无空值。" .
:restrictionCalendarRestricted a owl:DatatypeProperty ; rdfs:label "是否限行" ; rdfs:domain :RestrictionCalendar ; :physicalColumn "restricted" ;
    :businessDescription "restriction_calendar.restricted；取值 否 137 / 是 43；无空值。" .
:restrictionCalendarRestrictionType a owl:DatatypeProperty ; rdfs:label "限行类型" ; rdfs:domain :RestrictionCalendar ; :physicalColumn "restriction_type" ;
    :businessDescription "restriction_calendar.restriction_type；取值 None 137 / 尾号限行 22 / 黄标限行 14 / 临时管制 7；空值 137（76.11%）。" .
:restrictionCalendarNote a owl:DatatypeProperty ; rdfs:label "备注" ; rdfs:domain :RestrictionCalendar ; :physicalColumn "note" ;
    :businessDescription "restriction_calendar.note；取值 不限行 87 / 不限行；无证车辆可通行 50 / None 43；空值 43（23.89%）。不限行的 137 行里也有备注（不限行 / 不限行；无证车辆可通行），所以 note 不是限行说明列。" .

# ---------------------------------------------------------------- 车辆固定成本（vehicle_fixed_costs）

:vehicleFixedCostId a owl:DatatypeProperty ; rdfs:label "主键" ; rdfs:domain :VehicleFixedCost ; :physicalColumn "id" ;
    :businessDescription "vehicle_fixed_costs.id；无空值。" .
:vehicleFixedCostVehicleId a owl:ObjectProperty ; rdfs:label "车辆" ; rdfs:domain :VehicleFixedCost ; :physicalColumn "vehicle_id" ; :references :Vehicle ;
    :businessDescription "vehicle_fixed_costs.vehicle_id；无空值。" .
:vehicleFixedCostPeriod a owl:DatatypeProperty ; rdfs:label "成本期" ; rdfs:domain :VehicleFixedCost ; :physicalColumn "period" ;
    :businessDescription "vehicle_fixed_costs.period；无空值。每台车 3 个期；四个科目相加为这台车这一期的固定成本。" .
:vehicleFixedCostInsurance a owl:DatatypeProperty ; rdfs:label "保险" ; rdfs:domain :VehicleFixedCost ; :physicalColumn "insurance" ;
    :businessDescription "vehicle_fixed_costs.insurance；范围 9,006.52–13,965.34，合计 2,046,338.28；无空值。" .
:vehicleFixedCostDepreciation a owl:DatatypeProperty ; rdfs:label "折旧" ; rdfs:domain :VehicleFixedCost ; :physicalColumn "depreciation" ;
    :businessDescription "vehicle_fixed_costs.depreciation；范围 3,673.11–5,840.25，合计 846,233.22；无空值。" .
:vehicleFixedCostRoadTax a owl:DatatypeProperty ; rdfs:label "车船税" ; rdfs:domain :VehicleFixedCost ; :physicalColumn "road_tax" ;
    :businessDescription "vehicle_fixed_costs.road_tax；范围 320–680，合计 87,480；无空值。" .
:vehicleFixedCostInspection a owl:DatatypeProperty ; rdfs:label "年检" ; rdfs:domain :VehicleFixedCost ; :physicalColumn "inspection" ;
    :businessDescription "vehicle_fixed_costs.inspection；范围 100.04–299.23，合计 34,639.07；无空值。" .
:vehicleFixedCostCurrency a owl:DatatypeProperty ; rdfs:label "币种" ; rdfs:domain :VehicleFixedCost ; :physicalColumn "currency" ;
    :businessDescription "vehicle_fixed_costs.currency；取值 人民币 180；无空值。" .
