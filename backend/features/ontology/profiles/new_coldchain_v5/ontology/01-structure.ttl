:axleType a owl:DatatypeProperty ; rdfs:domain :VehicleAxle ; :physicalColumn "axle_type" ; :businessDescription "轴型：前轴/后轴" .
:axleRatedKg a owl:DatatypeProperty ; rdfs:domain :VehicleAxle ; :physicalColumn "rated_kg" ; :businessDescription "该轴额定载重公斤" .
:axleLoadShare a owl:DatatypeProperty ; rdfs:domain :VehicleAxle ; :physicalColumn "load_share" ; :businessDescription "该轴承担装载重量的比例" .

