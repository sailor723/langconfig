# ABC 冷链配送运营本体 v5 —— 对象与物理列（new_coldchain_v5）
# 一个对象类型 = 一张表；属性名按业务问法命名，物理列名只出现在 :physicalColumn 里。
# 每个属性名唯一到类（:tripRevenue / :stopOnTime / :driverLeftOn），因为 RDF 里同名即同一属性，
# 同名两处会让编译器在任何一处都因歧义拒绝。属性名 = 类名前缀 + 列名，机械生成，便于与 schema 逐列对账。
# 事实来源：information_schema 直读 + 每列一次聚合查询（work/new_coldchain_v5/profile_measured.json），
# 由 check_structure.py 对着活库复核：27 张业务表 + 235 列 + 31 条外键。
# nl_events 是平台自己写的问答日志（nl.py 建表），不是业务表，按平台表排除。
# 数据是固定历史窗 2026-08-01 → 2026-10-29（90 天，天天有趟次）：「最近 30 天」在这个库里不是一个有用的问法，
# 时段对比一律写「数据窗内最近 30 个数据日」，见 settings 的 guard.default_window_days=0。

@prefix : <https://cube.local/ontology/new_coldchain_v5#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------- 对象类

:Vehicle a owl:Class ; rdfs:label "车辆" ; :physicalTable "vehicles" ; :primaryKey "id" ;
    :businessDescription "司机自带的冷藏货车 60 台（8t 36 / 3t 11 / 5t 6 / 10t 4 / 12t 3，吨位合计 429）。排放 国四 27 / 国五 25 / 国六 8，核心区通行许可只有 14 台（23.33%），车龄 3.9–14.5 年（均值 8.98）。车与司机 1:1（drivers.vehicle_id 唯一），所以「换司机」在数据上等于「换车」。" .

:Driver a owl:Class ; rdfs:label "司机" ; :physicalTable "drivers" ; :primaryKey "id" ; :timeColumn "left_on" ;
    :businessDescription "带车加盟司机 60 人。status 全是 active，离职只体现在 left_on 上（10 人有值：转做外车 5 / 主动离职 3 / 合同到期 2），所以「在职/离职」必须看 left_on，不能看 status。年龄 43–57 岁，从业 2.2–12.2 年。" .

:Route a owl:Class ; rdfs:label "线路" ; :physicalTable "routes" ; :primaryKey "id" ; :timeColumn "effective_from" ;
    :businessDescription "品牌方下达的配送线路，按版本存：v1 50 条 / v2 40 条，共 90 个版本行。v2 是 2026-09-22 并线之后的版本：计划站数 v1 均值 10.46 → v2 15.55。一趟次挂的是当时生效的那一版，所以「按线路看」在事实行上就是按 trips.route_version 看。" .

:RouteStop a owl:Class ; rdfs:label "计划站序" ; :physicalTable "route_stops" ; :primaryKey "route_id, seq" ;
    :businessDescription "品牌方计划里的一条站序：某线路第几站去哪家门店，1,145 行（seq 1–17）。这是计划不是执行——与 stops 的实际到店不是同一批门店，不能拿来算计划达成率。" .

:Store a owl:Class ; rdfs:label "门店" ; :physicalTable "stores" ; :primaryKey "id" ;
    :businessDescription "品牌方连锁餐厅门店 800 家（core 533 / suburb 267，10 个区）。收货时间窗 window_from→window_to 与是否带警铃（has_alarm 445 家）决定这一站难不难送。name 只有 765 个不同值（有重名），门店身份要用 id。" .

:Trip a owl:Class ; rdfs:label "行程" ; :physicalTable "trips" ; :primaryKey "id" ; :timeColumn "trip_date" ;
    :businessDescription "一趟配送 = 一天 + 一台车 + 一个司机 + 一条线路，4,120 趟（v1 2,600 / v2 1,520；自有 3,703 / 外车 417）。日期窗 2026-08-01→2026-10-29 共 90 天。装载能力（box/volume/weight_capacity_snapshot）是派车当时冻结的快照，事后换车不改历史。" .

:Stop a owl:Class ; rdfs:label "站点执行" ; :physicalTable "stops" ; :primaryKey "id" ;
    :businessDescription "一趟里的一次门店送货，50,832 行（平均每趟 12.34 站，seq 1–17）。准时、温度越界、破损箱、警铃、缺筐、搬运工是否配合都记在这一行——这是质量与服务指标的颗粒度。它自己没有时间列，日期要回到所属趟次的 trips.trip_date 上取。" .

:TripCost a owl:Class ; rdfs:label "趟次成本" ; :physicalTable "trip_costs" ; :primaryKey "trip_id" ; :timeColumn "as_of" ;
    :businessDescription "向 NASS 追加导出的按趟成本，4,120 行与趟次一一对应（source_type own 3,703 / external 417）。other_cost 整列为空（4,120/4,120），所以算出来的是成本下界、毛利上界，不是全成本。" .

:CalendarDay a owl:Class ; rdfs:label "日历日" ; :physicalTable "calendar" ; :primaryKey "day" ; :timeColumn "day" ;
    :businessDescription "2026-08-01→2026-10-29 的 90 天，标了 weekday（0–6 的整数）与 is_peak（25 天，27.78%）。峰日落在 weekday 4 与 5 上，但整数到星期名的映射本库没有声明，所以只按 is_peak 说事，不按「周几」下结论。" .

:Complaint a owl:Class ; rdfs:label "客诉" ; :physicalTable "complaints" ; :primaryKey "id" ; :timeColumn "opened_at" ;
    :businessDescription "一条客诉对一次到店，1,585 件。kind 有 406 件未分类；liability 与 amount 同时为空的有 731 件（46.12%）——这是「还没判」的状态，不是「无责任」，不能当 0 参与金额合计。closed_at 整列为空（1,585/1,585），所以没有闭环时长。" .

:Refusal a owl:Class ; rdfs:label "拒单" ; :physicalTable "refusals" ; :primaryKey "id" ; :timeColumn "refused_date" ;
    :businessDescription "司机对一条线路的一次拒单，389 次。reason 有 113 次（29.05%）没填；assigned 记录这次拒单是否发生在正式指派之后（144 次 true），是停车规则的唯一事实来源。" .

:ParkingRecord a owl:Class ; rdfs:label "停车记录" ; :physicalTable "parking_list" ; :primaryKey "id" ; :timeColumn "start_date" ;
    :businessDescription "司机被停车的期间，7 条记录、共 21 天（每条恒为 3 天）、7 位司机（来源 refusal 5 / manual 2）。样本极小，只能报事实，不能报趋势或处罚是否公平。" .

:DispatchDecision a owl:Class ; rdfs:label "派车决策" ; :physicalTable "dispatch_decisions" ; :primaryKey "id" ; :timeColumn "decision_date" ;
    :businessDescription "系统对一条线路给出建议司机、人最后选了谁，2,620 条，全部是影子模式（mode=shadow）。adopted 记录是否采纳（2,036 true / 584 false，77.71%），未采纳的 584 条 override_reason 全部填写。" .

:DriverStat a owl:Class ; rdfs:label "司机统计快照" ; :physicalTable "driver_stats" ; :primaryKey "driver_id, window_days" ;
    :businessDescription "60 位司机 × 一个滚动窗口（库里只有 window_days=30）的预聚合，60 行。它是快照不是事实表：与 stops 现算的数可能不同，指标一律从事实行算，这里只用于对账。" .

:Appeal a owl:Class ; rdfs:label "申诉" ; :physicalTable "appeals" ; :primaryKey "id" ; :timeColumn "filed_on" ;
    :businessDescription "司机申诉 46 件：驳回 25 / 支持 12 / 待处理 9。它与 complaints、parking_list 之间没有外键，所以「申诉对应哪条客诉/哪次停车」在本库里不可回答。" .

:Handler a owl:Class ; rdfs:label "搬运工" ; :physicalTable "handlers" ; :primaryKey "id" ; :timeColumn "first_day" ;
    :businessDescription "日结搬运工 420 人，来自 3 家派遣公司（诚达 159 / 宏图 134 / 安捷 127）。人均只干 5.31 天（2231 人天 / 420 人），最多 21 天；日单价 130.07–199.86 元。" .

:HandlerSettlement a owl:Class ; rdfs:label "搬运工结算单" ; :physicalTable "handler_settlements" ; :primaryKey "id" ; :timeColumn "period_start" ;
    :businessDescription "派遣公司按人结算的一张单：天数 × 日单价 = 金额，420 张，合计 361,407.74 元，币种全部 RMB。这是搬运工成本的可对账来源；trips.cost_total 里的 handler_cost（396,744）是分摊值，两者不等。" .

:Telemetry a owl:Class ; rdfs:label "车厢遥测" ; :physicalTable "telemetry" ; :primaryKey "id" ; :timeColumn "ts" ;
    :businessDescription "12,360 个温度点，每趟 3 个，但 ts 只覆盖 2026-11-06 06:00–08:45（2.75 小时，数据窗结束之后）——只够事后抽查，不够做趋势、趟级温控达标或温度 SLA。温度 -19.5–-12.0 ℃。" .

:IncidentTicket a owl:Class ; rdfs:label "异常工单" ; :physicalTable "incident_tickets" ; :primaryKey "id" ; :timeColumn "raised_at" ;
    :businessDescription "异常工单 107 张，落在 107 个不同的趟次上：破损 74 / 倒温 16 / 超时 13 / 拒收 4；责任方 承运 70 / 不可抗力 19 / 客户 18；is_primary=true 只有 23 张。渠道 司机APP 39 / 客服 37 / POD 31。" .

:Violation a owl:Class ; rdfs:label "违章记录" ; :physicalTable "violations" ; :primaryKey "id" ; :timeColumn "occurred_at" ;
    :businessDescription "违章 245 起：超速 66 / 违停 64 / 闯禁行 61 / 疲劳驾驶 54；罚款合计 62,000 元、扣分合计 705 分；状态 已处理 107 / 处理中 72 / 未处理 66。road_zone 超速多在 highway(120)、违停 suburb(64)、闯禁行 core(61)。" .

:FuelLog a owl:Class ; rdfs:label "加油记录" ; :physicalTable "fuel_logs" ; :primaryKey "id" ; :timeColumn "filled_at" ;
    :businessDescription "油卡加油 289 笔，合计 32,378.1 升 / 372,009.39 元（单价恒为 11.4895 元/升，只有一个取值）；4 个油站。289 笔对 4,120 趟，所以趟级油耗要用 trips.fuel_liters（全量口径），不是这张表的合计。" .

:MaintenanceOrder a owl:Class ; rdfs:label "维修工单" ; :physicalTable "maintenance_orders" ; :primaryKey "id" ; :timeColumn "opened_at" ;
    :businessDescription "维修工单 250 张：刹车 45 / 保养 45 / 轮胎 43 / 制冷机组 42 / 车厢 38 / 电瓶 37；费用合计 443,109.53 元、停机合计 4,038.1 小时（台均 67.3 h）。closed_at 全部有值，无未闭环工单；note 整列为空。" .

:ZonePermit a owl:Class ; rdfs:label "通行证" ; :physicalTable "zone_permits" ; :primaryKey "id" ; :timeColumn "valid_from" ;
    :businessDescription "核心区通行证 20 张：有效 12 / 已失效 8；60 台车对应 12 张有效证（覆盖率 20%）。这是「核心区限行趟次里有没有有效证」的唯一事实来源。" .

:DriverSchedule a owl:Class ; rdfs:label "司机排班" ; :physicalTable "driver_schedule" ; :primaryKey "driver_id, day" ; :timeColumn "day" ;
    :businessDescription "司机×日排班 5,400 行（60 人 × 90 天）：scheduled 5,036 / 未排班 364；status 出勤 2,894 / 缺勤 1,480 / 请假 662 / 未排班 364，reason 6 类（休息 522 / 车辆维修 499 / 私人事务 459 / 事假 230 / 年假 220 / 病假 212）。hours 恒为 8.0（只有一个取值），所以工时类指标按名拒绝。" .

:VehicleAxle a owl:Class ; rdfs:label "车辆轴配置" ; :physicalTable "vehicle_axles" ; :primaryKey "vehicle_id, axle_seq" ;
    :businessDescription "128 行的额定轴配置（60 台车，前桥+后桥各 60，8 台车有第 3 轴）：rated_kg 1,200–5,400、load_share 0.217–0.662。这是配置表，不是逐轴实测重量，所以「逐轴实载重量」按名拒绝；超载只能用 trips.axle_overload 快照。" .

:RestrictionCalendar a owl:Class ; rdfs:label "限行日历" ; :physicalTable "restriction_calendar" ; :primaryKey "day, zone" ; :timeColumn "day" ;
    :businessDescription "区域×日 180 行（core 90 / suburb 90）：限行 43 天（core 40 / suburb 3，类型 尾号限行 22 / 黄标限行 14 / 临时管制 7）。这是「某天某区限不限行」的唯一事实来源。" .

:VehicleFixedCost a owl:Class ; rdfs:label "车辆固定成本" ; :physicalTable "vehicle_fixed_costs" ; :primaryKey "id" ; :timeColumn "period" ;
    :businessDescription "60 台车 × 3 个期（period）180 行：保险 2,046,338.28 + 折旧 846,233.22 + 车船税 87,480 + 年检 34,639.07 = 3,014,690.57 元。trips.fixed_cost 合计 3,014,690.83 是它按趟分摊的快照（差 0.26 元是分摊舍入），币种全部 RMB。" .

# ---------------------------------------------------------------- 车辆（vehicles）

:vehicleId a owl:DatatypeProperty ; rdfs:label "主键" ; rdfs:domain :Vehicle ; :physicalColumn "id" ;
    :businessDescription "vehicles.id；无空值。" .
:vehiclePlate a owl:DatatypeProperty ; rdfs:label "车牌" ; rdfs:domain :Vehicle ; :physicalColumn "plate" ;
    :businessDescription "vehicles.plate；60 个不同值，最常见 沪A**#024（1 次）；无空值。" .
:vehicleTonnage a owl:DatatypeProperty ; rdfs:label "额定吨位" ; rdfs:domain :Vehicle ; :physicalColumn "tonnage" ;
    :businessDescription "vehicles.tonnage；范围 3–12，合计 429；无空值。" .
:vehicleEmission a owl:DatatypeProperty ; rdfs:label "排放标准" ; rdfs:domain :Vehicle ; :physicalColumn "emission" ;
    :businessDescription "vehicles.emission；取值 国四 27 / 国五 25 / 国六 8；无空值。" .
:vehicleAgeYears a owl:DatatypeProperty ; rdfs:label "车龄" ; rdfs:domain :Vehicle ; :physicalColumn "age_years" ;
    :businessDescription "vehicles.age_years；范围 3.9–14.5，合计 538.8；无空值。" .
:vehicleCoreZonePermit a owl:DatatypeProperty ; rdfs:label "是否有核心区通行许可" ; rdfs:domain :Vehicle ; :physicalColumn "core_zone_permit" ;
    :businessDescription "vehicles.core_zone_permit；取值 否 46 / 是 14；无空值。14 台有证（23.33%），与 zone_permits 里 12 张有效证不是同一个数：证的台账更小，指数口径以 trips.permit_valid 为准。" .
:vehicleBoxCapacity a owl:DatatypeProperty ; rdfs:label "额定箱数" ; rdfs:domain :Vehicle ; :physicalColumn "box_capacity" ;
    :businessDescription "vehicles.box_capacity；范围 74–313，合计 11,182；无空值。" .
:vehicleVolumeCapacity a owl:DatatypeProperty ; rdfs:label "额定体积" ; rdfs:domain :Vehicle ; :physicalColumn "volume_capacity" ;
    :businessDescription "vehicles.volume_capacity；范围 9.3–37.2，合计 1,329.9；无空值。" .
:vehicleWeightCapacity a owl:DatatypeProperty ; rdfs:label "额定载重" ; rdfs:domain :Vehicle ; :physicalColumn "weight_capacity" ;
    :businessDescription "vehicles.weight_capacity；范围 3,000–12,000，合计 429,000；无空值。" .
:vehicleStatus a owl:DatatypeProperty ; rdfs:label "状态" ; rdfs:domain :Vehicle ; :physicalColumn "status" ;
    :businessDescription "vehicles.status；取值 在职/在用 60；无空值。" .
:vehicleTotalKm a owl:DatatypeProperty ; rdfs:label "累计里程" ; rdfs:domain :Vehicle ; :physicalColumn "total_km" ;
    :businessDescription "vehicles.total_km；范围 3,215.9–5,412.5，合计 257,872.3；无空值。60 台合计 257,872.3 km，与 trips.actual_km 求和逐位相同——单公里成本的分母就是它。按车取，不要按趟相加。" .

# ---------------------------------------------------------------- 司机（drivers）

:driverId a owl:DatatypeProperty ; rdfs:label "主键" ; rdfs:domain :Driver ; :physicalColumn "id" ;
    :businessDescription "drivers.id；无空值。" .
:driverName a owl:DatatypeProperty ; rdfs:label "名称" ; rdfs:domain :Driver ; :physicalColumn "name" ;
    :businessDescription "drivers.name；60 个不同值，最常见 汤*胜#019（1 次）；无空值。" .
:driverAge a owl:DatatypeProperty ; rdfs:label "年龄" ; rdfs:domain :Driver ; :physicalColumn "age" ;
    :businessDescription "drivers.age；范围 43–57，合计 3,070；无空值。" .
:driverYearsService a owl:DatatypeProperty ; rdfs:label "从业年限" ; rdfs:domain :Driver ; :physicalColumn "years_service" ;
    :businessDescription "drivers.years_service；范围 2.2–12.2，合计 426.2；无空值。" .
:driverVehicleId a owl:ObjectProperty ; rdfs:label "车辆" ; rdfs:domain :Driver ; :physicalColumn "vehicle_id" ; :references :Vehicle ;
    :businessDescription "drivers.vehicle_id；无空值。" .
:driverStatus a owl:DatatypeProperty ; rdfs:label "状态" ; rdfs:domain :Driver ; :physicalColumn "status" ;
    :businessDescription "drivers.status；取值 在职/在用 60；无空值。60 人全部 active：离职不在这列，数在职人数必须用 left_on IS NULL。" .
:driverLeftOn a owl:DatatypeProperty ; rdfs:label "离职日期" ; rdfs:domain :Driver ; :physicalColumn "left_on" ;
    :businessDescription "drivers.left_on；空值 50（83.33%）。10 人有值（离职）；在职 50 人。" .
:driverLeaveReason a owl:DatatypeProperty ; rdfs:label "离职原因" ; rdfs:domain :Driver ; :physicalColumn "leave_reason" ;
    :businessDescription "drivers.leave_reason；取值 None 50 / 转做外车 5 / 主动离职 3 / 合同到期 2；空值 50（83.33%）。" .

# ---------------------------------------------------------------- 线路（routes）

:routeId a owl:DatatypeProperty ; rdfs:label "主键" ; rdfs:domain :Route ; :physicalColumn "id" ;
    :businessDescription "routes.id；无空值。" .
:routeCode a owl:DatatypeProperty ; rdfs:label "编号" ; rdfs:domain :Route ; :physicalColumn "code" ;
    :businessDescription "routes.code；90 个不同值，最常见 R-v1-007（1 次）；无空值。" .
:routeVersion a owl:DatatypeProperty ; rdfs:label "版本" ; rdfs:domain :Route ; :physicalColumn "version" ;
    :businessDescription "routes.version；取值 并线前 50 / 并线后 40；无空值。v1 50 条 / v2 40 条；2026-09-22 并线的分界在 trips.route_version 上，不在这一列。" .
:routeEffectiveFrom a owl:DatatypeProperty ; rdfs:label "生效日期" ; rdfs:domain :Route ; :physicalColumn "effective_from" ;
    :businessDescription "routes.effective_from；无空值。" .
:routePlannedStops a owl:DatatypeProperty ; rdfs:label "计划站数" ; rdfs:domain :Route ; :physicalColumn "planned_stops" ;
    :businessDescription "routes.planned_stops；取值 11 15 / 9 14 / 15 13 / 12 11 / 16 11 / 10 10 / 17 9 / 14 7；无空值。" .
:routePlannedKm a owl:DatatypeProperty ; rdfs:label "计划里程" ; rdfs:domain :Route ; :physicalColumn "planned_km" ;
    :businessDescription "routes.planned_km；范围 29.1–84.6，合计 5,234；无空值。" .
:routeZone a owl:DatatypeProperty ; rdfs:label "区域" ; rdfs:domain :Route ; :physicalColumn "zone" ;
    :businessDescription "routes.zone；取值 核心区 31 / 郊区 30 / 混合 29；无空值。" .
:routeDifficulty a owl:DatatypeProperty ; rdfs:label "难度分" ; rdfs:domain :Route ; :physicalColumn "difficulty" ;
    :businessDescription "routes.difficulty；范围 1–2.5，合计 155.8；无空值。" .

# ---------------------------------------------------------------- 计划站序（route_stops）

:routeStopRouteId a owl:ObjectProperty ; rdfs:label "线路" ; rdfs:domain :RouteStop ; :physicalColumn "route_id" ; :references :Route ;
    :businessDescription "route_stops.route_id；无空值。" .
:routeStopSeq a owl:DatatypeProperty ; rdfs:label "站序" ; rdfs:domain :RouteStop ; :physicalColumn "seq" ;
    :businessDescription "route_stops.seq；范围 1–17，合计 8,196；无空值。" .
:routeStopStoreId a owl:ObjectProperty ; rdfs:label "门店" ; rdfs:domain :RouteStop ; :physicalColumn "store_id" ; :references :Store ;
    :businessDescription "route_stops.store_id；无空值。" .

# ---------------------------------------------------------------- 门店（stores）

:storeId a owl:DatatypeProperty ; rdfs:label "主键" ; rdfs:domain :Store ; :physicalColumn "id" ;
    :businessDescription "stores.id；无空值。" .
:storeName a owl:DatatypeProperty ; rdfs:label "名称" ; rdfs:domain :Store ; :physicalColumn "name" ;
    :businessDescription "stores.name；765 个不同值，最常见 青禾普陀店-075（3 次）；无空值。765 个不同值 / 800 行：有同名门店，门店身份用 id。" .
:storeZone a owl:DatatypeProperty ; rdfs:label "区域" ; rdfs:domain :Store ; :physicalColumn "zone" ;
    :businessDescription "stores.zone；取值 核心区 533 / 郊区 267；无空值。" .
:storeDistrict a owl:DatatypeProperty ; rdfs:label "行政区" ; rdfs:domain :Store ; :physicalColumn "district" ;
    :businessDescription "stores.district；10 个不同值，最常见 黄浦（95 次）；无空值。" .
:storeWindowFrom a owl:DatatypeProperty ; rdfs:label "收货窗起" ; rdfs:domain :Store ; :physicalColumn "window_from" ;
    :businessDescription "stores.window_from；无空值。" .
:storeWindowTo a owl:DatatypeProperty ; rdfs:label "收货窗止" ; rdfs:domain :Store ; :physicalColumn "window_to" ;
    :businessDescription "stores.window_to；无空值。" .
:storeHasAlarm a owl:DatatypeProperty ; rdfs:label "门店是否带警铃" ; rdfs:domain :Store ; :physicalColumn "has_alarm" ;
    :businessDescription "stores.has_alarm；取值 是 445 / 否 355；无空值。" .

# ---------------------------------------------------------------- 行程（trips）

:tripId a owl:DatatypeProperty ; rdfs:label "主键" ; rdfs:domain :Trip ; :physicalColumn "id" ;
    :businessDescription "trips.id；无空值。" .
:tripTripDate a owl:DatatypeProperty ; rdfs:label "趟次日期" ; rdfs:domain :Trip ; :physicalColumn "trip_date" ;
    :businessDescription "trips.trip_date；无空值。" .
:tripRouteId a owl:ObjectProperty ; rdfs:label "线路" ; rdfs:domain :Trip ; :physicalColumn "route_id" ; :references :Route ;
    :businessDescription "trips.route_id；无空值。" .
:tripVehicleId a owl:ObjectProperty ; rdfs:label "车辆" ; rdfs:domain :Trip ; :physicalColumn "vehicle_id" ; :references :Vehicle ;
    :businessDescription "trips.vehicle_id；无空值。" .
:tripDriverId a owl:ObjectProperty ; rdfs:label "司机" ; rdfs:domain :Trip ; :physicalColumn "driver_id" ; :references :Driver ;
    :businessDescription "trips.driver_id；无空值。" .
:tripVehicleSource a owl:DatatypeProperty ; rdfs:label "运力来源" ; rdfs:domain :Trip ; :physicalColumn "vehicle_source" ;
    :businessDescription "trips.vehicle_source；取值 自有 3,703 / 外车 417；无空值。" .
:tripIsExternal a owl:DatatypeProperty ; rdfs:label "是否外车" ; rdfs:domain :Trip ; :physicalColumn "is_external" ;
    :businessDescription "trips.is_external；取值 否 3,703 / 是 417；无空值。" .
:tripIsPeakDay a owl:DatatypeProperty ; rdfs:label "是否峰日" ; rdfs:domain :Trip ; :physicalColumn "is_peak_day" ;
    :businessDescription "trips.is_peak_day；取值 否 2,970 / 是 1,150；无空值。" .
:tripPlannedStops a owl:DatatypeProperty ; rdfs:label "计划站数" ; rdfs:domain :Trip ; :physicalColumn "planned_stops" ;
    :businessDescription "trips.planned_stops；取值 11 780 / 9 728 / 12 572 / 10 520 / 15 494 / 16 418 / 17 342 / 14 266；无空值。" .
:tripActualStops a owl:DatatypeProperty ; rdfs:label "实际站数" ; rdfs:domain :Trip ; :physicalColumn "actual_stops" ;
    :businessDescription "trips.actual_stops；取值 11 780 / 9 728 / 12 572 / 10 520 / 15 494 / 16 418 / 17 342 / 14 266；无空值。与 planned_stops 逐趟相同（都合计 50,832）——计划站数在本库里没有落空过，所以「站点超标」判实际站数与判计划站数是同一个数。" .
:tripLoadBoxes a owl:DatatypeProperty ; rdfs:label "实载箱数" ; rdfs:domain :Trip ; :physicalColumn "load_boxes" ;
    :businessDescription "trips.load_boxes；范围 50–411，合计 691,610；无空值。" .
:tripLoadVolume a owl:DatatypeProperty ; rdfs:label "实载体积" ; rdfs:domain :Trip ; :physicalColumn "load_volume" ;
    :businessDescription "trips.load_volume；范围 6.5–50.9，合计 84,132.1；无空值。" .
:tripLoadWeight a owl:DatatypeProperty ; rdfs:label "实载重量" ; rdfs:domain :Trip ; :physicalColumn "load_weight" ;
    :businessDescription "trips.load_weight；范围 1,947–15,345，合计 25,790,127；无空值。实载重量（公斤），合计 25,790,127；与 weight_capacity_snapshot 比大小才是重量口径超载。" .
:tripBoxCapacitySnapshot a owl:DatatypeProperty ; rdfs:label "额定箱数快照" ; rdfs:domain :Trip ; :physicalColumn "box_capacity_snapshot" ;
    :businessDescription "trips.box_capacity_snapshot；范围 74–313，合计 763,885；无空值。" .
:tripVolumeCapacitySnapshot a owl:DatatypeProperty ; rdfs:label "额定体积快照" ; rdfs:domain :Trip ; :physicalColumn "volume_capacity_snapshot" ;
    :businessDescription "trips.volume_capacity_snapshot；范围 9.3–37.2，合计 90,879.6；无空值。" .
:tripWeightCapacitySnapshot a owl:DatatypeProperty ; rdfs:label "额定载重快照" ; rdfs:domain :Trip ; :physicalColumn "weight_capacity_snapshot" ;
    :businessDescription "trips.weight_capacity_snapshot；范围 3,000–12,000，合计 29,316,000；无空值。" .
:tripRevenue a owl:DatatypeProperty ; rdfs:label "运费收入" ; rdfs:domain :Trip ; :physicalColumn "revenue" ;
    :businessDescription "trips.revenue；范围 833.77–1,458.52，合计 4,423,204.39；无空值。运费合计 4,423,204.39 元，可加。" .
:tripExternalCost a owl:DatatypeProperty ; rdfs:label "外车结算成本" ; rdfs:domain :Trip ; :physicalColumn "external_cost" ;
    :businessDescription "trips.external_cost；范围 1,068.63–2,173.52，合计 625,958.91；空值 3,703（89.88%）。" .
:tripStatus a owl:DatatypeProperty ; rdfs:label "状态" ; rdfs:domain :Trip ; :physicalColumn "status" ;
    :businessDescription "trips.status；取值 已完成 4,120；无空值。" .
:tripCostTotal a owl:DatatypeProperty ; rdfs:label "已知成本合计" ; rdfs:domain :Trip ; :physicalColumn "cost_total" ;
    :businessDescription "trips.cost_total；范围 241.2–2,173.52，合计 2,144,972.86；无空值。油费+路桥+司机运费+搬运+外付，合计 2,144,972.86。不含固定成本与维修，所以是下界。" .
:tripLateStopCount a owl:DatatypeProperty ; rdfs:label "迟到站数" ; rdfs:domain :Trip ; :physicalColumn "late_stop_count" ;
    :businessDescription "trips.late_stop_count；取值 0 2,221 / 1 1,276 / 2 452 / 3 121 / 4 47 / 5 2 / 6 1；无空值。" .
:tripActualDurationMin a owl:DatatypeProperty ; rdfs:label "实际耗时" ; rdfs:domain :Trip ; :physicalColumn "actual_duration_min" ;
    :businessDescription "trips.actual_duration_min；范围 96–276，合计 734,715；无空值。" .
:tripRouteVersion a owl:DatatypeProperty ; rdfs:label "线路版本" ; rdfs:domain :Trip ; :physicalColumn "route_version" ;
    :businessDescription "trips.route_version；取值 并线前 2,600 / 并线后 1,520；无空值。" .
:tripActualKm a owl:DatatypeProperty ; rdfs:label "实际里程" ; rdfs:domain :Trip ; :physicalColumn "actual_km" ;
    :businessDescription "trips.actual_km；范围 29.1–97.3，合计 257,872.3；无空值。" .
:tripFuelLiters a owl:DatatypeProperty ; rdfs:label "油耗" ; rdfs:domain :Trip ; :physicalColumn "fuel_liters" ;
    :businessDescription "trips.fuel_liters；范围 2.5–21.2，合计 32,378.1；无空值。" .
:tripMaintenanceCost a owl:DatatypeProperty ; rdfs:label "维修成本" ; rdfs:domain :Trip ; :physicalColumn "maintenance_cost" ;
    :businessDescription "trips.maintenance_cost；范围 5.96–404.18，合计 443,109.53；空值 65（1.58%）。维修成本按趟分摊，65 趟为空（1.58%），合计 443,109.53，与 maintenance_orders.cost 合计相同。" .
:tripStopsDelivered a owl:DatatypeProperty ; rdfs:label "已送站数" ; rdfs:domain :Trip ; :physicalColumn "stops_delivered" ;
    :businessDescription "trips.stops_delivered；范围 7–17，合计 49,927；无空值。" .
:tripWeighbridgeWeight a owl:DatatypeProperty ; rdfs:label "地磅重量" ; rdfs:domain :Trip ; :physicalColumn "weighbridge_weight" ;
    :businessDescription "trips.weighbridge_weight；空值 639（15.51%）。地磅重量，639 趟为空（15.51%）；有值的趟里超过额定载重的为 0 趟，与重量口径的 1,215 趟矛盾——两个口径不许互相替代。" .
:tripFixedCost a owl:DatatypeProperty ; rdfs:label "固定成本分摊" ; rdfs:domain :Trip ; :physicalColumn "fixed_cost" ;
    :businessDescription "trips.fixed_cost；范围 168.61–3,486.68，合计 3,014,690.83；无空值。固定成本按趟分摊的快照，合计 3,014,690.83；费用本体在 vehicle_fixed_costs（3,014,690.57），差 0.26 元是舍入。" .
:tripAxleOverload a owl:DatatypeProperty ; rdfs:label "轴荷是否超限" ; rdfs:domain :Trip ; :physicalColumn "axle_overload" ;
    :businessDescription "trips.axle_overload；取值 否 2,488 / 是 1,632；无空值。轴荷超限是派车时的判定快照（1,632 趟 true）。它是布尔，不是逐轴重量；逐轴实载重量本库没有。" .
:tripCoreRestricted a owl:DatatypeProperty ; rdfs:label "是否落在核心区限行日" ; rdfs:domain :Trip ; :physicalColumn "core_restricted" ;
    :businessDescription "trips.core_restricted；取值 否 2,270 / 是 1,850；无空值。「这趟落在该线路所属区域当天限行」的判定快照，1,850 趟。与 restriction_calendar 联读可核对。" .
:tripPermitValid a owl:DatatypeProperty ; rdfs:label "通行证是否有效" ; rdfs:domain :Trip ; :physicalColumn "permit_valid" ;
    :businessDescription "trips.permit_valid；取值 否 3,226 / 是 894；无空值。通行证在当天是否有效，3,226 趟 false。它是核心区无证通行率的分母口径来源。" .

# ---------------------------------------------------------------- 站点执行（stops）

:stopId a owl:DatatypeProperty ; rdfs:label "主键" ; rdfs:domain :Stop ; :physicalColumn "id" ;
    :businessDescription "stops.id；无空值。" .
:stopTripId a owl:ObjectProperty ; rdfs:label "所属趟次" ; rdfs:domain :Stop ; :physicalColumn "trip_id" ; :references :Trip ;
    :businessDescription "stops.trip_id；无空值。" .
:stopSeq a owl:DatatypeProperty ; rdfs:label "站序" ; rdfs:domain :Stop ; :physicalColumn "seq" ;
    :businessDescription "stops.seq；范围 1–17，合计 353,840；无空值。" .
:stopStoreId a owl:ObjectProperty ; rdfs:label "门店" ; rdfs:domain :Stop ; :physicalColumn "store_id" ; :references :Store ;
    :businessDescription "stops.store_id；无空值。" .
:stopOnTime a owl:DatatypeProperty ; rdfs:label "是否准时" ; rdfs:domain :Stop ; :physicalColumn "on_time" ;
    :businessDescription "stops.on_time；取值 是 48,085 / 否 2,747；无空值。48,085 准时 / 2,747 迟到（5.40%）。判定用的是 ±5 分钟窗口（口径字典 OTA），本库只存布尔结果。" .
:stopTempExcursion a owl:DatatypeProperty ; rdfs:label "是否温度越界" ; rdfs:domain :Stop ; :physicalColumn "temp_excursion" ;
    :businessDescription "stops.temp_excursion；取值 否 49,684 / 是 1,148；无空值。" .
:stopDamagedBoxes a owl:DatatypeProperty ; rdfs:label "破损箱数" ; rdfs:domain :Stop ; :physicalColumn "damaged_boxes" ;
    :businessDescription "stops.damaged_boxes；取值 0 45,063 / 1 4,188 / 3 794 / 2 787；无空值。" .
:stopAlarmTriggered a owl:DatatypeProperty ; rdfs:label "是否触发警铃" ; rdfs:domain :Stop ; :physicalColumn "alarm_triggered" ;
    :businessDescription "stops.alarm_triggered；取值 否 49,853 / 是 979；无空值。" .
:stopBasketsMissing a owl:DatatypeProperty ; rdfs:label "缺筐数" ; rdfs:domain :Stop ; :physicalColumn "baskets_missing" ;
    :businessDescription "stops.baskets_missing；取值 0 33,773 / 2 8,565 / 1 8,494；无空值。" .
:stopHandlerId a owl:ObjectProperty ; rdfs:label "搬运工" ; rdfs:domain :Stop ; :physicalColumn "handler_id" ; :references :Handler ;
    :businessDescription "stops.handler_id；空值 14,133（27.80%）。14,133 站没有搬运工（27.80%）——「没派搬运工」是状态，不是数据缺失，工时/人效指标要把它单列。" .
:stopHandlerDaysWorked a owl:DatatypeProperty ; rdfs:label "搬运工在岗天数" ; rdfs:domain :Stop ; :physicalColumn "handler_days_worked" ;
    :businessDescription "stops.handler_days_worked；取值 None 14,133 / 3 7,144 / 1 6,712 / 2 6,310 / 21 5,996 / 5 5,340 / 9 5,197；空值 14,133（27.80%）。搬运工上岗天数，14,133 站为空（无搬运工）。它与 handlers.days_worked 是同一个数，破损集中在头几天。" .
:stopHandlerCooperated a owl:DatatypeProperty ; rdfs:label "搬运工是否配合" ; rdfs:domain :Stop ; :physicalColumn "handler_cooperated" ;
    :businessDescription "stops.handler_cooperated；取值 是 31,504 / None 14,133 / 否 5,195；空值 14,133（27.80%）。" .
:stopServiceStatus a owl:DatatypeProperty ; rdfs:label "服务结果" ; rdfs:domain :Stop ; :physicalColumn "service_status" ;
    :businessDescription "stops.service_status；取值 已送达 49,927 / 拒收 412 / 门店未营业 274 / 未送达 219；无空值。delivered 49,927 / refused 412 / closed_store 274 / not_delivered 219。准时率的分母要不要剔 refused 会影响 0.2 个点，所以分母写死为全部站次。" .

# ---------------------------------------------------------------- 趟次成本（trip_costs）

:tripCostTripId a owl:ObjectProperty ; rdfs:label "所属趟次" ; rdfs:domain :TripCost ; :physicalColumn "trip_id" ; :references :Trip ;
    :businessDescription "trip_costs.trip_id；无空值。" .
:tripCostSourceType a owl:DatatypeProperty ; rdfs:label "成本来源类型" ; rdfs:domain :TripCost ; :physicalColumn "source_type" ;
    :businessDescription "trip_costs.source_type；取值 自有 3,703 / 外车 417；无空值。" .
:tripCostFuelCost a owl:DatatypeProperty ; rdfs:label "油费" ; rdfs:domain :TripCost ; :physicalColumn "fuel_cost" ;
    :businessDescription "trip_costs.fuel_cost；范围 0–172.82，合计 372,009.39；无空值。" .
:tripCostTollCost a owl:DatatypeProperty ; rdfs:label "路桥费" ; rdfs:domain :TripCost ; :physicalColumn "toll_cost" ;
    :businessDescription "trip_costs.toll_cost；范围 0–43，合计 100,700.56；无空值。" .
:tripCostDriverPay a owl:DatatypeProperty ; rdfs:label "司机运费" ; rdfs:domain :TripCost ; :physicalColumn "driver_pay" ;
    :businessDescription "trip_costs.driver_pay；范围 0–227，合计 649,560；无空值。" .
:tripCostHandlerCost a owl:DatatypeProperty ; rdfs:label "搬运工成本" ; rdfs:domain :TripCost ; :physicalColumn "handler_cost" ;
    :businessDescription "trip_costs.handler_cost；范围 0–204，合计 396,744；无空值。" .
:tripCostExternalFee a owl:DatatypeProperty ; rdfs:label "外付运费" ; rdfs:domain :TripCost ; :physicalColumn "external_fee" ;
    :businessDescription "trip_costs.external_fee；范围 0–2,173.52，合计 625,958.91；无空值。" .
:tripCostOtherCost a owl:DatatypeProperty ; rdfs:label "其他成本" ; rdfs:domain :TripCost ; :physicalColumn "other_cost" ;
    :businessDescription "trip_costs.other_cost；空值 4,120（100.00%）。4,120 行全部为空。缺这一列不是「其他成本为 0」，所以成本是下界、毛利是上界。" .
:tripCostCurrency a owl:DatatypeProperty ; rdfs:label "币种" ; rdfs:domain :TripCost ; :physicalColumn "currency" ;
    :businessDescription "trip_costs.currency；取值 人民币 4,120；无空值。" .
:tripCostAsOf a owl:DatatypeProperty ; rdfs:label "导出日期" ; rdfs:domain :TripCost ; :physicalColumn "as_of" ;
    :businessDescription "trip_costs.as_of；无空值。" .

# ---------------------------------------------------------------- 日历日（calendar）

:calendarDayDay a owl:DatatypeProperty ; rdfs:label "日期" ; rdfs:domain :CalendarDay ; :physicalColumn "day" ;
    :businessDescription "calendar.day；无空值。" .
:calendarDayWeekday a owl:DatatypeProperty ; rdfs:label "星期序号" ; rdfs:domain :CalendarDay ; :physicalColumn "weekday" ;
    :businessDescription "calendar.weekday；取值 2 13 / 3 13 / 6 13 / 1 13 / 5 13 / 0 13 / 4 12；无空值。" .
:calendarDayIsPeak a owl:DatatypeProperty ; rdfs:label "是否峰日" ; rdfs:domain :CalendarDay ; :physicalColumn "is_peak" ;
    :businessDescription "calendar.is_peak；取值 否 65 / 是 25；无空值。" .

# ---------------------------------------------------------------- 客诉（complaints）

:complaintId a owl:DatatypeProperty ; rdfs:label "主键" ; rdfs:domain :Complaint ; :physicalColumn "id" ;
    :businessDescription "complaints.id；无空值。" .
:complaintStopId a owl:ObjectProperty ; rdfs:label "所属站点" ; rdfs:domain :Complaint ; :physicalColumn "stop_id" ; :references :Stop ;
    :businessDescription "complaints.stop_id；无空值。" .
:complaintOpenedAt a owl:DatatypeProperty ; rdfs:label "开单时间" ; rdfs:domain :Complaint ; :physicalColumn "opened_at" ;
    :businessDescription "complaints.opened_at；无空值。" .
:complaintLiability a owl:DatatypeProperty ; rdfs:label "责任方" ; rdfs:domain :Complaint ; :physicalColumn "liability" ;
    :businessDescription "complaints.liability；取值 None 731 / 司机 429 / 搬运工 425；空值 731（46.12%）。731 件为空 = 责任未判定，不是「无责任」。与 amount 同空，所以金额合计只能对已判定的 854 件说。" .
:complaintAmount a owl:DatatypeProperty ; rdfs:label "金额" ; rdfs:domain :Complaint ; :physicalColumn "amount" ;
    :businessDescription "complaints.amount；范围 80.13–1,199.92，合计 543,309.02；空值 731（46.12%）。已判定区间 80.13–1,199.92 元，合计 543,309.02；731 件为空，不许当 0。" .
:complaintClosedAt a owl:DatatypeProperty ; rdfs:label "闭环时间" ; rdfs:domain :Complaint ; :physicalColumn "closed_at" ;
    :businessDescription "complaints.closed_at；空值 1,585（100.00%）。1,585 行全部为空：没有闭环时间，所以客诉处理时长按名拒绝。" .
:complaintKind a owl:DatatypeProperty ; rdfs:label "客诉类型" ; rdfs:domain :Complaint ; :physicalColumn "kind" ;
    :businessDescription "complaints.kind；取值 迟到 485 / None 406 / 货损 309 / 少送/错送 229 / 态度 156；空值 406（25.62%）。迟到 485 / 货损 309 / 少送错送 229 / 态度 156 / 未分类 406。未分类不许并进任何一类。" .

# ---------------------------------------------------------------- 拒单（refusals）

:refusalId a owl:DatatypeProperty ; rdfs:label "主键" ; rdfs:domain :Refusal ; :physicalColumn "id" ;
    :businessDescription "refusals.id；无空值。" .
:refusalRefusedDate a owl:DatatypeProperty ; rdfs:label "refused_date" ; rdfs:domain :Refusal ; :physicalColumn "refused_date" ;
    :businessDescription "refusals.refused_date；无空值。" .
:refusalRouteId a owl:ObjectProperty ; rdfs:label "线路" ; rdfs:domain :Refusal ; :physicalColumn "route_id" ; :references :Route ;
    :businessDescription "refusals.route_id；无空值。" .
:refusalDriverId a owl:ObjectProperty ; rdfs:label "司机" ; rdfs:domain :Refusal ; :physicalColumn "driver_id" ; :references :Driver ;
    :businessDescription "refusals.driver_id；无空值。" .
:refusalReason a owl:DatatypeProperty ; rdfs:label "原因" ; rdfs:domain :Refusal ; :physicalColumn "reason" ;
    :businessDescription "refusals.reason；取值 None 113 / 站点太多 89 / 超载风险 80 / 排放限制 34 / 车辆不适配 31 / 私事 26 / 太远 16；空值 113（29.05%）。" .
:refusalAssigned a owl:DatatypeProperty ; rdfs:label "assigned" ; rdfs:domain :Refusal ; :physicalColumn "assigned" ;
    :businessDescription "refusals.assigned；取值 否 245 / 是 144；无空值。" .

