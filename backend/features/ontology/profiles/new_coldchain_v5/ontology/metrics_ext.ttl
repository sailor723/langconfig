# ABC 冷链配送运营本体 v5 —— 计算层（只放计算，不放含义）
# 含义（label / unit / additivity / formula / 口径来源）在 02-meaning.ttl；这里只写编译器要执行的：
# :aggregate（count|sum|ratio_of_sums）、:grain（颗粒度）、:universe（分母/母集）、:where（定义类过滤）、
# :groupBy（已声明属性）、:numerator/:denominator（比率的分子分母，另一个已声明指标）、:scale（千分/万分）。
# 比率一律 ratio_of_sums：先各自聚合再相除，不平均平均。跨颗粒比率（分子分母颗粒不同）由编译器各按自己的颗粒聚合。


@prefix : <https://cube.local/ontology/new_coldchain_v5#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------- 指标的计算

# 声明顺序 = 菜单顺序。tripCount 排第一是为了让「大表扫描被报告而不是被静默改写」这件事在
# 第一个指标上就能被看见：趟次数扫的是 trips（guard.big_tables 里真实的时间列 trip_date），
# 它的定义本身不带时间过滤，于是护栏在 declared 模式下必须报一句
# "unbounded scan on trips — the definition has no trip_date filter"，而不是偷偷加窗口。
# 站点级指标（stopCount）扫的是 stops：50,832 行、没有自己的时间列（日期隔一层 trip_id），
# 它只在计划预算里算大表，护栏对它只会加 page cap——所以它不能当这个代表指标。
:tripCount :aggregate "count" ; :grain :Trip ; :universe :Trip ;
    :askedAs "一共多少趟" .

:stopCount :aggregate "count" ; :grain :Stop ; :universe :Stop ;
    :askedAs "一共送了多少站" .

:onTimeStopCount :aggregate "count" ; :grain :Stop ; :universe :Stop ;
    :where :OnTimeStop ;
    :askedAs "按时到店多少站" .

:lateStopCount :aggregate "count" ; :grain :Stop ; :universe :Stop ;
    :where :LateStop ;
    :askedAs "迟到多少站" .

:stopOnTimeRate :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :onTimeStopCount ; :denominator :stopCount ;
    :askedAs "准时率是多少" .

:fullyOnTimeTripCount :aggregate "count" ; :grain :Trip ; :universe :Trip ;
    :where :FullyOnTimeTrip ;
    :askedAs "整趟没迟到的有多少趟" .

:tripFullyOnTimeRate :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :fullyOnTimeTripCount ; :denominator :tripCount ;
    :askedAs "整趟准时的比例" .

:damagedStopCount :aggregate "count" ; :grain :Stop ; :universe :Stop ;
    :where :DamagedStop ;
    :askedAs "破损多少站" .

:damagedStopRate :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :damagedStopCount ; :denominator :stopCount ;
    :askedAs "破损率多少" .

:tempExcursionStopCount :aggregate "count" ; :grain :Stop ; :universe :Stop ;
    :where :TempExcursionStop ;
    :askedAs "温度越界多少站" .

:tempExcursionStopRate :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :tempExcursionStopCount ; :denominator :stopCount ;
    :askedAs "温度越界率" .

:deliveredStopCount :aggregate "count" ; :grain :Stop ; :universe :Stop ;
    :where :DeliveredStop ;
    :askedAs "送了多少站" .

:overloadedTripWeightCount :aggregate "count" ; :grain :Trip ; :universe :Trip ;
    :where :OverloadedTrip ;
    :askedAs "超载多少趟" .

:overloadedTripRateWeight :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :overloadedTripWeightCount ; :denominator :tripCount ;
    :askedAs "装载口径超载率" .

:overloadedTripRateWeightByVersion :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :overloadedTripWeightCount ; :denominator :tripCount ;
    :groupBy :tripRouteVersion ;
    :askedAs "并线前后超载率" .

:axleOverloadTripCount :aggregate "count" ; :grain :Trip ; :universe :Trip ;
    :where :AxleOverloadTrip ;
    :askedAs "轴荷超限多少趟" .

:axleOverloadRate :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :axleOverloadTripCount ; :denominator :tripCount ;
    :askedAs "轴荷超限率" .

:axleOverloadRateByVersion :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :axleOverloadTripCount ; :denominator :tripCount ;
    :groupBy :tripRouteVersion ;
    :askedAs "并线前后轴荷超限率" .

:overStationTripCount :aggregate "count" ; :grain :Trip ; :universe :Trip ;
    :where :OverStationTrip ;
    :askedAs "超过15站的趟次" .

:overStationTripRate :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :overStationTripCount ; :denominator :tripCount ;
    :askedAs "站点超标率" .

:sumActualStops :aggregate "sum" ; :grain :Trip ; :universe :Trip ;
    :askedAs "一共多少个站次" .

:stopsPerTrip :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :sumActualStops ; :denominator :tripCount ;
    :askedAs "平均每趟几站" .

:routeCompletionRate :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :deliveredStopCount ; :denominator :stopCount ;
    :askedAs "线路完成率" .

:scheduledDriverDayCount :aggregate "count" ; :grain :DriverSchedule ; :universe :DriverSchedule ;
    :where :ScheduledDriverDay ;
    :askedAs "排了多少人天" .

:attendedDriverDayCount :aggregate "count" ; :grain :DriverSchedule ; :universe :DriverSchedule ;
    :where :AttendedDriverDay ;
    :askedAs "出勤多少人天" .

:attendanceRate :aggregate "ratio_of_sums" ; :grain :DriverSchedule ; :universe :DriverSchedule ;
    :numerator :attendedDriverDayCount ; :denominator :scheduledDriverDayCount ;
    :askedAs "出勤率多少" .

:complaintCount :aggregate "count" ; :grain :Complaint ; :universe :Complaint ;
    :askedAs "客诉多少件" .

:complaintAmountSum :aggregate "sum" ; :grain :Complaint ; :universe :Complaint ;
    :where :JudgedComplaint ;
    :askedAs "赔付金额合计" .

:complaintPerTrip :aggregate "ratio_of_sums" ; :grain :Complaint ; :universe :Complaint ;
    :numerator :complaintCount ; :denominator :tripCount ;
    :askedAs "每趟多少客诉" .

:totalKm :aggregate "sum" ; :grain :Trip ; :universe :Trip ;
    :askedAs "总里程多少" .

:fuelLitersSum :aggregate "sum" ; :grain :Trip ; :universe :Trip ;
    :askedAs "油耗多少升" .

:fuelPer100km :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :fuelLitersSum ; :denominator :totalKm ;
    :scale "100.0" ;
    :askedAs "百公里油耗" .

:operatingCostSum :aggregate "sum" ; :grain :Trip ; :universe :Trip ;
    :askedAs "运营成本多少" .

:operatingCostPerKm :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :operatingCostSum ; :denominator :totalKm ;
    :askedAs "运营成本每公里多少" .

:maintenanceCostSum :aggregate "sum" ; :grain :Trip ; :universe :Trip ;
    :askedAs "维修成本多少" .

:fullCostSum :aggregate "sum" ; :grain :Trip ; :universe :Trip ;
    :askedAs "全成本合计" .

:fullCostPerKm :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :fullCostSum ; :denominator :totalKm ;
    :askedAs "全成本每公里多少" .

:violationCount :aggregate "count" ; :grain :Violation ; :universe :Violation ;
    :askedAs "违章多少起" .

:violationRatePer10kKm :aggregate "ratio_of_sums" ; :grain :Violation ; :universe :Violation ;
    :numerator :violationCount ; :denominator :totalKm ;
    :scale "10000.0" ;
    :askedAs "每万公里违章几起" .

:violationTypeMix :aggregate "count" ; :grain :Violation ; :universe :Violation ;
    :groupBy :violationCategory ;
    :askedAs "违章类型构成" .

:coreZoneTripCount :aggregate "count" ; :grain :Trip ; :universe :Trip ;
    :where :CoreRestrictedTrip ;
    :askedAs "进核心区多少趟" .

:coreZoneNoPermitTripCount :aggregate "count" ; :grain :Trip ; :universe :Trip ;
    :where :CoreNoPermitTrip ;
    :askedAs "无证进核心区多少趟" .

:coreZoneNoPermitTripRate :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :coreZoneNoPermitTripCount ; :denominator :coreZoneTripCount ;
    :askedAs "核心区无证占比" .

:incidentTicketCount :aggregate "count" ; :grain :IncidentTicket ; :universe :IncidentTicket ;
    :askedAs "异常工单多少张" .

:nonForceMajeureTicketCount :aggregate "count" ; :grain :IncidentTicket ; :universe :IncidentTicket ;
    :where :NonForceMajeureTicket ;
    :askedAs "剔除不可抗力后多少工单" .

:anomalyTripRate :aggregate "ratio_of_sums" ; :grain :IncidentTicket ; :universe :IncidentTicket ;
    :numerator :nonForceMajeureTicketCount ; :denominator :tripCount ;
    :askedAs "配送异常率" .

:anomalyTypeMix :aggregate "count" ; :grain :IncidentTicket ; :universe :IncidentTicket ;
    :groupBy :incidentTicketType ;
    :askedAs "异常类型构成" .

:lateStopShare :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :lateStopCount ; :denominator :stopCount ;
    :askedAs "迟到站次占比" .

:stopOnTimeRateByVersion :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :onTimeStopCount ; :denominator :stopCount ;
    :groupBy :tripRouteVersion ;
    :askedAs "并线前后站点准时率" .

:tripOnTimeRateByWeek :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :fullyOnTimeTripCount ; :denominator :tripCount ;
    :timeBucket "week" ;
    :askedAs "整趟准时率按周怎么走" .

:lateStopCountByWeek :aggregate "sum" ; :grain :Trip ; :universe :Trip ;
    :timeBucket "week" ;
    :askedAs "每周迟到站次多少" .

:anomalyRateAll :aggregate "ratio_of_sums" ; :grain :IncidentTicket ; :universe :IncidentTicket ;
    :numerator :incidentTicketCount ; :denominator :tripCount ;
    :askedAs "全部异常工单率" .

:attendanceRateByWeek :aggregate "ratio_of_sums" ; :grain :DriverSchedule ; :universe :DriverSchedule ;
    :numerator :attendedDriverDayCount ; :denominator :scheduledDriverDayCount ;
    :timeBucket "week" ;
    :askedAs "出勤率按周怎么走" .

:forbiddenZoneViolationCount :aggregate "count" ; :grain :Violation ; :universe :Violation ;
    :where :ForbiddenZoneViolation ;
    :askedAs "闯禁行多少起" .

:forbiddenZoneViolationRatePer10kKm :aggregate "ratio_of_sums" ; :grain :Violation ; :universe :Violation ;
    :numerator :forbiddenZoneViolationCount ; :denominator :totalKm ;
    :scale "10000.0" ;
    :askedAs "闯禁行每万公里几起" .

:violationFineSum :aggregate "sum" ; :grain :Violation ; :universe :Violation ;
    :askedAs "违章罚款多少钱" .

:violationPointsSum :aggregate "sum" ; :grain :Violation ; :universe :Violation ;
    :askedAs "违章扣了多少分" .

:fixedCostSum :aggregate "sum" ; :grain :Trip ; :universe :Trip ;
    :askedAs "固定成本摊分多少" .

:maintenanceCostPer1000km :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :maintenanceCostSum ; :denominator :totalKm ;
    :scale "1000.0" ;
    :askedAs "维修每千公里多少钱" .

:maintenanceDowntimeHours :aggregate "sum" ; :grain :MaintenanceOrder ; :universe :MaintenanceOrder ;
    :askedAs "维修停机多少小时" .


# ---------------------------------------------------------------- 槽位（SLOT）：问题可以施加的约束
# :supportsSlot 声明「这个指标能接受哪种约束」；没有声明 = 按名拒绝，而不是悄悄忽略。
# 规则（rules #16）：时间窗口过滤的是**对象自己的** :timeColumn（在 01-structure 每个类上声明过）；
# 只有颗粒有自己的时间列、且指标是 count/sum 时才声明——比率（ratio_of_sums）不接受窗口，
# 因为窗口必须同时进两个子查询，没实现就不答半窗口的数。

:isSlot a owl:AnnotationProperty .
:supportsSlot a owl:AnnotationProperty .

:TimeWindow a owl:Class ;
    rdfs:label "时间窗口" ;
    :isSlot "true" ;
    :businessDescription "问题里说出的时间约束（如「9 月」「2026-09-01 之后」），过滤该颗粒自己的 :timeColumn。只声明在有自己的时间列、且不是比率的指标上。口径来自 refused: 时间窗口在 v5 之前完全没有声明。" .

# trips.trip_date（Trip 颗粒）

:tripCount :supportsSlot :TimeWindow .
:fullyOnTimeTripCount :supportsSlot :TimeWindow .
:overloadedTripWeightCount :supportsSlot :TimeWindow .
:axleOverloadTripCount :supportsSlot :TimeWindow .
:overStationTripCount :supportsSlot :TimeWindow .
:sumActualStops :supportsSlot :TimeWindow .
:totalKm :supportsSlot :TimeWindow .
:fuelLitersSum :supportsSlot :TimeWindow .
:operatingCostSum :supportsSlot :TimeWindow .
:maintenanceCostSum :supportsSlot :TimeWindow .
:fullCostSum :supportsSlot :TimeWindow .
:coreZoneTripCount :supportsSlot :TimeWindow .
:coreZoneNoPermitTripCount :supportsSlot :TimeWindow .

# violations.occurred_at（Violation 颗粒）

:violationCount :supportsSlot :TimeWindow .
:forbiddenZoneViolationCount :supportsSlot :TimeWindow .
:violationFineSum :supportsSlot :TimeWindow .
:violationPointsSum :supportsSlot :TimeWindow .

# complaints.opened_at（Complaint 颗粒）

:complaintCount :supportsSlot :TimeWindow .
:complaintAmountSum :supportsSlot :TimeWindow .

# incident_tickets.raised_at（IncidentTicket 颗粒）

:incidentTicketCount :supportsSlot :TimeWindow .
:nonForceMajeureTicketCount :supportsSlot :TimeWindow .

# driver_schedule.day（DriverSchedule 颗粒）

:scheduledDriverDayCount :supportsSlot :TimeWindow .
:attendedDriverDayCount :supportsSlot :TimeWindow .

# maintenance_orders.opened_at（MaintenanceOrder 颗粒）

:maintenanceDowntimeHours :supportsSlot :TimeWindow .

# ---------------------------------------------------------------- 并线前后（trips 口径）
:tripOnTimeRateByVersion :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :fullyOnTimeTripCount ; :denominator :tripCount ;
    :groupBy :tripRouteVersion ;
    :askedAs "整趟准时率按线路版本" .
