{
  "_doc": "R2 的第二条路线：每个定义类配一条手写的列级谓词（不抄编译出来的那一条）。闸门比 'SELECT count(*) FROM <table> WHERE <pred>' 与 '… WHERE <compiled concept_sql>'，两边行数必须相等；不等就是声明与数据对不上。布尔列直接写列名，不用 = 'true'，故意换一种写法。",
  "_definitions": {
    "OnTimeStop": ["stops", "on_time"],
    "LateStop": ["stops", "NOT on_time"],
    "DamagedStop": ["stops", "damaged_boxes > 0"],
    "TempExcursionStop": ["stops", "temp_excursion"],
    "AlarmStop": ["stops", "alarm_triggered"],
    "FailedStop": ["stops", "damaged_boxes > 0 OR temp_excursion"],
    "OverloadedTripWeight": ["trips", "load_weight - weight_capacity_snapshot > 0"],
    "ExternalTrip": ["trips", "is_external"],
    "OwnTrip": ["trips", "NOT is_external"],
    "PeakDayTrip": ["trips", "is_peak_day"],
    "RouteV1Trip": ["trips", "route_version = 'v1'"],
    "RouteV2Trip": ["trips", "route_version = 'v2'"],
    "JudgedComplaint": ["complaints", "liability IS NOT NULL"],
    "UnjudgedComplaint": ["complaints", "liability IS NULL"],
    "AdoptedDecision": ["dispatch_decisions", "adopted"]
  }
}
