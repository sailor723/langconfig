@prefix : <https://cube.local/ontology/new_coldchain_v6#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:tripCount a owl:DatatypeProperty ; rdfs:label "趟次" ; :askedAs "趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :unit "count" ;
    :businessDescription "Trip 粒度的一行一趟。口径来自 answers:Q6（外车占比的分母是全部趟次）。" .

:tripRevenue a owl:DatatypeProperty ; rdfs:label "收入（运费）" ; :askedAs "收入（运费）" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "revenue" ; :grain :Trip ; :universe :Trip ; :unit "RMB" ;
    :businessDescription "运费收入合计，RMB。口径来自 answers:Q1。" .

:tripCostTotal a owl:DatatypeProperty ; rdfs:label "已知成本合计" ; :askedAs "已知成本合计" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "cost_total" ; :grain :Trip ; :universe :Trip ; :unit "RMB" ;
    :businessDescription "燃油+路桥+司机运费+装卸分摊+外车结算价；其它成本桶未知，所以这是下限。口径来自 answers:Q1。" .

:grossMargin a owl:DatatypeProperty ; rdfs:label "毛利" ; :askedAs "毛利" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "revenue - cost_total" ; :grain :Trip ; :universe :Trip ; :unit "RMB" ;
    :businessDescription "收入 − 已知成本。因为其它成本桶为 NULL，毛利是上限而非终值。口径来自 answers:Q1。" .

:grossMarginRate a owl:DatatypeProperty ; rdfs:label "毛利率" ; :askedAs "毛利率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :grossMargin ; :denominator :tripRevenue ; :unit "ratio" ;
    :businessDescription "分子分母都是 Trip 粒度上同口径的量。口径来自 answers:Q1。" .

:overloadedTrips a owl:DatatypeProperty ; rdfs:label "超载趟次" ; :askedAs "超载趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :OverloadedTrip ; :unit "count" ;
    :businessDescription "重量口径超载的趟次。口径来自 answers:Q5。" .

:overloadRate a owl:DatatypeProperty ; rdfs:label "超载率" ; :askedAs "超载率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :overloadedTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "重量口径。口径来自 answers:Q5。" .

:overloadRateByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看超载率" ; :askedAs "按线路版本看超载率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :overloadedTrips ; :denominator :tripCount ; :groupBy :tripRouteVersion ; :unit "ratio" ;
    :businessDescription "同一条超载率，按并线前后切开：v1 2.65% / v2 75.39%（本库实测）。并线把两条线路的站并到一条上，装载没跟上，这是最尖锐的那个变化。口径来自 answers:Q2。" .

:externalTrips a owl:DatatypeProperty ; rdfs:label "外车趟次" ; :askedAs "外车趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :ExternalTrip ; :unit "count" ;
    :businessDescription "司机不接单时外部车队补位的趟次。口径来自 answers:Q6。" .

:externalShare a owl:DatatypeProperty ; rdfs:label "外车占比" ; :askedAs "外车占比" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :externalTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "分母是全部趟次。按高峰/平日分组见 :externalShareByPeak。口径来自 answers:Q6。" .

:externalShareByPeak a owl:DatatypeProperty ; rdfs:label "按高峰/平日看外车占比" ; :askedAs "按高峰/平日看外车占比" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :externalTrips ; :denominator :tripCount ; :groupBy :tripIsPeakDay ; :unit "ratio" ;
    :businessDescription "同一条比率，按高峰日切开：平日 <10%、高峰 15–20% 是业务给的期望。口径来自 answers:Q6。" .

:peakDayTrips a owl:DatatypeProperty ; rdfs:label "高峰日趟次" ; :askedAs "高峰日趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :PeakDayTrip ; :unit "count" ;
    :businessDescription "周五/周六的趟次。分母用它才能说清外车依赖的时间结构。口径来自 answers:Q6。" .

:avgTripDuration a owl:DatatypeProperty ; rdfs:label "平均耗时（分钟）" ; :askedAs "平均耗时（分钟）" ; rdfs:domain :Trip ;
    :aggregate "avg" ; :formula "actual_duration_min" ; :grain :Trip ; :universe :Trip ; :unit "minutes" ;
    :businessDescription "并线后应当变长——这是故事的痛点之一。口径来自 md 的『最好有：实际耗时』。（refused: 平台历史声明，业务出处待补）" .

:avgStopsPerTrip a owl:DatatypeProperty ; rdfs:label "每趟平均站数" ; :askedAs "每趟平均站数" ; rdfs:domain :Trip ;
    :aggregate "avg" ; :formula "planned_stops" ; :grain :Trip ; :universe :Trip ; :unit "count" ;
    :businessDescription "并线把站数从约 10.5 推到约 15.5。口径来自 docx 的并线痛点。" .

# ---- Stop 粒度
:stopCount a owl:DatatypeProperty ; rdfs:label "站点数" ; :askedAs "站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :unit "count" ;
    :businessDescription "一次门店拜访一行。口径来自 answers:Q2。" .
:onTimeStops a owl:DatatypeProperty ; rdfs:label "准时站点数" ; :askedAs "准时站点数" ; rdfs:domain :Stop ;
    :aggregate "sum" ; :formula "CASE WHEN on_time THEN 1 ELSE 0 END" ; :grain :Stop ; :universe :Stop ; :unit "count" ;
    :businessDescription "站点级准时口径：按站点数，不是按趟。口径来自 answers:Q2。" .
:onTimeRate a owl:DatatypeProperty ; rdfs:label "准点率（站点级）" ; :askedAs "准点率（站点级）" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :onTimeStops ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "站点级：每个收货点是否在窗口内。口径来自 answers:Q2。" .
:damagedBoxes a owl:DatatypeProperty ; rdfs:label "破损箱数" ; :askedAs "破损箱数" ; rdfs:domain :Stop ;
    :aggregate "sum" ; :formula "damaged_boxes" ; :grain :Stop ; :universe :Stop ; :unit "boxes" ;
    :businessDescription "货损箱数合计。口径来自 docx 的破损痛点。" .
:damagedBoxesPer1kStops a owl:DatatypeProperty ; rdfs:label "每千站破损箱" ; :askedAs "每千站破损箱" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :damagedBoxesX1000 ; :denominator :stopCount ; :unit "boxes/1k stops" ;
    :businessDescription "把破损放到每千站上比，否则站点多的线路看着更差。口径来自 docx。" .
:tripCountByVehicle a owl:DatatypeProperty ; rdfs:label "按车辆看趟次" ; :askedAs "按车辆看趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :groupBy :vehiclePlate ; :unit "count" ;
    :businessDescription "车与司机 1:1，按车看趟次就是按司机看；分组后各车趟次之和应回到总趟次（D3 用它验证分组不丢行）。口径来自 docx 的派车痛点。" .
:stopCountByVehicle a owl:DatatypeProperty ; rdfs:label "按车辆看站点数" ; :askedAs "按车辆看站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :groupBy :vehiclePlate ; :unit "count" ;
    :businessDescription "按出车车辆数站点；经 stops→trips→vehicles 的声明式连接，各车站点数之和应回到总站点数。口径来自 docx。" .
:damagedBoxesPer1kStopsByVehicle a owl:DatatypeProperty ; rdfs:label "按车辆看每千站破损箱数" ; :askedAs "按车辆看每千站破损箱数" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ; :groupBy :vehiclePlate ;
    :numerator :damagedBoxesX1000 ; :denominator :stopCount ; :unit "boxes/1k stops" ;
    :businessDescription "车与司机 1:1 绑定，所以按车看破损等于按司机看；分子分母同在 Stop 粒度，分组后的比率仍是加权回整体。口径来自 docx 的破损痛点。" .
:damagedBoxesX1000 a owl:DatatypeProperty ; rdfs:label "破损箱×1000" ; :askedAs "破损箱×1000" ; rdfs:domain :Stop ;
    :aggregate "sum" ; :formula "damaged_boxes * 1000" ; :grain :Stop ; :universe :Stop ; :unit "boxes" ;
    :businessDescription "比率的分子；乘以 1000 是为了把『每千站』做成一个可编译的比率。口径来自 docx。" .
:newbieHandlerStops a owl:DatatypeProperty ; rdfs:label "新手搬运工操作的站点数" ; :askedAs "新手搬运工操作的站点数" ; rdfs:domain :Stop ;
    :aggregate "count" ; :grain :Stop ; :universe :Stop ; :where :NewbieHandlerStop ; :unit "count" ;
    :businessDescription "破损集中在日结工上岗头几天。口径来自 docx。" .

# ---- Complaint 粒度
:complaintCount a owl:DatatypeProperty ; rdfs:label "客诉数" ; :askedAs "客诉数" ; rdfs:domain :Complaint ;
    :aggregate "count" ; :grain :Complaint ; :universe :Complaint ; :unit "count" ;
    :businessDescription "客诉记录数；类型约 25% 未记录，因此按类型拆解要带着这个缺口。口径来自 docx。" .
:unjudgedComplaints a owl:DatatypeProperty ; rdfs:label "责任未判定客诉数" ; :askedAs "责任未判定客诉数" ; rdfs:domain :Complaint ;
    :aggregate "count" ; :grain :Complaint ; :universe :Complaint ; :where :UnjudgedComplaint ; :unit "count" ;
    :businessDescription "NULL 是状态不是 0。口径来自 answers:Q4。" .
:compensationCost a owl:DatatypeProperty ; rdfs:label "赔付成本（已判定）" ; :askedAs "赔付成本（已判定）" ; rdfs:domain :Complaint ;
    :aggregate "sum" ; :formula "amount" ; :grain :Complaint ; :universe :Complaint ; :where :JudgedComplaint ; :unit "RMB" ;
    :businessDescription "只算已判定责任的赔付；未判定的 46% 不在这个数里。口径来自 answers:Q4。" .

# ---- Refusal 粒度
:refusalCount a owl:DatatypeProperty ; rdfs:label "拒单次数" ; :askedAs "拒单次数" ; rdfs:domain :Refusal ;
    :aggregate "count" ; :grain :Refusal ; :universe :Refusal ; :unit "count" ;
    :businessDescription "拒单记录数，不做归因。口径来自 answers:Q8。" .
:unrecordedRefusals a owl:DatatypeProperty ; rdfs:label "原因未记录的拒单数" ; :askedAs "原因未记录的拒单数" ; rdfs:domain :Refusal ;
    :aggregate "count" ; :grain :Refusal ; :universe :Refusal ; :where :UnrecordedRefusalReason ; :unit "count" ;
    :businessDescription "约 29% 的拒单没填原因；归因不可靠，只报缺口。口径来自 answers:Q8。" .

# ---- Trip：整趟全准点
:fullOnTimeTrips a owl:DatatypeProperty ; rdfs:label "整趟全准点趟次" ; :askedAs "整趟全准点趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :FullOnTimeTrip ; :unit "count" ;
    :businessDescription "整趟没有任何迟到站点；与站点级准点率是两个问题。口径来自 answers:Q2。" .
:fullOnTimeTripRate a owl:DatatypeProperty ; rdfs:label "整趟全准点率" ; :askedAs "整趟全准点率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :fullOnTimeTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "第二口径：这趟跑干净了吗。口径来自 answers:Q2。" .

:avgRevenuePerTrip a owl:DatatypeProperty ; rdfs:label "每趟平均运费" ; :askedAs "每趟平均运费" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :tripRevenue ; :denominator :tripCount ; :unit "RMB/trip" ;
    :businessDescription "运费总额除以趟次；分子分母都在 Trip 粒度上。口径来自 answers:Q1。" .

:unrecordedRefusalRate a owl:DatatypeProperty ; rdfs:label "拒单原因缺失率" ; :askedAs "拒单原因缺失率" ; rdfs:domain :Refusal ;
    :aggregate "ratio_of_sums" ; :grain :Refusal ; :universe :Refusal ;
    :numerator :unrecordedRefusals ; :denominator :refusalCount ; :unit "ratio" ;
    :businessDescription "分子分母都在 Refusal 粒度上：原因没填的那部分占全部拒单的比例（实测 113/389 = 29.0%）。不归因，只报缺口。口径来自 answers:Q8。" .

# ---- Appeal 粒度（docx 任务9：司机申诉；outcome 是写入的 pending，不是判定）
:appealCount a owl:DatatypeProperty ; rdfs:label "司机申诉数" ; :askedAs "司机申诉数" ; rdfs:domain :Appeal ;
    :aggregate "count" ; :grain :Appeal ; :universe :Appeal ; :unit "count" ;
    :businessDescription "申诉记录数。outcome 现在只有 pending：本版的 FileAppeal 只登记，判定不由动词负责。口径来自 docx 任务9。" .
:appealCountByOutcome a owl:DatatypeProperty ; rdfs:label "按结果看司机申诉数" ; :askedAs "按结果看司机申诉数" ; rdfs:domain :Appeal ;
    :aggregate "count" ; :grain :Appeal ; :universe :Appeal ; :groupBy :appealOutcome ; :unit "count" ;
    :businessDescription "同一条申诉记录数按 outcome 切开（库里 pending 9 / rejected 25 / upheld 12）：登记与判定是两件事，pending 的那 9 条就是缺口。维度名是 outcome，中文问法是「按结果看申诉数」。口径来自 docx 任务9。" .

:costPerTrip a owl:DatatypeProperty ; rdfs:label "每趟平均成本" ; :askedAs "每趟平均成本" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :tripCostTotal ; :denominator :tripCount ; :unit "RMB/trip" ;
    :businessDescription "已知成本合计除以趟次；分子分母都在 Trip 粒度上。加指标的自检样例。（refused: 平台历史声明，业务出处待补）" .

# ── 演示用：加指标的三条路（都是 Trip 自己的列，不需要新结构）────────────────────────
# (1) 分组计数：一条 1 维指标，让"按版本"的斜率/排名/桑基都能画
:tripCountByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看趟次" ; :askedAs "按线路版本看趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :groupBy :tripRouteVersion ; :unit "count" ;
    :businessDescription "同一个计数按并线版本切开。分组键是 Trip 自己的列（不是 routes 表），所以能编译。（refused: 平台历史声明，业务出处待补）" .

:externalTripsByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看外车趟次" ; :askedAs "按线路版本看外车趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :ExternalTrip ;
    :groupBy :tripRouteVersion ; :unit "count" ;
    :businessDescription "外车趟次按版本切开：外车补位是不是集中在并线之后。（refused: 平台历史声明，业务出处待补）" .

# (2) 两个维度：矩阵/桑基需要的"二维计数"
:tripsByVersionPeak a owl:DatatypeProperty ; rdfs:label "按线路版本×高峰看趟次" ; :askedAs "按线路版本×高峰看趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ;
    :groupBy :tripRouteVersion ; :groupBy :tripIsPeakDay ; :unit "count" ;
    :businessDescription "二维计数：并线版本 × 高峰/平日。矩阵与桑基都吃这个形状。（refused: 平台历史声明，业务出处待补）" .

# (3) 一对面孔：平均的比率 ≠ 比率的平均（分母的选择就是这个指标的语义）
:loadUtilization a owl:DatatypeProperty ; rdfs:label "平均装载利用率" ; :askedAs "平均装载利用率" ; rdfs:domain :Trip ;
    :aggregate "avg" ; :formula "load_boxes::numeric / box_capacity_snapshot" ;
    :grain :Trip ; :universe :Trip ; :unit "ratio" ;
    :businessDescription "每趟装载箱数 / 该趟发车时冻结的箱容量，再对趟次取平均：它回答「典型的一趟装得多满」。数据缺失的趟不计入分母。（refused: 平台历史声明，业务出处待补）" .

:capacityUseRate a owl:DatatypeProperty ; rdfs:label "容量利用率（总量比）" ; :askedAs "容量利用率（总量比）" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :loadedBoxes ; :denominator :boxCapacitySum ; :unit "ratio" ;
    :businessDescription "总装载箱数 / 总容量：回答「整体运力用了多少」。与平均装载利用率是两个问题，永远不该相等。（refused: 平台历史声明，业务出处待补）" .

:loadedBoxes a owl:DatatypeProperty ; rdfs:label "装载箱数合计" ; :askedAs "装载箱数合计" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "load_boxes" ; :grain :Trip ; :universe :Trip ; :unit "boxes" ;
    :businessDescription "分母/分子之一：装载箱数合计。（refused: 平台历史声明，业务出处待补）" .

:boxCapacitySum a owl:DatatypeProperty ; rdfs:label "箱容量合计" ; :askedAs "箱容量合计" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "box_capacity_snapshot" ; :grain :Trip ; :universe :Trip ; :unit "boxes" ;
    :businessDescription "分母/分子之一：派车时冻结的箱容量合计。（refused: 平台历史声明，业务出处待补）" .

:ownTripsByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看自有车趟次" ; :askedAs "按线路版本看自有车趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :OwnTrip ;
    :groupBy :tripRouteVersion ; :unit "count" ;
    :businessDescription "自有车趟次按版本切开；与外车趟次互补（两者相加 = 该版本总趟次）。（refused: 平台历史声明，业务出处待补）" .

# (4) 给气泡图：每个版本上的两把尺子（都是 Trip 自己的列，且都是比率）
:externalShareByRouteVersion a owl:DatatypeProperty ; rdfs:label "按线路版本看外车占比" ; :askedAs "按线路版本看外车占比" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :externalTrips ; :denominator :tripCount ; :groupBy :tripRouteVersion ; :unit "ratio" ;
    :businessDescription "外车占比按并线版本切开：外车补位是不是并线之后才变多。（refused: 平台历史声明，业务出处待补）" .

# (5) 给树图：二维金额（版本 × 高峰），格子面积就是钱
:revenueByVersionPeak a owl:DatatypeProperty ; rdfs:label "按版本×高峰看收入" ; :askedAs "按版本×高峰看收入" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "revenue" ; :grain :Trip ; :universe :Trip ;
    :groupBy :tripRouteVersion ; :groupBy :tripIsPeakDay ; :unit "RMB" ;
    :businessDescription "运费收入按并线版本 × 高峰/平日切成四块，树图每块面积就是这一格的钱。（refused: 平台历史声明，业务出处待补）" .

# ═══════════════════════════════════════════════════════════════════════════════════════════
# KPI 扩展：三份 Excel 的六类指标（运输运营核心指标口径字典 / Book1 / DEMO案例 K1–K6）
#
# 口径来源一律写在 :businessDescription 里（C5b），每个指标都有 :askedAs（C5a）。
# 阈值的判断写成 :formula 的 CASE WHEN，而不是 :physicalPredicate —— 谓词按列名归属类挑表，
# 而 planned_stops（trips 与 routes 都有）、status（trips/vehicles/drivers 都有）会挑错表。
# ═══════════════════════════════════════════════════════════════════════════════════════════

# ── K2 异常率（上报口径 + 实际口径，两个数）─────────────────────────────────────────────
:incidentCount a owl:DatatypeProperty ; rdfs:label "异常工单数" ; :askedAs "异常工单数" ; rdfs:domain :IncidentTicket ;
    :aggregate "count" ; :grain :IncidentTicket ; :universe :IncidentTicket ; :unit "count" ;
    :businessDescription "上报了的异常工单条数（107）。口径来自 DEMO案例.xlsx K2 与 口径字典『配送异常率』。它是「被记录的」，不等于「发生的」。" .

:incidentTrips a owl:DatatypeProperty ; rdfs:label "有上报异常的趟次" ; :askedAs "有上报异常的趟次" ; rdfs:domain :Trip ;
    :aggregate "count" ; :grain :Trip ; :universe :Trip ; :where :TripsWithIncident ; :unit "count" ;
    :businessDescription "至少有一张异常工单的趟次（107/4,120）。口径来自 DEMO案例.xlsx K2 的分子。" .

:incidentRate a owl:DatatypeProperty ; rdfs:label "异常率（上报口径）" ; :askedAs "异常率（上报口径）" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :incidentTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "上报异常趟次 ÷ 总趟次 = 2.60%。口径来自 DEMO案例.xlsx K2（目标 ≤3%），所以它「达标」——而同样的数据里 80.9% 的趟次至少有一个站点倒温或破损。达标是上报口径的达标，不是服务的达标。" .

:incidentCountByType a owl:DatatypeProperty ; rdfs:label "按类型看异常工单数" ; :askedAs "按类型看异常工单数" ; rdfs:domain :IncidentTicket ;
    :aggregate "count" ; :grain :IncidentTicket ; :universe :IncidentTicket ; :groupBy :ticketType ; :unit "count" ;
    :businessDescription "破损 74 / 倒温 16 / 超时 13 / 拒收 4。口径来自 口径字典『异常类型分拆成分项率』与 Book1『分类异常率』。" .

:incidentCountByResponsibleParty a owl:DatatypeProperty ; rdfs:label "按责任方看异常工单数" ; :askedAs "按责任方看异常工单数" ; rdfs:domain :IncidentTicket ;
    :aggregate "count" ; :grain :IncidentTicket ; :universe :IncidentTicket ; :groupBy :ticketResponsibleParty ; :unit "count" ;
    :businessDescription "承运 70 / 不可抗力 19 / 客户 18。口径来自 口径字典『责任方(enum: 承运/客户/不可抗力)』。" .

:tempExcursionStops a owl:DatatypeProperty ; rdfs:label "倒温站点数" ; :askedAs "倒温站点数" ; rdfs:domain :Stop ;
    :aggregate "sum" ; :formula "CASE WHEN temp_excursion THEN 1 ELSE 0 END" ; :grain :Stop ; :universe :Stop ; :unit "count" ;
    :businessDescription "温度越限的站点（1,148）。口径来自 DEMO案例.xlsx K2 的『倒温』一项（实测口径，不是上报口径）。" .

:tempExcursionRate a owl:DatatypeProperty ; rdfs:label "倒温站点率" ; :askedAs "倒温站点率" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :tempExcursionStops ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "倒温站点 ÷ 全部站点 = 2.26%。与 :incidentRate 的 2.60% 恰好接近是巧合：一个是站点级的实测，一个是趟级的上报，两者没有换算关系。" .

:damagedStops a owl:DatatypeProperty ; rdfs:label "破损站点数" ; :askedAs "破损站点数" ; rdfs:domain :Stop ;
    :aggregate "sum" ; :formula "CASE WHEN damaged_boxes > 0 THEN 1 ELSE 0 END" ; :grain :Stop ; :universe :Stop ; :unit "count" ;
    :businessDescription "至少一箱破损的站点。口径来自 Book1『货损的发生比例』与 口径字典『破损』。" .

:damagedStopRate a owl:DatatypeProperty ; rdfs:label "破损站点率" ; :askedAs "破损站点率" ; :domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :damagedStops ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "破损站点 ÷ 全部站点。分子分母同在 Stop 粒度，分组后仍可加权回到整体。口径来自 Book1『分类异常率 = 某类异常数 ÷ 总站次数』。" .

# ── K3 超载与站点超标 ────────────────────────────────────────────────────────────────
:overloadedByVolumeTrips a owl:DatatypeProperty ; rdfs:label "体积超载趟次" ; :askedAs "体积超载趟次" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "CASE WHEN load_volume > volume_capacity_snapshot THEN 1 ELSE 0 END" ;
    :grain :Trip ; :universe :Trip ; :unit "count" ;
    :businessDescription "装载体积超过派车快照的趟次（1,229）。口径来自 Book1『单趟超载（重量/体积/箱数超限）』：三条口径分别比，任一条超了就是超载。" .

:overloadRateByVolume a owl:DatatypeProperty ; rdfs:label "体积超载率" ; :askedAs "体积超载率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :overloadedByVolumeTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "体积超载趟次 ÷ 总趟次 = 29.83%。重量口径是 29.49%（:overloadRate）—— 两条口径差 0.3 个百分点，说明「哪条口径为准」不是学术问题。口径来自 Book1。" .

:overloadedByBoxesTrips a owl:DatatypeProperty ; rdfs:label "箱数超载趟次" ; :askedAs "箱数超载趟次" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "CASE WHEN load_boxes > box_capacity_snapshot THEN 1 ELSE 0 END" ;
    :grain :Trip ; :universe :Trip ; :unit "count" ;
    :businessDescription "装载筐数超过派车快照的趟次（1,253）。口径来自 Book1 的箱数口径。" .

:overloadRateByBoxes a owl:DatatypeProperty ; rdfs:label "箱数超载率" ; :askedAs "箱数超载率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :overloadedByBoxesTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "箱数超载趟次 ÷ 总趟次 = 30.41%。三条口径里它最高 —— 周转筐先到极限，是装载能力最紧的那一条。口径来自 Book1。" .

:overStopTrips a owl:DatatypeProperty ; rdfs:label "站点超阈值趟次" ; :askedAs "站点超阈值趟次" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "CASE WHEN planned_stops > 15 THEN 1 ELSE 0 END" ;
    :grain :Trip ; :universe :Trip ; :unit "count" ;
    :businessDescription "计划站数 > 15 的趟次（760）。阈值取 15 是声明，不是数据：并线前 v1 平均 10.46 站、并线后 v2 平均 15.55 站，15 站正是「并线后的一趟」的门槛。口径来自 口径字典『站点数超过阈值』（阈值由本声明给出，业务可改）。" .

:overStopRate a owl:DatatypeProperty ; rdfs:label "站点超标率" ; :askedAs "站点超标率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :overStopTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "站点超阈值趟次 ÷ 总趟次 = 18.45%。改阈值只需改 :overStopTrips 的 formula，不用改数据。口径来自 口径字典。" .

:weightUtilizationAvg a owl:DatatypeProperty ; rdfs:label "平均载重利用率" ; :askedAs "平均载重利用率" ; rdfs:domain :Trip ;
    :aggregate "avg" ; :formula "load_weight::numeric / weight_capacity_snapshot" ; :grain :Trip ; :universe :Trip ; :unit "ratio" ;
    :businessDescription "每趟载重 ÷ 该趟冻结的载重能力，再对趟次平均。超载幅度 =（实载 − 额定）÷ 额定，就是它减 1 —— 但它对欠载与超载一视同仁，所以超载率仍要单独报。口径来自 口径字典『超载幅度』。" .

# ── K4 出勤与线路完成率 ──────────────────────────────────────────────────────────────
:attendedDays a owl:DatatypeProperty ; rdfs:label "实际出勤日" ; :askedAs "实际出勤日" ; rdfs:domain :DriverSchedule ;
    :aggregate "sum" ; :formula "CASE WHEN status = 'attended' THEN 1 ELSE 0 END" ;
    :grain :DriverSchedule ; :universe :DriverSchedule ; :unit "days" ;
    :businessDescription "司机真的出车的司机日（2,894）。口径来自 口径字典『出勤率 = 实际出勤天数 ÷ 应出勤天数』与 DEMO案例.xlsx K4。" .

:scheduledDays a owl:DatatypeProperty ; rdfs:label "应出勤日" ; :askedAs "应出勤日" ; rdfs:domain :DriverSchedule ;
    :aggregate "sum" ; :formula "CASE WHEN scheduled THEN 1 ELSE 0 END" ;
    :grain :DriverSchedule ; :universe :DriverSchedule ; :unit "days" ;
    :businessDescription "排班表认定的应出勤司机日（5,036 = 5,400 − 364 个无人出车的周日）。这个分母不在趟次里 —— 趟次只能证明「出了」，证明不了「该出」。口径来自 口径字典。" .

:attendanceRate a owl:DatatypeProperty ; rdfs:label "出勤率" ; :askedAs "出勤率" ; rdfs:domain :DriverSchedule ;
    :aggregate "ratio_of_sums" ; :grain :DriverSchedule ; :universe :DriverSchedule ;
    :numerator :attendedDays ; :denominator :scheduledDays ; :unit "ratio" ;
    :businessDescription "实际出勤 ÷ 应出勤 = 57.47%。这个数远低于 DEMO案例.xlsx K4 的 ≥98% 目标：本库的带车加盟司机没有保底收入，闲置时多数选择休息，所以 29% 的应出勤日记为『休息/私人事务』。它是这条业务上一个真实的缺口，不是数据缺陷。" .

:completedTrips a owl:DatatypeProperty ; rdfs:label "送全的趟次" ; :askedAs "送全的趟次" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "CASE WHEN stops_delivered >= planned_stops THEN 1 ELSE 0 END" ;
    :grain :Trip ; :universe :Trip ; :unit "count" ;
    :businessDescription "所有计划站点都送达的趟次（3,330）。判定靠 trips.stops_delivered（冻结的送达站数，I9 保证它等于 stops 里 delivered 的站数），所以不跨表计数。口径来自 Book1『线路完成率 = 实际完成站点数 ÷ 计划站点数』的趟次级写法。" .

:lineCompletionRate a owl:DatatypeProperty ; rdfs:label "线路完成率" ; :askedAs "线路完成率" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :completedTrips ; :denominator :tripCount ; :unit "ratio" ;
    :businessDescription "送全的趟次 ÷ 总趟次 = 80.83%，对 DEMO案例.xlsx K4 的 ≥98% 是红灯。这个指标在扩展之前恒等于 100%（actual_stops 每趟都等于 planned_stops），是一个「永远不会失败」的假 KPI；把它做成能红的能力，来自 stops.service_status 这一列。" .

:deliveredStops a owl:DatatypeProperty ; rdfs:label "送达站点数" ; :askedAs "送达站点数" ; rdfs:domain :Stop ;
    :aggregate "sum" ; :formula "CASE WHEN service_status = 'delivered' THEN 1 ELSE 0 END" ;
    :grain :Stop ; :universe :Stop ; :unit "count" ;
    :businessDescription "真正送达的站点（49,927/50,832）。与 :stopCount 的差 = 拒收 412 + 门店关门 274 + 未送 219。口径来自 Book1 的站点级写法。" .

:deliveredStopRate a owl:DatatypeProperty ; rdfs:label "站点送达率" ; :askedAs "站点送达率" ; rdfs:domain :Stop ;
    :aggregate "ratio_of_sums" ; :grain :Stop ; :universe :Stop ;
    :numerator :deliveredStops ; :denominator :stopCount ; :unit "ratio" ;
    :businessDescription "送达站点 ÷ 全部站点 = 98.22%。站点级 98.2% 与趟级 80.8% 并不矛盾：一趟挂了 12 个站，只要错 1 站，这趟就算没完成，站点率却只掉 1/12 —— 这正是「按趟看」与「按站看」必须并列的原因。口径来自 Book1。" .

# ── K5 违章与路权 ────────────────────────────────────────────────────────────────────
:violationCount a owl:DatatypeProperty ; rdfs:label "违章次数" ; :askedAs "违章次数" ; rdfs:domain :Violation ;
    :aggregate "count" ; :grain :Violation ; :universe :Violation ; :unit "count" ;
    :businessDescription "交管违章记录条数（245）。口径来自 Book1『违章次数（按司机/车辆）』与 口径字典『交通违章率』。" .

:violationCountByCategory a owl:DatatypeProperty ; rdfs:label "按类型看违章次数" ; :askedAs "按类型看违章次数" ; rdfs:domain :Violation ;
    :aggregate "count" ; :grain :Violation ; :universe :Violation ; :groupBy :violationCategory ; :unit "count" ;
    :businessDescription "超速 66 / 违停 64 / 闯禁行 61 / 疲劳驾驶 54。闯禁行和路权相关，超速与疲劳是驾驶行为 —— 两类的整改手段不同。口径来自 口径字典。" .

:violationPointsTotal a owl:DatatypeProperty ; rdfs:label "违章扣分合计" ; :askedAs "违章扣分合计" ; rdfs:domain :Violation ;
    :aggregate "sum" ; :formula "points" ; :grain :Violation ; :universe :Violation ; :unit "points" ;
    :businessDescription "扣分合计 705。扣分记在司机身上、罚款记在车队身上，不能相加也不能互换。口径来自 口径字典『扣分(int)』。" .

:violationFineTotal a owl:DatatypeProperty ; rdfs:label "违章罚款合计" ; :askedAs "违章罚款合计" ; :domain :Violation ;
    :aggregate "sum" ; :formula "fine_amount" ; :grain :Violation ; :universe :Violation ; :unit "RMB" ;
    :businessDescription "罚款合计 62,000 元。口径来自 口径字典『罚款金额(currency)』。" .

:violationsPerTenThousandKm a owl:DatatypeProperty ; rdfs:label "每万公里违章率" ; :askedAs "每万公里违章率" ; rdfs:domain :Violation ;
    :aggregate "ratio_of_sums" ; :grain :Violation ; :universe :Violation ;
    :numerator :violationCount ; :denominator :kmTotal ; :unit "per 10,000 km" ;
    :businessDescription "**这条会拒绝**：分子在 Violation 粒度，分母 :kmTotal 在 Trip 粒度，跨粒度相除会得到一个假数（一趟违章的车和一公里都不开的车会混在一起）。缺的声明是「违章粒度上的里程列」。两个半边都已声明（:violationCount 与 :kmTotal），所以这个数在报表层可以算，但在本体里必须拒绝而不是猜。口径来自 口径字典『违章率 = 违章起数 ÷ 总行驶里程（万公里）』。" .

:kmTotal a owl:DatatypeProperty ; rdfs:label "行驶里程合计" ; :askedAs "行驶里程合计" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "actual_km" ; :grain :Trip ; :universe :Trip ; :unit "km" ;
    :businessDescription "实际行驶里程合计 257,872 km（均值 62.6 km/趟）。百公里油耗、每万公里违章率、单公里成本三者共同的分母。口径来自 口径字典『行驶里程(km)』。" .

:permitExpiredCount a owl:DatatypeProperty ; rdfs:label "已失效通行证数" ; :askedAs "已失效通行证数" ; rdfs:domain :ZonePermit ;
    :aggregate "sum" ; :formula "CASE WHEN valid_to < DATE '2026-10-29' THEN 1 ELSE 0 END" ;
    :grain :ZonePermit ; :universe :ZonePermit ; :unit "count" ;
    :businessDescription "在观察窗结束前就失效的通行证（8/20：2 张并线日到期未续、6 张是更早的旧证）。口径来自 口径字典『路权合规率 = 有有效通行证车辆数 ÷ 进入限行区车辆数』里的有效性一半；按日期判定是这一列存在的全部理由。" .

# ── K6 油耗、维修与 TCO ──────────────────────────────────────────────────────────────
:fuelLitersX100 a owl:DatatypeProperty ; rdfs:label "燃油升数×100" ; :askedAs "燃油升数×100" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "fuel_liters * 100" ; :grain :Trip ; :universe :Trip ; :unit "L" ;
    :businessDescription "比率的分子；乘 100 是为了把「每百公里」做成一个可编译的比率，而不是在被除以后移小数点。口径来自 口径字典『百公里油耗 = 加油量 ÷ 行驶里程 × 100』。" .

:fuelLitersPer100km a owl:DatatypeProperty ; rdfs:label "百公里油耗" ; :askedAs "百公里油耗" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :fuelLitersX100 ; :denominator :kmTotal ; :unit "L/100km" ;
    :businessDescription "燃油升数 ÷ 里程 × 100 = 12.56 L/100km。它是**牵引油耗**：本库的 fuel_cost 桶含冷机用油，折算单价 11.49 元/L 高于油枪价，所以含冷机的全口径油耗约 24 L/100km。对照 DEMO案例.xlsx K6 的 11–13 L/100km（8T 城配）与 ≤22.5（12T），必须说清比的是哪一半。" .

:maintenanceCostTotal a owl:DatatypeProperty ; rdfs:label "维修成本合计（分摊）" ; :askedAs "维修成本合计（分摊）" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "maintenance_cost" ; :grain :Trip ; :universe :Trip ; :unit "RMB" ;
    :businessDescription "按公里分摊到趟次的维修成本（443,110 元）。按车合计与 :maintenanceOrderCost 相等（I5），所以它是可对账的分摊值。口径来自 DEMO案例.xlsx K6『单趟燃油/电耗+维修保养费用』。" .

:maintenanceOrderCost a owl:DatatypeProperty ; rdfs:label "维修工单金额" ; :askedAs "维修工单金额" ; rdfs:domain :MaintenanceOrder ;
    :aggregate "sum" ; :formula "cost" ; :grain :MaintenanceOrder ; :universe :MaintenanceOrder ; :unit "RMB" ;
    :businessDescription "维修工单原始金额（443,110 元，250 张）。与分摊值是两个粒度：一个是会计的事实，一个是趟次的分母。口径来自 口径字典『维修总费用』。" .

:variableCostTotal a owl:DatatypeProperty ; rdfs:label "变动成本合计" ; :askedAs "变动成本合计" ; rdfs:domain :Trip ;
    :aggregate "sum" ; :formula "cost_total + maintenance_cost" ; :grain :Trip ; :universe :Trip ; :unit "RMB" ;
    :businessDescription "已知趟次成本 + 分摊维修成本（2,588,083 元）。trip_costs.other_cost 整列为空，所以这仍是下限。口径来自 口径字典『期间总成本』的变动部分。" .

:variableCostPerKm a owl:DatatypeProperty ; rdfs:label "单公里变动成本" ; :askedAs "单公里变动成本" ; rdfs:domain :Trip ;
    :aggregate "ratio_of_sums" ; :grain :Trip ; :universe :Trip ;
    :numerator :variableCostTotal ; :denominator :kmTotal ; :unit "RMB/km" ;
    :businessDescription "变动成本 ÷ 里程 = 10.04 元/km。折合每公里收入 17.15 元（:tripRevenue ÷ :kmTotal），毛利空间 7.11 元/km。**它不是 TCO**：保险、折旧、车船税、年检不在这个数里（见 :fixedCostMonthly），所以不要在报价场合把它当全成本。口径来自 口径字典『单公里总运营成本』的变动部分。" .

:fixedCostMonthly a owl:DatatypeProperty ; rdfs:label "固定成本合计（月）" ; :askedAs "固定成本合计（月）" ; rdfs:domain :VehicleFixedCost ;
    :aggregate "sum" ; :formula "insurance + depreciation + road_tax + inspection" ;
    :grain :VehicleFixedCost ; :universe :VehicleFixedCost ; :unit "RMB" ;
    :businessDescription "保险 + 折旧 + 车船税 + 年检，3 个月合计 3,014,691 元（约 16,748 元/车·月）。停驶也照付，所以它是「不敢换车」的成本来源。口径来自 口径字典『折旧/保险/人工分摊』与 DEMO案例.xlsx K6。" .

:fixedCostByPeriod a owl:DatatypeProperty ; rdfs:label "按期间看固定成本" ; :askedAs "按期间看固定成本" ; rdfs:domain :VehicleFixedCost ;
    :aggregate "sum" ; :formula "insurance + depreciation + road_tax + inspection" ;
    :grain :VehicleFixedCost ; :universe :VehicleFixedCost ; :groupBy :fixedCostPeriod ; :unit "RMB" ;
    :businessDescription "同一条固定成本按 2026-08 / 09 / 10 三个月切开，用来验证分摊不随期间跳变。口径来自 口径字典『同一指标跨周期对比时须保持周期一致』。" .
