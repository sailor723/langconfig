    "metric": "refusalCount",
    "route": "SELECT count(1)::numeric FROM refusals"
   }
  },
  {
   "question": "拒单原因分布是怎样的",
   "expect": {
    "metric": "refusalCountByReason",
    "route": "SELECT r.reason, count(DISTINCT r.id)::numeric FROM refusals AS r GROUP BY r.reason ORDER BY 2 DESC"
   }
  },
  {
   "question": "建议采纳率是多少",
   "expect": {
    "metric": "recommendationAdoptionRate",
