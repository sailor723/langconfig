{
 "_note": "Every sample below declares its expectation as a SECOND hand-written SQL route, not as a frozen number: check_samples.py runs that SQL at gate time and compares it to the pipeline's own compiled answer. Two independent derivations, no copied values.",
 "samples": [
  {
   "question": "趟次数",
   "expect": {
    "metric": "tripCount",
    "route": "SELECT count(1)::numeric FROM trips"
   }
  },
  {
   "question": "总收入",
   "expect": {
    "metric": "revenueTotal",
    "route": "SELECT sum(t.revenue)::float8 FROM trips AS t"
   }
  },
  {
   "question": "总成本",
   "expect": {
    "metric": "totalCostSum",
    "route": "SELECT sum(t.cost_total)::float8 FROM trips AS t"
   }
  },
  {
   "question": "毛利率是多少",
   "expect": {
    "metric": "grossMarginRate",
    "route": "SELECT (100.0 * sum(revenue - cost_total)::numeric / nullif(sum(revenue),0)::numeric)::float8 FROM trips"
   }
  },
  {
   "question": "有多少客诉",
   "expect": {
    "metric": "complaintCount",
    "route": "SELECT count(1)::numeric FROM complaints"
   }
  },
  {
