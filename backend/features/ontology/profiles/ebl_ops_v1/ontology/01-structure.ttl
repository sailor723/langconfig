:miRetreatedAt a owl:DatatypeProperty ; rdfs:label "回退日期" ; rdfs:domain :MicroImprovement ; :physicalColumn "retreated_at" ;
    :businessDescription "非空即已回退（本库 0 条）" .

# ---------------------------------------------------------------- 属性：RuleRegime（rule_regimes，4 列）
