    :businessDescription "主动离职 82 / 合同到期 43 / 退休 39；在册者为 NULL" .

# ---------------------------------------------------------------- 属性：Lead（leads，5 列）
:leadId a owl:DatatypeProperty ; rdfs:label "线索号" ; rdfs:domain :Lead ; :physicalColumn "id" ;
