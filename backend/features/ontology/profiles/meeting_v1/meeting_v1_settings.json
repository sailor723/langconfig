{
  "title": "会议决议闭环本体（meeting_v1）",
  "ns": "https://cube.local/ontology/meeting_v1#",
  "ontology_dir": ".",
  "overlay": "metrics_ext.ttl",
  "dsn": {
    "host": "${ONTOLOGY_DB_HOST:-127.0.0.1}",
    "port": "${ONTOLOGY_DB_PORT:-5432}",
    "dbname": "meeting_hub",
    "user": "${ONTOLOGY_DB_USER:-weiping}",
    "password": "${MEETING_V1_DB_PASSWORD:-}"
  },
  "guard": {
    "enabled": true,
    "max_rows": 500,
    "default_window_days": 0,
    "statement_timeout_ms": 8000,
    "max_plan_rows": 5000000,
    "big_tables": {
      "meeting_hub_raw": "c1"
    },
    "large_tables": [
      "meeting_hub_attendance"
    ]
  },
  "features": {
    "actions": false,
    "lane_b": false,
    "tutorial": true,
    "tutorial_style": "auto"
  },
  "aliases": {
    "_comment": "别名值必须落到「声明侧」的词：维度别名要等于 :groupBy 属性名里的某个词（site/venue/type，或中文的 责任人），指标别名写指标名（camelCase 会被切成小写单词）。中文→中文的别名对匹配器完全无效——上一版就是这么写的，menu 全绿而每个分组问题都被拒绝。别名之间不要互相包含：'有责任人' 会命中 '没有责任人'、'超期' 会让计数指标赢过占比指标，所以这里只用不会互相吃掉的长短语。",
    "厂区": "site",
    "各厂区": "site",
    "分厂区": "site",
    "场所": "venue",
    "会议室": "venue",
    "责任人": "责任人",
    "负责人": "责任人",
    "指派人": "责任人",
    "会议类型": "type",
    "类型": "type",
    "决议事项": "itemCount",
    "事项数": "itemCount",
    "行数": "itemCount",
    "有责任人的": "ownedItemCount",
    "无责任人": "noOwnerItemCount",
    "没有责任人": "noOwnerItemCount",
    "未指派": "noOwnerItemCount",
    "无责任人占比": "noOwnerRate",
    "无责任人比例": "noOwnerRate",
    "实质纪要": "notedItemCount",
    "有实质内容": "notedItemCount",
    "纪要缺失": "noNoteItemCount",
    "没有纪要": "noNoteItemCount",
    "纪要缺失占比": "noNoteRate",
    "会议类": "meetingItemCount",
    "非会议事项": "nonMeetingItemCount",
    "非会议": "nonMeetingItemCount",
    "周会类": "weeklyMeetingItemCount",
    "专题会类": "topicMeetingItemCount",
    "临时会类": "adHocMeetingItemCount",
    "培训类": "trainingMeetingItemCount",
    "类型存疑": "ambiguousTypeItemCount",
    "可判定闭环": "datedItemCount",
    "闭环可判定": "datedItemCount",
    "按期完成事项": "onScheduleItemCount",
    "按期完成率": "closeRate",
    "期完成率": "按期完成率",
    "闭环率": "closeRate",
    "超期事项": "overdueItemCount",
    "超期占比": "overdueRate",
    "超期率": "overdueRate",
    "提前完成": "earlyItemCount",
    "未来": "futureScheduledItemCount",
    "会议总时长": "minutesSum",
    "总时长": "minutesSum",
    "平均每条事项的会议时长": "avgMinutesPerItem",
    "平均时长": "avgMinutesPerItem",
    "会议场次": "meetingCount",
    "场次": "meetingCount",
    "平均每场会议时长": "avgMeetingMinutes",
    "每场平均参会人次": "attendancePerMeeting"
  },
  "samples": [
    "决议事项数是多少？",
    "无责任人占比是多少？",
    "按厂区看无责任人占比",
    "会议总时长是多少分钟？",
    "平均每条事项的会议时长",
    "按期完成率是多少？",
    "超期占比是多少？",
    "按厂区看按期完成率",
    "非会议事项有多少条？",
    "按会议类型看事项数",
    "专题会类事项有多少条？",
    "临时会类事项有多少条？",
    "培训类事项有多少条？",
    "纪要缺失占比是多少？",
    "按场所看事项数",
    "按责任人看事项数",
    "排期在未来的事项有多少条？",
    "会议场次数是多少？",
    "会议场次（含面试/接待客户）是多少？",
    "平均每场会议时长是多少？",
    "每场会议平均参会人次是多少？",
    "按厂区看会议场次",
