@prefix : <https://cube.local/ontology/meeting_v1#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:aggregate a owl:AnnotationProperty .
:grain a owl:AnnotationProperty .
:universe a owl:AnnotationProperty .
:where a owl:AnnotationProperty .
:groupBy a owl:AnnotationProperty .
:numerator a owl:AnnotationProperty .
:denominator a owl:AnnotationProperty .
:scale a owl:AnnotationProperty .
:additivity a owl:AnnotationProperty .
:unit a owl:AnnotationProperty .
:askedAs a owl:AnnotationProperty .

# =============================================================================
# S3 计算层：只有 selector + aggregate，没有业务解释（解释在 02-meaning.ttl）。
# 全部指标的粒度都是 :DecisionItem = 「纪要里的一行」，因为没有会议键（见 01-structure）。
# 每条指标都要么编译出 SQL，要么按名拒绝；本文件里只放能编译的，拒绝清单在
# tutorial.json 的 refused 步骤与本目录的 refusal 说明里（不声明半成品指标）。
# =============================================================================

# ---------------------------------------------------------------- 计数（事项行）
:itemCount a owl:DatatypeProperty ; rdfs:label "决议事项数" ;
    :askedAs "决议事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q1 + Q11（对象 = 事项行，3562 行不去重）；全表行数 = 3562。它就是「导出里有多少条决议事项」，不是「开了多少场会」（没有会议键）。" .

:ownedItemCount a owl:DatatypeProperty ; rdfs:label "有责任人的决议事项数" ;
    :askedAs "有责任人的决议事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :OwnedItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q2/Q9（有具体人 = 有责任人，责任人只做原始字符串不归一）；责任人写了具体人的行 = 1929。" .

:noOwnerItemCount a owl:DatatypeProperty ; rdfs:label "无责任人的决议事项数" ;
    :askedAs "无责任人的决议事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :NoOwnerItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q2/Q9（「无/空/—/-」= 无责任人）；责任人缺失（无/空/—/-）= 1633。归属判定的谓词只在 :NoOwnerItem 里写一次（Q2）。" .

:notedItemCount a owl:DatatypeProperty ; rdfs:label "有实质纪要的决议事项数" ;
    :askedAs "有实质纪要的决议事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :NotedItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q2（纪要占位的行仍然是事项）+ measured: samples.json；纪要非占位且长度 >3 = 1911。" .

:noNoteItemCount a owl:DatatypeProperty ; rdfs:label "纪要缺失的决议事项数" ;
    :askedAs "纪要缺失的决议事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :NoNoteItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q2（纪要缺失的行仍然是事项）+ measured: samples.json；纪要是占位符或空 = 1617。" .

:meetingItemCount a owl:DatatypeProperty ; rdfs:label "会议类决议事项数" ;
    :askedAs "会议类决议事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :MeetingItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q4（面试/接待客户不计入会议统计）；剔除面试/接待客户之后的会议类事项 = 3375（Q4：非会议不进会议统计）。" .

:nonMeetingItemCount a owl:DatatypeProperty ; rdfs:label "非会议事项数" ;
    :askedAs "非会议事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :NonMeetingItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q4（面试 148 + 接待客户 39）；面试 148 + 接待客户 39 = 187。" .

:weeklyMeetingItemCount a owl:DatatypeProperty ; rdfs:label "周会类事项数" ;
    :askedAs "周会类事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :WeeklyMeetingItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q5（14 个原始标签，斜杠值不拆）；例会 369 + 周会 112 = 481，不含组合标签「例会/工作汇报」257 行。" .

:topicMeetingItemCount a owl:DatatypeProperty ; rdfs:label "专题会类事项数" ;
    :askedAs "专题会类事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :TopicMeetingItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q5（14 个原始标签，斜杠值不拆）；六种有议题的会 = 1902，不含组合标签「例会/工作汇报」257 行。" .

:adHocMeetingItemCount a owl:DatatypeProperty ; rdfs:label "临时会类事项数" ;
    :askedAs "临时会类事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :AdHocMeetingItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q5（14 个原始标签，斜杠值不拆）；临时 661 + 例会/临时会议 7 = 668。" .

:trainingMeetingItemCount a owl:DatatypeProperty ; rdfs:label "培训类事项数" ;
    :askedAs "培训类事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :TrainingMeetingItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q5（14 个原始标签，斜杠值不拆）；培训 = 67。" .

:ambiguousTypeItemCount a owl:DatatypeProperty ; rdfs:label "类型存疑事项数" ;
    :askedAs "类型存疑事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :AmbiguousTypeItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q5（类型无法唯一归一的 145 行单列，不猜）；「例会/工作汇报」257 行，规格 §2.5 自相矛盾，本体不替业务拍（Q5）。这 257 行既不在周会类也不在专题会类里，四个会议类互不重叠。" .

# ---------------------------------------------------------------- 日期闭环
:datedItemCount a owl:DatatypeProperty ; rdfs:label "可判定闭环的事项数" ;
    :askedAs "可判定闭环的事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :DatedItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q6（分母 = 计划完成与实际完成都存在的行）+ Q10；计划与实际都能解析成日期的行 = 1678，闭环类指标唯一合法的分母（Q6）。" .

:onScheduleItemCount a owl:DatatypeProperty ; rdfs:label "按期完成事项数" ;
    :askedAs "按期完成事项数" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :OnScheduleItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q6（分母 = 可判定闭环的事项）+ Q10（锚会议日期）；实际=计划（日期）= 1609。只是日期上按期，不等于业务确认的闭环。" .

:overdueItemCount a owl:DatatypeProperty ; rdfs:label "超期事项数" ;
    :askedAs "超期事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :OverdueItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q6 + Q10（锚会议日期）；实际晚于计划 = 58。" .

:earlyItemCount a owl:DatatypeProperty ; rdfs:label "提前完成事项数" ;
    :askedAs "提前完成事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :EarlyItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q6 + Q10（锚会议日期）；实际早于计划 = 11。提前不是超期，不计入未按期。" .

:futureScheduledItemCount a owl:DatatypeProperty ; rdfs:label "排期在未来的事项数" ;
    :askedAs "排期在未来的事项数是多少？" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :where :FutureScheduledItem ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q10（排期在未来 7 行只在这一点上计数，不进窗口分母）；会议日期晚于今天 = 7（Q10：看闭环时剔除未来期间，剔除量在这里可数）。" .

# ---------------------------------------------------------------- 占比（分子/分母都声明）
:noOwnerRate a owl:DatatypeProperty ; rdfs:label "无责任人占比" ;
    :askedAs "无责任人占比是多少？" ;
    :aggregate "ratio_of_sums" ; :numerator :noOwnerItemCount ; :denominator :itemCount ;
    :scale "100.0" ; :grain :DecisionItem ; :universe :DecisionItem ;
    :additivity "non-additive" ; :unit "percent" ;
    :businessDescription "口径来源：answers:Q2（分母 = 全部事项，不是会议类）+ measured: samples.json；无责任人 1633 ÷ 全部 3562 × 100 = 45.845%。分母是全表：缺失不能从分母里剔掉（Q2）。" .

:noNoteRate a owl:DatatypeProperty ; rdfs:label "纪要缺失占比" ;
    :askedAs "纪要缺失占比是多少？" ;
    :aggregate "ratio_of_sums" ; :numerator :noNoteItemCount ; :denominator :itemCount ;
    :scale "100.0" ; :grain :DecisionItem ; :universe :DecisionItem ;
    :additivity "non-additive" ; :unit "percent" ;
    :businessDescription "口径来源：answers:Q2（分母 = 全部事项）+ measured: samples.json；纪要缺失 1617 ÷ 全部 3562 × 100 = 45.396%。" .

:closeRate a owl:DatatypeProperty ; rdfs:label "按期完成率" ;
    :askedAs "按期完成率" ;
    :aggregate "ratio_of_sums" ; :numerator :onScheduleItemCount ; :denominator :datedItemCount ;
    :scale "100.0" ; :grain :DecisionItem ; :universe :DecisionItem ;
    :additivity "non-additive" ; :unit "percent" ;
    :businessDescription "口径来源：answers:Q6（分母 = 可判定闭环的事项，不是全部事项）；按期 1609 ÷ 可判定 1678 × 100 = 95.888%。分母是 1678 不是 3562：没有日期承诺的 1884 行不在闭环口径里（Q6）。" .

:overdueRate a owl:DatatypeProperty ; rdfs:label "超期占比" ;
    :askedAs "超期占比是多少？" ;
    :aggregate "ratio_of_sums" ; :numerator :overdueItemCount ; :denominator :datedItemCount ;
    :scale "100.0" ; :grain :DecisionItem ; :universe :DecisionItem ;
    :additivity "non-additive" ; :unit "percent" ;
    :businessDescription "口径来源：answers:Q6（分母 = 可判定闭环的事项）；超期 58 ÷ 可判定 1678 × 100 = 3.457%。与「未闭环率」不是同一个数，不要混用。" .

# ---------------------------------------------------------------- 时长
:minutesSum a owl:DatatypeProperty ; rdfs:label "会议总时长" ;
    :askedAs "会议总时长是多少分钟？" ;
    :aggregate "sum" ; :formula "cast(duration_minutes_raw as numeric)" ;
    :grain :DecisionItem ; :universe :DecisionItem ;
    :additivity "additive" ; :unit "minute" ;
    :businessDescription "口径来源：answers:Q7（180 分钟不是业务阈值，只做分档）+ measured: meeting_hub_raw.c6；逐行时长求和 = 195320 分钟。注意口径：时长是整场会的，却挂在每条事项行上，所以这个和是「事项×时长」的重复计入，只能读成「这 3562 条事项所挂会议的时长合计」，不是「会议实际耗时」——会议场次数在库里无法确定（Q3）。" .

:avgMinutesPerItem a owl:DatatypeProperty ; rdfs:label "平均每条事项的会议时长" ;
    :askedAs "平均每条事项的会议时长是多少？" ;
    :aggregate "avg" ; :formula "cast(duration_minutes_raw as numeric)" ;
    :grain :DecisionItem ; :universe :DecisionItem ;
    :additivity "non-additive" ; :unit "minute" ;
    :businessDescription "口径来源：answers:Q7 + measured: meeting_hub_raw.c6；195320 ÷ 3562 = 54.834 分钟/条。同一场会的 9 条事项各自计一次，所以这是「每条事项」的平均，不是「每场会」的平均时长。" .

# ---------------------------------------------------------------- 分组
:itemCountBySite a owl:DatatypeProperty ; rdfs:label "按厂区看事项数" ;
    :askedAs "按厂区看事项数" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :groupBy :siteCode ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q2 + measured: meeting_hub_raw.c0；HQ 3125 / SW 253 / OS 184，合计 3562。厂区是本库唯一的组织维度。" .

:itemCountByMeetingType a owl:DatatypeProperty ; rdfs:label "按会议类型看事项数" ;
    :askedAs "按会议类型看事项数" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :groupBy :meetingTypeRaw ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q4 + Q5；按 14 个原始标签分组（工作汇报 1384 … 例会/临时会议 7）。这是**未归一化**的分布：要看 4 个会议类别请用 weekly/topic/adHoc/training 四个指标（Q5 未决的组合标签会单独出现）。" .

:itemCountByVenue a owl:DatatypeProperty ; rdfs:label "按场所看事项数" ;
    :askedAs "按场所看事项数" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :groupBy :venueName ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q2 + measured: meeting_hub_raw.c9；场所是自由文本（会议室名/线上/车间现场），空白差异未清洗，分组结果按名称原样出现。" .

:itemCountByOwner a owl:DatatypeProperty ; rdfs:label "按责任人看事项数" ;
    :askedAs "按责任人看事项数" ;
    :aggregate "count" ; :grain :DecisionItem ; :universe :DecisionItem ; :groupBy :责任人 ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q9（责任人原始字符串，不拆多人）；按责任人列的**原始文本**点名计数，未做人员归一化：同一人的不同写法（空格/全半角/「张三/李四」多人写法）各自成组，「无」也成一组。它回答「谁背的决议事项最多」，不能回答「人均负荷」——本库没有人员主数据表可以对账，所以不做合并。" .

:noOwnerRateBySite a owl:DatatypeProperty ; rdfs:label "按厂区看无责任人占比" ;
    :askedAs "按厂区看无责任人占比" ;
    :aggregate "ratio_of_sums" ; :numerator :noOwnerItemCount ; :denominator :itemCount ;
    :scale "100.0" ; :grain :DecisionItem ; :universe :DecisionItem ; :groupBy :siteCode ;
    :additivity "non-additive" ; :unit "percent" ;
    :businessDescription "口径来源：answers:Q2（同一 where，只换维）+ measured: samples.json；每个厂区自己的「无责任人 ÷ 该厂区全部行」。分子分母在同一粒度上，所以按厂区切分后仍加权回 45.845%。" .

:closeRateBySite a owl:DatatypeProperty ; rdfs:label "按厂区看按期完成率" ;
    :askedAs "按厂区看按期完成率" ;
    :aggregate "ratio_of_sums" ; :numerator :onScheduleItemCount ; :denominator :datedItemCount ;
    :scale "100.0" ; :grain :DecisionItem ; :universe :DecisionItem ; :groupBy :siteCode ;
    :additivity "non-additive" ; :unit "percent" ;
    :businessDescription "口径来源：answers:Q6（同一分母，只换维）+ measured: samples.json；每个厂区自己的「按期 ÷ 该厂区可判定」。分母随厂区变，不是全表 1678 —— 所以三个厂区的分母相加才等于 1678。" .

:overdueRateBySite a owl:DatatypeProperty ; rdfs:label "按厂区看超期占比" ;
    :askedAs "按厂区看超期占比" ;
    :aggregate "ratio_of_sums" ; :numerator :overdueItemCount ; :denominator :datedItemCount ;
    :scale "100.0" ; :grain :DecisionItem ; :universe :DecisionItem ; :groupBy :siteCode ;
    :additivity "non-additive" ; :unit "percent" ;
    :businessDescription "口径来源：answers:Q2（「超期占比」的同一 where，只换维）+ measured: samples.json；每个厂区自己的「超期 ÷ 该厂区可判定」。分母随厂区变（只有两个日期都解析得出来的行才算可判定），所以三个厂区的分母相加才等于全表的可判定数 —— 不能用全表分母去除各厂区分子" .

# ---------------------------------------------------------------- 人时（会议 × 人）
# 这一组指标的粒度是 :Attendance（视图 meeting_hub_attendance，一行 = 一场会 × 一个人），
# 不是上面那 3000 多行的 :DecisionItem。人时必须落在这层：时长是整场会的，挂在每条事项行上，
# 按事项行求和会按「这条会有几条事项」重复计入（Q8 人确认可以用这层）。

:manHours a owl:DatatypeProperty ; rdfs:label "会议人时" ;
    :askedAs "会议人时是多少？" ;
    :aggregate "sum" ; :formula "duration_minutes / 60.0" ;
    :grain :Attendance ; :universe :Attendance ; :where :MeetingAttendance ;
    :additivity "additive" ; :unit "hour" ;
    :businessDescription "口径来源：answers:Q8（人时由运维建的 meeting_hub_attendance 视图，本体只声明视图）+ measured: attendance.duration_minutes；会议类会议的出席人时 = Σ(会议时长)÷60，**按出席记录逐条求和**，不是按事项、也不是按场次。取值 9456.1833 小时 = 11515 条会议类出席记录各自的会议时长之和。口径：一场会 90 分钟、9 个人在场，就是 13.5 人时；同一个人在同一天的两场会各计一次（本库没有工时表可以对冲）。已剔除面试/接待客户（那条边界见 :MeetingAttendance）。它可加：按厂区/类型切分后相加仍等于 9456.1833" .

:manHoursAll a owl:DatatypeProperty ; rdfs:label "会议人时（含面试/接待客户）" ;
    :askedAs "会议人时（含面试/接待客户）是多少？" ;
    :aggregate "sum" ; :formula "duration_minutes / 60.0" ;
    :grain :Attendance ; :universe :Attendance ; :where :AllAttendance ;
    :additivity "additive" ; :unit "hour" ;
    :businessDescription "口径来源：answers:Q8 + Q4（含面试/接待客户的对照口径）；不过滤类型的全部人时 = 9977.3667 小时（11849 条出席记录）。与 :manHours 的差 521.1833 小时（334 人次、185 个会议键）就是面试与接待客户。这个指标存在的目的就是把「剔掉了多少」摆到台面上，不允许用一句「已剔除非会议」把差额藏掉（Q4）" .

:attendanceCount a owl:DatatypeProperty ; rdfs:label "会议类人次" ;
    :askedAs "会议类人次是多少？" ;
    :aggregate "count" ; :grain :Attendance ; :universe :Attendance ; :where :MeetingAttendance ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q8（视图行 = 人次）+ measured: attendance；会议类会议的出席人次 = 11515（一条出席记录算一次）。它是 :manHours 的分母：人均参会时长 = 9456.1833 ÷ 11515 = 0.8212 小时（49.3 分钟）。注意它**不是**参会人数：同一个人开 10 场会算 10 次" .

:manHoursPerAttendance a owl:DatatypeProperty ; rdfs:label "人均每场参会时长" ;
    :askedAs "人均每场参会时长是多少？" ;
    :aggregate "ratio_of_sums" ; :numerator :manHours ; :denominator :attendanceCount ;
    :grain :Attendance ; :universe :Attendance ;
    :additivity "non-additive" ; :unit "hour" ;
    :businessDescription "口径来源：answers:Q8（人时 ÷ 人次，同一视图）；会议人时 ÷ 会议人次 = 0.8212 小时/人次（49.3 分钟）——即「一个人被拉进一场会，平均占用多少小时」。两个口径同粒度（都是 :Attendance），可以相除。它衡量的是**会开多长**，不是人有多少" .

:manHoursBySite a owl:DatatypeProperty ; rdfs:label "按厂区看会议人时" ;
    :askedAs "按厂区看会议人时" ;
    :aggregate "sum" ; :formula "duration_minutes / 60.0" ;
    :grain :Attendance ; :universe :Attendance ; :where :MeetingAttendance ; :groupBy :site_code ;
    :additivity "additive" ; :unit "hour" ;
    :businessDescription "口径来源：answers:Q8 + measured: attendance.site_code；按厂区拆人时，三个厂区相加 = 9456.1833。厂区是出席记录上的列（:site_code），与事项层的 :siteCode 同源同值；分组直接落在 :Attendance 上，不需要 join，所以不会因为「同一场会的事项行重复」而放大" .

:attendanceCountBySite a owl:DatatypeProperty ; rdfs:label "按厂区看会议人次" ;
    :askedAs "按厂区看会议人次" ;
    :aggregate "count" ; :grain :Attendance ; :universe :Attendance ;
    :where :MeetingAttendance ; :groupBy :site_code ;
    :additivity "additive" ; :unit "row" ;
    :businessDescription "口径来源：answers:Q8 + measured: attendance.site_code；按厂区拆人次，三个厂区相加 = 11515。与人时并排看才能判「时长大」还是「人多」" .

:manHoursByMeetingType a owl:DatatypeProperty ; rdfs:label "按会议类型看会议人时" ;
    :askedAs "按会议类型看会议人时" ;
    :aggregate "sum" ; :formula "duration_minutes / 60.0" ;
    :grain :Attendance ; :universe :Attendance ;
    :where :MeetingAttendance ; :groupBy :meeting_type ;
    :additivity "additive" ; :unit "hour" ;
    :businessDescription "口径来源：answers:Q8 + Q5（类型取自事项侧，视图带过来）；按会议类型拆人时，14 个标签相加 = 9456.1833。这里用的是**会议级**标签（:meeting_type，同一会议键取 min(c3)）：2270 个会议键里 8 个在行级有两个标签，它们会整体落到字典序较小的那一类，所以按类型的分布对那 8 场会有 0.35% 的归属噪声。它是**未归一化**的 14 个原始标签，四种会议类别的归一见事项层的四个 :*MeetingItem 类（Q5 未决的组合标签仍单独出现）" .

# ---------------------------------------------------------------- 场次（会议粒度）
# 这一组指标回答的是 raw 根本答不了的问题：「开了多少场会」。场次 = 会议键的去重计数，
# 键是 Q3 人确认的四元组；raw 的 c2 是导出行号，拿它 count 出来的是事项数，不是场次。
# 场次、人次、人时三者互为分母，不能相加（见 :Meeting 的说明）。

:meetingCount a owl:DatatypeProperty ; rdfs:label "会议场次" ;
    :askedAs "会议场次是多少？" ;
    :aggregate "count" ; :grain :Meeting ; :universe :Meeting ; :where :MeetingClass ;
    :additivity "additive" ; :unit "count" ;
    :businessDescription "口径来源：answers:Q3（会议键四元组）+ Q4（面试/接待客户不算会议）；会议类会议的场次 = 2085。分母不是事项：同一场会的 9 条事项只算一场。它与「事项数 3375」不是一回事：一场会平均 1.6 条事项。按厂区相加仍等于 2085" .

:meetingCountAll a owl:DatatypeProperty ; rdfs:label "会议场次（含面试/接待客户）" ;
    :askedAs "会议场次（含面试/接待客户）是多少？" ;
    :aggregate "count" ; :grain :Meeting ; :universe :Meeting ; :where :AllMeetings ;
    :additivity "additive" ; :unit "count" ;
    :businessDescription "口径来源：answers:Q3 + Q4（对照口径）；全部会议键 = 2270 场。与 :meetingCount 的差 185 场（面试 146 + 接待客户 39）。这个指标存在的目的是把「剔掉了多少」摆到台面上" .

:avgMeetingMinutes a owl:DatatypeProperty ; rdfs:label "平均每场会议时长" ;
    :askedAs "平均每场会议时长是多少？" ;
    :aggregate "avg" ; :formula "duration_minutes" ;
    :grain :Meeting ; :universe :Meeting ; :where :MeetingClass ;
    :additivity "non-additive" ; :unit "minute" ;
    :businessDescription "口径来源：answers:Q7 + measured: meeting_hub_meeting；103000 分钟 ÷ 2085 场 = 49.4005 分钟/场。这是**每场会**的平均，与 :avgMinutesPerItem（每条事项 54.834 分钟）不是同一个分母：后者把一场会重复计了它的事项数" .

:attendancePerMeeting a owl:DatatypeProperty ; rdfs:label "每场会议平均参会人次" ;
    :askedAs "每场会议平均参会人次是多少？" ;
    :aggregate "ratio_of_sums" ; :numerator :attendanceCount ; :denominator :meetingCount ;
    :grain :Meeting ; :universe :Meeting ;
    :additivity "non-additive" ; :unit "person" ;
    :businessDescription "口径来源：answers:Q8（人次）+ Q3（场次）；11515 人次 ÷ 2085 场 = 5.5228 人次/场。分子分母在同一个会议键上，所以不会因为事项行重复而放大。注意它是「人次/场」：同一个人开两场算两票，本库没有去重所需的人员主数据" .

:meetingCountBySite a owl:DatatypeProperty ; rdfs:label "按厂区看会议场次" ;
    :askedAs "按厂区看会议场次" ;
    :aggregate "count" ; :grain :Meeting ; :universe :Meeting ;
    :where :MeetingClass ; :groupBy :m_site ;
    :additivity "additive" ; :unit "count" ;
    :businessDescription "口径来源：answers:Q3 + measured: meeting_hub_meeting.site_code；HQ 1845 / SW 166 / OS 74，合计 2085。厂区是唯一的组织维度，本库没有部门" .

:meetingCountByMeetingType a owl:DatatypeProperty ; rdfs:label "按会议类型看会议场次" ;
    :askedAs "按会议类型看会议场次" ;
    :aggregate "count" ; :grain :Meeting ; :universe :Meeting ;
    :where :MeetingClass ; :groupBy :m_type ;
    :additivity "additive" ; :unit "count" ;
    :businessDescription "口径来源：answers:Q4 + Q5 + measured: meeting_hub_meeting.meeting_type；12 个会议类标签相加 = 2085（工作汇报 758、临时 611、例会/工作汇报 235、例会 187 … 周会 18、项目会议 7、例会/临时会议 7）。这是**未归一化**的原始标签分布；四种会议类别请用事项层的 weekly/topic/adHoc/training 四个指标" .
