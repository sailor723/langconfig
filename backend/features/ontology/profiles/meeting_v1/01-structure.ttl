@prefix : <https://cube.local/ontology/meeting_v1#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# S1 结构层：这个库到底有什么
# 库：meeting_hub（schema public）。
#   ① 表 meeting_hub_raw：3562 行，14 列，全部 text，无主键 —— 客户按 Excel 导出的会议纪要明细：
#      不是规范化库，没有会议表、没有状态机、没有佐证表。
#   ② 视图 meeting_hub_attendance：11849 行 —— **本本体授权的数据层**（生成脚本见
#      generated/meeting_v1_views.sql，Q8 人确认）。它只做两件机械的事：把 c1/c6 类型化、
#      按 Q3 的四元组造会议键 (厂区, 日期, 会议名称, 时段, 主导人)，再把 c8 的参会人拆成一人一行。
#      没有任何业务归一化（类型不归一、责任人不清洗）。它是「人时」唯一可能的口径：
#      raw 里一行是一条事项，一条事项上的时长属于整场会，按行求和人时会按「事项数」重复计。
#      视图不存在时，:Attendance 上的指标会编译失败（这是设计：口径依赖的数据层必须显式存在）。
# =============================================================================

:DecisionItem a owl:Class ;
    rdfs:label "决议事项（会议记录行）" ;
    :physicalTable "meeting_hub_raw" ;
    :primaryKey "c2" ;
    :timeColumn "c1" ;
    :businessDescription "一行 = 一条决议事项，粒度就是「纪要里的一行」，不是「一场会议」。客户导出的表没有会议键：同一场会的 9 条事项共用一个会议日期和会议名称，但没有任何字段能证明两行属于同一场会（同名同日会议确实存在），所以「会议场次」不能用本表 count 出来。表内 3562 行、4 个厂区（HQ 3125 / SW 253 / OS 184）、2026-01-01→2026-12-27。c2（序号）是导出时的行号，全表唯一，只能当行标识用，没有业务含义" .

# --- 会议元数据（每行都重复一遍，不是会议维表） -------------------------------

:siteCode a owl:DatatypeProperty ; rdfs:label "厂区代码" ; :askedAs "厂区" ;
    rdfs:domain :DecisionItem ; :physicalColumn "c0" ;
    :businessDescription "厂区代码，只有 HQ / SW / OS 三个取值（另外 0 行空值）。是唯一的组织维度；本库没有部门、没有课别，所以「部门归口」在这份数据上无法回答" .

:meetingDateRaw a owl:DatatypeProperty ; rdfs:label "会议日期（原始文本）" ; :askedAs "会议日期" ;
    rdfs:domain :DecisionItem ; :physicalColumn "c1" ;
    :businessDescription "会议日期，存成 text 的 ISO 日期（2026-01-01…2026-12-27，3562 行全部可解析，无空值）。它是本表唯一的时间轴，但因为是 text，按月/按周分桶需要一次 CAST，当前没有声明可用的时间分桶" .

:rowSeq a owl:DatatypeProperty ; rdfs:label "导出行号" ; :askedAs "序号" ;
    rdfs:domain :DecisionItem ; :physicalColumn "c2" ;
    :businessDescription "导出时的行号，1…3562 唯一。仅作行标识（类主键），不是会议序号、不是事项序号，不要用它排序当成业务顺序" .

:meetingTypeRaw a owl:DatatypeProperty ; rdfs:label "会议类型（原始标签）" ; :askedAs "会议类型" ;
    rdfs:domain :DecisionItem ; :physicalColumn "c3" ;
    :businessDescription "客户下拉框的 14 个原始标签，其中 3 个是组合式脏值（例会/工作汇报 257、例会/临时会议 7）：下拉无法单选导致一格塞两类。统计必须归一化（规格 §2.5），直接按原始标签分组会把同一类会拆开" .

:meetingName a owl:DatatypeProperty ; rdfs:label "会议名称" ; :askedAs "会议名称" ;
    rdfs:domain :DecisionItem ; :physicalColumn "c4" ;
    :businessDescription "会议名称。它与会议日期一起被当成「同一场会」的线索，但同名同日重复出现（不同厂区/不同主导人），所以它不是会议主键，只能做展示与下钻" .

:timeSlotRaw a owl:DatatypeProperty ; rdfs:label "时段（原始文本）" ; :askedAs "时段" ;
    rdfs:domain :DecisionItem ; :physicalColumn "c5" ;
    :businessDescription "时段，形如「09:00~10:30」的起止文本，也有「下午」这类非结构化值。起止时间混在一个 text 列里，要按小时分桶得先把它拆成两列（数据层改造），当前不声明时段分析" .

# 名字用小写蛇形是本体的规矩：:formula 里的标识符按 [a-z_] 切词（编译器只认小写），
# camelCase 的属性名在 formula 里永远解析不到。
:duration_minutes_raw a owl:DatatypeProperty ; rdfs:label "时长（分钟，原始文本）" ; :askedAs "时长" ;
    rdfs:domain :DecisionItem ; :physicalColumn "c6" ;
    :businessDescription "会议时长，单位分钟，存成 text 但全部是整数（15…600），求和/求平均需要一次 ::int 转换。注意：这是「整场会的时长」，却挂在每条事项行上，按行求和等于按「事项数」重复计一次会议时长，所以时长类指标必须同时说清口径（见 minutesSum / avgMinutesPerItem）" .

:hostRaw a owl:DatatypeProperty ; rdfs:label "主导人（原始文本）" ; :askedAs "主导人" ;
    rdfs:domain :DecisionItem ; :physicalColumn "c7" ;
    :businessDescription "会议主导人姓名，自由文本，存在「张三/李四」这类多人写法，没有人员主数据表可以对账。只能做点名计数，不能做人员归一化" .

:attendeesRaw a owl:DatatypeProperty ; rdfs:label "参会人员（原始文本）" ; :askedAs "参会人员" ;
    rdfs:domain :DecisionItem ; :physicalColumn "c8" ;
    :businessDescription "参会人员，一个 text 里放多个人，分隔符不统一（、，,/／;；空格）。按分隔符拆分后全表 23793 人次；拆分是「人时」口径的唯一入口，拆错一格就多算一个人" .

:venueName a owl:DatatypeProperty ; rdfs:label "场所" ; :askedAs "场所" ;
    rdfs:domain :DecisionItem ; :physicalColumn "c9" ;
    :businessDescription "开会场所（会议室名 / 线上 / 车间现场等），自由文本，含少量空白差异。可用于「在哪开的会」的分布，不能用于成本核算（本库无场地费率）" .

# --- 决议事项本身 -------------------------------------------------------------

:noteText a owl:DatatypeProperty ; rdfs:label "会议纪要 / 决议事项内容" ; :askedAs "纪要" ;
    rdfs:domain :DecisionItem ; :physicalColumn "c10" ;
    :businessDescription "会议纪要正文，实际写的是「这一条决议事项的内容」。1617 行是占位（无 / 空 / — / -），说明这部分会议没留纪要或没录入；长度 ≤3 字符的短值也不是有效纪要" .

:责任人 a owl:DatatypeProperty ; rdfs:label "责任人（原始文本）" ; :askedAs "责任人" ;
    # 本地名用中文是刻意的：「按责任人看…」这类问题的维度覆盖率是按 :groupBy 属性名的词来判定的，
    # 名字叫 ownerRaw 就需要一条「责任人→owner」的别名，而「无责任人占比」里也含「责任人」，
    # 那条别名会让它凭空多出一个 ownerRaw 维度，被 dims 检查判成「没有指标同时按厂区和责任人分组」。
    rdfs:domain :DecisionItem ; :physicalColumn "c11" ;
    :businessDescription "责任人，自由文本。1630 行写「无」+ 3 行空值 = 1633 行没有责任人（占 45.8%），这不是「一条有效记录」而是缺失；另外还有「所有人/各课」这类泛指派，需要业务给词表才能判定，本本体不做猜测" .

:planFinishRaw a owl:DatatypeProperty ; rdfs:label "计划完成时间（原始文本）" ; :askedAs "计划完成时间" ;
    rdfs:domain :DecisionItem ; :physicalColumn "c12" ;
    :businessDescription "计划完成时间。混合了 6 种写法：ISO 日期（1669 行）、斜杠日期 2026/9/22（8 行）、「无 1630 / 持续进行 117 / 持续执行 28 / 每周 6 …」这类非日期承诺。只有两列都能解析成日期时才能判「按期/超期」，这个分母是 1678 行，不是 3562" .

:actualFinishRaw a owl:DatatypeProperty ; rdfs:label "实际完成时间（原始文本）" ; :askedAs "实际完成时间" ;
    rdfs:domain :DecisionItem ; :physicalColumn "c13" ;
    :businessDescription "实际完成时间，写法与计划列同构（含「持续跟进 8 / 按完成时间 3 / / 6」等非日期值）。单看这一列不能判断「已闭环」——闭环必须是「计划与实际都可解析」才有意义，而且本库没有审核/佐证表，所以能算的只是「日期上按期」，不等于业务确认的闭环" .

# =============================================================================
# 出席记录（视图 meeting_hub_attendance）：一行 = 一场会 × 一个人
# 会议键 = (厂区, 会议日期, 会议名称, 时段, 主导人)，取自 raw 的 c0/c1/c4/c5/c7（Q3）。
# 这一层存在的唯一理由：raw 的粒度是「事项」，人时必须落在「会议×人」上才不会被重复计数。
# =============================================================================

:Attendance a owl:Class ;
    rdfs:label "出席记录（会议 × 人）" ;
    :physicalTable "meeting_hub_attendance" ;
    :primaryKey "attendance_key" ;
    :timeColumn "meeting_date" ;
    :businessDescription "一行 = 一个人出现在一场会里（出席记录），11849 行、2270 个会议键。粒度是「会×人」，不是「事项」：人时（会议时长×人数）只有落在这一层才可加，落在事项行上会按事项数把同一场会的时长重复计 1~9 次。它是本库唯一有真实会议粒度的数据层，但它是本本体声明的数据层（视图），不是客户原始表：raw 一张表里没有任何字段能证明两行属于同一场会，会议键是 Q3 人确认的四元组（厂区+日期+会议名称+时段+主导人）。同名同日不同主导人算两场会，这是口径选择，不是数据事实" .

:attendance_key a owl:DatatypeProperty ; rdfs:label "出席记录键" ; :askedAs "出席" ;
    rdfs:domain :Attendance ; :physicalColumn "attendance_key" ;
    :businessDescription "会议键 || '|' || 人名，视图内唯一（11849/11849）。类主键，没有业务含义" .

:meeting_key a owl:DatatypeProperty ; rdfs:label "会议键" ; :askedAs "会议" ;
    rdfs:domain :Attendance ; :physicalColumn "meeting_key" ;
    :businessDescription "会议键文本 = 厂区|日期|会议名称|时段|主导人。2270 个取值。它是「一场会」的唯一标识，但只在视图里成立（见 :Attendance 的说明）" .

:site_code a owl:DatatypeProperty ; rdfs:label "厂区代码" ; :askedAs "厂区" ;
    rdfs:domain :Attendance ; :physicalColumn "site_code" ;
    :businessDescription "厂区代码 HQ / SW / OS。与 :DecisionItem 上的 :siteCode 是同一列 c0 的两次声明：一个是事项行粒度、一个是出席记录粒度，名字不同是为了让「两个类不共享属性名」这条结构纪律成立（共享名会让编译器在需要 join 的地方按名拒绝）。两边数值永远一致（同一列）" .

:meeting_date a owl:DatatypeProperty ; rdfs:label "会议日期（date）" ; :askedAs "会议日期" ;
    rdfs:domain :Attendance ; :physicalColumn "meeting_date" ;
    :businessDescription "会议日期，已类型化成 date（视图里 c1::date，3562 行全部可解析）。人时的时间轴用这一列，不是 raw 里的 text 列 :meetingDateRaw" .

:duration_minutes a owl:DatatypeProperty ; rdfs:label "时长（分钟，整数）" ; :askedAs "时长" ;
    rdfs:domain :Attendance ; :physicalColumn "duration_minutes" ;
    :businessDescription "整场会的时长，单位分钟，已类型化成 integer（视图里 c6::int，取值 15…600，同一会议键下恒定 —— 实测 2270 个会议键里 0 个出现两个时长）。它随出席记录重复出现，所以人时 = Σ(时长)/60 只在这层可加；raw 的 :duration_minutes_raw 挂的是同一个值，但挂在事项行上" .

:meeting_type a owl:DatatypeProperty ; rdfs:label "会议类型（会议级标签）" ; :askedAs "会议类型" ;
    rdfs:domain :Attendance ; :physicalColumn "meeting_type" ;
    :businessDescription "会议级的会议类型标签：同一会议键下行级 c3 的取值。2270 个会议键里 2262 个只有一种标签，8 个有两种（专项汇报/项目会议、临时/工作汇报、培训/工作汇报），视图对它们取 min(c3)（字典序）。这 8 场会都没有跨过「面试/接待客户」边界，所以按它剔除非会议不会错；但按类型拆人时时这 8 场会会整体落到字典序较小的那一类 —— 这是 0.35% 的口径噪声，已写进 :manHoursByMeetingType 的说明。别把它当成归一化后的类型：归一化（规格 §2.5）在事项层仍由 :WeeklyMeetingItem 等四个类负责" .

:person a owl:DatatypeProperty ; rdfs:label "参会人（单人）" ; :askedAs "参会人" ;
    rdfs:domain :Attendance ; :physicalColumn "person" ;
    :businessDescription "单个参会人的姓名，从 c8 按 [,、;；/／空格] 拆分并 btrim 后的结果。全表 11849 个非空值（拆分后空串被丢掉）。同一格里的多人写法、全半角差异、同名不同人，都没有归一化 —— 本库没有人员主数据表可以对账" .

# =============================================================================
# 会议（视图 meeting_hub_meeting）：一行 = 一场会
# 粒度就是 Q3 确认的会议键 (厂区, 会议日期, 会议名称, 时段, 主导人)，与 :Attendance 同一个键，
# 只是把「会×人」塌缩成「会」。它存在的理由：raw 的 c2 是导出行号，不是场次；要回答
# 「开了多少场会」必须有一个按会议键去重的数据层，而这一层只能是声明出来的视图。
# 视图定义 = meeting_hub_attendance 上的 SELECT DISTINCT（生成脚本 generated/meeting_v1_views.sql，
# 与 :Attendance 同一次授权）。没有任何新的业务判断：键还是那个四元组。
# =============================================================================

:Meeting a owl:Class ;
    rdfs:label "会议（一场会一行）" ;
    :physicalTable "meeting_hub_meeting" ;
    :primaryKey "meeting_key" ;
    :timeColumn "meeting_date" ;
    :businessDescription "一行 = 一场会（会议键唯一，2270 行 / 2270 个键）。粒度是「会」，不是「事项」、也不是「会×人」：事项层用 :DecisionItem（3562 行），人次层用 :Attendance（11849 行）。三个粒度上的数不能相加，可以互相做分母：每场平均参会人次 = 人次 ÷ 场次。注意场次是**声明的口径**而不是库里的字段：raw 没有任何一列证明两行属于同一场会，键是 Q3 人确认的四元组；同名同日不同主导人算两场会" .

:m_key a owl:DatatypeProperty ; rdfs:label "会议键" ; :askedAs "会议编号" ;
    rdfs:domain :Meeting ; :physicalColumn "meeting_key" ;
    :businessDescription "厂区|日期|会议名称|时段|主导人 拼成的文本键，视图内唯一（2270/2270）。类主键，没有业务含义；不要与 raw 的 c2（导出行号）混用" .

:m_site a owl:DatatypeProperty ; rdfs:label "厂区代码（会议级）" ; :askedAs "厂区" ;
    rdfs:domain :Meeting ; :physicalColumn "site_code" ;
    :businessDescription "厂区代码 HQ / SW / OS，与 :DecisionItem 的 c0、:Attendance 的 site_code 是同一列。名字不同是结构纪律（两个类不共享属性名），数值永远一致" .

:m_date a owl:DatatypeProperty ; rdfs:label "会议日期（会议级 date）" ; :askedAs "会议日期" ;
    rdfs:domain :Meeting ; :physicalColumn "meeting_date" ;
    :businessDescription "会议日期，已类型化成 date（视图里 c1::date）。它是场次类指标的时间轴；raw 里的 :meetingDateRaw 是 text，两者同源" .

:m_minutes a owl:DatatypeProperty ; rdfs:label "会议时长（分钟，会议级）" ; :askedAs "会议时长" ;
    rdfs:domain :Meeting ; :physicalColumn "duration_minutes" ;
    :businessDescription "整场会的时长（整数分钟，视图里 c6::int，5…713，0 个空值）。在 :Meeting 上它一场一行，可以直接求平均；在 :Attendance 上它随人数重复，只能求和做加权" .

:m_type a owl:DatatypeProperty ; rdfs:label "会议类型（会议级）" ; :askedAs "会议类型" ;
    rdfs:domain :Meeting ; :physicalColumn "meeting_type" ;
    :businessDescription "会议键上的类型标签（行级 c3 取 min）：2270 场里 2262 场只有一种标签，8 场有两种。它是**未归一化**的 14 个原始标签，归一化在事项层的 :WeeklyMeetingItem 等四个类" .
