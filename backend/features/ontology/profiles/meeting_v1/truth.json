{
  "_comment": [
    "truth.json — 第二条手写 SQL 路线（R2 定义等价门禁）。每个定义类给出「独立写的谓词 + 表」，",
    "门禁把它的计数和编译出来的谓词计数比。数字路线（指标值）由 samples.json 的 route 字段承担。"
  ],
  "_definitions": {
    "OwnedItem": [
      "meeting_hub_raw",
      "c11 IS NOT NULL AND btrim(c11) NOT IN ('', '无', '—', '-')"
    ],
    "NoOwnerItem": [
      "meeting_hub_raw",
      "c11 IS NULL OR btrim(c11) IN ('', '无', '—', '-')"
    ],
    "NotedItem": [
      "meeting_hub_raw",
      "btrim(c10) NOT IN ('', '无', '—', '-') AND char_length(btrim(c10)) > 3"
    ],
    "NonMeetingItem": [
      "meeting_hub_raw",
      "c3 LIKE '面试%' OR c3 LIKE '接待%'"
    ],
    "MeetingItem": [
      "meeting_hub_raw",
      "NOT (c3 LIKE '面试%' OR c3 LIKE '接待%')"
    ],
    "WeeklyMeetingItem": [
      "meeting_hub_raw",
      "c3 IN ('周会', '例会')"
    ],
    "TrainingMeetingItem": [
      "meeting_hub_raw",
      "c3 = '培训'"
    ],
    "AmbiguousTypeItem": [
      "meeting_hub_raw",
      "c3 = '例会/工作汇报'"
    ],
    "DatedItem": [
      "meeting_hub_raw",
      "translate(left(c12,10),'/',  '-') ~ '^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}' AND translate(left(c13,10),'/',  '-') ~ '^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}'"
    ],
    "OverdueItem": [
      "meeting_hub_raw",
      "translate(left(c12,10),'/',  '-') ~ '^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}' AND translate(left(c13,10),'/',  '-') ~ '^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}' AND translate(left(c13,10),'/',  '-')::date > translate(left(c12,10),'/',  '-')::date"
    ],
    "MeetingAttendance": [
      "meeting_hub_attendance",
      "meeting_type NOT IN ('面试', '接待客户')"
    ],
    "AllAttendance": [
      "meeting_hub_attendance",
      "1=1"
    ],
    "MeetingClass": [
      "meeting_hub_meeting",
      "meeting_type NOT IN ('面试', '接待客户')"
    ],
    "AllMeetings": [
      "meeting_hub_meeting",
      "1=1"
    ],
    "NoNoteItem": [
      "meeting_hub_raw",
      "c10 IS NULL OR btrim(c10) IN ('', '无', '—', '-') OR length(btrim(c10)) <= 3"
    ]
  }
}
