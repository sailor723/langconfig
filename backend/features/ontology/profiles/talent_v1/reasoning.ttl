# Role axioms generated by scripts/talent/author_tbox.py from the client's job descriptions.
# A role becomes a DEFINED class: nobody types a candidate with it, the reasoner entails it.
@prefix : <https://cube.local/ontology/talent_v1#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Candidate a owl:Class .
:Role a owl:Class ; owl:disjointWith :Candidate .
:SkillTag a owl:Class .

:hasSkill a owl:ObjectProperty ; rdfs:domain :Candidate ; rdfs:range :SkillTag .
:yearsExperience a owl:DatatypeProperty ; rdfs:domain :Candidate ; rdfs:range xsd:integer .
:educationRank a owl:DatatypeProperty ; rdfs:domain :Candidate ; rdfs:range xsd:integer .
:appliedFor a owl:ObjectProperty ; rdfs:domain :Candidate ; rdfs:range :Role .
:missingData a owl:ObjectProperty ; rdfs:domain :Candidate .
:salaryMinK a owl:DatatypeProperty ; rdfs:domain :Candidate ; rdfs:range xsd:integer .
:salaryMaxK a owl:DatatypeProperty ; rdfs:domain :Candidate ; rdfs:range xsd:integer .
:age a owl:DatatypeProperty ; rdfs:domain :Candidate ; rdfs:range xsd:integer .
:sourceFile a owl:DatatypeProperty ; rdfs:domain :Candidate ; rdfs:range xsd:string .
:requiredYears a owl:DatatypeProperty ; rdfs:domain :Role ; rdfs:range xsd:integer .
:requiredEducationRank a owl:DatatypeProperty ; rdfs:domain :Role ; rdfs:range xsd:integer .
:requiresSkill a owl:ObjectProperty ; rdfs:domain :Role ; rdfs:range :SkillTag .
:notStated a owl:DatatypeProperty ; rdfs:domain :Role ; rdfs:range xsd:string .

# ── skill categories (generated from the vocabulary the ABox types individuals with)
:AdminSkill a owl:Class ; rdfs:subClassOf :SkillTag .
:BusinessSystem a owl:Class ; rdfs:subClassOf :SkillTag .
:CAD a owl:Class ; rdfs:subClassOf :SkillTag .
:CompensationSkill a owl:Class ; rdfs:subClassOf :SkillTag .
:CustomsSkill a owl:Class ; rdfs:subClassOf :SkillTag .
:DesignSoftware a owl:Class ; rdfs:subClassOf :SkillTag .
:FinanceSkill a owl:Class ; rdfs:subClassOf :SkillTag .
:LaborLawKnowledge a owl:Class ; rdfs:subClassOf :SkillTag .
:LanguageSkill a owl:Class ; rdfs:subClassOf :SkillTag .
:OfficeSoftware a owl:Class ; rdfs:subClassOf :SkillTag .
:OperationsSkill a owl:Class ; rdfs:subClassOf :SkillTag .
:OrderTracking a owl:Class ; rdfs:subClassOf :SkillTag .
:QualitySystem a owl:Class ; rdfs:subClassOf :SkillTag .
:RecruitingSkill a owl:Class ; rdfs:subClassOf :SkillTag .
:SpreadsheetSoftware a owl:Class ; rdfs:subClassOf :SkillTag .
:TradeSkill a owl:Class ; rdfs:subClassOf :SkillTag .

# ── role definitions, one per job description that stated enough to judge

# 品质经理: any of ['ISO/TS16949', '英语'] -> categories ['LanguageSkill', 'QualitySystem']; years>=3 education>=大专
:skillsFor_品质经理 a owl:Class ; rdfs:subClassOf :SkillTag ;
    owl:equivalentClass [ owl:unionOf ( :LanguageSkill :QualitySystem ) ] .
:matches_品质经理 a owl:Class ;
    rdfs:label "matches_品质经理 (品质经理)" ;
    owl:equivalentClass [ owl:intersectionOf (
        :Candidate
        [ a owl:Restriction ; owl:onProperty :hasSkill ; owl:someValuesFrom :skillsFor_品质经理 ]
        [ a owl:Restriction ; owl:onProperty :yearsExperience ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                               owl:withRestrictions ( [ xsd:minInclusive 3 ] ) ] ]
        [ a owl:Restriction ; owl:onProperty :educationRank ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                               owl:withRestrictions ( [ xsd:minInclusive 3 ] ) ] ]
    ) ] .

# 业务跟单: any of ['Excel', '行政', '跟单'] -> categories ['AdminSkill', 'OrderTracking', 'SpreadsheetSoftware']; years>=2 education>=中专/高中
:skillsFor_业务跟单 a owl:Class ; rdfs:subClassOf :SkillTag ;
    owl:equivalentClass [ owl:unionOf ( :AdminSkill :OrderTracking :SpreadsheetSoftware ) ] .
:matches_业务跟单 a owl:Class ;
    rdfs:label "matches_业务跟单 (业务跟单)" ;
    owl:equivalentClass [ owl:intersectionOf (
        :Candidate
        [ a owl:Restriction ; owl:onProperty :hasSkill ; owl:someValuesFrom :skillsFor_业务跟单 ]
        [ a owl:Restriction ; owl:onProperty :yearsExperience ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                               owl:withRestrictions ( [ xsd:minInclusive 2 ] ) ] ]
        [ a owl:Restriction ; owl:onProperty :educationRank ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                               owl:withRestrictions ( [ xsd:minInclusive 2 ] ) ] ]
    ) ] .

# 副总助理: any of ['Excel', 'Illustrator', 'PowerPoint', 'Word', '薪酬绩效'] -> categories ['CompensationSkill', 'DesignSoftware', 'OfficeSoftware', 'SpreadsheetSoftware']; years>=2 education>=大专
:skillsFor_副总助理 a owl:Class ; rdfs:subClassOf :SkillTag ;
    owl:equivalentClass [ owl:unionOf ( :CompensationSkill :DesignSoftware :OfficeSoftware :SpreadsheetSoftware ) ] .
:matches_副总助理 a owl:Class ;
    rdfs:label "matches_副总助理 (副总助理)" ;
    owl:equivalentClass [ owl:intersectionOf (
        :Candidate
        [ a owl:Restriction ; owl:onProperty :hasSkill ; owl:someValuesFrom :skillsFor_副总助理 ]
        [ a owl:Restriction ; owl:onProperty :yearsExperience ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                               owl:withRestrictions ( [ xsd:minInclusive 2 ] ) ] ]
        [ a owl:Restriction ; owl:onProperty :educationRank ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                               owl:withRestrictions ( [ xsd:minInclusive 3 ] ) ] ]
    ) ] .

# 业务助理: any of ['外贸业务'] -> categories ['TradeSkill']; years>=2 education>=中专/高中
:skillsFor_业务助理 a owl:Class ; rdfs:subClassOf :SkillTag ;
    owl:equivalentClass [ owl:unionOf ( :TradeSkill ) ] .
:matches_业务助理 a owl:Class ;
    rdfs:label "matches_业务助理 (业务助理)" ;
    owl:equivalentClass [ owl:intersectionOf (
        :Candidate
        [ a owl:Restriction ; owl:onProperty :hasSkill ; owl:someValuesFrom :skillsFor_业务助理 ]
        [ a owl:Restriction ; owl:onProperty :yearsExperience ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                               owl:withRestrictions ( [ xsd:minInclusive 2 ] ) ] ]
        [ a owl:Restriction ; owl:onProperty :educationRank ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                               owl:withRestrictions ( [ xsd:minInclusive 2 ] ) ] ]
    ) ] .

# 专案工程师: any of ['AutoCAD'] -> categories ['CAD']; years>=3 education: NOT STATED · NOT STATED: ['education_floor']
:skillsFor_专案工程师 a owl:Class ; rdfs:subClassOf :SkillTag ;
    owl:equivalentClass [ owl:unionOf ( :CAD ) ] .
:matches_专案工程师 a owl:Class ;
    rdfs:label "matches_专案工程师 (专案工程师)" ;
    owl:equivalentClass [ owl:intersectionOf (
        :Candidate
        [ a owl:Restriction ; owl:onProperty :hasSkill ; owl:someValuesFrom :skillsFor_专案工程师 ]
        [ a owl:Restriction ; owl:onProperty :yearsExperience ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                               owl:withRestrictions ( [ xsd:minInclusive 3 ] ) ] ]
    ) ] .

# 招聘专员: any of ['招聘', '薪酬绩效', '行政'] -> categories ['AdminSkill', 'CompensationSkill', 'RecruitingSkill']; years>=1 education>=中专/高中
:skillsFor_招聘专员 a owl:Class ; rdfs:subClassOf :SkillTag ;
    owl:equivalentClass [ owl:unionOf ( :AdminSkill :CompensationSkill :RecruitingSkill ) ] .
:matches_招聘专员 a owl:Class ;
    rdfs:label "matches_招聘专员 (招聘专员)" ;
    owl:equivalentClass [ owl:intersectionOf (
        :Candidate
        [ a owl:Restriction ; owl:onProperty :hasSkill ; owl:someValuesFrom :skillsFor_招聘专员 ]
        [ a owl:Restriction ; owl:onProperty :yearsExperience ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                               owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ]
        [ a owl:Restriction ; owl:onProperty :educationRank ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                               owl:withRestrictions ( [ xsd:minInclusive 2 ] ) ] ]
    ) ] .

# 管理课长: any of ['招聘', '薪酬绩效', '行政'] -> categories ['AdminSkill', 'CompensationSkill', 'RecruitingSkill']; years>=5 education>=大专
:skillsFor_管理课长 a owl:Class ; rdfs:subClassOf :SkillTag ;
    owl:equivalentClass [ owl:unionOf ( :AdminSkill :CompensationSkill :RecruitingSkill ) ] .
:matches_管理课长 a owl:Class ;
    rdfs:label "matches_管理课长 (管理课长)" ;
    owl:equivalentClass [ owl:intersectionOf (
        :Candidate
        [ a owl:Restriction ; owl:onProperty :hasSkill ; owl:someValuesFrom :skillsFor_管理课长 ]
        [ a owl:Restriction ; owl:onProperty :yearsExperience ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                               owl:withRestrictions ( [ xsd:minInclusive 5 ] ) ] ]
        [ a owl:Restriction ; owl:onProperty :educationRank ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                               owl:withRestrictions ( [ xsd:minInclusive 3 ] ) ] ]
    ) ] .
