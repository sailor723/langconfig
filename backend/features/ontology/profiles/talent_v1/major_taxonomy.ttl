# 专业层级 —— 由 scripts/talent/build_major_taxonomy.py 生成,不要手改。
# 目的:让「等工程类专业」这种说法能被推理,而不是被正则近似。
@prefix : <https://cube.local/ontology/talent_v1#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Major a owl:Class .
:MajorField a owl:Class ; owl:disjointUnionOf ( :field_医学 :field_工学 :field_教育学 :field_文学 :field_法学 :field_理学 :field_管理学 :field_经济学 :field_艺术学 ) .
:MajorCategory a owl:Class .

:field_医学 a owl:Class, :MajorField ; rdfs:label "医学" .
:field_工学 a owl:Class, :MajorField ; rdfs:label "工学" .
:field_教育学 a owl:Class, :MajorField ; rdfs:label "教育学" .
:field_文学 a owl:Class, :MajorField ; rdfs:label "文学" .
:field_法学 a owl:Class, :MajorField ; rdfs:label "法学" .
:field_理学 a owl:Class, :MajorField ; rdfs:label "理学" .
:field_管理学 a owl:Class, :MajorField ; rdfs:label "管理学" .
:field_经济学 a owl:Class, :MajorField ; rdfs:label "经济学" .
:field_艺术学 a owl:Class, :MajorField ; rdfs:label "艺术学" .

:cat_中国语言文学类 a owl:Class, :MajorCategory ; rdfs:label "中国语言文学类" ; :majorField :field_文学 
    ; rdfs:subClassOf :field_文学 .
:cat_交通运输类 a owl:Class, :MajorCategory ; rdfs:label "交通运输类" ; :majorField :field_工学 
    ; rdfs:subClassOf :field_工学 .
:cat_公共管理类 a owl:Class, :MajorCategory ; rdfs:label "公共管理类" ; :majorField :field_管理学 
    ; rdfs:subClassOf :field_管理学 .
:cat_医学技术类 a owl:Class, :MajorCategory ; rdfs:label "医学技术类" ; :majorField :field_医学 
    ; rdfs:subClassOf :field_医学 .
:cat_土木建筑类 a owl:Class, :MajorCategory ; rdfs:label "土木建筑类" ; :majorField :field_工学 
    ; rdfs:subClassOf :field_工学 .
:cat_外国语言文学类 a owl:Class, :MajorCategory ; rdfs:label "外国语言文学类" ; :majorField :field_文学 
    ; rdfs:subClassOf :field_文学 .
:cat_安全科学与工程类 a owl:Class, :MajorCategory ; rdfs:label "安全科学与工程类" ; :majorField :field_工学 
    ; rdfs:subClassOf :field_工学 .
:cat_工商管理类 a owl:Class, :MajorCategory ; rdfs:label "工商管理类" ; :majorField :field_管理学 
    ; rdfs:subClassOf :field_管理学 .
:cat_心理学类 a owl:Class, :MajorCategory ; rdfs:label "心理学类" ; :majorField :field_理学 
    ; rdfs:subClassOf :field_理学 .
:cat_教育学类 a owl:Class, :MajorCategory ; rdfs:label "教育学类" ; :majorField :field_教育学 
    ; rdfs:subClassOf :field_教育学 .
:cat_旅游管理类 a owl:Class, :MajorCategory ; rdfs:label "旅游管理类" ; :majorField :field_管理学 
    ; rdfs:subClassOf :field_管理学 .
:cat_机械类 a owl:Class, :MajorCategory ; rdfs:label "机械类" ; :majorField :field_工学 
    ; rdfs:subClassOf :field_工学 .
:cat_机电设备类 a owl:Class, :MajorCategory ; rdfs:label "机电设备类" ; :majorField :field_工学 
    ; rdfs:subClassOf :field_工学 .
:cat_材料类 a owl:Class, :MajorCategory ; rdfs:label "材料类" ; :majorField :field_工学 
    ; rdfs:subClassOf :field_工学 .
:cat_法学类 a owl:Class, :MajorCategory ; rdfs:label "法学类" ; :majorField :field_法学 
    ; rdfs:subClassOf :field_法学 .
:cat_物流管理与工程类 a owl:Class, :MajorCategory ; rdfs:label "物流管理与工程类" ; :majorField :field_管理学 
    ; rdfs:subClassOf :field_管理学 .
:cat_电子信息类 a owl:Class, :MajorCategory ; rdfs:label "电子信息类" ; :majorField :field_工学 
    ; rdfs:subClassOf :field_工学 .
:cat_纺织类 a owl:Class, :MajorCategory ; rdfs:label "纺织类" ; :majorField :field_工学 
    ; rdfs:subClassOf :field_工学 .
:cat_经济与贸易类 a owl:Class, :MajorCategory ; rdfs:label "经济与贸易类" ; :majorField :field_经济学 
    ; rdfs:subClassOf :field_经济学 .
:cat_自动化类 a owl:Class, :MajorCategory ; rdfs:label "自动化类" ; :majorField :field_工学 
    ; rdfs:subClassOf :field_工学 .
:cat_计算机类 a owl:Class, :MajorCategory ; rdfs:label "计算机类" ; :majorField :field_工学 
    ; rdfs:subClassOf :field_工学 .
:cat_设计学类 a owl:Class, :MajorCategory ; rdfs:label "设计学类" ; :majorField :field_艺术学 
    ; rdfs:subClassOf :field_艺术学 .

