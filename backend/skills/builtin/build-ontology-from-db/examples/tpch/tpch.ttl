@prefix : <https://cube.local/ontology/tpch#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cube.local/ontology/tpch> a owl:Ontology ;
    rdfs:label "TPC-H ontology, merged from the tutorial track" ;
    rdfs:comment "Union of the generated structure files and the hand-written meaning files, plus the sql-first overlay that declares :aggregate/:grain/:universe. Generated by merge_ttl.py — do not edit; edit the sources." .

:DiscountedSale a owl:Class ;
    rdfs:label "Discounted sale" ;
    rdfs:comment "A line carrying a discount greater than zero. The first definition in this track whose criterion is a comparison rather than a threshold — and the seam gate has to compare `>` with the SQL's `>`, not only the number." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OrderLine [ a owl:Restriction ;
                        owl:onProperty :l_discount ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minExclusive 0.0 ] ) ] ] ) ] ;
    :businessAlias "discounted lines",
        "discounted sales" ;
    :thresholdSource "definitional: any discount at all (> 0) — no policy threshold is involved, which is why this one is a `minExclusive` facet and the others are `minInclusive`. Measured 2026-09-21: 546,433 of 600,572 lines (90.99%), so it excludes rather than selects." .

:HighValueOrder a owl:Class ;
    rdfs:label "High value order" ;
    rdfs:comment "An order whose total is at or above 5000. Deliberately a different class from HighValueLine (line grain): an order is not a line, and neither set implies the other — measured, 148,552 orders against 148,517 orders having such a line." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :SalesOrder [ a owl:Restriction ;
                        owl:onProperty :o_totalprice ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 5000.0 ] ) ] ] ) ] ;
    :businessAlias "big order",
        "high value orders" ;
    :thresholdSource "RATIFIED 2026-09-21 by weiping (acting business approver): 5000 is the gate number, at all three grains it is used at. Measured here: 99.03% of orders qualify (148,552 of 150,000), against 44.89% of customers and 93.65% of lines at the same value -- which is why one number is stated three times instead of factored out." .

:LateLine a owl:Class ;
    rdfs:label "Late line" ;
    rdfs:comment "The only definition in this track stated as a `:physicalPredicate` rather than an equivalence axiom, because it compares two properties of the same individual and OWL cannot express that. `rdfs:subClassOf :OrderLine` states the part that OWL CAN carry (the grain), the predicate states the criterion, and `check_mapping.py` rule 7 keeps the predicate and the SQL that runs equal -- including the comparison operator, which is the half a numeric rule could never see." ;
    rdfs:subClassOf :OrderLine ;
    :businessAlias "late lines",
        "late shipments" ;
    :businessDescription "A line shipped AFTER the date it was promised for. Measured 2026-09-21: 302,748 of 600,572 lines (50.41%), carrying 10,905,811,109.64 of extended price. NOT the same set as lines shipped on or after that date: `>=` selects 307,800, and the 5,052 lines in between were shipped exactly on the promise date, which the register's wording does not call late." ;
    :physicalPredicate "l_shipdate > l_commitdate" .

:OrderWithHighValueLine a owl:Class ;
    rdfs:label "Order with a high value line" ;
    rdfs:comment "Defined with an existential restriction over :hasLine, whose filler is :HighValueLine -- the first definition in this track that REUSES a defined class instead of a numeric facet, so the 5000 is stated once (in :HighValueLine) and this class inherits it. `check_mapping.py` rule 3 accepts the measure that implements it on the line-grain cube, because a `count_distinct` over :l_orderkey answers at the order grain; the same member compiled as a plain `count` would count LINES and is refused." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :SalesOrder [ a owl:Restriction ;
                        owl:onProperty :hasLine ;
                        owl:someValuesFrom :HighValueLine ] ) ] ;
    :businessAlias "order with a big line",
        "orders with a high value line" ;
    :businessDescription "An order having AT LEAST ONE line whose extended price is at least 5000. NOT :HighValueOrder, and the two must not be confused: this one asks whether a big line exists inside the order, that one asks whether the order's total is big. Measured 2026-09-21: 148,517 against 148,552, so the counts are close and the SELECTIONS are not -- an order can be high value with no high-value line, and a line can be high value inside a low-value order." .

:ReturnedLine a owl:Class ;
    rdfs:label "Returned line" ;
    rdfs:comment "A line whose return flag is R. The only definition here whose criterion is a CODE, and therefore the only one `check_mapping.py`'s numeric rule cannot check: a literal has to be compared with a literal." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OrderLine [ a owl:Restriction ;
                        owl:hasValue "R" ;
                        owl:onProperty :l_returnflag ] ) ] ;
    :businessAlias "returned lines",
        "returns" ;
    :thresholdSource "definitional: the return status code is R — no threshold and no number are involved, which is why this one is an `owl:hasValue` restriction and the seam gate needs a rule for it that the numeric one cannot express. Measured 2026-09-21: 148,301 of 600,572 lines (24.69%) — the COPQ volume, worth 5,071,818,533 in returned value." .

:additivity a owl:AnnotationProperty .

:aggregate a owl:AnnotationProperty .

:averageLineValue a owl:DatatypeProperty ;
    rdfs:label "Average line value" ;
    rdfs:domain :OrderLine ;
    :additivity "non-additive" ;
    :aggregate "ratio_of_sums" ;
    :businessDescription "Net revenue divided by the number of lines: the average value of a line. A RATIO OF SUMS, not the average of the lines' individual values, and NOT additive -- the average across groups is not the sum of their averages. Both halves are checked: rule 6 compares this word with the member's `type`, so a `sum` wearing this name would be a different measurement. Its terms are MEMBERS, not columns: `revenue` and `line_items` belong to this same cube. Measured 2026-09-21: 34,192.52 over 600,572 lines." ;
    :formula "revenue / line_items" ;
    :formulaSource "register M-0011 (decided 2026-09-20 by weiping, acting business approver)" ;
    :grain :OrderLine ;
    :unit "money" ;
    :universe :OrderLine .

:averageOrderValue a owl:DatatypeProperty ;
    rdfs:label "Average order value" ;
    rdfs:domain :SalesOrder ;
    :additivity "non-additive" ;
    :businessDescription "Total order value divided by the number of orders: the average value of an order. A RATIO OF SUMS, not the mean of the orders' totals -- `avg(o_totalprice)` is a different number that happens not to be re-aggregatable at any other grain, and it is what the model first carried. Non-additive, and its formula divides, which is the check rule 6 makes. Measured 2026-09-21: 142,377.306870866667 over 150,000 orders." ;
    :formula "o_totalprice / 1" ;   # per row; ratio_of_sums turns it into sum(total) / count(*)
    :formulaSource "register M-0005 (ratified and re-shaped 2026-09-21)" ;
    :unit "money" .

:businessAlias a owl:AnnotationProperty .

:businessDescription a owl:AnnotationProperty .

:c_address a owl:DatatypeProperty ;
    rdfs:label "c_address" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:string ;
    :physicalColumn "c_address" ;
    :sqlType "character varying" .

:c_custkey a owl:DatatypeProperty ;
    rdfs:label "c_custkey" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:integer ;
    :businessAlias "Customer ID" ;
    :businessDescription "The customer's key. Hidden from consumers by Cube, because a dimension marked primary_key becomes public: false by default." ;
    :physicalColumn "c_custkey" ;
    :sqlType "bigint" .

:c_mktsegment a owl:DatatypeProperty ;
    rdfs:label "c_mktsegment" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:string ;
    :businessAlias "Market segment" ;
    :businessDescription "One of five segments: AUTOMOBILE, BUILDING, FURNITURE, HOUSEHOLD, MACHINERY. The vocabulary is enforced by a CHECK constraint on the column." ;
    :physicalColumn "c_mktsegment" ;
    :sqlType "character varying" ;
    :unit "text" .

:c_name a owl:DatatypeProperty ;
    rdfs:label "c_name" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:string ;
    :physicalColumn "c_name" ;
    :sqlType "character varying" .

:c_phone a owl:DatatypeProperty ;
    rdfs:label "c_phone" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:string ;
    :physicalColumn "c_phone" ;
    :sqlType "character varying" .

:columnCount a owl:AnnotationProperty .

:contributionMargin a owl:DatatypeProperty ;
    rdfs:label "Contribution margin" ;
    rdfs:domain :OrderLine ;
    :additivity "additive" ;
    :businessDescription "Net revenue minus the MATERIAL cost of what was sold. Named contribution, not gross, because TPC-H has no labour, overhead, depreciation or amortisation. Additive: a difference of two additive amounts. Its formula is written entirely in terms of OTHER MEASURES, and its Cube `type` is `number` rather than `sum` -- measured while adding this declaration, and the reason rule 6 compares the additivity WORD with the ARITHMETIC (a division is what makes a ratio non-additive) instead of with the member's type, which would have called this additive measure non-additive. Measured 2026-09-21: 12,877,154,937.2250." ;
    :formula "l_extendedprice * (1 - l_discount) - l_quantity * ps_supplycost" ;
    :formulaSource "register M-0013 (decided 2026-09-20 by weiping, acting business approver)" ;
    :unit "money" .

:contributionMarginPct a owl:DatatypeProperty ;
    rdfs:label "Contribution margin %" ;
    rdfs:domain :OrderLine ;
    :additivity "non-additive" ;
    :businessDescription "Contribution margin as a share of net revenue: 62.71% on this data. Non-additive for the obvious reason -- it divides -- and the register writes Cube's own divide-by-zero guard into the formula, which is why rule 6 strips `NULLIF(<expr>, 0)` from BOTH sides rather than treating it as a difference between the declaration and the SQL. The unit is `percent`, which the model already stated and which `unit_registry` does NOT carry (it has `ratio`, whose convention is 0.04 = 4%): a registered unit for percentages is owed, and the model's word is used here so the declaration and the model agree." ;
    :formula "contributionMargin / netRevenue" ;   # :scale "100.0" in the overlay
    :formulaSource "register M-0014 (decided 2026-09-20 by weiping, acting business approver)" ;
    :unit "percent" .

:customerRegion a owl:ObjectProperty ;
    rdfs:label "Customer region" ;
    rdfs:range :Region ;
    owl:propertyChainAxiom ( :c_nationkey :n_regionkey ) ;
    :businessAlias "Region" ;
    :businessDescription "The region a customer's nation belongs to: two hops, customer -> nation -> region. Group by the region's name; the intermediate nation key means nothing to a reader." .

:formula a owl:AnnotationProperty .

:formulaSource a owl:AnnotationProperty .

:grain a owl:AnnotationProperty .

:highBalanceCustomers a owl:DatatypeProperty ;
    rdfs:label "High balance customers" ;
    rdfs:domain :Customer ;
    :aggregate "count" ;
    :concept :HighBalanceCustomer ;
    :counts :Customer ;
    :grain :Customer ;
    :universe :Customer .

:l_commitdate a owl:DatatypeProperty ;
    rdfs:label "l_commitdate" ;
    rdfs:comment "SQL `date`; typed xsd:dateTime because xsd:date is not in the OWL 2 datatype map." ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:dateTime ;
    :businessAlias "Commit date" ;
    :businessDescription "The date the line was promised to ship. Comparing it with the ship date is what 'late lines' means — a definition this ontology still cannot state, because it compares two properties (M-0034)." ;
    :physicalColumn "l_commitdate" ;
    :sqlType "date" ;
    :unit "date" .

:l_linenumber a owl:DatatypeProperty ;
    rdfs:label "l_linenumber" ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:integer ;
    :physicalColumn "l_linenumber" ;
    :sqlType "integer" .

:l_linestatus a owl:DatatypeProperty ;
    rdfs:label "l_linestatus" ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:string ;
    :businessAlias "Line status" ;
    :businessDescription "O = open, F = finished. The line's own status, distinct from the order's — an order can be finished while a line is not." ;
    :physicalColumn "l_linestatus" ;
    :sqlType "character varying" .

:l_partkey a owl:ObjectProperty ;
    rdfs:domain :OrderLine ;
    rdfs:range :Product ;
    :businessAlias "Product" ;
    :businessDescription "The product sold on this line. Group by the product's name, brand or type; the label rule for :Product is identified but waiting on the naming migration (see 06-part-meaning.ttl)." ;
    :physicalColumn "l_partkey" ;
    :referencesColumn "p_partkey" .

:l_partkey_l_suppkey a owl:ObjectProperty ;
    rdfs:domain :OrderLine ;
    rdfs:range :ProductSupplier ;
    :businessAlias "Product supplier pair" ;
    :businessDescription "The COMPOSITE reference: this line's (product, supplier) pair is one row of `:ProductSupplier`, which is where the vendor's price for it lives. Composite keys are paired POSITIONALLY from :physicalColumn and :referencesColumn, which is why half a key cannot be derived by mistake — Cube's own generator did exactly that once, dropping l_partkey and inflating every cost by it." ;
    :physicalColumn "l_partkey,l_suppkey" ;
    :referencesColumn "ps_partkey,ps_suppkey" .

:l_quantity a owl:DatatypeProperty ;
    rdfs:label "l_quantity" ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:decimal ;
    :businessAlias "Quantity" ;
    :businessDescription "Units sold on this line. An ADDITIVE count: summable across products, suppliers and time alike." ;
    :physicalColumn "l_quantity" ;
    :sqlType "numeric" ;
    :unit "count" .

:l_receiptdate a owl:DatatypeProperty ;
    rdfs:label "l_receiptdate" ;
    rdfs:comment "SQL `date`; typed xsd:dateTime because xsd:date is not in the OWL 2 datatype map." ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:dateTime ;
    :businessAlias "Receipt date" ;
    :businessDescription "When the customer received the line." ;
    :physicalColumn "l_receiptdate" ;
    :sqlType "date" ;
    :unit "date" .

:l_shipdate a owl:DatatypeProperty ;
    rdfs:label "l_shipdate" ;
    rdfs:comment "SQL `date`; typed xsd:dateTime because xsd:date is not in the OWL 2 datatype map." ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:dateTime ;
    :businessAlias "Ship date" ;
    :businessDescription "When the line was SHIPPED. The line grain's own time axis, and the reason `verify_measures.py` compares line measures on this and order measures on `o_orderdate`: an order placed in one year can ship in the next, so the two per-year splits do not add up to each other." ;
    :physicalColumn "l_shipdate" ;
    :sqlType "date" ;
    :unit "date" .

:l_shipinstruct a owl:DatatypeProperty ;
    rdfs:label "l_shipinstruct" ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:string ;
    :physicalColumn "l_shipinstruct" ;
    :sqlType "character varying" .

:l_shipmode a owl:DatatypeProperty ;
    rdfs:label "l_shipmode" ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:string ;
    :businessAlias "Ship mode" ;
    :businessDescription "How it was shipped: one of 7 TPC-H modes (AIR, FOB, MAIL, RAIL, REG AIR, SHIP, TRUCK)." ;
    :physicalColumn "l_shipmode" ;
    :sqlType "character varying" .

:l_suppkey a owl:ObjectProperty ;
    rdfs:domain :OrderLine ;
    rdfs:range :Supplier ;
    :businessAlias "Supplier" ;
    :businessDescription "The supplier of this line, directly — the reference the model did not have until this table entered the ontology. A supplier/part pair is what `:ProductSupplier` describes, and both joins exist: this one, and the composite one." ;
    :physicalColumn "l_suppkey" ;
    :referencesColumn "s_suppkey" .

:l_tax a owl:DatatypeProperty ;
    rdfs:label "l_tax" ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:decimal ;
    :businessAlias "Tax" ;
    :businessDescription "The tax applied, as a ratio in [0, 0.08]. Never sum it either (M-0028)." ;
    :physicalColumn "l_tax" ;
    :sqlType "numeric" ;
    :unit "ratio" .

:labelProperty a owl:AnnotationProperty .

:lineItems a owl:DatatypeProperty ;
    rdfs:label "Line items" ;
    rdfs:domain :OrderLine ;
    :additivity "additive" ;
    :aggregate "count" ;
    :grain :OrderLine ;
    :memberAlias "line_items" ;
    :unit "count" ;
    :universe :OrderLine .

:memberAlias a owl:AnnotationProperty .

:n_nationkey a owl:DatatypeProperty ;
    rdfs:label "n_nationkey" ;
    rdfs:domain :Nation ;
    rdfs:range xsd:integer ;
    :businessAlias "Nation ID" ;
    :businessDescription "The nation's key. A surrogate with no business meaning: group by :n_name instead." ;
    :physicalColumn "n_nationkey" ;
    :sqlType "integer" .

:netRevenue a owl:DatatypeProperty ;
    rdfs:label "Net revenue" ;
    rdfs:domain :OrderLine ;
    :additivity "additive" ;
    :aggregate "sum" ;
    :businessDescription "What the line is worth after discount, before tax. ADDITIVE although one of its two columns is a RATE that may never be summed (`l_discount`): the product is money, and money of a transaction adds up. The member is called `revenue`, which is why the binding is an explicit `meta.ontology_concept` rather than a name match. Measured 2026-09-21: 20,535,072,231.4150." ;
    :formula "l_extendedprice * (1 - l_discount)" ;
    :formulaSource "register M-0009 (ratified 2026-09-21, additivity decided ADDITIVE)" ;
    :grain :OrderLine ;
    :memberAlias "revenue" ;
    :unit "money" ;
    :universe :OrderLine .

:o_clerk a owl:DatatypeProperty ;
    rdfs:label "o_clerk" ;
    rdfs:domain :SalesOrder ;
    rdfs:range xsd:string ;
    :businessAlias "Clerk" ;
    :businessDescription "The clerk who processed the order, as a formatted identifier (Clerk#000000951). Not a foreign key: TPC-H has no clerk table." ;
    :physicalColumn "o_clerk" ;
    :sqlType "character varying" .

:o_custkey a owl:ObjectProperty ;
    rdfs:domain :SalesOrder ;
    rdfs:range :Customer ;
    :businessAlias "Customer" ;
    :businessDescription "The customer that placed the order. Group by the customer's LABEL rather than by this key; the customer cube exposes no name column today (c_name is excluded by a declared, inherited decision), so this key is all there is until that is decided." ;
    :physicalColumn "o_custkey" ;
    :referencesColumn "c_custkey" .

:o_orderdate a owl:DatatypeProperty ;
    rdfs:label "o_orderdate" ;
    rdfs:comment "SQL `date`; typed xsd:dateTime because xsd:date is not in the OWL 2 datatype map." ;
    rdfs:domain :SalesOrder ;
    rdfs:range xsd:dateTime ;
    :businessAlias "Order date" ;
    :businessDescription "The date the order was placed. A time dimension: the order-grain measures are compared year by year on this axis, where the line-grain ones use l_shipdate — the two are different axes and an order placed in one year can ship in the next." ;
    :physicalColumn "o_orderdate" ;
    :sqlType "date" ;
    :unit "date" .

:o_orderkey a owl:DatatypeProperty ;
    rdfs:label "o_orderkey" ;
    rdfs:domain :SalesOrder ;
    rdfs:range xsd:integer ;
    :businessAlias "Order ID" ;
    :businessDescription "The order number. This is the identifier a person quotes, which is why :SalesOrder declares no :labelProperty: the key IS the readable identity." ;
    :physicalColumn "o_orderkey" ;
    :sqlType "bigint" .

:o_orderpriority a owl:DatatypeProperty ;
    rdfs:label "o_orderpriority" ;
    rdfs:domain :SalesOrder ;
    rdfs:range xsd:string ;
    :businessAlias "Order priority" ;
    :businessDescription "The priority the order was given, one of five TPC-H values (1-URGENT through 5-LOW)." ;
    :physicalColumn "o_orderpriority" ;
    :sqlType "character varying" .

:o_orderstatus a owl:DatatypeProperty ;
    rdfs:label "o_orderstatus" ;
    rdfs:domain :SalesOrder ;
    rdfs:range xsd:string ;
    :businessAlias "Order status" ;
    :businessDescription "O = open, F = finished, P = partially shipped (TPC-H's own vocabulary, enforced by a CHECK constraint on the column)." ;
    :physicalColumn "o_orderstatus" ;
    :sqlType "character varying" .

:o_shippriority a owl:DatatypeProperty ;
    rdfs:label "o_shippriority" ;
    rdfs:domain :SalesOrder ;
    rdfs:range xsd:integer ;
    :businessAlias "Shipping priority" ;
    :businessDescription "A shipping priority code carried over from the order. No business rule is attached to its values in TPC-H." ;
    :physicalColumn "o_shippriority" ;
    :sqlType "integer" .

:p_brand a owl:DatatypeProperty ;
    rdfs:label "p_brand" ;
    rdfs:domain :Product ;
    rdfs:range xsd:string ;
    :businessAlias "Brand" ;
    :businessDescription "The manufacturer's brand, of the form 'Brand#23'. Group revenue by this to see the brand mix." ;
    :physicalColumn "p_brand" ;
    :sqlType "character varying" .

:p_container a owl:DatatypeProperty ;
    rdfs:label "p_container" ;
    rdfs:domain :Product ;
    rdfs:range xsd:string ;
    :businessAlias "Container" ;
    :businessDescription "The packaging: one of 15 TPC-H values (SM CASE, LG BOX, ...)." ;
    :physicalColumn "p_container" ;
    :sqlType "character varying" .

:p_mfgr a owl:DatatypeProperty ;
    rdfs:label "p_mfgr" ;
    rdfs:domain :Product ;
    rdfs:range xsd:string ;
    :businessAlias "Manufacturer" ;
    :businessDescription "The manufacturer, of the form 'Manufacturer#3'." ;
    :physicalColumn "p_mfgr" ;
    :sqlType "character varying" .

:p_name a owl:DatatypeProperty ;
    rdfs:label "p_name" ;
    rdfs:domain :Product ;
    rdfs:range xsd:string ;
    :businessAlias "Product name" ;
    :businessDescription "The product's name (a TPC-H generated phrase such as 'green blue lace trim'). This is the property :Product's label rule would point at." ;
    :physicalColumn "p_name" ;
    :sqlType "character varying" .

:p_partkey a owl:DatatypeProperty ;
    rdfs:label "p_partkey" ;
    rdfs:domain :Product ;
    rdfs:range xsd:integer ;
    :businessAlias "Product ID" ;
    :businessDescription "The product's key. A surrogate with no business meaning: group by the name instead, once the label rule can be declared (see the header)." ;
    :physicalColumn "p_partkey" ;
    :sqlType "bigint" .

:p_retailprice a owl:DatatypeProperty ;
    rdfs:label "p_retailprice" ;
    rdfs:domain :Product ;
    rdfs:range xsd:decimal ;
    :businessAlias "List price" ;
    :businessDescription "The list price of ONE unit, in money. A UNIT PRICE: summing it across products produces a number with no interpretation, which is why `sum(p_retailprice)` is screened out (M-0031) while an average at a stated grain is legitimate." ;
    :physicalColumn "p_retailprice" ;
    :sqlType "numeric" ;
    :unit "money" .

:p_size a owl:DatatypeProperty ;
    rdfs:label "p_size" ;
    rdfs:domain :Product ;
    rdfs:range xsd:integer ;
    :businessAlias "Size" ;
    :businessDescription "The size code, 1..50." ;
    :physicalColumn "p_size" ;
    :sqlType "integer" .

:p_type a owl:DatatypeProperty ;
    rdfs:label "p_type" ;
    rdfs:domain :Product ;
    rdfs:range xsd:string ;
    :businessAlias "Product type" ;
    :businessDescription "A phrase over the container and the material ('SMALL PLATED COPPER'). Not a clean dimension: the vocabulary is combinatorial, which is why the model also exposes size and container separately." ;
    :physicalColumn "p_type" ;
    :sqlType "character varying" .

:pendingModelling a owl:AnnotationProperty .

:physicalColumn a owl:AnnotationProperty .

:physicalPredicate a owl:AnnotationProperty .

:physicalTable a owl:AnnotationProperty .

:primaryKey a owl:AnnotationProperty .

:ps_availqty a owl:DatatypeProperty ;
    rdfs:label "ps_availqty" ;
    rdfs:domain :ProductSupplier ;
    rdfs:range xsd:integer ;
    :businessAlias "Available quantity" ;
    :businessDescription "The quantity a supplier has available for this product, in units. A SNAPSHOT of stock, not a flow: summing it over suppliers is meaningful (total availability), summing it over TIME is not -- which is why `sum(ps_availqty)` is deferred in the register (M-0027) for want of an as-of rule, not refused. The unit is registered in `unit_registry`, so the ontology can state it rather than guess." ;
    :physicalColumn "ps_availqty" ;
    :sqlType "integer" ;
    :unit "count" .

:ps_partkey a owl:ObjectProperty ;
    rdfs:domain :ProductSupplier ;
    rdfs:range :Product ;
    :businessAlias "Product" ;
    :businessDescription "One end of the pair: the product. Group by the product's name rather than by this key (the label rule for :Product is identified but waiting on the naming migration -- see 06-part-meaning.ttl)." ;
    :physicalColumn "ps_partkey" ;
    :referencesColumn "p_partkey" .

:ps_suppkey a owl:ObjectProperty ;
    rdfs:domain :ProductSupplier ;
    rdfs:range :Supplier ;
    :businessAlias "Supplier" ;
    :businessDescription "The other end of the pair: the supplier. Group by `s_name`, which is a dimension of the supplier cube already and matches its property :s_name by name." ;
    :physicalColumn "ps_suppkey" ;
    :referencesColumn "s_suppkey" .

:ps_supplycost a owl:DatatypeProperty ;
    rdfs:label "ps_supplycost" ;
    rdfs:domain :ProductSupplier ;
    rdfs:range xsd:decimal ;
    :businessAlias "Supply cost" ;
    :businessDescription "What the supplier charges per unit for this product, in money. A unit cost at the (product, supplier) grain: it is multiplied by a quantity to become a cost, which is what the `supply_cost` measure does." ;
    :physicalColumn "ps_supplycost" ;
    :sqlType "numeric" ;
    :unit "money" .

:r_name a owl:DatatypeProperty ;
    rdfs:label "r_name" ;
    rdfs:domain :Region ;
    rdfs:range xsd:string ;
    :physicalColumn "r_name" ;
    :sqlType "character varying" .

:r_regionkey a owl:DatatypeProperty ;
    rdfs:label "r_regionkey" ;
    rdfs:domain :Region ;
    rdfs:range xsd:integer ;
    :physicalColumn "r_regionkey" ;
    :sqlType "integer" .

:referencesColumn a owl:AnnotationProperty .

:s_acctbal a owl:DatatypeProperty ;
    rdfs:label "s_acctbal" ;
    rdfs:domain :Supplier ;
    rdfs:range xsd:decimal ;
    :physicalColumn "s_acctbal" ;
    :sqlType "numeric" ;
    :unit "money" .

:s_address a owl:DatatypeProperty ;
    rdfs:label "s_address" ;
    rdfs:domain :Supplier ;
    rdfs:range xsd:string ;
    :physicalColumn "s_address" ;
    :sqlType "character varying" .

:s_name a owl:DatatypeProperty ;
    rdfs:label "s_name" ;
    rdfs:domain :Supplier ;
    rdfs:range xsd:string ;
    :physicalColumn "s_name" ;
    :sqlType "character varying" .

:s_nationkey a owl:ObjectProperty ;
    rdfs:domain :Supplier ;
    rdfs:range :Nation ;
    :physicalColumn "s_nationkey" ;
    :referencesColumn "n_nationkey" .

:s_phone a owl:DatatypeProperty ;
    rdfs:label "s_phone" ;
    rdfs:domain :Supplier ;
    rdfs:range xsd:string ;
    :physicalColumn "s_phone" ;
    :sqlType "character varying" .

:s_suppkey a owl:DatatypeProperty ;
    rdfs:label "s_suppkey" ;
    rdfs:domain :Supplier ;
    rdfs:range xsd:integer ;
    :physicalColumn "s_suppkey" ;
    :sqlType "bigint" .

:sqlType a owl:AnnotationProperty .

:supplyCost a owl:DatatypeProperty ;
    rdfs:label "Supply cost" ;
    rdfs:domain :OrderLine ;
    :additivity "additive" ;
    :businessDescription "What the supplying vendor charges for the quantity actually sold: the line's quantity times the unit cost of its (product, supplier) pair. The ONE derived property here whose formula crosses a cube boundary, and it crosses on the COMPOSITE key `:l_partkey_l_suppkey` -- a join missing half the key matches every supplier of the product and inflates the cost, which is the failure Cube's own generator committed once. `{product_supplier.supply_cost}` is a DIMENSION there (ps_supplycost, a unit cost at the (product, supplier) grain), not a measure, so rule 6 expands it through the model's own `sql` before comparing. Measured 2026-09-21: 7,657,917,294.19." ;
    :formula "l_quantity * ps_supplycost" ;
    :formulaSource "register M-0012 (decided 2026-09-20 by weiping, acting business approver)" ;
    :unit "money" .

:thresholdSource a owl:AnnotationProperty .

:totalDiscount a owl:DatatypeProperty ;
    rdfs:label "Total discount" ;
    rdfs:domain :OrderLine ;
    :additivity "additive" ;
    :businessDescription "The money given away on this line: extended price times the discount ratio. Additive, because it is money of a transaction -- but it counts the discount at LIST price, so it is not the discount on net revenue (`revenue` is price AFTER discount) and the two must not be subtracted from each other. Measured 2026-09-21: 1,080,857,048.83 over 600,572 lines." ;
    :formula "l_extendedprice * l_discount" ;
    :formulaSource "register M-0010 (decided 2026-09-20 by weiping, acting business approver)" ;
    :unit "money" .

:unit a owl:AnnotationProperty .

:universe a owl:AnnotationProperty .

:weightedAverageDiscount a owl:DatatypeProperty ;
    rdfs:label "Weighted average discount" ;
    rdfs:domain :OrderLine ;
    :additivity "non-additive" ;
    :businessDescription "The discount actually given: total discount over gross revenue, 0.05000280278549279781 on this data. A RATIO OF SUMS, and the reason the candidate exists at all -- `avg(l_discount)` gives a different number and cannot be re-aggregated, because the average of the lines' rates ignores how much each line was worth. Declared and implemented on the same day, and the register's original note said it first: the formula is built from two measures that already exist and are verified, so nothing new had to be measured to trust it." ;
    :formula "{total_discount} / {gross_revenue}" ;
    :formulaSource "register M-0036 (approved 2026-09-21, implemented the same day)" ;
    :unit "ratio" .

:HighBalanceCustomer a owl:Class ;
    rdfs:label "High balance customer" ;
    rdfs:comment "An account whose balance is at least 5000. c_acctbal is a BALANCE (money), not a revenue figure, and it carries no time dimension: it is a snapshot, so this class is about the account's standing, not about its activity." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Customer [ a owl:Restriction ;
                        owl:onProperty :c_acctbal ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 5000.0 ] ) ] ] ) ] ;
    :businessAlias "big account",
        "high balance customers" ;
    :thresholdSource "RATIFIED 2026-09-21 by weiping (acting business approver): 5000 is the gate number for this concept, decided rather than assumed. It replaced a project convention that had been disclosed as unratified for a day. Measured 2026-09-21: 44.89% of customers qualify (6,733 of 15,000); the median balance is 4,404.96 and the maximum 9,999.72, so this selects a little under half the base; >= 3000 selects 9,479, >= 7000 selects 4,056, >= 10000 selects none." .

:HighValueLine a owl:Class ;
    rdfs:label "High value line" ;
    rdfs:comment "An order line whose extended price is at least 5000. Not the same set as HighValueOrder: an order can be high value with no high-value line, and a line can be high value inside a low-value order — the two counts differ, 562,414 against 148,552." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OrderLine [ a owl:Restriction ;
                        owl:onProperty :l_extendedprice ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 5000.0 ] ) ] ] ) ] ;
    :businessAlias "big line",
        "high value lines" ;
    :thresholdSource "RATIFIED 2026-09-21 by weiping (acting business approver): 5000 is the gate number. Measured here: 93.65% of lines qualify (562,414 of 600,572), against 99.03% of orders and 44.89% of customers at the same value. The line grain is also where it has a second use: :HighValueLine is the filler of :OrderWithHighValueLine, so this number reaches a class about ORDERS through a property of lines." .

:c_acctbal a owl:DatatypeProperty ;
    rdfs:label "c_acctbal" ;
    rdfs:domain :Customer ;
    rdfs:range xsd:decimal ;
    :businessAlias "Account balance" ;
    :businessDescription "The customer's account balance, in money. A snapshot with no time dimension: do not trend it." ;
    :physicalColumn "c_acctbal" ;
    :sqlType "numeric" ;
    :unit "money" .

:c_nationkey a owl:ObjectProperty ;
    rdfs:domain :Customer ;
    rdfs:range :Nation ;
    :businessAlias "Nation" ;
    :businessDescription "The nation this customer belongs to. Group by the target's label (n_name) rather than by this key, whose values mean nothing to a reader." ;
    :physicalColumn "c_nationkey" ;
    :referencesColumn "n_nationkey" .

:hasLine a owl:ObjectProperty ;
    rdfs:label "has line" ;
    rdfs:domain :SalesOrder ;
    rdfs:range :OrderLine ;
    owl:inverseOf :l_orderkey ;
    :businessDescription "The lines of this order — `:l_orderkey` read backwards. It exists because a definition about an ORDER cannot be stated through a property that starts at a line, and because the alternative is a SQL predicate with no ontology behind it (which is what M-0019 carried for a day)." .

:l_discount a owl:DatatypeProperty ;
    rdfs:label "l_discount" ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:decimal ;
    :businessAlias "Discount" ;
    :businessDescription "The discount applied, as a RATIO in [0, 0.10]. Never sum it: `sum(l_discount)` is a category error the register screens out (M-0025), and the average the business means is a ratio of sums (`average_line_value`)." ;
    :physicalColumn "l_discount" ;
    :sqlType "numeric" ;
    :unit "ratio" .

:l_extendedprice a owl:DatatypeProperty ;
    rdfs:label "l_extendedprice" ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:decimal ;
    :businessAlias "Extended price" ;
    :businessDescription "Quantity times the list price, in money, BEFORE discount and tax. Additive: the amount of a completed transaction." ;
    :physicalColumn "l_extendedprice" ;
    :sqlType "numeric" ;
    :unit "money" .

:l_orderkey a owl:ObjectProperty ;
    rdfs:domain :OrderLine ;
    rdfs:range :SalesOrder ;
    :businessAlias "Order" ;
    :businessDescription "The order this line belongs to. Group by the order's status or date rather than by this key; `sales_order` is where those live." ;
    :physicalColumn "l_orderkey" ;
    :referencesColumn "o_orderkey" .

:l_returnflag a owl:DatatypeProperty ;
    rdfs:label "l_returnflag" ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:string ;
    :businessAlias "Return flag" ;
    :businessDescription "R = returned, A = accepted, N = neither yet. R is what `:ReturnedLine` restricts on, and it is the one definition in this track whose criterion is a CODE rather than a number." ;
    :physicalColumn "l_returnflag" ;
    :sqlType "character varying" ;
    :unit "text" .

:n_name a owl:DatatypeProperty ;
    rdfs:label "n_name" ;
    rdfs:domain :Nation ;
    rdfs:range xsd:string ;
    :businessAlias "Country name" ;
    :businessDescription "The country's name, in capitals (IRAQ, IRAN, EGYPT...). This is :Nation's label — the property `:labelProperty` points at — so it is what a question 'by country' groups by." ;
    :physicalColumn "n_name" ;
    :sqlType "character varying" .

:n_regionkey a owl:ObjectProperty ;
    rdfs:domain :Nation ;
    rdfs:range :Region ;
    :businessAlias "Region" ;
    :businessDescription "The region this country belongs to. Group by the region's label (r_name) rather than by this key, whose values mean nothing to a reader." ;
    :physicalColumn "n_regionkey" ;
    :referencesColumn "r_regionkey" .

:o_totalprice a owl:DatatypeProperty ;
    rdfs:label "o_totalprice" ;
    rdfs:domain :SalesOrder ;
    rdfs:range xsd:decimal ;
    :businessAlias "Order total" ;
    :businessDescription "The total value of the order, in money, before tax. ADDITIVE across every dimension — unlike a snapshot balance such as c_acctbal, this is the amount of a completed transaction. The decision is recorded in the candidate register as M-0004; the ontology carries the fact (:unit money), not the decision." ;
    :physicalColumn "o_totalprice" ;
    :sqlType "numeric" ;
    :unit "money" .

:Region a owl:Class ;
    rdfs:label "Region" ;
    :columnCount 3 ;
    :physicalTable "region" ;
    :primaryKey "r_regionkey" .

:Nation a owl:Class ;
    rdfs:label "Nation" ;
    :businessAlias "countries",
        "country" ;
    :businessDescription "A country in the TPC-H geography: 25 of them, each belonging to exactly one region. Rows are referenced by customer, supplier and region through keys, so a question 'by nation' is really a question 'by n_name'." ;
    :columnCount 4 ;
    :labelProperty :n_name ;
    :physicalTable "nation" ;
    :primaryKey "n_nationkey" .

:ProductSupplier a owl:Class ;
    rdfs:label "ProductSupplier" ;
    :businessAlias "product supplier",
        "supply pairs" ;
    :businessDescription "One purchasable (product, supplier) pair, with the vendor's price and the quantity available. A LINK rather than an entity: its key is the pair, and it declares no :labelProperty because there is no third name to give it -- group it by the product's name or the supplier's." ;
    :columnCount 5 ;
    :physicalTable "partsupp" ;
    :primaryKey "ps_partkey,ps_suppkey" .

:Supplier a owl:Class ;
    rdfs:label "Supplier" ;
    :columnCount 7 ;
    :physicalTable "supplier" ;
    :primaryKey "s_suppkey" .

:Product a owl:Class ;
    rdfs:label "Product" ;
    :businessAlias "product",
        "products" ;
    :businessDescription "A part the business sells, as TPC-H models it: 200,000 of them, each with a brand, a type, a size and a list price. Note the absent :labelProperty — see the header; it is blocked by the naming migration, not forgotten." ;
    :columnCount 9 ;
    :physicalTable "part" ;
    :primaryKey "p_partkey" .

:Customer a owl:Class ;
    rdfs:label "Customer" ;
    :columnCount 8 ;
    :physicalTable "customer" ;
    :primaryKey "c_custkey" .

:SalesOrder a owl:Class ;
    rdfs:label "SalesOrder" ;
    :businessAlias "order",
        "orders" ;
    :businessDescription "One order placed by one customer. Carries the order-level total only; the individual lines are :OrderLine. Note the deliberate absence of :labelProperty — see the header of 05-orders-meaning.ttl." ;
    :columnCount 9 ;
    :physicalTable "orders" ;
    :primaryKey "o_orderkey" .

:OrderLine a owl:Class ;
    rdfs:label "OrderLine" ;
    :businessAlias "order line",
        "order lines",
        "sales line" ;
    :businessDescription "One line of a sales order: the unit of sale. Quantity, price, discount and tax facts live here, and the order-level ones live on :SalesOrder. Deliberately a different grain from :HighValueOrder, and neither implies the other." ;
    :columnCount 16 ;
    :physicalTable "lineitem" ;
    :primaryKey "l_orderkey,l_linenumber" .

