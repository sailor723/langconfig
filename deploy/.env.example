# ── the app ────────────────────────────────────────────────────────────────────
APP_PORT=8765
POSTGRES_USER=langconfig
POSTGRES_PASSWORD=change-me
POSTGRES_DB=langconfig
# the app's own database, as the backend reads it
DATABASE_URL=postgresql://langconfig:change-me@postgres:5432/langconfig

# ── the ontology databases ─────────────────────────────────────────────────────
# These are substituted into each profile's `dsn` block by compiler/dsn.py. A variable the profiles
# name but this file does not set is an ERROR at connect time, not a blank host.
ONTOLOGY_DB_HOST=ontology-postgres
ONTOLOGY_DB_PORT=5432
ONTOLOGY_DB_USER=weiping
ONTOLOGY_DB_PASSWORD=ontology_dev
ONTOLOGY_DB_NAME=abc_coldchain

# ── optional ───────────────────────────────────────────────────────────────────
# The ontology learning mirror (kept whole for study; not a runtime dependency). Mount it read-only
# when someone wants the standalone workbench available; leave unset otherwise.
# ONTOLOGY_MIRROR=/srv/ontology
# The interpreter that runs the compiler. Inside this image that IS the app's interpreter, so leave
# it empty unless the compiler must be isolated.
# ONTOLOGY_PYTHON=/usr/local/bin/python
# Seed directory for the ontology database (init scripts run once, on an empty volume)
# ONTOLOGY_SEED_DIR=./seed
